# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   What opens a file that no desktop application does.
#
# Every desktop default is /usr/share/kdos/xdg/kde-mimeapps.list; this list
# holds the handlers that are not a desktop application's, for types nothing
# in that list opens. The lookup reads this directory before
# /usr/share/kdos/xdg, so a type is named in one of the two and never both:
# named in both, this row would win and the other would never be read.
#
# A person's own choices live in their config directory and outrank every row
# here, which is what makes this a default rather than a policy.
# ---------------------------------

[Default Applications]
# THE ARCHIVES NOTHING ELSE ON THIS IMAGE OPENS. Ark has no reader for rar,
# and there is no unrar here, so `kdos-openarchive` extracts rar and the comic
# books packed as 7z or rar. Only these families are listed: they are what
# `ouch` reads AND what shared-mime-info can name, and a row for a type the
# image cannot produce is one nobody can tell is dead.
application/vnd.rar=kdos-openarchive.desktop
application/x-cb7=kdos-openarchive.desktop
application/vnd.comicbook-rar=kdos-openarchive.desktop
