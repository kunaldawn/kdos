# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   What opens a file on KDOS.
#
# This file names the desktop, so it is searched ahead of the plain
# `mimeapps.list` beside it wherever $XDG_CURRENT_DESKTOP begins with KDOS —
# which /etc/profile.d/10-wayland.sh makes true in every login shell, not only
# under the compositor. A row here therefore answers on a bare virtual terminal
# too, and every row here ends in a window: `imv` is a Wayland client and
# `nvim` is run inside the emulator, which is one as well. A type whose opener
# needs no display belongs in the plain table underneath, so that the two
# layers keep meaning something.
#
# A person's own choices live in their config directory and outrank every row
# here.
# ---------------------------------

[Default Applications]
image/png=imv.desktop
image/jpeg=imv.desktop
image/gif=imv.desktop
image/webp=imv.desktop
image/bmp=imv.desktop
image/tiff=imv.desktop
image/svg+xml=imv.desktop
text/plain=nvim.desktop
text/markdown=nvim.desktop
text/x-shellscript=nvim.desktop
application/json=nvim.desktop
application/x-shellscript=nvim.desktop
