# <file system> <mount point>   <type>  <options>       <dump>  <pass>
proc            /proc           proc    defaults        0       0
sysfs           /sys            sysfs   defaults        0       0
devtmpfs        /dev            devtmpfs defaults       0       0
# mode=1777 is NOT optional: a tmpfs mounted with `defaults` comes up 0755
# root, hiding the 1777 /tmp baked into the image, and then no non-root user
# can write to /tmp at all — which breaks Wayland/GTK apps, GIMP, LibreOffice,
# podman's temp files and fontconfig's cache writes.
tmpfs           /tmp            tmpfs   mode=1777,nosuid,nodev  0   0
tmpfs           /run            tmpfs   mode=0755,nosuid,nodev  0   0
cgroup2         /sys/fs/cgroup  cgroup2 nsdelegate      0       0
# The kernel mounts none of these three: without tracefs every tracepoint
# probe (bpftrace, perf trace, trace-cmd) finds an empty /sys/kernel/tracing,
# without debugfs the kernel's debug files (/sys/kernel/debug/dri/,
# wakeup_sources, powertop's readings) are absent, and without bpffs no pinned
# BPF object survives the process that made it.
tracefs         /sys/kernel/tracing tracefs nosuid,nodev,noexec 0   0
debugfs         /sys/kernel/debug debugfs nosuid,nodev,noexec 0     0
bpf             /sys/fs/bpf     bpf     nosuid,nodev,noexec,mode=0700 0 0
