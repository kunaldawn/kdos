#!/bin/bash

# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------
#
# service_helper - Shared service management functions
# Source this file from individual service scripts via:
#   . /etc/init.d/service_helper
#
# These are three thin wrappers now: the supervisor lives in ksvc, which is C.
# It had to move, because a respawn loop in a backgrounded subshell is not a
# process-group leader — so `kill -- -$pid` in the old stop_service addressed a
# group that pid did not lead, failed, fell back to killing the supervisor
# alone, and left the daemon running while reporting success.
#
# The command is a real argv now. `supervise foo /usr/sbin/foo --daemon` — not
# one string that a later unquoted expansion re-splits.

supervise() {
    local name="$1"
    shift
    ksvc supervise "$name" "$@"
}

stop_service() {
    ksvc stop-supervised "$1"
}

check_status() {
    ksvc check "$1"
}
