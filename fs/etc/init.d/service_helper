#
# service_helper - Shared service management functions
# Source this file from individual service scripts via:
#   . /etc/init.d/service_helper
#
# Three thin wrappers over ksvc, which is C. The supervisor must lead its own
# process group so that stopping it signals the group and the daemon goes with
# it; a respawn loop in a backgrounded shell subshell leads no group, and
# stopping it leaves the daemon running while reporting success.
#
# The command is an argument vector: `supervise foo /usr/sbin/foo --flag`, not
# one string that a later unquoted expansion would re-split.

supervise() {
    local name="$1"
    shift
    ksvc supervise "$name" "$@"
}

stop_service() {
    ksvc stop-supervised "$1"
}

check_status() {
    ksvc check "$1"
}
