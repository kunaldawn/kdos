#!/bin/bash

# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------

# rcS's mirror, run by init as the first `::shutdown` entry. toybox init runs
# the shutdown entries and then signals every process; it never runs a script's
# `stop` on its own, so without this no service saves its state — the mixer
# levels `50_alsa` stores are the plainest case.
#
# THE SAME SET rcS STARTED, in reverse. The enable rule is rcS's exactly: an
# executable `NN_name.sh` with no `/etc/service.disabled/<name>` marker. A
# script that rcS would have skipped is not stopped, and one that rcS ran is
# stopped after everything that started later than it.
#
# BEFORE swapoff AND umount in /etc/inittab. A service stopped after its
# filesystem went read-only cannot write what it came to save.
#
# THE FIREWALL IS NOT STOPPED. `25_nftables stop` flushes the ruleset, and it
# would run after the network scripts, whose interfaces stay configured when
# NetworkManager exits: the machine would sit on the network with nothing
# filtering until power-off. The ruleset goes when the kernel does.
#
# A failing stop does not end the walk. A service that was never started —
# skipped for want of hardware, or standing down for another — answers its stop
# with "not running", and every service after it still needs its turn.

export PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/sbin:/usr/local/bin

INIT_DIR="/etc/init.d"
DISABLED_DIR="/etc/service.disabled"

_scripts=()
for _script in "${INIT_DIR}"/[0-9][0-9]_*.sh; do
    [ -x "$_script" ] || continue
    _name=$(basename "$_script" | sed 's/^[0-9][0-9]_//;s/\.sh$//')
    [ -f "${DISABLED_DIR}/${_name}" ] && continue
    [ "$_name" = nftables ] && continue
    _scripts+=("$_script")
done

for ((_i = ${#_scripts[@]} - 1; _i >= 0; _i--)); do
    _script=${_scripts[_i]}
    echo "[KDOS] Running: $(basename "$_script") stop"
    "$_script" stop || true
done

sync
echo "KDOS services stopped."
