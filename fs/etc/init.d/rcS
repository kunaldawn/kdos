#!/bin/bash

# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------

# sysvinit hands its children PATH=/sbin:/usr/sbin:/bin:/usr/bin, which
# does not reach /usr/local. `kdos` and the rest of the KDOS commands live
# there, and a service or timer that names one by its bare name would be
# skipped as missing. Appended, so a name in both resolves to the base system.
export PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/sbin:/usr/local/bin

# On a boot with `quiet` the boot splash is already running: the initramfs
# started it and it survived switch_root, because its FIFO lives on devtmpfs.
# Keep talking to the same process so the screen never blinks between the two
# halves of boot. On a boot without `quiet` no splash runs, and every call is
# a no-op because nothing is listening on the FIFO.
splash() {
    command -v kdos-splash >/dev/null 2>&1 || return 0
    kdos-splash "$@" 2>/dev/null
    return 0
}

# Tell the progress bar how many stages this half of boot will add: fstab,
# one per enabled service script, and the session hand-off.
_n=2
for _s in /etc/init.d/[0-9][0-9]_*.sh; do
    [ -x "$_s" ] || continue
    [ -f "/etc/service.disabled/$(basename "$_s" | sed 's/^[0-9][0-9]_//;s/\.sh$//')" ] && continue
    _n=$((_n + 1))
done
splash total "$_n"
unset _s _n

# THE ACCENT, AS SOON AS /etc CAN BE READ. The splash was started by the
# initramfs, where no root filesystem existed, so it came up in the accent
# compiled into it. This is the first point at which the machine's own choice
# is readable, and the splash is still the only thing on the screen — so it
# repaints into the right scheme before anybody sees a frame in the wrong one.
#
# `/etc/kdos/accent` is written by the image build, the installer and
# kdos-powerd. Absent leaves the splash in the compiled-in default it is
# already wearing: nothing to send, and not a failure.
if [ -r /etc/kdos/accent ]; then
    # Kept at EOF: the writers end the name with no newline, on which `read`
    # fails after assigning it.
    _accent=""
    { read -r _accent || [ -n "$_accent" ]; } < /etc/kdos/accent
    [ -n "$_accent" ] && splash accent "$_accent"
    unset _accent
fi

# Mount all filesystems in fstab
splash step "MOUNTING FILESYSTEMS"
# Check every fstab filesystem with a pass number before anything mounts it.
# The root is left out (-R): the initramfs checked it before mounting it, and
# a check of a mounted root would ask for a reboot. The ESP is the one the
# installer marks, and it is FAT with no journal, holding the A/B boot state.
# An entry on a logical volume the initramfs activated is checked here like any
# other. One on a group it did not activate — any group on a live boot, or on a
# disk that appeared after it ran — has no device yet, so fsck reports it with
# bit 8, which is not shown here, and 03_lvm checks it once its group is active.
# A filesystem with errors left uncorrected is still mounted — the machine
# boots and says so, rather than stopping behind the splash. The report is held
# until /run is mounted: written now, it would land on the root filesystem's
# /run and be hidden under the tmpfs.
_fsck_rc=0
_fsck_out=""
if command -v fsck >/dev/null 2>&1; then
    _fsck_out=$(fsck -A -R -T -a </dev/null 2>&1)
    _fsck_rc=$?
fi
mount -a
[ -n "$_fsck_out" ] && printf '%s\n' "$_fsck_out" > /run/kdos-fsck.log
if [ $((_fsck_rc & 4)) -ne 0 ]; then
    splash detail "fsck: errors left uncorrected, see /run/kdos-fsck.log"
    printf '%s\n' "$_fsck_out"
fi
unset _fsck_rc _fsck_out
# efivarfs is not in fstab because it exists only on a UEFI boot, and a BIOS
# boot would fail the line. Without it /sys/firmware/efi/efivars is an empty
# directory: efibootmgr reports no EFI variables, the installer cannot write
# its NVRAM boot entry or see Secure Boot, fwupd has no UEFI devices, and
# kdos-bootctl can neither arm an update's BootNext trial nor, in mark-good,
# clear one.
if [ -d /sys/firmware/efi/efivars ] && ! mountpoint -q /sys/firmware/efi/efivars; then
    mount -t efivarfs -o nosuid,nodev,noexec efivarfs /sys/firmware/efi/efivars
fi
# /run is a fresh tmpfs, so /run/lock (and /var/lock, a link to it) exists only
# once made here. minicom and picocom run as the user and take their UUCP port
# locks there: absent, they lock nothing and two programs share one serial
# port; created 0755, picocom refuses to start with "cannot lock".
mkdir -p /run/lock
chmod 1777 /run/lock
# Loopback, before any service: NetworkManager brings lo up only when it runs,
# and a machine on the dhcpcd fallback never runs it, which leaves 127.0.0.1
# and ::1 unreachable for CUPS, chrony's command socket and everything else
# that talks to localhost.
ip link set lo up 2>/dev/null
# fstab asks for mode=1777, but a tmpfs that is already mounted ignores a mode
# change on remount, and a 0755 /tmp locks every non-root user out of /tmp —
# GTK/Wayland apps, GIMP, LibreOffice and fontconfig all fail in ways that look
# like "the app just doesn't start". Cheap, idempotent, and it always sticks.
chmod 1777 /tmp
# The X11 and ICE socket directories, root-owned and sticky, as nothing else
# on a tmpfs /tmp makes them. Without /tmp/.X11-unix KWin starts no Xwayland,
# DISPLAY stays empty and no X11 program opens, boxed ones included. Without
# /tmp/.ICE-unix the first session's ksmserver makes it as that user, and
# libICE then refuses it to every other account.
mkdir -p /tmp/.X11-unix /tmp/.ICE-unix
chown root:root /tmp/.X11-unix /tmp/.ICE-unix
chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix
# fstab may carry a swap entry (the installer writes one for a swap partition
# or a /swapfile). `mount -a` ignores swap lines, and inittab already has the
# matching swapoff on shutdown, so this is the only place it gets turned on.
swapon -a 2>/dev/null || true
# /etc/localtime belongs to no package, so a tzdata upgrade never rewrites a
# chosen zone, even one the new tzdata no longer lists. UTC is linked here only
# when nothing is there — every boot of the live medium, whose /etc starts as
# the image's — and a link that exists, dangling or not, is the machine's own
# choice and is left alone.
[ -L /etc/localtime ] || [ -e /etc/localtime ] || \
    ln -s /usr/share/zoneinfo/UTC /etc/localtime 2>/dev/null
splash ok

# Console font and palette are NOT set here: fbcon's deferred take-over resets
# every VT to the kernel's built-in font, and on the live medium it happens only
# when the first getty prints on its VT, after rcS is long gone.
# /usr/local/sbin/kdos-getty does both, per VT, at the only time it sticks.

# Make / recursively shared. systemd does this at PID1; OpenRC/Alpine document the
# same. Rootless podman/crun require a shared root for mount propagation, otherwise
# they warn "/ is not a shared mount" and container mount/exec breaks.
mount --make-rshared /

# ── Auto-run all numbered service scripts ─────────────────────────────────────
# Scripts must match the pattern:  /etc/init.d/NN_name.sh
# They are executed in numeric order with the argument 'start'.
# Each script is responsible for checking if its daemon exists before running.

INIT_DIR="/etc/init.d"
DISABLED_DIR="/etc/service.disabled"

for _script in "${INIT_DIR}"/[0-9][0-9]_*.sh; do
    [ -x "$_script" ] || continue
    _name=$(basename "$_script" | sed 's/^[0-9][0-9]_//;s/\.sh$//')
    if [ -f "${DISABLED_DIR}/${_name}" ]; then
        echo "[KDOS] Skipping disabled service: ${_name}"
        continue
    fi
    echo "[KDOS] Running: $(basename $_script) start"
    splash step "$(echo "$_name" | tr '[:lower:]' '[:upper:]')"

    # Redirect to a file and print it AFTERWARDS, never through a pipe. A
    # `supervise` points the supervisor and the daemon at its own log
    # forwarder, so a supervised service lets go of the script's output; any
    # other process a script leaves running with that output open would hold
    # a pipe's write end, a `| tee` would never see EOF, and the boot would
    # stop at that service. A file has no reader to wait on.
    #
    # Every message still reaches the console and the serial line, which is
    # the only way to debug a machine that dies behind a splash — just after
    # the step rather than streamed during it.
    _log="/run/kdos-init.${_name}.log"
    "$_script" start >"$_log" 2>&1
    _rc=$?
    cat "$_log"
    if [ "$_rc" = 0 ]; then
        splash ok
    else
        splash fail
        # The reason, not just the verdict. On the live medium this output
        # goes to the serial line, and the screen shows only the splash.
        while IFS= read -r _l; do
            splash detail "$_l"
        done < <(tail -n 6 "$_log" 2>/dev/null)
        unset _l
    fi
    unset _rc
done

unset _script

# THE FIRST OF THE TWO MARKERS THAT CONFIRM AN A/B SLOT: this boot started
# every service that was going to fail. It confirms nothing on its own.
# kdos-sysupdated runs `kdos-bootctl mark-good` only once the graphical marker
# beside it exists too, which it writes when a desktop session has answered
# for a minute — or the greeter has, on a machine nobody logs in to — so a
# slot whose services start and whose desktop does not still spends its
# attempt and is rolled back once its attempts are spent.
# Both markers are root's, under /run/kdos/bless, and /run is a tmpfs, so a
# boot starts with neither.
#
# LAST, deliberately: a boot that wedges before this line never writes it.
#
# AN IMAGE WITHOUT kdos-sysupdated CONFIRMS HERE, because nothing else would:
# the marker would wait for a reader that is not there, and every trial slot
# would roll back however well it booted. Silent when the machine has no boot
# state, which is every machine with a single root: there is nothing to
# confirm and that is not a failure.
mkdir -p /run/kdos/bless
chmod 0755 /run/kdos/bless
: > /run/kdos/bless/userspace
if [ ! -x /usr/sbin/kdos-sysupdated ] || [ -f "${DISABLED_DIR}/sysupdated" ]; then
    if command -v kdos-bootctl >/dev/null 2>&1; then
        kdos-bootctl mark-good >/dev/null 2>&1 || true
    fi
fi

# HAND THE SCREEN TO THE DISPLAY MANAGER. `handoff` runs the power-off
# animation and leaves the framebuffer black, and tty1 in graphics mode with
# its text cleared and its cursor hidden: nothing printed after it — the line
# below, init's runlevel message, a kernel message — is drawn between the
# splash's last frame and the first frame of the greeter's compositor, which
# takes tty1 from elogind still in graphics mode. A single-user boot puts
# sulogin on the console instead, which needs text, and gets `quit`: the same
# animation, with the console left in text mode and its cursor shown. The
# runlevel is the one a word on the kernel command line asks init for.
#
# SYNCHRONOUS. Either returns only once the splash has stopped drawing, so the
# compositor's modeset — started from inittab, which init reaches only after
# this script returns — acquires a device the splash has already let go. A
# splash that let go asynchronously would race that modeset, and the loser of
# the race is a black screen with a running session behind it.
_next=handoff
_words=()
{ read -r -a _words < /proc/cmdline; } 2>/dev/null
for _w in "${_words[@]}"; do
    case "$_w" in
    single|s|S|1|-s) _next=quit ;;
    esac
done
splash step "STARTING SESSION"
splash ok
splash "$_next"
unset _w _words _next

echo "KDOS Initialized."
