#!/bin/bash

# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------

# Mount all filesystems in fstab
mount -a

# Console font. Set here rather than in /etc/profile: KDFONTOP needs root, so a
# non-root login shell only ever printed an error. -C names the VT explicitly
# because rcS itself may be running on the serial console.
if [ -x /usr/bin/setfont ]; then
    for _tty in /dev/tty1 /dev/tty2; do
        [ -c "$_tty" ] && setfont -C "$_tty" ter-v32n 2>/dev/null
    done
    unset _tty
fi

# Console palette. PIO_CMAP sets the default colour map for the whole VT
# subsystem, so the text console is phosphor green from the first login prompt
# on — before anything Wayland exists. setvtrgb has no -C, and rcS may be
# running on the serial console, so stdin is redirected from a real VT to give
# it a console fd to ioctl.
if [ -x /usr/bin/setvtrgb ] && [ -r /etc/vtrgb ] && [ -c /dev/tty0 ]; then
    setvtrgb /etc/vtrgb < /dev/tty0 > /dev/tty0 2>/dev/null
fi

# Make / recursively shared. systemd does this at PID1; OpenRC/Alpine document the
# same. Rootless podman/crun require a shared root for mount propagation, otherwise
# they warn "/ is not a shared mount" and container mount/exec breaks.
mount --make-rshared /

# ── Auto-run all numbered service scripts ─────────────────────────────────────
# Scripts must match the pattern:  /etc/init.d/NN_name.sh
# They are executed in numeric order with the argument 'start'.
# Each script is responsible for checking if its daemon exists before running.

INIT_DIR="/etc/init.d"
DISABLED_DIR="/etc/service.disabled"

for _script in "${INIT_DIR}"/[0-9][0-9]_*.sh; do
    [ -x "$_script" ] || continue
    _name=$(basename "$_script" | sed 's/^[0-9][0-9]_//;s/\.sh$//')
    if [ -f "${DISABLED_DIR}/${_name}" ]; then
        echo "[KDOS] Skipping disabled service: ${_name}"
        continue
    fi
    echo "[KDOS] Running: $(basename $_script) start"
    "$_script" start
done

unset _script

echo "KDOS Initialized."
