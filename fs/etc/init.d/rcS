#!/bin/bash

# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------

# toybox init hands its children PATH=/sbin:/usr/sbin:/bin:/usr/bin, which
# does not reach /usr/local. `kdos` and the rest of the KDOS commands live
# there, and a service or timer that names one by its bare name would be
# skipped as missing. Appended, so a name in both resolves to the base system.
export PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/sbin:/usr/local/bin

# The boot splash is already running: the initramfs started it and it survived
# switch_root, because its FIFO lives on devtmpfs. Keep talking to the same
# process so the screen never blinks between the two halves of boot.
splash() {
    command -v kdos-splash >/dev/null 2>&1 || return 0
    kdos-splash "$@" 2>/dev/null
    return 0
}

# Tell the progress bar how many stages this half of boot will add: fstab,
# one per enabled service script, and the session hand-off.
_n=2
for _s in /etc/init.d/[0-9][0-9]_*.sh; do
    [ -x "$_s" ] || continue
    [ -f "/etc/service.disabled/$(basename "$_s" | sed 's/^[0-9][0-9]_//;s/\.sh$//')" ] && continue
    _n=$((_n + 1))
done
splash total "$_n"
unset _s _n

# THE ACCENT, AS SOON AS /etc CAN BE READ. The splash was started by the
# initramfs, where no root filesystem existed, so it came up in the accent
# compiled into it. This is the first point at which the machine's own choice
# is readable, and the splash is still the only thing on the screen — so it
# repaints into the right scheme before anybody sees a frame in the wrong one.
#
# `/etc/kdos/accent` is written by kdos-powerd when `kdos theme` runs. Absent
# means nothing has ever changed it, which is the compiled-in default the
# splash is already wearing: nothing to send, and not a failure.
if [ -r /etc/kdos/accent ]; then
    read -r _accent < /etc/kdos/accent || _accent=""
    [ -n "$_accent" ] && splash accent "$_accent"
    unset _accent
fi

# Mount all filesystems in fstab
splash step "MOUNTING FILESYSTEMS"
mount -a
# fstab asks for mode=1777, but a tmpfs that is already mounted ignores a mode
# change on remount, and a 0755 /tmp locks every non-root user out of /tmp —
# GTK/Wayland apps, GIMP, LibreOffice and fontconfig all fail in ways that look
# like "the app just doesn't start". Cheap, idempotent, and it always sticks.
chmod 1777 /tmp
# fstab may carry a swap entry (the installer writes one for a swap partition
# or a /swapfile). `mount -a` ignores swap lines, and inittab already has the
# matching swapoff on shutdown, so this is the only place it gets turned on.
swapon -a 2>/dev/null || true
splash ok

# Console font and palette are NOT set here: fbcon's deferred take-over (which
# happens when the first getty writes to its VT, after rcS is long gone) resets
# every VT to the kernel's built-in font, wiping whatever setfont loaded.
# /usr/local/sbin/kdos-getty does both, per VT, at the only time it sticks.

# Make / recursively shared. systemd does this at PID1; OpenRC/Alpine document the
# same. Rootless podman/crun require a shared root for mount propagation, otherwise
# they warn "/ is not a shared mount" and container mount/exec breaks.
mount --make-rshared /

# ── Auto-run all numbered service scripts ─────────────────────────────────────
# Scripts must match the pattern:  /etc/init.d/NN_name.sh
# They are executed in numeric order with the argument 'start'.
# Each script is responsible for checking if its daemon exists before running.

INIT_DIR="/etc/init.d"
DISABLED_DIR="/etc/service.disabled"

for _script in "${INIT_DIR}"/[0-9][0-9]_*.sh; do
    [ -x "$_script" ] || continue
    _name=$(basename "$_script" | sed 's/^[0-9][0-9]_//;s/\.sh$//')
    if [ -f "${DISABLED_DIR}/${_name}" ]; then
        echo "[KDOS] Skipping disabled service: ${_name}"
        continue
    fi
    echo "[KDOS] Running: $(basename $_script) start"
    splash step "$(echo "$_name" | tr '[:lower:]' '[:upper:]')"

    # Redirect to a file and print it AFTERWARDS, never through a pipe. A
    # service that calls `supervise` leaves a supervisor running that holds
    # any pipe's write end, so a `| tee` would never see EOF and rcS would
    # wait on it for ever: the boot stops at the first supervised service.
    #
    # Every message still reaches the console and the serial line, which is
    # the only way to debug a machine that dies behind a splash — just after
    # the step rather than streamed during it.
    _log="/run/kdos-init.${_name}.log"
    "$_script" start >"$_log" 2>&1
    _rc=$?
    cat "$_log"
    if [ "$_rc" = 0 ]; then
        splash ok
    else
        splash fail
        # The reason, not just the verdict. fbcon has not taken the console
        # over yet, so on a framebuffer boot this output is otherwise gone.
        while IFS= read -r _l; do
            splash detail "$_l"
        done < <(tail -n 6 "$_log" 2>/dev/null)
        unset _l
    fi
    unset _rc
done

unset _script

# The other half of A/B rollback: this boot got far enough to start every
# service that was going to fail, so the slot it booted is confirmed good.
#
# LAST, deliberately. Confirming earlier would confirm a system that has not yet
# failed rather than one that has succeeded — and the whole value of the attempt
# counter is that a boot which wedges before this line never reaches it, spends
# its attempt, and eventually rolls back.
#
# Silent when the machine has no boot state, which is every machine with a
# single root: there is nothing to confirm and that is not a failure.
if command -v kdos-bootctl >/dev/null 2>&1; then
    kdos-bootctl mark-good >/dev/null 2>&1 || true
fi

# Hand the screen back. This runs the power-off animation and leaves the
# framebuffer black, so the first write to tty1 — which is what finally
# triggers fbcon's deferred take-over — paints onto a clean console instead of
# fighting a process that is still drawing.
#
# SYNCHRONOUS, and the desktop depends on it twice over. `kdos-splash quit`
# returns only once the splash has stopped drawing, so init starts the tty1
# login on a framebuffer nothing else owns; and the compositor's modeset,
# further down that same chain, acquires a device the splash has already let
# go. A splash that quit asynchronously would race a modeset, and the loser of
# that race is a black screen with a running session behind it.
splash step "STARTING SESSION"
splash ok
splash quit

echo "KDOS Initialized."
