<?xml version="1.0"?>
<!--
  kdos-comp (labwc fork) window-manager config.
  KDOS-only settings (crt*, idle_*, wallpaper) live in ~/.config/kdos/comp.conf.
  Modifiers: W=Super  S=Shift  C=Ctrl  A=Alt.

  <default /> MUST BE THE FIRST CHILD of <keyboard> and of <mouse>, and it is
  the most load-bearing line in this file.

  labwc loads its built-in bindings ONLY when the user's file defines none at
  all (rcxml.c post_processing). A file that binds one key therefore silently
  throws away every default — and the defaults are not conveniences, they are
  the desktop: `Client Left Press -> Focus/Raise` is what makes CLICKING A
  WINDOW FOCUS IT (focus_follow_mouse is false), `Title Left Drag -> Move` is
  the titlebar, `Close/Iconify/Maximize Left Click` are the three buttons
  drawn on every frame, `Border Left Drag -> Resize` is the edges, and
  `Root Right Press -> ShowMenu` is the desktop menu. Dropping this line ships
  a session where the mouse appears not to work at all.

  Overrides go AFTER it: a duplicate binding replaces the earlier one
  (deduplicate_{key,mouse}_bindings keeps the LATER of the two).
-->
<labwc_config>

  <core>
    <gap>0</gap>
    <!--
      The yes/no dialog for <action name="If"><prompt>. labwc's default names
      `labnag`, which KDOS does not build (-Dlabnag=disabled: it is a
      pango-and-cairo dialog and this desktop draws cells), so the facility
      pointed at a binary that is not on the image. kdos-prompt is
      kdos-shell under another name and answers with the exit status labwc
      reads: 0 yes, 1 no, 254 cancelled.
    -->
    <promptCommand>kdos-prompt --message '%m' --no '%n' --yes '%y'</promptCommand>
  </core>

  <!--
    THE ONE CELL SIZE — and the one surface that cannot have it.

    Everything else on this desktop is a character grid at Terminus 32px: the
    panels, the menus, the launcher, the desktop icons, the lock screen, the
    boot splash and tty1. The compositor's own chrome — titlebars, the root
    menu, the window-switcher OSD — is drawn with pango, and pango's default
    is `sans` at 10 points. That put a 13-pixel antialiased sans title on top
    of every 32-pixel window, which is the one place the desktop stopped
    looking like one machine.

    Plain `Terminus` was asked for here and NEVER ARRIVED. Terminus is a PCF
    bitmap and **pango has not rendered bitmap fonts since 1.44** (this ships
    1.57), so the request fell through to DejaVu Sans on every titlebar and
    every menu — measured on a booted ISO, where the panel's text has 3
    luminance levels and the titlebar's has 143. fontconfig was never the
    problem: `fc-match Terminus` resolves correctly on the target.

    Hence the `terminus-ttf` port: the same face, converted to TTF, which pango
    CAN draw. Its family is `Terminus (TTF)` — upstream names it that way on
    purpose — and that separation is doing real work here. fcft draws the cell
    grid from the PCF and stays crisp; only these pango surfaces ask for the
    scalable one. A fontconfig alias from `Terminus` to the TTF would have
    "fixed" this line and turned the whole panel antialiased.

    Pango sizes are POINTS: at 96dpi, 24pt is 32 pixels, which keeps the
    titlebar the height of one cell. The colours of these same surfaces are
    generated — ~/.config/kdos-comp/themerc-override, written by `kdos theme`.
  -->
  <theme>
    <!-- SQUARE CORNERS. labwc's default is 8px, which puts a rounded plate at
         the top of every window on a desktop whose every other surface is a
         double-line box drawn on a character grid. A radius is the one thing
         a cell grid cannot express, so it is the one thing that makes an SSD
         read as somebody else's toolkit. -->
    <cornerRadius>0</cornerRadius>
    <font place="ActiveWindow"><name>Terminus (TTF)</name><size>24</size></font>
    <font place="InactiveWindow"><name>Terminus (TTF)</name><size>24</size></font>
    <font place="MenuHeader"><name>Terminus (TTF)</name><size>24</size></font>
    <font place="MenuItem"><name>Terminus (TTF)</name><size>24</size></font>
    <font place="OnScreenDisplay"><name>Terminus (TTF)</name><size>24</size></font>
  </theme>

  <!-- Named, because the panel's strip can show a name where it shows a digit,
       and "www" says more than "2". Numeric targets still work: to="2" resolves
       by index whatever the name says. -->
  <desktops number="4">
    <names>
      <name>main</name>
      <name>www</name>
      <name>hack</name>
      <name>misc</name>
    </names>
  </desktops>

  <keyboard>
    <default />

    <!-- the KDOS bindings, carried over from the old compositor -->
    <keybind key="W-Return"><action name="Execute" command="foot"/></keybind>
    <keybind key="W-d"><action name="Execute" command="kdos-launcher"/></keybind>
    <keybind key="W-q"><action name="Close"/></keybind>
    <!-- Ends the session, and ASKS first: one keystroke between a full screen
         of unsaved work and no screen at all is how a desktop loses trust.
         The dialog is kdos-prompt, via <promptCommand> above. -->
    <keybind key="W-Escape">
      <!-- The list of what was open is written BEFORE the question, because
           after the answer there is no session left to ask. It is only ever
           read back when ~/.config/kdos/session-restore exists. -->
      <action name="Execute" command="kdos-session-save"/>
      <action name="If">
        <prompt><message>End the KDOS session? Unsaved work will be lost.</message></prompt>
        <then><action name="Exit"/></then>
      </action>
    </keybind>
    <keybind key="W-Tab"><action name="NextWindow"/></keybind>
    <keybind key="W-S-Tab"><action name="PreviousWindow"/></keybind>
    <keybind key="W-l"><action name="Execute" command="kdos-lock"/></keybind>
    <keybind key="W-S-l"><action name="Execute" command="kdos-saver"/></keybind>

    <!-- new with the fork: maximize / fullscreen finally exist -->
    <keybind key="W-m"><action name="ToggleMaximize"/></keybind>
    <keybind key="W-f"><action name="ToggleFullscreen"/></keybind>
    <!-- Minimise had no key at all: the taskbar could do it with a click and
         the keyboard could not, so a window sent behind another could only be
         got at with the mouse. -->
    <keybind key="W-n"><action name="Iconify"/></keybind>
    <!-- The root menu from the keyboard. It is a right-click on the desktop
         otherwise, and the desktop is not always reachable — a maximised
         window covers all of it. atCursor="no" puts it where the pointer is
         NOT, which is the right answer for a menu opened by a key. -->
    <keybind key="W-space">
      <action name="ShowMenu" menu="root-menu" atCursor="no"/>
    </keybind>

    <!-- The notification CENTRE. A toast that expired used to be gone; the
         daemon keeps a history now and this is the way back to it, which
         matters most for the notifications nobody was there to see. Shift,
         because W-n is Iconify and a minimise key is pressed far more often
         than a history is read. -->
    <keybind key="W-S-n"><action name="Execute" command="kdos-notify"/></keybind>

    <!-- the three shell front ends that had no way in until now -->
    <keybind key="A-F2"><action name="Execute" command="kdos-run"/></keybind>
    <keybind key="W-e"><action name="Execute" command="foot -e mc"/></keybind>
    <!-- The screens. labwc takes its output configuration over
         wlr-output-management-v1 and KDOS had no client for it, so a mode, a
         scale or a second monitor's place could not be set at all. Both keys,
         because a laptop's own display key is the one people press. -->
    <keybind key="W-p"><action name="Execute" command="kdos-display"/></keybind>
    <keybind key="XF86Display"><action name="Execute" command="kdos-display"/></keybind>
    <keybind key="Print"><action name="Execute" command="kdos-shot region"/></keybind>
    <keybind key="S-Print"><action name="Execute" command="kdos-shot screen"/></keybind>

    <keybind key="W-1"><action name="GoToDesktop" to="1"/></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2"/></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3"/></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4"/></keybind>

    <keybind key="W-S-1"><action name="SendToDesktop" to="1"/></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2"/></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3"/></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4"/></keybind>

    <!-- 5 to 9 as well, and they are here even though <desktops number> above
         is 4: the panel's strip has room for four digits and does not scroll,
         so a fifth workspace was reachable with the WHEEL and with nothing
         else. Raise the number above and these keys are already bound; leave
         it at 4 and labwc resolves them to nothing, which is the same answer
         the strip gives. -->
    <keybind key="W-5"><action name="GoToDesktop" to="5"/></keybind>
    <keybind key="W-6"><action name="GoToDesktop" to="6"/></keybind>
    <keybind key="W-7"><action name="GoToDesktop" to="7"/></keybind>
    <keybind key="W-8"><action name="GoToDesktop" to="8"/></keybind>
    <keybind key="W-9"><action name="GoToDesktop" to="9"/></keybind>

    <keybind key="W-S-5"><action name="SendToDesktop" to="5"/></keybind>
    <keybind key="W-S-6"><action name="SendToDesktop" to="6"/></keybind>
    <keybind key="W-S-7"><action name="SendToDesktop" to="7"/></keybind>
    <keybind key="W-S-8"><action name="SendToDesktop" to="8"/></keybind>
    <keybind key="W-S-9"><action name="SendToDesktop" to="9"/></keybind>

    <!-- Relative workspace movement: the root-scroll default does the same
         thing and is unreachable under a maximised window. -->
    <keybind key="W-comma"><action name="GoToDesktop" to="left" wrap="yes"/></keybind>
    <keybind key="W-period"><action name="GoToDesktop" to="right" wrap="yes"/></keybind>
    <keybind key="W-S-comma"><action name="SendToDesktop" to="left"/></keybind>
    <keybind key="W-S-period"><action name="SendToDesktop" to="right"/></keybind>

    <!-- Window-state toggles the fork compiled and nothing bound. -->
    <keybind key="W-t"><action name="ToggleAlwaysOnTop"/></keybind>
    <keybind key="W-o"><action name="ToggleOmnipresent"/></keybind>
    <keybind key="W-s"><action name="ToggleShade"/></keybind>
    <!-- W-d above shadows labwc's default ToggleShowDesktop (the launcher
         matters more); this gives Show Desktop a key back. -->
    <keybind key="W-S-d"><action name="ToggleShowDesktop"/></keybind>
    <!-- The window menu from the keyboard (also a labwc default; restated
         because this file is the record of what a key does). -->
    <keybind key="A-space">
      <action name="ShowMenu" menu="client-menu" atCursor="no"/>
    </keybind>

    <!-- Keyboard tiling. The W-arrow snaps are labwc defaults, restated with
         the same combine="yes" they ship with; MoveToEdge and GrowToEdge had
         no key at all. -->
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" combine="yes"/></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" combine="yes"/></keybind>
    <keybind key="W-Up"><action name="SnapToEdge" direction="up" combine="yes"/></keybind>
    <keybind key="W-Down"><action name="SnapToEdge" direction="down" combine="yes"/></keybind>
    <keybind key="W-A-Left"><action name="MoveToEdge" direction="left"/></keybind>
    <keybind key="W-A-Right"><action name="MoveToEdge" direction="right"/></keybind>
    <keybind key="W-A-Up"><action name="MoveToEdge" direction="up"/></keybind>
    <keybind key="W-A-Down"><action name="MoveToEdge" direction="down"/></keybind>
    <!--
      C-S-Escape is the chord every task manager since NT has answered to, and
      the shipped bindings use no C-S- combination at all, so nothing is
      displaced. W-i is kdos-settings and W-Escape is the logout prompt; both
      are taken.
    -->
    <keybind key="C-S-Escape"><action name="Execute" command="kdos-res"/></keybind>
    <keybind key="W-C-Left"><action name="GrowToEdge" direction="left"/></keybind>
    <keybind key="W-C-Right"><action name="GrowToEdge" direction="right"/></keybind>
    <keybind key="W-C-Up"><action name="GrowToEdge" direction="up"/></keybind>
    <keybind key="W-C-Down"><action name="GrowToEdge" direction="down"/></keybind>
    <!-- The next workspace somebody is using, in either direction: nine of
         them reached only by number is nine keys for a person who uses two. -->
    <keybind key="W-Page_Up"><action name="GoToDesktop" to="left"/></keybind>
    <keybind key="W-Page_Down"><action name="GoToDesktop" to="right"/></keybind>

    <!-- The keybind cheat sheet, generated from THIS file. -->
    <keybind key="W-F1"><action name="Execute" command="kdos-keys"/></keybind>
    <!-- The rest of the panel from the keyboard. Everything below was a
         pointer-only surface: the clock and battery opened a calendar on a
         click and on nothing else, the volume applet was the wheel, and the
         settings and the documentation had no way in at all. -->
    <keybind key="W-c"><action name="Execute" command="kdos-cal"/></keybind>
    <keybind key="W-F2"><action name="Execute" command="kdos-teams"/></keybind>
    <keybind key="W-F3"><action name="Execute" command="kdos-audio"/></keybind>
    <keybind key="W-i"><action name="Execute" command="kdos-settings"/></keybind>
    <keybind key="W-slash"><action name="Execute" command="kdos-doc"/></keybind>
    <!-- The Start menu from the keyboard. The taskbar's own button is where a
         pointer goes; this is the same surface for a hand already on the
         keyboard, and it is deliberately NOT W-d — the launcher is a search
         box and this is a menu, and conflating them would cost one of them. -->
    <keybind key="W-a"><action name="Execute" command="kdos-start"/></keybind>
    <!-- And the F-key twins the console's function-key taskbar names. That row
         labels the chord rather than binding a bare key — a bare F7 belongs to
         the program in the window — so the chord it labels has to exist on
         both desktops or the label is true on one of them only. -->
    <keybind key="W-F10"><action name="Execute" command="kdos-start"/></keybind>
    <keybind key="W-F7"><action name="Execute" command="kdos-launcher"/></keybind>
    <!-- The device managers. Everything they drive has been running here
         since before there was a desktop; what was missing was a way in. -->
    <keybind key="W-F4"><action name="Execute" command="kdos-net"/></keybind>
    <keybind key="W-F5"><action name="Execute" command="kdos-bt"/></keybind>
    <keybind key="W-F6"><action name="Execute" command="kdos-devices"/></keybind>

    <!-- The two surfaces that had no chord on either desktop. A power page and
         a system monitor are what a person reaches for while something is
         going wrong, and both were reachable only from the Start menu. The
         console binds the same two, so there is one key card. -->
    <!-- Tile, cascade and keyboard rearrange are the CONSOLE'S ALONE and the
         card says so. labwc has no tile-all or cascade action and its
         MoveResize is not the same interaction, so binding W-S-t to the
         nearest thing here would make one chord mean two different things on
         the two desktops — which is the one rule this file and keys.conf
         exist to keep. W-F2 already opens kdos-teams above, which is the
         window list the console's Super+F2 draws for itself. -->
    <keybind key="W-C-p"><action name="Execute" command="kdos-energy"/></keybind>
    <keybind key="W-C-t"><action name="Execute" command="kdos-res"/></keybind>

    <!-- The desk accessories, the same chords the console binds. Summoned over
         whatever is on the screen and dismissed leaving it untouched, which is
         what Sidekick sold a million copies of in 1984 and what a layer
         surface already is. -->
    <keybind key="W-C-q"><action name="Execute" command="kdos-calc"/></keybind>
    <keybind key="W-C-n"><action name="Execute" command="kdos-note"/></keybind>
    <keybind key="W-C-v"><action name="Execute" command="kdos-clip"/></keybind>

    <!-- Run-or-raise, for anyone who wants one key per app. ForEach runs its
         <then> on every view matching the <query> (identifier is the app_id,
         globs allowed) and <none> when nothing matched — fluxbox's
         ClientPattern language, already compiled in. One key, one terminal:

    <keybind key="W-grave">
      <action name="ForEach">
        <query identifier="foot"/>
        <then><action name="Focus"/><action name="Raise"/></then>
        <none><action name="Execute" command="foot"/></none>
      </action>
    </keybind>
    -->


    <!-- media keys: keysyms that exist only on those keys, safe unmodified.
         These REPLACE the defaults, which shell out to pactl and
         brightnessctl — neither of which KDOS ships. kdos-osd does the
         change and draws the gauge. -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="kdos-osd volume +5"/></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="kdos-osd volume -5"/></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="kdos-osd volume toggle"/></keybind>
    <!-- The other half of the panel's `●MIC` lamp: the indicator names the
         application recording you and this is the key that stops it. It was
         the one media key with a readout and no control. -->
    <keybind key="XF86AudioMicMute"><action name="Execute" command="kdos-osd mic toggle"/></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="kdos-osd brightness +10"/></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="kdos-osd brightness -10"/></keybind>
  </keyboard>

  <!--
    Pointing devices. Nothing here is set, and the block is left as a comment
    on purpose: labwc's own defaults are already right for a laptop —
    tap-to-click is ENABLED by default (libinput_category_create() in
    config/libinput.c), which is the one people expect to have to turn on.
    These are the knobs for the ones that are a preference rather than a
    default, so they can be found without reading labwc's manual.

    <libinput>
      <device category="touchpad">
        <naturalScroll>yes</naturalScroll>
        <tap>yes</tap>
        <tapButtonMap>lrm</tapButtonMap>
        <disableWhileTyping>yes</disableWhileTyping>
        <pointerSpeed>0.0</pointerSpeed>
      </device>
      <device category="default">
        <accelProfile>adaptive</accelProfile>
        <scrollFactor>1.0</scrollFactor>
      </device>
    </libinput>
  -->

  <mouse>
    <default />

    <!-- Super+drag moves, Super+right-drag resizes: most KDOS windows are
         alien apps drawing their own decorations, with no titlebar to aim
         at. Both are in the defaults above verbatim; they are restated here
         because they are the two this desktop cannot do without and a future
         labwc would be free to drop them. -->
    <context name="Frame">
      <mousebind button="W-Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="W-Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="W-Right" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="W-Right" action="Drag"><action name="Resize"/></mousebind>
    </context>

    <!-- Shade on the titlebar, the fluxbox way: wheel up rolls the window into
         its bar, wheel down rolls it back. The wheel pair restates a labwc
         default verbatim (Unfocus/Focus included — a shaded window must not
         keep the keyboard); the double-click replaces the default
         ToggleMaximize, which W-m and the Maximize button both still do.
         "Title" is the context that covers the blank titlebar as well as the
         text (node-type.c), which is why the double-click is bound there and
         not on "Titlebar" — the latter would also fire on the buttons. -->
    <context name="Titlebar">
      <mousebind direction="Up" action="Scroll"><action name="Unfocus"/><action name="Shade"/></mousebind>
      <mousebind direction="Down" action="Scroll"><action name="Unshade"/><action name="Focus"/></mousebind>
      <!-- The window menu on press, not on release: same feel as the root
           menu's default Root Right Press. -->
      <mousebind button="Right" action="Press"><action name="Focus"/><action name="ShowMenu" menu="client-menu"/></mousebind>
    </context>
    <context name="Title">
      <mousebind button="Left" action="DoubleClick"><action name="ToggleShade"/></mousebind>
      <!-- Replaces the default Title Right Click (Focus/Raise/ShowMenu): the
           Titlebar Press above already opens the menu, and a second ShowMenu
           on the release would close what the press opened. -->
      <mousebind button="Right" action="Click"><action name="Focus"/><action name="Raise"/></mousebind>
    </context>
  </mouse>

  <!--
    Per-window rules, applied when a window first maps. Criteria are
    attributes (identifier = app_id, globs allowed; type = the window type;
    sandboxEngine/sandboxAppId = what kdos-boxsock tagged the client with, so
    a rule can name "everything from the appbox" — something no X11 window
    manager could say); properties are attributes too, and child <action>
    elements run on the new window. Three worked examples:

    GIMP's tool dialogs are busy enough without a titlebar each:

      <windowRule identifier="gimp" type="utility" serverDecoration="no"/>

    An alien app opens on workspace 4 (misc) — the box name is the
    sandboxAppId kdos-boxsock registers, and a pack box is named after its
    pack; follow="no" keeps you where you are:

      <windowRule sandboxEngine="io.kdos.appbox" sandboxAppId="app.gimp">
        <action name="SendToDesktop" to="4" follow="no"/>
      </windowRule>

    A dropdown terminal (`foot -a dropdown-foot`), parked at the top edge and
    immune to interactive moves:

      <windowRule identifier="dropdown-foot" fixedPosition="yes">
        <action name="MoveTo" x="0" y="0"/>
      </windowRule>

    Wrap the rules in one <windowRules> element to enable them.
  -->

</labwc_config>
