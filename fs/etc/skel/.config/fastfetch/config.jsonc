// ██╗  ██╗██████╗  ██████╗ ███████╗
// ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
// █████╔╝ ██║  ██║██║   ██║███████╗
// ██╔═██╗ ██║  ██║██║   ██║╚════██║
// ██║  ██╗██████╔╝╚██████╔╝███████║
// ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
// ---------------------------------
//   KD's Homebrew Linux Distro
// ---------------------------------
//
// KDOS system banner. Replaces the static /etc/motd on interactive login —
// /etc/bash.bashrc runs it when fastfetch is present and falls back to motd
// when it is not.
//
// The logo carries its own ANSI escapes (file-raw), so it stays phosphor
// regardless of what fastfetch would otherwise pick for the distro.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file-raw",
    "source": "/usr/share/kdos/logo.txt",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": " │ ",
    "color": { "keys": "green", "title": "light_green" },
    "constants": []
  },

  "modules": [
    { "type": "title", "color": { "user": "light_green", "at": "green", "host": "light_green" } },
    { "type": "custom", "format": "\u001b[32m────────────────────────────────────────\u001b[0m" },

    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "host", "key": "Host" },

    { "type": "custom", "format": "" },

    { "type": "command", "key": "Packages", "text": "ls -1 /var/lib/kpkg/db 2>/dev/null | wc -l | tr -d ' '" },
    { "type": "command", "key": "Accent", "text": "kdos theme 2>/dev/null" },
    { "type": "command", "key": "Alien apps", "text": "ls -1 \"$HOME\"/.local/share/applications/*.desktop 2>/dev/null | wc -l | tr -d ' '" },
    { "type": "command", "key": "Containers", "text": "podman ps --format '{{.Names}}' 2>/dev/null | wc -l | tr -d ' '" },
    { "type": "shell", "key": "Shell" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "wm", "key": "WM" },
    { "type": "display", "key": "Display" },

    { "type": "custom", "format": "" },

    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "swap", "key": "Swap" },
    { "type": "disk", "key": "Disk", "folders": "/" },
    { "type": "localip", "key": "Network", "showIpv6": false },

    { "type": "custom", "format": "" },
    { "type": "colors", "symbol": "block" }
  ]
}
