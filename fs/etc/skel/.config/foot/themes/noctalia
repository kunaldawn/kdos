# KDOS-Phosphor, in the shape noctalia's template processor writes.
#
# foot.ini includes this file. It is REGENERATED from the active colour scheme
# whenever the scheme changes (noctalia's `foot` template, applied by
# Scripts/bash/template-apply.sh), so `kdos theme amber` repaints every terminal
# without touching foot.ini. This copy is the phosphor default, seeded so the
# include always resolves on a fresh home — foot logs an error and falls back to
# its own colours if the included file is missing.
#
# Anything not written by the template (alpha, cursor, urls) belongs in
# foot.ini, after the include, where it survives regeneration.

[colors-dark]
background = 000a03
foreground = b8ffc8

selection-background = 12401f
selection-foreground = 39ff14

regular0 = 04120a
regular1 = ff3131
regular2 = 39ff14
regular3 = ffb000
regular4 = 2f8fff
regular5 = c77dff
regular6 = 25d0c0
regular7 = b8ffc8

bright0  = 12401f
bright1  = ff6b6b
bright2  = 7dff5c
bright3  = ffd166
bright4  = 6bb6ff
bright5  = e0aaff
bright6  = 68f5e6
bright7  = e8ffee
