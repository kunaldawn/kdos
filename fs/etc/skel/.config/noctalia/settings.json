{
  "general": {
    "showChangelogOnStartup": false,
    "telemetryEnabled": false,
    "radiusRatio": 0,
    "iRadiusRatio": 0,
    "boxRadiusRatio": 0,
    "screenRadiusRatio": 0,
    "showScreenCorners": false,
    "animationSpeed": 1.3,
    "enableShadows": true,
    "enableBlurBehind": true,
    "shadowOffsetX": 0,
    "shadowOffsetY": 0,
    "avatarImage": "/usr/share/kdos/kdos.png",
    "dimmerOpacity": 0.35,
    "clockStyle": "custom",
    "clockFormat": "HH\\nmm",
    "lockOnSuspend": true,
    "lockScreenAnimations": false,
    "enableLockScreenCountdown": true,
    "showSessionButtonsOnLockScreen": true,
    "showHibernateOnLockScreen": false,
    "lockScreenBlur": 0.5,
    "lockScreenTint": 0.4,
    "allowPanelsOnScreenWithoutBar": true
  },

  "ui": {
    "fontDefault": "DejaVu Sans",
    "fontFixed": "DejaVu Sans Mono",
    "panelBackgroundOpacity": 0.88,
    "boxBorderEnabled": true,
    "translucentWidgets": false,
    "panelsAttachedToBar": true,
    "scrollbarAlwaysVisible": true,
    "tooltipsEnabled": true
  },

  "colorSchemes": {
    "predefinedScheme": "KDOS-Phosphor",
    "useWallpaperColors": false,
    "darkMode": true,
    "schedulingMode": "off",
    "syncGsettings": true
  },

  "templates": {
    "enableUserTheming": true,
    "activeTemplates": [
      { "id": "foot", "enabled": true },
      { "id": "starship", "enabled": true },
      { "id": "btop", "enabled": true },
      { "id": "gtk", "enabled": true },
      { "id": "qt", "enabled": true }
    ]
  },

  "bar": {
    "barType": "framed",
    "position": "top",
    "density": "compact",
    "showOutline": true,
    "showCapsule": false,
    "capsuleOpacity": 1,
    "widgetSpacing": 8,
    "contentPadding": 2,
    "backgroundOpacity": 0.85,
    "marginVertical": 0,
    "marginHorizontal": 0,
    "frameThickness": 6,
    "frameRadius": 0,
    "outerCorners": false,
    "enableExclusionZoneInset": true,
    "displayMode": "always_visible",
    "hideOnOverview": false,
    "mouseWheelAction": "none",
    "rightClickAction": "controlCenter",
    "middleClickAction": "none",
    "widgets": {
      "left": [
        {
          "id": "Launcher",
          "icon": "terminal-2",
          "useDistroLogo": false
        },
        {
          "id": "Workspace",
          "labelMode": "name",
          "characterCount": 4,
          "hideUnoccupied": false,
          "showBadge": false,
          "pillSize": 0.5,
          "fontWeight": "bold",
          "focusedColor": "primary",
          "occupiedColor": "secondary",
          "emptyColor": "secondary"
        },
        {
          "id": "ActiveWindow",
          "showIcon": true,
          "showText": true,
          "maxWidth": 220,
          "scrollingMode": "hover"
        }
      ],
      "center": [
        {
          "id": "Clock",
          "formatHorizontal": "ddd dd MMM · HH:mm:ss",
          "formatVertical": "HH mm",
          "tooltipFormat": "dddd, dd MMMM yyyy · HH:mm:ss",
          "clockColor": "primary"
        }
      ],
      "right": [
        {
          "id": "AudioVisualizer",
          "width": 90,
          "colorName": "primary",
          "hideWhenIdle": true
        },
        {
          "id": "MediaMini",
          "hideWhenIdle": true,
          "maxWidth": 160,
          "showAlbumArt": false,
          "showProgressRing": true,
          "compactMode": true
        },
        {
          "id": "CustomButton",
          "ipcIdentifier": "kdos",
          "icon": "box",
          "showIcon": true,
          "iconPosition": "left",
          "hideMode": "alwaysExpanded",
          "textCommand": "kdos status --bar",
          "textIntervalMs": 30000,
          "leftClickExec": "foot -e kdos status",
          "rightClickExec": "foot --app-id=kdos-help -e kdos help --pager",
          "generalTooltipText": "Alien app containers — click for detail",
          "maxTextLength": { "horizontal": 20, "vertical": 8 }
        },
        {
          "id": "SystemMonitor",
          "compactMode": true,
          "useMonospaceFont": true,
          "showCpuUsage": true,
          "showCpuTemp": true,
          "showMemoryUsage": true,
          "showMemoryAsPercent": true,
          "showDiskUsage": false,
          "showNetworkStats": false
        },
        {
          "id": "Network",
          "displayMode": "onhover"
        },
        {
          "id": "Volume",
          "displayMode": "onhover",
          "middleClickCommand": "foot -e alsamixer"
        },
        {
          "id": "Battery",
          "displayMode": "graphic-clean",
          "hideIfNotDetected": true
        },
        {
          "id": "Tray",
          "drawerEnabled": true,
          "hidePassive": false
        },
        {
          "id": "NotificationHistory",
          "showUnreadBadge": true,
          "unreadBadgeColor": "primary"
        },
        {
          "id": "ControlCenter",
          "icon": "settings"
        },
        {
          "id": "SessionMenu",
          "iconColor": "error"
        }
      ]
    }
  },

  "wallpaper": {
    "enabled": true,
    "directory": "/usr/share/backgrounds/kdos",
    "fillMode": "crop",
    "fillColor": "#000a03",
    "setWallpaperOnAllMonitors": true,
    "overviewEnabled": true,
    "overviewBlur": 0.25,
    "overviewTint": 0.55,
    "transitionDuration": 900,
    "transitionType": ["pixelate", "stripes", "disc"],
    "transitionEdgeSmoothness": 0.02,
    "skipStartupTransition": true,
    "automationEnabled": false,
    "wallpaperChangeMode": "random",
    "randomIntervalSec": 900,
    "useWallhaven": false
  },

  "appLauncher": {
    "terminalCommand": "foot -e",
    "position": "center",
    "viewMode": "list",
    "density": "compact",
    "showCategories": true,
    "iconMode": "tabler",
    "showIconBackground": false,
    "sortByMostUsed": true,
    "enableSettingsSearch": true,
    "enableWindowsSearch": true,
    "enableSessionSearch": true,
    "enableClipboardHistory": false
  },

  "controlCenter": {
    "position": "close_to_bar_button",
    "diskPath": "/",
    "cards": [
      { "enabled": true, "id": "profile-card" },
      { "enabled": true, "id": "shortcuts-card" },
      { "enabled": true, "id": "audio-card" },
      { "enabled": false, "id": "brightness-card" },
      { "enabled": false, "id": "weather-card" },
      { "enabled": true, "id": "media-sysmon-card" }
    ],
    "shortcuts": {
      "left": [
        { "id": "Network" },
        { "id": "Bluetooth" },
        { "id": "WallpaperSelector" },
        { "id": "DarkMode" }
      ],
      "right": [
        { "id": "Notifications" },
        { "id": "KeepAwake" },
        { "id": "NightLight" },
        { "id": "NoctaliaPerformance" }
      ]
    }
  },

  "dock": {
    "enabled": false
  },

  "desktopWidgets": {
    "enabled": true,
    "overviewEnabled": false,
    "gridSnap": true,
    "monitorWidgets": [
      { "name": "VGA-1", "widgets": [
        { "id": "Clock", "x": 64, "y": 96, "scale": 1.8, "showBackground": false, "roundedCorners": false, "clockStyle": "digital", "clockColor": "primary", "format": "HH:mm\\nddd dd MMM yyyy" },
        { "id": "SystemStat", "x": 64, "y": 320, "scale": 1.0, "showBackground": false, "roundedCorners": false, "statType": "CPU", "layout": "bottom" },
        { "id": "AudioVisualizer", "x": 64, "y": 470, "scale": 1.0, "showBackground": false, "roundedCorners": false, "width": 340, "height": 64, "hideWhenIdle": true, "colorName": "primary" }
      ]},
      { "name": "Virtual-1", "widgets": [
        { "id": "Clock", "x": 64, "y": 96, "scale": 1.8, "showBackground": false, "roundedCorners": false, "clockStyle": "digital", "clockColor": "primary", "format": "HH:mm\\nddd dd MMM yyyy" },
        { "id": "SystemStat", "x": 64, "y": 320, "scale": 1.0, "showBackground": false, "roundedCorners": false, "statType": "CPU", "layout": "bottom" },
        { "id": "AudioVisualizer", "x": 64, "y": 470, "scale": 1.0, "showBackground": false, "roundedCorners": false, "width": 340, "height": 64, "hideWhenIdle": true, "colorName": "primary" }
      ]},
      { "name": "eDP-1", "widgets": [
        { "id": "Clock", "x": 64, "y": 96, "scale": 1.8, "showBackground": false, "roundedCorners": false, "clockStyle": "digital", "clockColor": "primary", "format": "HH:mm\\nddd dd MMM yyyy" },
        { "id": "SystemStat", "x": 64, "y": 320, "scale": 1.0, "showBackground": false, "roundedCorners": false, "statType": "CPU", "layout": "bottom" }
      ]},
      { "name": "HDMI-A-1", "widgets": [
        { "id": "Clock", "x": 64, "y": 96, "scale": 1.8, "showBackground": false, "roundedCorners": false, "clockStyle": "digital", "clockColor": "primary", "format": "HH:mm\\nddd dd MMM yyyy" },
        { "id": "SystemStat", "x": 64, "y": 320, "scale": 1.0, "showBackground": false, "roundedCorners": false, "statType": "CPU", "layout": "bottom" }
      ]},
      { "name": "DP-1", "widgets": [
        { "id": "Clock", "x": 64, "y": 96, "scale": 1.8, "showBackground": false, "roundedCorners": false, "clockStyle": "digital", "clockColor": "primary", "format": "HH:mm\\nddd dd MMM yyyy" },
        { "id": "SystemStat", "x": 64, "y": 320, "scale": 1.0, "showBackground": false, "roundedCorners": false, "statType": "CPU", "layout": "bottom" }
      ]}
    ]
  },

  "notifications": {
    "enabled": true,
    "location": "top_right",
    "density": "compact",
    "backgroundOpacity": 0.9,
    "lowUrgencyDuration": 3,
    "normalUrgencyDuration": 6,
    "criticalUrgencyDuration": 15,
    "enableBatteryToast": true,
    "enableKeyboardLayoutToast": true,
    "sounds": {
      "enabled": true,
      "volume": 0.35,
      "separateSounds": false
    }
  },

  "osd": {
    "enabled": true,
    "location": "bottom_center",
    "autoHideMs": 1500,
    "backgroundOpacity": 0.9
  },

  "audio": {
    "volumeStep": 5,
    "spectrumFrameRate": 30,
    "visualizerType": "linear",
    "spectrumMirrored": true,
    "volumeFeedback": false
  },

  "location": {
    "weatherEnabled": false,
    "use12hourFormat": false,
    "autoLocate": false
  },

  "calendar": {
    "cards": [
      { "enabled": true, "id": "calendar-header-card" },
      { "enabled": true, "id": "calendar-month-card" },
      { "enabled": false, "id": "weather-card" }
    ]
  },

  "sessionMenu": {
    "position": "center",
    "showHeader": true,
    "showKeybinds": true,
    "largeButtonsStyle": true,
    "largeButtonsLayout": "single-row",
    "powerOptions": [
      { "action": "lock", "enabled": true, "keybind": "1" },
      { "action": "suspend", "enabled": true, "keybind": "2" },
      { "action": "hibernate", "enabled": false, "keybind": "3" },
      { "action": "reboot", "enabled": true, "keybind": "4" },
      { "action": "logout", "enabled": true, "keybind": "5" },
      { "action": "shutdown", "enabled": true, "keybind": "6" },
      { "action": "rebootToUefi", "enabled": true, "keybind": "7" }
    ]
  },

  "idle": {
    "enabled": true,
    "screenOffTimeout": 900,
    "lockTimeout": 0,
    "suspendTimeout": 0,
    "fadeDuration": 5
  },

  "hooks": {
    "enabled": true,
    "startup": "/usr/local/bin/kdos-hook startup",
    "colorGeneration": "/usr/local/bin/kdos-hook colors",
    "wallpaperChange": "/usr/local/bin/kdos-hook wallpaper",
    "screenLock": "/usr/local/bin/kdos-hook lock",
    "screenUnlock": "/usr/local/bin/kdos-hook unlock"
  },

  "systemMonitor": {
    "externalMonitor": "foot -e btop",
    "useCustomColors": false
  },

  "network": {
    "disableDiscoverability": false,
    "bluetoothAutoConnect": true
  },

  "nightLight": {
    "enabled": false
  }
}
