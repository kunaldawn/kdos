# KDOS-Phosphor for btop, in the shape noctalia's template processor writes.
# Regenerated from the active colour scheme by `kdos theme`; btop.conf points
# color_theme at it. Seeded so a fresh home is already green.

theme[main_bg]="#000a03"
theme[main_fg]="#b8ffc8"
theme[title]="#39ff14"
theme[hi_fg]="#25d0c0"
theme[selected_bg]="#04120a"
theme[selected_fg]="#b8ffc8"
theme[inactive_fg]="#7ddb96"
theme[proc_misc]="#ffb000"
theme[cpu_box]="#12401f"
theme[mem_box]="#12401f"
theme[net_box]="#12401f"
theme[proc_box]="#12401f"
theme[div_line]="#12401f"
theme[temp_start]="#39ff14"
theme[temp_mid]="#ffb000"
theme[temp_end]="#ff3131"
theme[cpu_start]="#39ff14"
theme[cpu_mid]="#ffb000"
theme[cpu_end]="#25d0c0"
theme[free_start]="#39ff14"
theme[free_mid]="#ffb000"
theme[free_end]="#25d0c0"
theme[cached_start]="#39ff14"
theme[cached_mid]="#ffb000"
theme[cached_end]="#25d0c0"
theme[available_start]="#39ff14"
theme[available_mid]="#ffb000"
theme[available_end]="#25d0c0"
theme[used_start]="#39ff14"
theme[used_mid]="#ffb000"
theme[used_end]="#25d0c0"
theme[download_start]="#39ff14"
theme[download_mid]="#ffb000"
theme[download_end]="#25d0c0"
theme[upload_start]="#39ff14"
theme[upload_mid]="#ffb000"
theme[upload_end]="#25d0c0"
