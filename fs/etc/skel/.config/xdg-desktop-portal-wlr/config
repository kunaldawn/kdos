# xdg-desktop-portal-wlr — what happens when something asks to record the screen.
#
# chooser_type=simple runs chooser_cmd and reads the output it picks. slurp is
# already installed (phase 4) and is what upstream's own sample uses. The
# alternative, chooser_type=none, silently captures the first output — right on
# a laptop, wrong the moment a second screen is plugged in, and wrong in the
# direction where the user does not find out.
#
# max_fps caps the capture, not the desktop: a 30 fps screen recording of a
# 60 Hz session costs half the encode and looks the same.
[screencast]
max_fps=30
chooser_type=simple
chooser_cmd=slurp -f %o -or
