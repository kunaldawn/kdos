# xdg-desktop-portal-wlr — what happens when something asks to record the screen.
#
# chooser_type=dmenu writes every source the request allows, screens as
# "Monitor: <name> <description>" and windows as "Window: <title> (<id>)", to
# chooser_cmd's stdin and captures the line it prints. It is the only type
# that offers windows: `simple` (slurp) can name only an output, and a request
# for a window answered with an output name records the whole screen. fuzzel
# is a phase-4 port and a layer-shell client. The alternative,
# chooser_type=none, silently captures the first output — right on a laptop,
# wrong the moment a second screen is plugged in, and wrong in the direction
# where the user does not find out.
#
# max_fps caps the capture, not the desktop: a 30 fps screen recording of a
# 60 Hz session costs half the encode and looks the same. It is also what
# bounds a recording of a screen NOBODY IS TOUCHING — the compositor answers a
# capture whether or not anything changed, so a still desktop is committed and
# encoded at this rate for as long as the recording runs, and at the output's
# own rate if this line is removed.
[screencast]
max_fps=30
chooser_type=dmenu
chooser_cmd=fuzzel --dmenu --lines=10 --prompt='Share: '
