# THIS FILE IS LIVE, NOT COMMENTED OUT, and that is the difference between khal
# and the mail templates beside it. khal with no `[calendars]` section refuses
# to start — `critical: Found no calendar section in the config file`, exit 1 —
# so a file of comments would be a calendar that cannot open. It points instead
# at a store holding one EMPTY calendar: nothing is configured, and everything
# runs.

[calendars]

# A DIRECTORY OF DIRECTORIES, each one a vdir: plain .ics files, one per event.
# Greppable, diffable, and backed up by copying it — the same reason this image
# keeps mail in a Maildir rather than in a database.
#
# `discover`, so every directory under the glob is a calendar: the image ships
# one, `personal`, empty, which `khal import` and `khal new` write into, and a
# directory added beside it (a vdirsyncer collection, say) is found with no
# edit here. Discover creates nothing; with no directory under the glob khal
# has no calendar and `khal import` fails.
[[local]]
path = ~/.local/share/calendars/*
type = discover

[locale]
# ISO, AND THAT IS A DECISION SCRIPTS DEPEND ON. khal parses the dates on its
# command line with THIS format and prints them with it too, so a script can
# pass `2026-09-01 30d` and read back `2026-09-14` without guessing at
# anybody's locale. Change it and every such script misreads its dates.
dateformat = %Y-%m-%d
longdateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
longdatetimeformat = %Y-%m-%d %H:%M
timeformat = %H:%M
# Monday, which is what the ISO week is.
firstweekday = 0
