# msmtp's configuration, and the machine ships it EMPTY OF ACCOUNTS.
#
# THIS FILE IS MODE 600 AND MSMTP ENFORCES IT THE MOMENT YOU WRITE A `password`
# LINE: a file carrying one that is not owned by you, or that anyone else can
# read, is refused outright and the send fails rather than leaking.
# `passwordeval` below avoids the question by keeping the secret in the
# password store instead of here, and does not trip the check.
#
# `sendmail` ON THIS IMAGE IS THIS PROGRAM. /usr/sbin/sendmail and
# /usr/bin/sendmail both link to msmtp, so anything that hands a message to
# either — aerc, cron, mailx, a script — is configured by this file and by
# nothing else.

#defaults
#auth on
#tls on
#tls_trust_file /etc/ssl/certs/ca-certificates.crt
#logfile ~/.local/state/msmtp.log

#account example
#host smtp.example.org
#port 587
#from you@example.org
#user you@example.org
#passwordeval "pass show mail/example.org"

# The account used when a message names none. Without this line msmtp refuses
# a message from a program that does not pass `-a`, which is most of them.
#account default : example
