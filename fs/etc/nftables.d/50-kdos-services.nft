# Written by kdos-powerd, for the Firewall settings page and
# `kdos-power firewall`. Rewritten WHOLE on every change, so a
# rule it does not recognise is dropped — anything hand-made
# belongs in a file beside this one, which this never touches.
#
# An open name is its rule. A closed name's packets from another
# machine are counted in kdos_knock_<name>; every closed name's
# packets then meet the chain's policy.
#
# No `type`/`hook` line: that is what re-opens the existing
# input chain rather than declaring a second one.

table inet filter {
	counter kdos_knock_ssh {
	}
	counter kdos_knock_http {
	}
	counter kdos_knock_https {
	}
	counter kdos_knock_ipp {
	}
	counter kdos_knock_smb {
	}
	counter kdos_knock_kiwix {
	}
	counter kdos_knock_mqtt {
	}
	counter kdos_knock_xmpp {
	}
	counter kdos_knock_nfs {
	}
	counter kdos_knock_babel {
	}
	counter kdos_knock_nut {
	}
	counter kdos_knock_snmp {
	}
	counter kdos_knock_mumble {
	}
	counter kdos_knock_caldav {
	}
	counter kdos_knock_mail {
	}
	counter kdos_knock_irc {
	}
	counter kdos_knock_dlna {
	}
	counter kdos_knock_tryton {
	}
	counter kdos_knock_caddy {
	}
	counter kdos_knock_mosh {
	}
	counter kdos_knock_syncthing {
	}
	counter kdos_knock_kdeconnect {
	}
	counter kdos_knock_vnc {
	}
	counter kdos_knock_rdp {
	}
	counter kdos_knock_xonotic {
	}
	chain input {
		fib saddr type != local tcp dport 22 counter name "kdos_knock_ssh"
		fib saddr type != local tcp dport 80 counter name "kdos_knock_http"
		fib saddr type != local tcp dport 443 counter name "kdos_knock_https"
		fib saddr type != local tcp dport 631 counter name "kdos_knock_ipp"
		fib saddr type != local tcp dport 445 counter name "kdos_knock_smb"
		fib saddr type != local tcp dport 8080 counter name "kdos_knock_kiwix"
		fib saddr type != local tcp dport { 1883, 8883 } counter name "kdos_knock_mqtt"
		fib saddr type != local tcp dport 5222 counter name "kdos_knock_xmpp"
		fib saddr type != local tcp dport 2049 counter name "kdos_knock_nfs"
		fib saddr type != local udp dport 6696 counter name "kdos_knock_babel"
		fib saddr type != local tcp dport 3493 counter name "kdos_knock_nut"
		fib saddr type != local udp dport 161 counter name "kdos_knock_snmp"
		fib saddr type != local meta l4proto . th dport { tcp . 64738, udp . 64738 } counter name "kdos_knock_mumble"
		fib saddr type != local tcp dport 5232 counter name "kdos_knock_caldav"
		fib saddr type != local tcp dport { 25, 143, 465, 587, 993 } counter name "kdos_knock_mail"
		fib saddr type != local tcp dport { 6667, 6697 } counter name "kdos_knock_irc"
		fib saddr type != local meta l4proto . th dport { tcp . 8200, udp . 1900 } counter name "kdos_knock_dlna"
		fib saddr type != local tcp dport 8000 counter name "kdos_knock_tryton"
		fib saddr type != local tcp dport 8443 counter name "kdos_knock_caddy"
		fib saddr type != local udp dport 60000-61000 counter name "kdos_knock_mosh"
		fib saddr type != local meta l4proto . th dport { tcp . 22000, udp . 22000, udp . 21027 } counter name "kdos_knock_syncthing"
		fib saddr type != local meta l4proto { tcp, udp } th dport 1714-1764 counter name "kdos_knock_kdeconnect"
		fib saddr type != local tcp dport 5900 counter name "kdos_knock_vnc"
		fib saddr type != local tcp dport 3389 counter name "kdos_knock_rdp"
		fib saddr type != local udp dport 26000 counter name "kdos_knock_xonotic"
	}
}
