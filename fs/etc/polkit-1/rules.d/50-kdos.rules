/*
 * KDOS: what polkit's shipped defaults do not decide the way this desktop
 * wants, and nothing else.
 *
 * THE DEFAULTS DECIDE FIRST. polkitd tracks sessions through elogind, so a
 * subject in the active local session — the person at the machine — gets each
 * action's allow_active, a local session switched away from gets
 * allow_inactive, and anything else gets allow_any: an SSH login (openssh
 * registers no session), a cron job, a daemon. polkit-kde-authentication-
 * agent-1 answers every password the defaults ask for in a Plasma session.
 * This file changes an answer only where KDOS wants another one, and names
 * the action each time.
 *
 * THE RULES DECIDE; THE AGENT ONLY ANSWERS WHAT THEY LEAVE. A rule returning
 * YES is a grant nobody is asked about, so one exists only for something an
 * administrator at the keyboard does as a matter of course and whose default
 * would stop them for a password every time. A rule returning AUTH_ADMIN_KEEP
 * is a prompt made explicit, so a broader rule in a file sorted after this one
 * cannot turn it into a silent yes. A rule returning NO is something this
 * system does not do, refused where the defaults would have asked.
 *
 * WHEEL MEANS WHEEL AT THE MACHINE. Every grant to the group also tests
 * subject.local && subject.active, so it reaches the administrator in the
 * foreground session and never an SSH login, a backgrounded job or a session
 * switched away from. Those get the defaults, and a wheel member there has
 * sudo, which asks.
 *
 * WHAT THE GRANTS GIVE. The administrator at the machine edits and deletes
 * system network connections, and can read back their passphrases; mounts,
 * unlocks and formats internal disks and opens a raw device for an image
 * writer; and saves root-owned files from Kate, repartitions with GParted,
 * manages libvirt's system guests and ends other users' processes from
 * Resources after one password every five minutes. That is the group whose
 * shipped sudoers line is `%wheel ALL=(ALL) ALL`, so each is a shortcut to
 * something they already have rather than a new capability.
 *
 * A NAME NOT IN THIS FILE IS THE DEFAULT'S. Removable drives, Wi-Fi and the
 * network toggles, hotspots, smart cards, modems, suspend and power-off,
 * brightness, power profiles, the time zone and network time, the accent and
 * the rest are allow_active upstream already, and the person at the machine
 * gets them with no rule here. testing/fixtures/polkit holds the measured
 * defaults and the table of answers this file must produce, and
 * testing/selftest.sh evaluates this file against both.
 */

polkit.addRule(function (action, subject) {
    var here = subject.local && subject.active;

    switch (action.id) {
    /*
     * THE SYSTEM CRONTAB IS NOT OFFERED. crond runs each user's own crontab
     * and is built to read no /etc/crontab: the timers the system ships are
     * snooze's, in /etc/kdos/timers.d. A Task Scheduler save into the system
     * crontab would write a file nothing reads, so it is refused where the
     * save is asked for, and the user's own crontab, which needs no polkit,
     * is the one it edits.
     */
    case "local.kcron.crontab.save":
        return polkit.Result.NO;

    /*
     * BATTERY CHARGE THRESHOLDS ARE TLP's. TLP sets them from /etc/tlp.d at
     * boot and again each time it applies a profile, so a limit PowerDevil's
     * helper wrote would last until TLP next ran, and a battery page showing
     * a limit the battery does not keep is worse than one that refuses. The
     * two writes are refused for everyone; the reads stay the defaults'.
     */
    case "org.kde.powerdevil.chargethresholdhelper.setthreshold":
    case "org.kde.powerdevil.chargethresholdhelper.setconservationmode":
        return polkit.Result.NO;

    /*
     * HELD AT A PASSWORD FOR EVERYONE AT THE MACHINE, whatever comes after
     * this file: flashing system firmware, letting a Thunderbolt device onto
     * the PCIe bus, and gvfs's admin:// writes as root. Away from the machine
     * the defaults apply, and each of them is stricter there.
     */
    case "org.freedesktop.fwupd.update-internal":
    case "org.freedesktop.bolt.enroll":
    case "org.freedesktop.bolt.authorize":
    case "org.freedesktop.bolt.manage":
    case "org.gtk.vfs.file-operations":
    case "org.gtk.vfs.file-operations-helper":
        return here ? polkit.Result.AUTH_ADMIN_KEEP : undefined;
    }

    if (!here || !subject.isInGroup("wheel"))
        return undefined;   /* not ours to answer — the defaults decide */

    switch (action.id) {
    /*
     * A SYSTEM CONNECTION is one every user of the machine joins: what
     * plasma-nm creates with "all users may connect", what nmcli makes, and
     * every profile the installer wrote. Its default is a password even at
     * the machine. The rest of NetworkManager's everyday actions — scanning,
     * joining, the Wi-Fi switch, a hotspot, a profile of one's own — are
     * allow_active already.
     */
    case "org.freedesktop.NetworkManager.settings.modify.system":
        return polkit.Result.YES;

    /*
     * udisks2's actions for a drive that is not removable, or that another
     * user holds: Dolphin and the Device Notifier mounting a second internal
     * disk, unlocking its LUKS container, unmounting or ejecting what another
     * login mounted, taking ownership of a fresh filesystem, an image writer
     * or GNOME Disks reaching the raw device, and formatting or partitioning
     * an internal drive. Their removable twins are allow_active upstream; the
     * -system and -others forms are a password at the machine, and here are
     * the administrator's without one. The storage layout under a running
     * system — fstab, crypttab, RAID, LVM, btrfs, swap — and the firmware
     * erases stay the defaults' prompt.
     */
    case "org.freedesktop.udisks2.filesystem-mount-system":
    case "org.freedesktop.udisks2.filesystem-unmount-others":
    case "org.freedesktop.udisks2.filesystem-take-ownership":
    case "org.freedesktop.udisks2.encrypted-unlock-system":
    case "org.freedesktop.udisks2.encrypted-lock-others":
    case "org.freedesktop.udisks2.eject-media-system":
    case "org.freedesktop.udisks2.loop-delete-others":
    case "org.freedesktop.udisks2.open-device":
    case "org.freedesktop.udisks2.open-device-system":
    case "org.freedesktop.udisks2.modify-device-system":
        return polkit.Result.YES;

    /*
     * Administrative applications, one password per agent session rather
     * than one per action: GParted re-running itself through pkexec, K3b
     * setting the burner's group and permissions, KTextEditor (Kate,
     * KDevelop) writing a file the user cannot, virt-manager reaching
     * qemu:///system, and Resources ending another user's process. Each
     * writes a raw disk or a root-owned file, which is what a prompt is for.
     */
    case "org.gnome.gparted":
    case "org.kde.k3b.updatepermissions":
    case "org.kde.ktexteditor6.katetextbuffer.savefile":
    case "org.libvirt.unix.manage":
    case "net.nokyan.Resources.kill":
        return polkit.Result.AUTH_ADMIN_KEEP;
    }

    return undefined;
});
