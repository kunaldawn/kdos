/*
 * KDOS: the actions this desktop calls, granted to wheel.
 *
 * WHY THERE IS NO AUTHENTICATION AGENT INSTEAD. polkit resolves a subject's
 * session by asking org.freedesktop.ConsoleKit, which is not on this system
 * and is not coming — logind is refused and ConsoleKit would be a session
 * daemon bought for one consumer. So no subject is ever in an active session,
 * allow_active and allow_inactive are never read, and every check lands on
 * allow_any. NetworkManager's policy omits allow_any entirely for
 * enable-disable-wifi, enable-disable-network and both wifi.share actions,
 * and an omitted element is a flat refusal that raises no challenge — an
 * agent is consulted only for a challenge, so no agent could ever be asked
 * about the controls this file exists to make work.
 *
 * ONE MECHANISM, NEVER TWO. The decision is written in
 * docs/kdos/03-architecture/security-model.md; if an agent is ever added this
 * file is what has to go, and the reverse.
 *
 * NAMED ACTIONS, NOT AN INTERFACE. The alternative is a D-Bus policy granting
 * wheel NetworkManager's write interfaces, which cannot scope a
 * Properties.Set to one property and cannot leave out the hostname or the
 * machine-wide resolver.
 *
 * WHAT THIS GRANTS. Anybody in wheel reconfigures networking with no prompt,
 * and can read back any stored passphrase. That is the group whose shipped
 * sudoers line is `%wheel ALL=(ALL) ALL`, so it is a shortcut to something
 * they already have rather than a new capability: the passphrases are files
 * under /etc/NetworkManager that `sudo cat` prints. The boundary this file
 * moves is convenience, not privilege. They also reach a smart card through
 * pcscd, which is the card holder's own device behind the card's own PIN.
 * They can also unlock and enable a modem and read its text messages through
 * mmcli (ModemManager Device.Control and Messaging), which ModemManager
 * otherwise allows only to an active session.
 *
 * A NAME NOT IN THIS LIST IS NOT GRANTED. Every id here is one a shipped
 * surface or a shipped user program calls; adding a row is a decision, and
 * the list is short so that reading it is one.
 */

polkit.addRule(function (action, subject) {
    if (!subject.isInGroup("wheel"))
        return undefined;   /* not ours to answer — fall through */

    switch (action.id) {
    /*
     * pcscd asks for these on every PC/SC connection and on every reader it
     * hands out, and ships them allow_active only: without them only root
     * reaches a smart card, and gpg's scdaemon, opensc, ykman and
     * openconnect's certificate login all read "access denied". A card is
     * its holder's own device and its PIN is the card's to check, so this is
     * the same grant a logged-in desktop would get from the policy itself.
     */
    case "org.debian.pcsc-lite.access_pcsc":
    case "org.debian.pcsc-lite.access_card":
        return polkit.Result.YES;

    /* kdos-net: the list, joining, forgetting, and the wifi toggle. */
    case "org.freedesktop.NetworkManager.network-control":
    case "org.freedesktop.NetworkManager.wifi.scan":
    case "org.freedesktop.NetworkManager.enable-disable-wifi":
    case "org.freedesktop.NetworkManager.enable-disable-network":
    case "org.freedesktop.NetworkManager.settings.modify.own":
    /*
     * SYSTEM CONNECTIONS ARE THE ONLY KIND THAT WORK HERE, so this is the
     * permission that forgetting a network and reading its passphrase back
     * actually land on. NetworkManager is built -Dsession_tracking=no —
     * there is no logind and no ConsoleKit — so its session monitor answers
     * FALSE for every user, a profile naming an owner in `permissions` is
     * permanently invisible, and an invisible profile has autoconnect
     * blocked. kdos-net therefore writes no owner, and modify.own is kept
     * only for profiles some other tool created with one.
     */
    case "org.freedesktop.NetworkManager.settings.modify.system":
    /*
     * A hotspot is share.open or share.protected, and the choice is made by
     * whether the profile carries an 802-11-wireless-security setting AT ALL —
     * not by the band, and not by what key-mgmt says: even key-mgmt=none picks
     * `protected`. Neither is reached unless ipv4.method is "shared". Both are
     * the same decision here.
     */
    case "org.freedesktop.NetworkManager.wifi.share.open":
    case "org.freedesktop.NetworkManager.wifi.share.protected":
        return polkit.Result.YES;

    /*
     * mmcli: unlocking a SIM, enabling a modem, and its text messages.
     * NetworkManager needs neither — it is root, and polkit answers root
     * without reading a rule — so these are for the person at a terminal,
     * whose carrier's data-limit warnings arrive as SMS. ModemManager is built
     * -Dpolkit=strict, which ships both allow_active only.
     */
    case "org.freedesktop.ModemManager1.Device.Control":
    case "org.freedesktop.ModemManager1.Messaging":
        return polkit.Result.YES;
    }

    /*
     * DELIBERATELY ABSENT, each for its own reason:
     *   settings.modify.hostname   the hostname is the installer's and
     *                              /etc/hostname's, not a running desktop's
     *   settings.modify.global-dns a machine-wide resolver is not a per-user
     *                              decision
     *   checkpoint-rollback        nothing here creates a checkpoint, so a
     *                              rollback could only undo somebody else's
     *   sleep-wake                 kdos-powerd owns suspend, with its own gate
     *   reload                     re-reading NetworkManager's own config is
     *                              administration, and `sudo` is how it is done
     */
    return undefined;
});
