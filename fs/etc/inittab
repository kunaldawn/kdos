::sysinit:/etc/init.d/rcS

# Serial Console (root, for debugging)
ttyS0::askfirst:/bin/bash -l

# Local Console (QEMU Window / Physical) — the console desktop's login.
#
# kdos-con-login reads /etc/kdos/con.conf: `greet = no` hands the tty to
# `agetty --autologin kdos`, which is the live medium's answer and keeps utmp,
# lastlog and the shell profile on the path they take everywhere else; `greet =
# yes` draws the login surface instead. agetty, not toybox getty, because only
# agetty implements --autologin.
#
# kdos-getty stays in the chain and stays FIRST: it loads the console font and
# palette after fbcon's deferred take-over, and doing that in rcS is futile
# because the take-over resets every VT's font. It also falls back to the plain
# autologin getty if the program named here is missing, so an image built
# without the console desktop still gives a console.
tty1::respawn:/usr/local/sbin/kdos-getty tty1 /usr/local/sbin/kdos-con-login tty1

# Second console, root login prompt. THE RECOVERY CONSOLE: it is a plain getty
# and nothing above may be allowed to make it one too, because it is what is
# left when the desktop on tty1 does not come up.
tty2::respawn:/usr/local/sbin/kdos-getty tty2 /sbin/getty 38400 tty2

# Restart
::restart:/sbin/init
::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
