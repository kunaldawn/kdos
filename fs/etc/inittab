::sysinit:/etc/init.d/rcS

# Serial Console (root, for debugging)
ttyS0::askfirst:/bin/bash -l

# Local Console (QEMU Window / Physical) — the desktop's login.
#
# kdos-login reads /etc/kdos/login.conf and hands the tty to agetty, with
# `--autologin` where that file names an account. agetty, not toybox getty,
# because only agetty implements --autologin. The desktop itself is started by
# the login shell's profile, not from here.
#
# kdos-getty stays in the chain and stays FIRST: it loads the console font and
# palette after fbcon's deferred take-over, and doing that in rcS is futile
# because the take-over resets every VT's font. It also falls back to the plain
# autologin getty if the program named here is missing, so a broken login path
# still gives a console.
tty1::respawn:/usr/local/sbin/kdos-getty tty1 /usr/local/sbin/kdos-login tty1

# Second console, root login prompt. THE RECOVERY CONSOLE: it is a plain getty
# and nothing above may be allowed to make it one too, because it is what is
# left when the desktop on tty1 does not come up.
tty2::respawn:/usr/local/sbin/kdos-getty tty2 /sbin/getty 38400 tty2

# Restart
::restart:/sbin/init
::ctrlaltdel:/sbin/reboot
# Shutdown entries run in order, each to completion, before init signals every
# process. rcK stops the services first, while the filesystems they save to
# are still writable.
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
