# KDOS — serial adapters reachable by the console user.
#
# These rules and `kdos`'s membership of `dialout` in fs/etc/group are one
# mechanism: without both, every serial programmer, dev board, instrument and
# GPS in the ports tree is installed and unopenable, and the failure presents
# as a broken cable rather than as a permission.
#
# MODE 0660 with GROUP dialout, not 0666: a serial port is a device other users
# on a multi-user machine have no business reading.

SUBSYSTEM=="tty", KERNEL=="ttyUSB[0-9]*", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", KERNEL=="ttyAMA[0-9]*", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", KERNEL=="ttyS[0-9]*",   GROUP="dialout", MODE="0660"

# FTDI, Prolific, Silicon Labs and WCH bridges reached as raw USB rather than
# through the tty layer — libftdi1 and libserialport both open these directly,
# and a tty rule does not cover them.
SUBSYSTEM=="usb", ATTR{idVendor}=="0403", GROUP="dialout", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="067b", GROUP="dialout", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="10c4", GROUP="dialout", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", GROUP="dialout", MODE="0660"
