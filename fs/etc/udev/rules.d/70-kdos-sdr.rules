# KDOS — software-defined radio front ends.
#
# The dvb_usb_rtl28xxu blacklist in /etc/modprobe.d/kdos-sdr.conf is the
# load-bearing half of this. The kernel otherwise claims an RTL2832U as a DVB-T
# tuner on plug-in and librtlsdr cannot open a device that is present,
# enumerated and listed by lsusb — which presents as a dead dongle. This file
# is the access half; neither works alone.

# Every RTL2832U stick librtlsdr's device table knows — the Realtek reference
# ids, and the Terratec, Compro, Dexatek, Peak/SVEON, MyGica and other branded
# sticks. rtl-sdr's own rtl-sdr.rules lists the same ids with
# GROUP="plugdev", a group this system does not have, so its recipe does not
# install it and this list is kept to it instead.
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2832", GROUP="dialout", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2838", GROUP="dialout", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="0413", ATTR{idProduct}=="6680", GROUP="dialout", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="0413", ATTR{idProduct}=="6f0f", GROUP="dialout", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="0458", ATTR{idProduct}=="707f", GROUP="dialout", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="0ccd", ATTR{idProduct}=="00a9", GROUP="dialout", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="0ccd", ATTR{idProduct}=="00b3", GROUP="dialout", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="0ccd", ATTR{idProduct}=="00b4", GROUP="dialout", MODE="0660"
