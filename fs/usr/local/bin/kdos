#!/bin/bash
# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------
#
# kdos — the front door. Everything KDOS-specific hangs off this one command so
# there is exactly one thing to remember and one place to discover the rest.
#
#   kdos help            keybinds and commands
#   kdos theme           switch the accent across COSMIC, foot, btop, starship
#   kdos status          what is installed, running and containerised
#   kdos app <name>      install an alien app into a distrobox
#   kdos doctor          check the session for the things that usually break
#   kdos version         who and what this is

set -u

COSMIC_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/cosmic"
FOOT_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/foot/themes/kdos"
BTOP_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/btop/themes/kdos.theme"
STARSHIP_TOML="${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml"
# Overridable so the generator can be exercised outside an installed system.
GTK_THEME_GEN="${KDOS_GTK_THEME_GEN:-/usr/share/kdos/gtk-theme/gengtk.py}"
ICON_GEN="${KDOS_ICON_GEN:-/usr/share/kdos/icons/genicons.py}"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/kdos"
THEME_STATE="$STATE_DIR/theme"

THEMES="phosphor amber ice bone"

# ANSI, but only when someone is looking.
if [ -t 1 ]; then
    C_A=$'\033[1;32m'; C_B=$'\033[0;32m'; C_D=$'\033[2;32m'; C_W=$'\033[1;33m'; C_0=$'\033[0m'
else
    C_A=""; C_B=""; C_D=""; C_W=""; C_0=""
fi

die() { printf '%skdos:%s %s\n' "$C_W" "$C_0" "$*" >&2; exit 1; }

# ─────────────────────────────────────────────────────────────────────
# Palettes
#
# One table, four schemes, consumed by every generator below. Fields:
#   primary  dim  secondary  urgent  deep  text  variant  primary_dark  backdrop  label
# ─────────────────────────────────────────────────────────────────────
palette() {
    case "$1" in
        phosphor) echo "39ff14 12401f ffb000 ff3131 000a03 b8ffc8 04120a 1f8f0c 02120a KDOS-Phosphor" ;;
        amber)    echo "ffb000 4a2f00 ff6b1a ff3131 0d0600 ffd9a0 160d02 8a5f00 140b02 KDOS-Amber" ;;
        ice)      echo "4dd7ff 123a4a 7aa2ff ff4d6d 00080d bfeeff 031420 1f7fa0 021a26 KDOS-Ice" ;;
        bone)     echo "f4f0e2 3a3833 b9b3a1 ff5a5a 0a0a09 ded9cb 141412 8f8b7e 161512 KDOS-Bone" ;;
        *)        return 1 ;;
    esac
}

current_theme() {
    if [ -r "$THEME_STATE" ]; then
        read -r t < "$THEME_STATE"
        palette "$t" >/dev/null 2>&1 && { echo "$t"; return; }
    fi
    echo phosphor
}

# ─────────────────────────────────────────────────────────────────────
# kdos theme
# ─────────────────────────────────────────────────────────────────────
write_cosmic_theme() {
    # kdos-theme-helper drives cosmic-theme's own ThemeBuilder, so the applied
    # theme (accent, backgrounds, hover/pressed states, the lot) is exactly
    # what the Settings UI would compute. COSMIC repaints live.
    command -v kdos-theme-helper >/dev/null 2>&1 || {
        echo "kdos: kdos-theme-helper not installed — COSMIC keeps its palette" >&2
        return 0
    }
    kdos-theme-helper "$1" "$2" "$3" "$4" "$5" "$6" >/dev/null
}

write_panel_colors() {
    # Panel + dock background follow the scheme's deep bg. cosmic-panel
    # watches its config and repaints live.
    local deep="$1" ron dir f
    ron=$(awk -v r=$((16#${deep:0:2})) -v g=$((16#${deep:2:2})) -v b=$((16#${deep:4:2})) \
        'BEGIN{printf "Color((%.7f, %.7f, %.7f))", r/255, g/255, b/255}')
    for f in com.system76.CosmicPanel.Panel com.system76.CosmicPanel.Dock; do
        dir="${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/$f/v1"
        mkdir -p "$dir"
        printf '%s\n' "$ron" > "$dir/background"
    done
}

# Integer-percent hex mixer: mix_hex AABBCC DDEEFF 30 -> 70% first + 30% second.
mix_hex() {
    local a="$1" b="$2" f="$3" out="" i x y
    for i in 0 2 4; do
        x=$((16#${a:$i:2})); y=$((16#${b:$i:2}))
        out+=$(printf '%02x' $(( (x * (100 - f) + y * f) / 100 )))
    done
    printf '%s' "$out"
}

write_gtk() {
    # Two layers, and both are needed.
    #
    #   1. ~/.themes/KDOS — the full stylesheet, regenerated for this accent by
    #      the kdos-gtk-theme generator. Straight @define-color in the user
    #      config is NOT enough on its own for GTK3: stock Adwaita is compiled
    #      from SASS with literal hex in every rule, so the names reach only the
    #      widgets that reference them (GIMP's spin-scales did; its panels did
    #      not). The theme KDOS ships is adw-gtk3, which is written against the
    #      named colours end to end, so retinting it retints everything.
    #   2. ~/.config/gtk-{3,4}.0/gtk.css — the same palette as @define-color, at
    #      the highest style priority. libadwaita apps ignore GTK themes
    #      entirely and read only this, and it also overrides the theme for any
    #      GTK3 app started before the theme was regenerated.
    #
    # Alien apps in the appbox share $HOME, which is why both live there rather
    # than in /usr/share. Qt apps in the box follow via the qgtk3 platform
    # theme (QT_QPA_PLATFORMTHEME=gtk3).
    local p="$1" dim="$2" sec="$3" urg="$4" deep="$5" text="$6" var="$7" pdark="$8" backdrop="$9"
    local lift pop insens d3 d4 header onacc
    lift=$(mix_hex "$deep" "$text" 9)
    pop=$(mix_hex "$deep" "$text" 11)
    header=$(mix_hex "$deep" "$text" 7)
    onacc=$(mix_hex "ffffff" "$text" 35)
    insens=$(mix_hex "$text" "$var" 55)
    d3="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0"
    d4="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0"
    mkdir -p "$d3" "$d4"

    if [ -r "$GTK_THEME_GEN" ] && command -v python3 >/dev/null 2>&1; then
        mkdir -p "$HOME/.themes"
        python3 "$GTK_THEME_GEN" "$HOME/.themes/KDOS" \
            "$p" "$dim" "$sec" "$urg" "$deep" "$text" "$var" "$pdark" "$backdrop"
    fi

    # One palette, written twice: GTK3 spells the surfaces theme_*, GTK4 and
    # libadwaita spell them window_*/view_*. Both files carry both spellings so
    # neither toolkit has to fall back to the stylesheet's own value.
    local common
    common=$(cat <<EOF
@define-color accent_color #$p;
@define-color accent_bg_color #$pdark;
@define-color accent_fg_color #$onacc;
@define-color success_color #$p;
@define-color success_bg_color #$pdark;
@define-color success_fg_color #$onacc;
@define-color warning_color #$sec;
@define-color warning_bg_color #$sec;
@define-color warning_fg_color #$deep;
@define-color destructive_color #$urg;
@define-color destructive_bg_color #$urg;
@define-color destructive_fg_color #$deep;
@define-color error_color #$urg;
@define-color error_bg_color #$urg;
@define-color error_fg_color #$deep;

@define-color window_bg_color #$var;
@define-color window_fg_color #$text;
@define-color view_bg_color #$deep;
@define-color view_fg_color #$text;
@define-color headerbar_bg_color #$header;
@define-color headerbar_fg_color #$text;
@define-color headerbar_border_color #$dim;
@define-color headerbar_backdrop_color #$var;
@define-color headerbar_shade_color rgba(0, 0, 0, 0.36);
@define-color headerbar_darker_shade_color rgba(0, 0, 0, 0.72);
@define-color sidebar_bg_color #$header;
@define-color sidebar_fg_color #$text;
@define-color sidebar_backdrop_color #$var;
@define-color sidebar_shade_color rgba(0, 0, 0, 0.25);
@define-color secondary_sidebar_bg_color #$header;
@define-color secondary_sidebar_fg_color #$text;
@define-color secondary_sidebar_backdrop_color #$var;
@define-color secondary_sidebar_shade_color rgba(0, 0, 0, 0.25);
@define-color card_bg_color #$lift;
@define-color card_fg_color #$text;
@define-color card_shade_color rgba(0, 0, 0, 0.36);
@define-color dialog_bg_color #$pop;
@define-color dialog_fg_color #$text;
@define-color popover_bg_color #$pop;
@define-color popover_fg_color #$text;
@define-color popover_shade_color rgba(0, 0, 0, 0.36);
@define-color thumbnail_bg_color #$lift;
@define-color thumbnail_fg_color #$text;
@define-color panel_bg_color #$deep;
@define-color panel_fg_color #$text;
@define-color shade_color rgba(0, 0, 0, 0.36);
@define-color scrollbar_outline_color rgba(0, 0, 0, 0.5);

@define-color theme_bg_color #$var;
@define-color theme_fg_color #$text;
@define-color theme_base_color #$deep;
@define-color theme_text_color #$text;
@define-color theme_selected_bg_color #$pdark;
@define-color theme_selected_fg_color #$onacc;
@define-color theme_unfocused_bg_color #$var;
@define-color theme_unfocused_fg_color #$text;
@define-color theme_unfocused_base_color #$deep;
@define-color theme_unfocused_text_color #$text;
@define-color theme_unfocused_selected_bg_color #$pdark;
@define-color theme_unfocused_selected_fg_color #$onacc;
@define-color insensitive_bg_color #$var;
@define-color insensitive_fg_color #$insens;
@define-color insensitive_base_color #$deep;
@define-color borders #$dim;
@define-color unfocused_borders #$dim;
@define-color content_view_bg #$deep;
@define-color text_view_bg #$deep;
EOF
)

    printf '/* KDOS GTK3 palette — GENERATED by `kdos theme`; edits will be overwritten. */\n%s\n' \
        "$common" > "$d3/gtk.css"
    printf '/* KDOS GTK4/libadwaita palette — GENERATED by `kdos theme`; edits overwritten. */\n%s\n' \
        "$common" > "$d4/gtk.css"
}

write_icons() {
    # The icon theme is recoloured per accent for the same reason the GTK theme
    # is: Papirus is flat single-fill artwork, so the accent lives in the SVGs
    # themselves and no amount of CSS reaches it. ~/.icons wins over
    # /usr/share/icons for the session AND is the only icon path the appbox can
    # see, so regenerating it here retints the host and the box in one go.
    [ -r "$ICON_GEN" ] && command -v python3 >/dev/null 2>&1 || return 0
    mkdir -p "$HOME/.icons"
    python3 "$ICON_GEN" "$HOME/.icons/KDOS" "$@" >/dev/null
    # KDOS's own marks are not in the vendored artwork; carry them over from
    # the installed theme rather than making the generator know about them.
    local sysdir=/usr/share/icons/KDOS f rel
    if [ -d "$sysdir" ]; then
        for rel in 256x256/apps scalable/apps; do
            [ -d "$sysdir/$rel" ] || continue
            mkdir -p "$HOME/.icons/KDOS/$rel"
            for f in "$sysdir/$rel"/*; do
                [ -e "$f" ] && cp -f "$f" "$HOME/.icons/KDOS/$rel/"
            done
        done
    fi
}

write_foot() {
    local p="$1" dim="$2" sec="$3" urg="$4" deep="$5" text="$6"
    mkdir -p "$(dirname "$FOOT_THEME")"
    cat > "$FOOT_THEME" <<EOF
# KDOS foot theme — GENERATED by \`kdos theme\`; edits will be overwritten.
[colors]
background=$deep
foreground=$text
selection-background=$dim
selection-foreground=$p
regular0=$deep
regular1=$urg
regular2=$p
regular3=$sec
regular4=$dim
regular5=$sec
regular6=$p
regular7=$text
bright0=$dim
bright1=$urg
bright2=$p
bright3=$sec
bright4=$dim
bright5=$sec
bright6=$p
bright7=$text

[colors-dark]
background=$deep
foreground=$text
cursor=$deep $p
EOF
}

write_btop() {
    local p="$1" dim="$2" sec="$3" urg="$4" deep="$5" text="$6"
    mkdir -p "$(dirname "$BTOP_THEME")"
    cat > "$BTOP_THEME" <<EOF
# KDOS btop theme — GENERATED by \`kdos theme\`; edits will be overwritten.
theme[main_bg]="#$deep"
theme[main_fg]="#$text"
theme[title]="#$p"
theme[hi_fg]="#$p"
theme[selected_bg]="#$dim"
theme[selected_fg]="#$p"
theme[inactive_fg]="#$dim"
theme[graph_text]="#$text"
theme[proc_misc]="#$sec"
theme[cpu_box]="#$dim"
theme[mem_box]="#$dim"
theme[net_box]="#$dim"
theme[proc_box]="#$dim"
theme[div_line]="#$dim"
theme[temp_start]="#$p"
theme[temp_mid]="#$sec"
theme[temp_end]="#$urg"
theme[cpu_start]="#$p"
theme[cpu_mid]="#$sec"
theme[cpu_end]="#$urg"
theme[free_start]="#$dim"
theme[free_mid]="#$sec"
theme[free_end]="#$p"
theme[cached_start]="#$dim"
theme[cached_mid]="#$sec"
theme[cached_end]="#$p"
theme[available_start]="#$dim"
theme[available_mid]="#$sec"
theme[available_end]="#$p"
theme[used_start]="#$dim"
theme[used_mid]="#$sec"
theme[used_end]="#$urg"
theme[download_start]="#$dim"
theme[download_mid]="#$sec"
theme[download_end]="#$p"
theme[upload_start]="#$dim"
theme[upload_mid]="#$sec"
theme[upload_end]="#$urg"
EOF
}

write_starship() {
    local p="$1" dim="$2" sec="$3" urg="$4" deep="$5" text="$6" var="$7"
    [ -w "$STARSHIP_TOML" ] || return 0
    local tmp="$STARSHIP_TOML.kdos.$$"
    awk -v p="$p" -v dim="$dim" -v sec="$sec" -v urg="$urg" -v deep="$deep" -v text="$text" -v var="$var" '
        /^# >>> NOCTALIA STARSHIP PALETTE >>>/ || /^# >>> KDOS STARSHIP PALETTE >>>/ {
            inpal = 1
            print "# >>> KDOS STARSHIP PALETTE >>>"
            print "# Regenerated by `kdos theme`. Everything between the markers is replaced"
            print "# wholesale — do not edit by hand."
            print "[palettes.kdos]"
            print "blue      = \"#" p "\""
            print "red       = \"#" urg "\""
            print "green     = \"#" sec "\""
            print "yellow    = \"#" sec "\""
            print "cyan      = \"#" sec "\""
            print "magenta   = \"#" sec "\""
            print "white     = \"#" text "\""
            print "black     = \"#" deep "\""
            print "text      = \"#" text "\""
            print "subtext1  = \"#" dim "\""
            print "subtext0  = \"#" dim "\""
            print "overlay2  = \"#" dim "\""
            print "overlay1  = \"#" dim "\""
            print "overlay0  = \"#" var "\""
            print "surface2  = \"#" var "\""
            print "surface1  = \"#" deep "\""
            print "surface0  = \"#" deep "\""
            print "base      = \"#" deep "\""
            print "mantle    = \"#" deep "\""
            print "crust     = \"#" deep "\""
            print "rosewater = \"#" sec "\""
            print "flamingo  = \"#" sec "\""
            print "pink      = \"#" sec "\""
            print "mauve     = \"#" p "\""
            print "maroon    = \"#" urg "\""
            print "peach     = \"#" sec "\""
            print "teal      = \"#" sec "\""
            print "sky       = \"#" sec "\""
            print "sapphire  = \"#" sec "\""
            print "lavender  = \"#" p "\""
            print "# <<< KDOS STARSHIP PALETTE <<<"
            next
        }
        /^# <<< NOCTALIA STARSHIP PALETTE <<</ || /^# <<< KDOS STARSHIP PALETTE <<</ { inpal = 0; next }
        inpal { next }
        { print }
    ' "$STARSHIP_TOML" > "$tmp" && mv "$tmp" "$STARSHIP_TOML"
}

cmd_theme() {
    local want="${1:-}" cur list n
    cur="$(current_theme)"

    case "$want" in
        ""|show|current)
            echo "$cur"
            return 0
            ;;
        list)
            for t in $THEMES; do
                if [ "$t" = "$cur" ]; then
                    printf '%s* %-10s%s %s\n' "$C_A" "$t" "$C_0" "$(palette "$t" | awk '{print $10}')"
                else
                    printf '  %-10s %s\n' "$t" "$(palette "$t" | awk '{print $10}')"
                fi
            done
            return 0
            ;;
        next|prev)
            list="$THEMES"
            [ "$want" = prev ] && list="$(echo $THEMES | tr ' ' '\n' | tac | tr '\n' ' ')"
            n=0
            for t in $list; do
                n=$((n + 1))
                [ "$t" = "$cur" ] && break
            done
            want="$(echo $list | cut -d' ' -f$(( n % $(echo $list | wc -w) + 1 )))"
            ;;
    esac

    palette "$want" >/dev/null 2>&1 || die "unknown theme '$want' (try: kdos theme list)"

    local p dim sec urg deep text var pdark backdrop scheme
    read -r p dim sec urg deep text var pdark backdrop scheme <<EOF
$(palette "$want")
EOF

    write_cosmic_theme "$p" "$deep" "$var" "$text" "$sec" "$urg"
    write_panel_colors "$deep"
    write_gtk "$p" "$dim" "$sec" "$urg" "$deep" "$text" "$var" "$pdark" "$backdrop"
    write_icons "$p" "$dim" "$sec" "$urg" "$deep" "$text" "$var" "$pdark" "$backdrop"
    write_foot "$p" "$dim" "$sec" "$urg" "$deep" "$text"
    write_btop "$p" "$dim" "$sec" "$urg" "$deep" "$text"
    write_starship "$p" "$dim" "$sec" "$urg" "$deep" "$text" "$var"

    # A regenerated file does not repaint a running process: COSMIC re-themes
    # itself (settings daemon watches the Builder), starship on next prompt,
    # btop and foot on next start (foot cannot reload its config at all).
    # GTK apps — every alien app — pick up the new theme and icons when they
    # are next launched; GTK re-reads neither on a file change.
    command -v tmux >/dev/null 2>&1 && tmux source-file ~/.config/tmux/tmux.conf 2>/dev/null

    mkdir -p "$STATE_DIR"
    echo "$want" > "$THEME_STATE"
    printf '%s%s%s (%s)\n' "$C_A" "$want" "$C_0" "$scheme"
}

# ─────────────────────────────────────────────────────────────────────
# kdos help
# ─────────────────────────────────────────────────────────────────────
cmd_help() {
    local pager=cat
    [ "${1:-}" = "--pager" ] && { command -v less >/dev/null 2>&1 && pager="less -R"; }

    {
        printf '%s' "$C_A"
        command cat <<'BANNER'
██╗  ██╗██████╗  ██████╗ ███████╗
██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
█████╔╝ ██║  ██║██║   ██║███████╗
██╔═██╗ ██║  ██║██║   ██║╚════██║
██║  ██╗██████╔╝╚██████╔╝███████║
╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
BANNER
        printf '%s   KD'"'"'s Homebrew Linux Distro%s\n\n' "$C_D" "$C_0"

        printf '%sCOMMANDS%s\n' "$C_A" "$C_0"
        printf '  %-26s %s\n' "desktop"             "start the COSMIC desktop from a tty (kdos-desktop)"
        printf '  %-26s %s\n' "kdos app <name>"     "install an alien app (distrobox + export)"
        printf '  %-26s %s\n' "kdos theme [name]"   "phosphor | amber | ice | bone | next | prev | list"
        printf '  %-26s %s\n' "kdos status"         "packages, containers, exported apps"
        printf '  %-26s %s\n' "kdos doctor"         "check the session for common breakage"
        printf '  %-26s %s\n' "kdos-shot [region]"  "screenshot to clipboard and ~/Pictures"
        printf '  %-26s %s\n' "kdos-fetch-static"   "fetch a single verified static binary"
        printf '\n'

        printf '%sKEYS%s  %s(COSMIC defaults — remap in Settings > Keyboard)%s\n' "$C_A" "$C_0" "$C_D" "$C_0"
        printf '  %s%-22s%s %s\n' "$C_B" "Super"              "$C_0" "open the launcher"
        printf '  %s%-22s%s %s\n' "$C_B" "Super+T"            "$C_0" "terminal (foot)"
        printf '  %s%-22s%s %s\n' "$C_B" "Super+A"            "$C_0" "application library"
        printf '  %s%-22s%s %s\n' "$C_B" "Super+F"            "$C_0" "files"
        printf '  %s%-22s%s %s\n' "$C_B" "Super+Q"            "$C_0" "close window"
        printf '  %s%-22s%s %s\n' "$C_B" "Super+M"            "$C_0" "maximize"
        printf '  %s%-22s%s %s\n' "$C_B" "Super+Arrows"       "$C_0" "focus windows"
        printf '  %s%-22s%s %s\n' "$C_B" "Super+Shift+Arrows" "$C_0" "move window"
        printf '  %s%-22s%s %s\n' "$C_B" "Super+Y"            "$C_0" "toggle tiling mode"
        printf '  %s%-22s%s %s\n' "$C_B" "Super+1..9"         "$C_0" "switch workspace"
        printf '  %s%-22s%s %s\n' "$C_B" "Super+Esc"          "$C_0" "lock / session menu"
        printf '  %s%-22s%s %s\n' "$C_B" "PrtSc"              "$C_0" "screenshot"
    } | $pager
}

# ─────────────────────────────────────────────────────────────────────
# kdos status
# ─────────────────────────────────────────────────────────────────────
# grep -c always prints a count and exits 1 when that count is zero, so these
# must NOT be chained with `|| echo 0` — that prints the number twice.
count_containers() {
    command -v podman >/dev/null 2>&1 || { echo 0; return; }
    podman ps --format '{{.Names}}' 2>/dev/null | grep -c .
}

count_exported() {
    ls -1 "${XDG_DATA_HOME:-$HOME/.local/share}"/applications/*.desktop 2>/dev/null | grep -c .
}

cmd_status() {
    if [ "${1:-}" = "--bar" ]; then
        printf '%s box · %s app\n' "$(count_containers)" "$(count_exported)"
        return 0
    fi

    printf '%sKDOS%s  %s\n\n' "$C_A" "$C_0" "$(uname -sr)"

    printf '%s%-16s%s %s\n' "$C_B" "Theme"      "$C_0" "$(current_theme)"
    printf '%s%-16s%s %s\n' "$C_B" "Packages"   "$C_0" "$(ls -1 /var/lib/kpkg/db 2>/dev/null | grep -c .)"
    printf '%s%-16s%s %s\n' "$C_B" "Exported apps" "$C_0" "$(count_exported)"
    printf '%s%-16s%s %s\n' "$C_B" "Session"    "$C_0" "$([ -n "${WAYLAND_DISPLAY:-}" ] && echo cosmic || echo tty)"
    printf '\n'

    printf '%sCONTAINERS%s\n' "$C_A" "$C_0"
    if command -v podman >/dev/null 2>&1; then
        if podman ps -a --format '  {{.Names}}\t{{.Status}}\t{{.Image}}' 2>/dev/null | grep -q .; then
            podman ps -a --format '  {{.Names}}\t{{.Status}}\t{{.Image}}' 2>/dev/null
        else
            printf '  none — try: kdos app gimp\n'
        fi
    else
        printf '  podman not installed\n'
    fi
    printf '\n'

    printf '%sEXPORTED APPS%s\n' "$C_A" "$C_0"
    local found=0
    for d in "${XDG_DATA_HOME:-$HOME/.local/share}"/applications/*.desktop; do
        [ -e "$d" ] || continue
        found=1
        printf '  %s\n' "$(basename "$d" .desktop)"
    done
    [ "$found" = 0 ] && printf '  none\n'
}

# ─────────────────────────────────────────────────────────────────────
# kdos doctor — the checks that actually catch things on this system
# ─────────────────────────────────────────────────────────────────────
ok()   { printf '  %s[ ok ]%s %s\n' "$C_A" "$C_0" "$*"; }
warn() { printf '  %s[warn]%s %s\n' "$C_W" "$C_0" "$*"; }

cmd_doctor() {
    printf '%sKDOS doctor%s\n\n' "$C_A" "$C_0"

    printf '%sSession%s\n' "$C_B" "$C_0"
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then ok "WAYLAND_DISPLAY=$WAYLAND_DISPLAY"; else warn "no WAYLAND_DISPLAY — not inside the desktop session"; fi
    if [ -d "${XDG_RUNTIME_DIR:-/nonexistent}" ]; then ok "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"; else warn "XDG_RUNTIME_DIR missing — pipewire and podman will misbehave"; fi
    if pgrep -x cosmic-comp >/dev/null 2>&1; then ok "cosmic-comp running"; else warn "cosmic-comp not running — no desktop (start with: kdos-desktop)"; fi
    if pgrep -x cosmic-panel >/dev/null 2>&1; then ok "cosmic-panel running"; else warn "cosmic-panel not running — no bar"; fi
    if pgrep -f xdg-desktop-portal-cosmic >/dev/null 2>&1; then ok "cosmic portal running"; else warn "cosmic portal not running — screenshots and file pickers degraded"; fi
    printf '\n'

    printf '%sContainers%s\n' "$C_B" "$C_0"
    # The failure this distro actually had: toybox switch_root never MS_MOVEs
    # the root, so anything that JOINS a mount namespace lands on an empty tree.
    if [ "$(readlink /proc/self/root 2>/dev/null)" = "/" ] || [ -z "$(readlink /proc/self/root 2>/dev/null)" ]; then
        ok "mount namespace root is /"
    else
        warn "mount namespace root is $(readlink /proc/self/root) — podman exec and distrobox enter will fail"
    fi
    if [ "$(id -u)" -ne 0 ]; then
        if grep -q "^$(id -un):" /etc/subuid 2>/dev/null; then ok "subuid mapping present"; else warn "no /etc/subuid entry — rootless podman cannot map users"; fi
        if grep -q "^$(id -un):" /etc/subgid 2>/dev/null; then ok "subgid mapping present"; else warn "no /etc/subgid entry"; fi
    else
        warn "running as root — alien apps are meant to run as the kdos user"
    fi
    for b in newuidmap newgidmap; do
        if [ -u "$(command -v $b 2>/dev/null)" ] 2>/dev/null; then ok "$b is setuid"; else warn "$b missing or not setuid"; fi
    done
    printf '\n'

    printf '%sDesktop%s\n' "$C_B" "$C_0"
    if [ -d "$COSMIC_CFG/com.system76.CosmicTheme.Dark/v2" ]; then ok "cosmic theme applied ($(current_theme))"; else warn "no applied cosmic theme — run: kdos theme phosphor"; fi
    if [ -r "$FOOT_THEME" ]; then ok "foot theme present"; else warn "foot theme missing — run: kdos theme phosphor"; fi
    if [ -n "${DISPLAY:-}" ]; then ok "Xwayland on $DISPLAY"; else warn "no DISPLAY — X11-only alien apps will not start"; fi
    case ":$PATH:" in *":$HOME/.local/bin:"*) ok "~/.local/bin on PATH" ;; *) warn "~/.local/bin not on PATH — exported app wrappers will not resolve" ;; esac
}

# ─────────────────────────────────────────────────────────────────────
cmd_version() {
    printf '%sKDOS%s — KD'"'"'s Homebrew Linux Distro\n' "$C_A" "$C_0"
    printf '  kernel   %s\n' "$(uname -r)"
    printf '  libc     musl\n'
    printf '  userland toybox\n'
    printf '  session  COSMIC (%s)\n' "$(current_theme)"
}

case "${1:-help}" in
    help|-h|--help) shift; cmd_help "$@" ;;
    theme)          shift; cmd_theme "$@" ;;
    status)         shift; cmd_status "$@" ;;
    doctor)         shift; cmd_doctor ;;
    version|-V)     cmd_version ;;
    app)            shift; exec kdos-fetch-app "$@" ;;
    *)              die "unknown command '$1' (try: kdos help)" ;;
esac
