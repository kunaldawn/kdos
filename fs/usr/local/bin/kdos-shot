#!/bin/bash
# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------
#
# kdos-shot [region|screen|window] — screenshot to the clipboard AND to disk.
#
# niri's own Print binding opens an interactive picker that saves a file. This
# is the other half: one keystroke, region selected with the mouse, image on the
# clipboard ready to paste, a copy filed under ~/Pictures/Screenshots, and a
# toast through noctalia so you know it worked.

set -u

MODE="${1:-region}"
DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
FILE="$DIR/kdos-$(date +%Y%m%d-%H%M%S).png"

toast() {
    command -v noctalia >/dev/null 2>&1 || return 0
    noctalia ipc call toast send "{\"title\":\"$1\",\"body\":\"$2\",\"type\":\"${3:-notice}\"}" >/dev/null 2>&1 || true
}

command -v grim >/dev/null 2>&1 || { echo "kdos-shot: grim is not installed" >&2; exit 1; }
mkdir -p "$DIR"

case "$MODE" in
    region)
        command -v slurp >/dev/null 2>&1 || { echo "kdos-shot: slurp is not installed" >&2; exit 1; }
        # slurp writes nothing and exits non-zero when the selection is
        # cancelled with Escape — that is a user decision, not a failure.
        geom="$(slurp -b 000a03cc -c 39ff14ff -s 39ff1420 -w 2 2>/dev/null)" || exit 0
        [ -n "$geom" ] || exit 0
        grim -g "$geom" "$FILE" || { toast "Screenshot failed" "grim could not capture the region" error; exit 1; }
        ;;
    screen|full)
        grim "$FILE" || { toast "Screenshot failed" "grim could not capture the output" error; exit 1; }
        ;;
    window)
        # niri's IPC reports a focused window's SIZE but not its position on the
        # output, which is what grim -g needs. Rather than guess, hand it to the
        # region picker — niri's own Alt+Print does true per-window capture.
        exec "$0" region
        ;;
    *)
        echo "usage: kdos-shot [region|screen|window]" >&2
        exit 1
        ;;
esac

if command -v wl-copy >/dev/null 2>&1; then
    wl-copy --type image/png < "$FILE"
    toast "Screenshot copied" "$(basename "$FILE")"
else
    toast "Screenshot saved" "$(basename "$FILE")"
fi

echo "$FILE"
