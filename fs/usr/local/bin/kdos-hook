#!/bin/bash
# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------
#
# kdos-hook <event> — the glue noctalia calls on session events.
# Wired up in ~/.config/noctalia/settings.json under "hooks".
#
# The interesting one is `colors`: noctalia regenerates foot's, starship's,
# btop's, GTK's and Qt's theme files whenever the colour scheme changes, but
# regenerating a file does not repaint a running program. This is where the
# already-open windows are told to re-read.

set -u

LOG="${XDG_CACHE_HOME:-$HOME/.cache}/kdos/hook.log"
mkdir -p "$(dirname "$LOG")"

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }

case "${1:-}" in
    startup)
        log "session start (theme=$(kdos theme 2>/dev/null || echo '?'))"
        # The accent file is regenerated rather than trusted: a home restored
        # from /etc/skel is always phosphor, even if the saved theme is not.
        kdos theme "$(kdos theme 2>/dev/null || echo phosphor)" >/dev/null 2>&1 || true
        ;;

    colors)
        log "colour scheme regenerated — reloading live clients"

        # tmux has no signal for this, but it does have a control socket.
        if command -v tmux >/dev/null 2>&1 && tmux has-session 2>/dev/null; then
            tmux source-file "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf" 2>/dev/null || true
        fi

        # niri watches accent.kdl and repaints itself; noctalia repaints itself.
        #
        # foot cannot be repainted. It has NO config-reload signal: in 1.26
        # SIGUSR1/SIGUSR2 select the [colors-dark]/[colors-light] section that was
        # read at startup, they do not re-read the file. So a terminal that is
        # already open keeps the old palette until it is closed. Say so, rather
        # than leaving the user to wonder why one window did not change.
        if command -v pgrep >/dev/null 2>&1 && pgrep foot >/dev/null 2>&1 \
           && command -v noctalia >/dev/null 2>&1; then
            noctalia ipc call toast send \
                '{"title":"Accent changed","body":"Open terminals keep the old palette — foot cannot reload its config.","type":"notice"}' \
                >/dev/null 2>&1 || true
        fi
        ;;

    wallpaper)
        log "wallpaper changed: ${2:-}"
        ;;

    lock)
        log "screen locked"
        ;;

    unlock)
        log "screen unlocked"
        ;;

    *)
        echo "usage: kdos-hook {startup|colors|wallpaper|lock|unlock}" >&2
        exit 1
        ;;
esac
