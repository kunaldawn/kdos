#!/bin/sh
# kdos-desktop — launch the KDOS desktop. Run from a tty after login.
# Wayland env vars are set by /etc/profile.d/10-wayland.sh.
# KDOS uses seatd, not logind/elogind; kdos-comp talks to it via libseat.
. /usr/local/lib/kdos/session-common.sh

if [ ! -x /usr/bin/kdos-comp ]; then
	echo "kdos-desktop: no desktop installed (kdos-comp missing)." >&2
	echo "The compositor lands in build phase 05_desktop." >&2
	exit 1
fi

case "$(cat /sys/class/drm/card0/device/modalias 2>/dev/null)" in
	virtio:*|pci:v00001AF4*)
		# QEMU's cursor plane lies about what it supports; without this the
		# pointer is invisible or leaves trails on every virtio-gpu setup.
		export WLR_NO_HARDWARE_CURSORS=1
		# Without virgl there is no GL at all and wlroots must take its
		# software renderer — that is what makes plain `make run` (no
		# virgl) work. Read the feature bits from sysfs, NOT dmesg:
		# dmesg is root-only under dmesg_restrict, so the old grep
		# forced pixman for every normal user. The features file is one
		# character per feature bit; VIRGL is bit 0. (The old check
		# also demanded RESOURCE_BLOB — a smithay-era lesson; wlroots'
		# GLES2 renderer runs fine on virgl without blob, measured on
		# the labwc fork with the CRT pass on.)
		_gpu_virgl=0
		for _vdev in /sys/bus/virtio/devices/virtio*; do
			case "$(readlink "$_vdev/driver" 2>/dev/null)" in
			*/virtio_gpu) ;;
			*) continue ;;
			esac
			case "$(cut -c1 "$_vdev/features" 2>/dev/null)" in
			1) _gpu_virgl=1 ;;
			esac
		done
		if [ "$_gpu_virgl" != 1 ]; then
			export WLR_RENDERER=pixman
		fi
		unset _gpu_virgl _vdev
		;;
esac

kdos_session_runtime
kdos_session_keymap
kdos_session_boxes
kdos_session_bus

# kdos-desktop-start runs on the session bus: pipewire stack (audio +
# portal ScreenCast for OBS), then runs kdos-comp with its stderr kept in
# $XDG_RUNTIME_DIR/kdos-comp.log and a restart offer if it crashes.
exec /usr/local/bin/kdos-desktop-start
