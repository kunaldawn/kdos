#!/bin/sh
# kdos-openarchive — extract an archive beside itself, with `ouch`.
#
# THE DEFAULT HANDLER FOR WHAT NO DESKTOP APPLICATION HERE OPENS: the comic
# books packed as 7z or rar, for which Okular's comic book generator needs an
# unrar this image does not have (/etc/xdg/mimeapps.list). Its
# desktop entry, kdos-openarchive.desktop, runs it in a terminal, so a
# failure stays readable, and also offers it from Open With for plain 7z and
# rar, which Ark opens by default.
#
# THE CWD IS SET HERE AND NOT INHERITED. `ouch decompress` puts its output
# under the directory the PROCESS was started in, not under the archive's — so
# a desktop or a file manager that spawns this from an arbitrary place would
# scatter extractions wherever it happened to be standing.
#
# `--no` BECAUSE NOBODY IS THERE TO ANSWER. Left alone, ouch prompts four ways
# when the destination exists, and a caller with no stdin — a file manager's
# action, a script — would sit there forever looking like a hung extract.
# `--no` cancels instead, and the message says which directory is in the way.
set -eu

if [ $# -lt 1 ]; then
	echo "usage: kdos-openarchive ARCHIVE" >&2
	exit 2
fi

archive=$1
if [ ! -f "$archive" ]; then
	echo "kdos-openarchive: $archive: no such file" >&2
	exit 1
fi
if ! command -v ouch >/dev/null 2>&1; then
	echo "kdos-openarchive: ouch is not installed" >&2
	exit 1
fi

dir=$(dirname -- "$archive")
base=$(basename -- "$archive")

cd -- "$dir" || exit 1
if ! ouch decompress --no -- "$base"; then
	echo "kdos-openarchive: could not extract $base — a directory of that" \
	     "name may already be there" >&2
	exit 1
fi
