#!/bin/bash
# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   kdos-fetch-app
#
# Install an alien Linux app inside the default kdos-debian distrobox
# and export it to the host as a .desktop launcher.
#
# Usage:
#   kdos-fetch-app firefox
#   kdos-fetch-app --box arch chromium
#   kdos-fetch-app --remove firefox

set -e

BOX_DEFAULT="kdos-debian"
IMAGE_DEFAULT="debian:stable"

err() { echo "kdos-fetch-app: $*" >&2; exit 1; }

usage() {
	cat <<EOF
Usage: kdos-fetch-app [--box <name>] [--image <image>] <app>
       kdos-fetch-app --remove [--box <name>] <app>

Defaults:
  --box    $BOX_DEFAULT
  --image  $IMAGE_DEFAULT  (only used if the box doesn't exist yet)

Examples:
  kdos-fetch-app firefox
  kdos-fetch-app --box arch --image archlinux:latest yay
  kdos-fetch-app --remove firefox
EOF
	exit 1
}

BOX="$BOX_DEFAULT"
IMAGE="$IMAGE_DEFAULT"
REMOVE=0
APP=""

while [ $# -gt 0 ]; do
	case "$1" in
		--box) BOX="$2"; shift 2 ;;
		--image) IMAGE="$2"; shift 2 ;;
		--remove) REMOVE=1; shift ;;
		-h|--help) usage ;;
		-*) err "unknown flag: $1" ;;
		*) APP="$1"; shift ;;
	esac
done

[ -z "$APP" ] && usage
command -v distrobox >/dev/null || err "distrobox not installed"
command -v podman >/dev/null || err "podman not installed"

# Create the box on demand
if ! distrobox list 2>/dev/null | awk '{print $3}' | grep -qx "$BOX"; then
	if [ "$REMOVE" -eq 1 ]; then
		err "box '$BOX' does not exist"
	fi
	echo "==> Creating distrobox '$BOX' (image: $IMAGE)"
	distrobox create --name "$BOX" --image "$IMAGE" --yes
fi

# Path of the app's binary inside the box, empty if it is GUI-only.
app_binary() {
	distrobox enter "$BOX" -- sh -lc "command -v '$APP' 2>/dev/null" 2>/dev/null \
		| tr -d '\r' | tail -1
}

if [ "$REMOVE" -eq 1 ]; then
	echo "==> Removing exported launcher for '$APP'"
	distrobox enter "$BOX" -- distrobox-export --app "$APP" --delete \
		|| echo "    (no .desktop export to remove)"

	BIN="$(app_binary)"
	if [ -n "$BIN" ]; then
		echo "==> Removing CLI wrapper for '$APP'"
		distrobox enter "$BOX" -- distrobox-export --bin "$BIN" --delete \
			|| echo "    (no CLI wrapper to remove)"
	fi

	echo "==> Uninstalling '$APP' inside '$BOX'"
	# Best-effort uninstall — try apt, dnf, pacman in that order
	distrobox enter "$BOX" -- bash -c "
		if command -v apt >/dev/null; then sudo apt remove -y '$APP'
		elif command -v dnf >/dev/null; then sudo dnf remove -y '$APP'
		elif command -v pacman >/dev/null; then sudo pacman -Rns --noconfirm '$APP'
		else echo 'no known package manager' >&2; exit 1; fi"
	exit 0
fi

echo "==> Installing '$APP' inside '$BOX'"
distrobox enter "$BOX" -- bash -c "
	set -e
	if command -v apt >/dev/null; then
		sudo apt update
		sudo apt install -y '$APP'
	elif command -v dnf >/dev/null; then
		sudo dnf install -y '$APP'
	elif command -v pacman >/dev/null; then
		sudo pacman -Sy --noconfirm '$APP'
	else
		echo 'no known package manager in box' >&2
		exit 1
	fi"

# Two exports, and neither is fatal on its own: a GUI app has a .desktop but
# often no useful CLI name, a CLI tool has the reverse, and plenty have both.
EXPORTED=0

echo "==> Exporting '$APP' as a host launcher"
if distrobox enter "$BOX" -- distrobox-export --app "$APP"; then
	EXPORTED=1
else
	echo "    no .desktop file found for '$APP' — skipping the launcher entry"
fi

BIN="$(app_binary)"
if [ -n "$BIN" ]; then
	echo "==> Exporting '$APP' as a command ($BIN)"
	mkdir -p "$HOME/.local/bin"
	if distrobox enter "$BOX" -- distrobox-export --bin "$BIN" \
			--export-path "$HOME/.local/bin"; then
		EXPORTED=1
	else
		echo "    could not export a CLI wrapper for '$APP'"
	fi
fi

[ "$EXPORTED" -eq 1 ] || err "nothing to export for '$APP' — is it really installed?"

echo
echo "Done."
echo "  launcher : ~/.local/share/applications/  (fuzzel: Mod+D, noctalia: Mod+Space)"
if [ -n "$BIN" ]; then
	echo "  command  : just run '$APP' — ~/.local/bin is on PATH"
fi
