# The KDOS defaults for GSettings, which is where a GTK application on the host
# reads its theme when it is not reading the settings portal: GTK 3 on Wayland
# reads org.gnome.desktop.interface from GSettings unless GTK_USE_PORTAL is
# set, and once gsettings-desktop-schemas is installed an unset key there is
# the schema's default — Adwaita, Cantarell — applied over
# ~/.config/gtk-3.0/settings.ini.
#
# These are DEFAULTS, not settings: a value a person sets with `gsettings set`
# lives in their dconf database and wins over this file.
#
# An override takes effect only once glib-compile-schemas has read it into
# gschemas.compiled. kpkg's schemas trigger rebuilds that index whenever an
# installed package touches this directory, and 06_packaging/00_theme.sh
# rebuilds it once more, so a change here reaches an image without a schema
# package being reinstalled.
#
# Every value matches what xdg-desktop-portal-kdos answers for the same key.
# `KDOS` is the link `kdos theme` points at the accent in force; an application
# that reads it here does not restyle on an accent switch, which only the
# portal announces. The two fonts are the faces fontconfig puts first for
# `sans-serif` and `monospace` (noto-fonts' 56-noto-preferred.conf), and the
# same names are in `kdos theme`'s kdeglobals and qt5ct/qt6ct files.

[org.gnome.desktop.interface]
gtk-theme='KDOS'
icon-theme='KDOS'
cursor-theme='KDOS-cursors'
cursor-size=24
color-scheme='prefer-dark'
font-name='Noto Sans 10'
monospace-font-name='Noto Sans Mono 10'
