# ---------------------------------
#   The update tray: it says, and never applies.
#
# An update is never installed unasked. With UseUnattendedUpdates off,
# Discover's tray only reports what the KDOS notifier plugin reads — a system
# update the signed binhost covers, known vulnerabilities, a slot waiting for
# a restart — and the person starts the update from Discover's Updates page.
# The "updates available" notification comes at most once a day; the live
# medium turns it off in /usr/share/kdos/xdg-live.
# ---------------------------------

[Global]
UseUnattendedUpdates=false
RequiredNotificationInterval=86400
