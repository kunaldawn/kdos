# ---------------------------------
#   The live medium's update tray: silent.
#
# A machine booted from the medium is a demonstration or an installer, and
# an "updates available" notification there offers an update nobody can keep.
# A negative RequiredNotificationInterval stops Discover's notifier from ever
# raising it; the tray icon still shows the state. The directory goes first
# in XDG_CONFIG_DIRS, and only on the live medium.
# ---------------------------------

[Global]
RequiredNotificationInterval=-1
