# ---------------------------------
#   No timed lock on the live medium.
#
# The live session is SDDM's autologin of the kdos account, whose password
# is `kdos`: a screen that locks itself by the clock asks a person trying the
# system for a password they never typed, and nothing on the screen says what
# it is. This directory goes FIRST in XDG_CONFIG_DIRS, and only in a
# session whose root is the live medium's overlay, so it outranks /etc/xdg
# there; the person's own choice in ~/.config still outranks it. Meta+L and
# lock-on-resume still lock, and `kdos` unlocks them.
#
# Timeout=0 is what the Screen Locking page reads as "Never"; with only
# Autolock off it would show the 10 minutes inherited from /etc/xdg.
# ---------------------------------

[Daemon]
Autolock=false
Timeout=0
