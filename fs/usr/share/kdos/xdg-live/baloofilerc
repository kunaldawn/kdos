# ---------------------------------
#   No file index on the live medium.
#
# A live session's home is in memory and lasts one boot: an index of it is
# CPU and RAM spent on files that are gone at the next start. Dolphin's search
# still finds what is there, by walking the folder; KRunner finds files only
# from the index, so on the live medium it offers recent documents and typed
# paths and no file by name. The directory goes first in XDG_CONFIG_DIRS, and
# only on the live medium; an installed system indexes file names
# (/usr/share/kdos/xdg/baloofilerc).
# ---------------------------------

[Basic Settings]
Indexing-Enabled=false
