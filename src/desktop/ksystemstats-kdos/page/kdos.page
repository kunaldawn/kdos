# ---------------------------------
#   kdos.page — System Monitor's KDOS page
#
# Overview, Boxes, Energy and Slots, from the `kdos` sensors of
# ksystemstats-kdos. The per-box and per-application rows follow the KDOS
# Meters face's sensorPattern, so a box started after the page opened gets
# its row. Every card is a KDOS Meters face, the text ones without
# sparklines, and every row is as tall as its tallest face asks: a stock
# face or a balanced row would cut rows off at the card's edge, and the page
# scrolls instead. A page the user edits is saved under their own name in
# ~/.local/share/plasma-systemmonitor and shadows this one; `version` is
# raised whenever this file changes, which marks such a copy outdated.
# ---------------------------------

[Face-410000000000001][Appearance]
chartFace=org.kdos.meters
showTitle=true
Title=This Machine

[Face-410000000000001][Sensors]
highPrioritySensorIds=["cpu/all/usage","memory/physical/used","disk/all/read","disk/all/write","network/all/download","network/all/upload"]

[Face-410000000000002][Appearance]
chartFace=org.kdos.meters
showTitle=true
Title=All Boxes

[Face-410000000000002][Sensors]
highPrioritySensorIds=["kdos/box/all/boxes","kdos/box/all/cpu","kdos/box/all/memory","kdos/box/all/ioRead","kdos/box/all/ioWrite"]

[Face-410000000000002][org.kdos.meters][General]
showSparklines=true

[Face-410000000000003][Appearance]
chartFace=org.kdos.meters
showTitle=true
Title=System

[Face-410000000000003][Sensors]
highPrioritySensorIds=["kdos/slot/status","kdos/slot/runningVersion","kdos/slot/otherVersion","kdos/look/phosphor"]

[Face-410000000000003][org.kdos.meters][General]
showSparklines=false

[Face-410000000000004][Appearance]
chartFace=org.kdos.meters
showTitle=true
Title=CPU

[Face-410000000000004][Sensors]
highPrioritySensorIds=[]

[Face-410000000000004][org.kdos.meters][General]
sensorPattern=^kdos/box/(?!all/)[^/]+/cpu$
maximumRows=16

[Face-410000000000005][Appearance]
chartFace=org.kdos.meters
showTitle=true
Title=Memory

[Face-410000000000005][Sensors]
highPrioritySensorIds=[]

[Face-410000000000005][org.kdos.meters][General]
sensorPattern=^kdos/box/(?!all/)[^/]+/memory$
maximumRows=16

[Face-410000000000006][Appearance]
chartFace=org.kdos.meters
showTitle=true
Title=Disk Reads and Writes

[Face-410000000000006][Sensors]
highPrioritySensorIds=[]

[Face-410000000000006][org.kdos.meters][General]
sensorPattern=^kdos/box/(?!all/)[^/]+/io(Read|Write)$
maximumRows=32

[Face-410000000000007][Appearance]
chartFace=org.kdos.meters
showTitle=true
Title=Energy Impact by Application

[Face-410000000000007][Sensors]
highPrioritySensorIds=[]

[Face-410000000000007][org.kdos.meters][General]
sensorPattern=^kdos/energy/(?!all/)[^/]+/impact$
maximumRows=16
historyAmount=600

[Face-410000000000008][Appearance]
chartFace=org.kdos.meters
showTitle=true
Title=Ledger

[Face-410000000000008][Sensors]
highPrioritySensorIds=["kdos/energy/all/status","kdos/energy/all/window","kdos/energy/all/attributable","kdos/energy/all/idleFloor","kdos/energy/all/shortLived","kdos/energy/all/domains"]

[Face-410000000000008][org.kdos.meters][General]
showSparklines=false

[Face-410000000000009][Appearance]
chartFace=org.kdos.meters
showTitle=true
Title=Running Slot

[Face-410000000000009][Sensors]
highPrioritySensorIds=["kdos/slot/running","kdos/slot/runningVersion","kdos/slot/runningState","kdos/slot/attempts","kdos/slot/next"]

[Face-410000000000009][org.kdos.meters][General]
showSparklines=false

[Face-410000000000010][Appearance]
chartFace=org.kdos.meters
showTitle=true
Title=Other Slot

[Face-410000000000010][Sensors]
highPrioritySensorIds=["kdos/slot/other","kdos/slot/otherVersion","kdos/slot/otherState"]

[Face-410000000000010][org.kdos.meters][General]
showSparklines=false

