# ---------------------------------
#   kdos-overview.page — System Monitor's Overview, the page it opens on
#
# The stock overview.page with every sensor one that exists on any machine.
# A face names a sensor or a pattern that must match at least one; a missing
# one puts a "missing some sensors" banner over the page. The stock page's
# per-disk, per-interface and GPU sensors are absent on the live medium (its
# root is a RAM overlay with no block device), in a virtual machine and on a
# graphics card ksystemstats cannot read, so here Disks and Network read the
# `all` totals, and the GPU row is a KDOS Meters face following
# `gpu/gpu<n>/usage`, which shows each card that reports and none where
# none does. systemmonitorrc hides the stock page. `version` is raised
# whenever this file changes, which marks a user's edited copy outdated.
# ---------------------------------

[Face-420000000000001][Appearance]
chartFace=org.kde.ksysguard.piechart
showTitle=true
Title=CPU

[Face-420000000000001][Sensors]
highPrioritySensorIds=["cpu/all/usage"]
totalSensors=["cpu/all/usage"]

[Face-420000000000001][org.kde.ksysguard.piechart][General]
showLegend=false

[Face-420000000000002][Appearance]
