<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  The root steps behind Discover's Install and Remove buttons for host
  software. kdos-ports-helper installs a port prebuilt from the signed
  binhost into the running slot, or removes one somebody installed that
  nothing installed needs; kdos-ports-builder builds one there from its
  recipe. An install adds the port to the world set and a removal takes it
  off. pkexec matches an action by the program's path and, where the action
  names one, its first argument, taking the first that matches, so each
  action of the helper names its verb and each grant reaches nothing beyond
  `<verb> <port>`. The build is asked for every time: it runs a recipe's
  build.sh as root for a long while, and a grant kept from a prebuilt install
  must not cover it.
-->
<policyconfig>
  <vendor>KDOS</vendor>
  <vendor_url>https://kdos.dev/</vendor_url>

  <action id="io.kdos.ports.install">
    <description>Install host software from the signed binary host</description>
    <message>Authentication is required to install software into this version of the system.</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kdos-discover/kdos-ports-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">install</annotate>
  </action>

  <action id="io.kdos.ports.remove">
    <description>Remove host software installed on request</description>
    <message>Authentication is required to remove software from this version of the system.</message>
    <icon_name>edit-delete</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kdos-discover/kdos-ports-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">remove</annotate>
  </action>

  <action id="io.kdos.ports.build">
    <description>Build host software on this computer</description>
    <message>Authentication is required to build software from source and install it into this version of the system.</message>
    <icon_name>run-build</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kdos-discover/kdos-ports-builder</annotate>
  </action>
</policyconfig>
