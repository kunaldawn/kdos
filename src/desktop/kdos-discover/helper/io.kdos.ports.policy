<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  The one root step behind Discover's Install button for host software:
  kdos-ports-helper installs a port from the signed binhost into the running
  slot and adds it to the world set. pkexec runs that program and no other
  under this action, so the grant reaches nothing beyond `install <port>`.
-->
<policyconfig>
  <vendor>KDOS</vendor>
  <vendor_url>https://github.com/kunaldawn/kdos</vendor_url>

  <action id="io.kdos.ports.install">
    <description>Install host software from the signed binary host</description>
    <message>Authentication is required to install software into this version of the system.</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kdos-discover/kdos-ports-helper</annotate>
  </action>
</policyconfig>
