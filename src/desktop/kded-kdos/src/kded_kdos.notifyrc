[Global]
IconName=distributor-logo-kdos
Name=KDOS
Comment=KDOS

[Event/importOffer]
Name=Application set on a removable drive
Comment=A drive you connected holds an exported KDOS application set
Action=Popup

[Event/shareStartFailed]
Name=Folder sharing unavailable
Comment=You can share folders, but the file server could not be started to serve them
Action=Popup

[Event/shellRespawnLimit]
Name=Desktop shell keeps stopping
Comment=The panel and desktop stopped several times in a minute and were not started again
Action=Popup

[Event/syncFailed]
Name=Accent not applied everywhere
Comment=The desktop changed accent, but the terminal programs, greeter or boot menu could not follow
Action=Popup
