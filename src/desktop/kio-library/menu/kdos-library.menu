<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
 "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">
<!--
  The menu's Library category: one launcher per offline book, map, model,
  docset or course, each installed by the data pack that carries it with
  Categories=X-KDOS-Library.
-->
<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>Library</Name>
    <Directory>kdos-library.directory</Directory>
    <Include>
      <Category>X-KDOS-Library</Category>
    </Include>
  </Menu>
</Menu>
