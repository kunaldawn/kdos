#!/bin/sh
# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   fake-kdos — the `kdos theme` and `kdos phosphor` verbs, as looktest
#               needs them
#
# State lives in $FAKE_KDOS_DIR: argv.log (one line per run, the arguments
# joined by spaces), accent, etc/accent (the /etc/kdos/accent stand-in),
# phosphor (on|off), preset (subtle|retro|custom), terminus (on|off),
# fullscreen (on|off), previous, unsupported
# (present: no GPU). Plasma's side is $XDG_CONFIG_HOME/kdeglobals, written
# the way plasma-apply-lookandfeel leaves it. FAKE_KDOS_NO_MACHINE set means
# kdos-powerd did not answer, so the machine's accent is left alone.

set -u
d=${FAKE_KDOS_DIR:?}
printf '%s\n' "$*" >> "$d/argv.log"

accents="phosphor amber ice bone norton borland perfect paper"

current() {
	if [ -s "$d/accent" ]; then cat "$d/accent"; else echo bone; fi
}

label() {
	first=$(printf '%s' "$1" | cut -c1 | tr '[:lower:]' '[:upper:]')
	printf '%s%s' "$first" "$(printf '%s' "$1" | cut -c2-)"
}

known() {
	for a in $accents; do [ "$a" = "$1" ] && return 0; done
	return 1
}

# kdeglobals as Plasma leaves it after a theme: the scheme, and the
# animation factor a test set in $d/anim.
plasma() {
	g="${XDG_CONFIG_HOME:?}/kdeglobals"
	anim=""
	[ -f "$d/anim" ] && anim=$(cat "$d/anim")
	{
		printf '[General]\nColorScheme=KDOS%s\n' "$(label "$1")"
		if [ -n "$anim" ]; then
			printf '\n[KDE]\nAnimationDurationFactor=%s\n' "$anim"
		fi
	} > "$g"
}

wear() {
	printf '%s' "$1" > "$d/accent"
	[ -n "${FAKE_KDOS_NO_MACHINE:-}" ] || printf '%s' "$1" > "$d/etc/accent"
}

case "${1:-} ${2:-}" in
"theme list")
	cur=$(current)
	for a in $accents; do
		if [ "$a" = "$cur" ]; then
			printf '* %-10s KDOS-%s\n' "$a" "$(label "$a")"
		else
			printf '  %-10s KDOS-%s\n' "$a" "$(label "$a")"
		fi
	done
	;;
"theme --from-plasma")
	known "${3:-}" || { echo "unknown theme '${3:-}' (try: kdos theme list)" >&2; exit 1; }
	wear "$3"
	echo "$3 (KDOS-$(label "$3"))"
	;;
"phosphor status")
	on=false pre=subtle term=false full=false sup=true reason=null prev=null
	[ "$(cat "$d/phosphor" 2>/dev/null)" = on ] && on=true
	[ -f "$d/preset" ] && pre=$(cat "$d/preset")
	[ "$(cat "$d/terminus" 2>/dev/null)" = on ] && term=true
	[ "$(cat "$d/fullscreen" 2>/dev/null)" = on ] && full=true
	if [ -f "$d/unsupported" ]; then
		sup=false
		reason='"phosphor mode needs GPU rendering (this session renders in software)"'
	fi
	[ -s "$d/previous" ] && prev="\"$(cat "$d/previous")\""
	printf '{"on": %s, "supported": %s, "reason": %s, "preset": "%s", "fullscreen": %s, "terminus": %s, "accent": "%s", "previous_accent": %s}\n' \
		"$on" "$sup" "$reason" "$pre" "$full" "$term" "$(current)" "$prev"
	;;
"phosphor on")
	if [ -f "$d/unsupported" ]; then
		echo "phosphor mode needs GPU rendering (this session renders in software)" >&2
		exit 1
	fi
	echo on > "$d/phosphor"
	cur=$(current)
	if [ "$cur" = bone ] || [ "$cur" = paper ]; then
		printf '%s' "$cur" > "$d/previous"
		wear phosphor
		plasma phosphor
	fi
	;;
"phosphor off")
	echo off > "$d/phosphor"
	if [ -s "$d/previous" ]; then
		prev=$(cat "$d/previous")
		wear "$prev"
		plasma "$prev"
		rm -f "$d/previous"
	fi
	;;
"phosphor preset")
	case "${3:-}" in subtle|retro) echo "$3" > "$d/preset" ;; *) exit 2 ;; esac
	;;
"phosphor terminus")
	case "${3:-}" in on|off) echo "$3" > "$d/terminus" ;; *) exit 2 ;; esac
	;;
"phosphor fullscreen")
	case "${3:-}" in on|off) echo "$3" > "$d/fullscreen" ;; *) exit 2 ;; esac
	;;
*)
	if [ "${1:-}" = theme ] && [ $# -eq 2 ]; then
		known "$2" || { echo "unknown theme '$2' (try: kdos theme list)" >&2; exit 1; }
		wear "$2"
		plasma "$2"
		[ -n "${FAKE_KDOS_NO_MACHINE:-}" ] && \
			echo "boot menu, splash and login screen unchanged (kdos-powerd did not answer)"
		echo "$2 (KDOS-$(label "$2"))"
		exit 0
	fi
	echo "fake-kdos: no verb $*" >&2
	exit 2
	;;
esac
