[Icon Theme]
Name=KDOS
Comment=Breeze Dark with the KDOS marks, in the accent of the colour scheme
Inherits=breeze-dark,breeze,Adwaita,hicolor
FollowsColorScheme=true
Example=folder
DisplayDepth=32

DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256

Directories=16x16/places,22x22/places,24x24/places,32x32/places,48x48/places,64x64/places,128x128/places,256x256/places,scalable/apps,actions/16,actions/22,actions/24,applets/256,emblems/8,emblems/16,emblems/22,status/16,status/22,status/24,status/64
