+
+    // Meta+Alt+S starts the screen reader, the chord a Plasma session binds;
+    // the greeter's KWin runs without global shortcuts, so the greeter binds
+    // it here. The command is a fixed string with no shell syntax in it, which
+    // the executable engine's KProcess splits into a program and arguments and
+    // starts with no shell; nothing typed at the greeter ever reaches it.
+    Shortcut {
+        sequences: ["Meta+Alt+S"]
+        context: Qt.ApplicationShortcut
+        onActivated: screenReader.connectSource("orca --replace")
+    }
+
+    P5Support.DataSource {
+        id: screenReader
+        engine: "executable"
+        connectedSources: []
+        onNewData: sourceName => disconnectSource(sourceName)
+    }
+
+    // KDOS's power-on hands over through black at every stage: the greeter
+    // rises out of black when it appears and goes back to black on a login,
+    // so the next mode set lands inside a black frame. Black is not a scheme
+    // colour; it is the screen with nothing on it. The plate takes no input,
+    // and its opacity must not drive `visible`: an Animator writes the
+    // property only when it ends, so a binding on it would hide the fade.
+    Rectangle {
+        id: blackout
+        anchors.fill: parent
+        color: "black"
+        opacity: 1
+        Behavior on opacity {
+            OpacityAnimator {
+                duration: Kirigami.Units.veryLongDuration
+                easing.type: Easing.InOutQuad
+            }
+        }
+        Component.onCompleted: opacity = 0
+    }
 }
--- /dev/null
+++ b/MonoClock.qml
@@ -0,0 +1,56 @@
+/*
+    SPDX-FileCopyrightText: 2016 David Edmundson <davidedmundson@kde.org>
+    SPDX-FileCopyrightText: 2025 Thomas Duckworth <tduck@filotimoproject.org>
+
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+// The Breeze greeter's clock (org.kde.breeze.components Clock.qml) set in the
+// fixed-width face: the time and the date read in the monospace the rest of
+// KDOS uses for numerals. Tabular figures keep the width still as it ticks.
+// The time's spaces are plain ones: a locale's short format may put U+202F
+// before AM or PM, the fixed-width face has no glyph for it, and the fallback
+// face's taller line pushes the date down.
+
+import QtQuick
+import QtQuick.Layouts
+
+import org.kde.plasma.clock as PlasmaClock
+import org.kde.plasma.components as PlasmaComponents3
+import org.kde.kirigami as Kirigami
+
+ColumnLayout {
+    id: root
+
+    readonly property bool softwareRendering: GraphicsInfo.api === GraphicsInfo.Software
+
+    PlasmaComponents3.Label {
+        text: Qt.formatTime(timeSource.dateTime, Qt.locale(), Locale.ShortFormat).replace(/[\u00a0\u202f]/g, " ")
+        textFormat: Text.PlainText
+        style: root.softwareRendering ? Text.Outline : Text.Normal
+        styleColor: root.softwareRendering ? Kirigami.Theme.backgroundColor : "transparent" //no outline, doesn't matter
+        font.family: Kirigami.Theme.fixedWidthFont.family
+        font.pointSize: Math.round(Kirigami.Theme.defaultFont.pointSize * 7.2)
+        font.weight: Font.DemiBold
+        font.features: { "tnum": 1 }
+        renderType: Text.NativeRendering
+        Layout.alignment: Qt.AlignHCenter
+        Accessible.name: text
+    }
+    PlasmaComponents3.Label {
+        text: Qt.formatDate(timeSource.dateTime, Qt.locale(), Locale.LongFormat)
+        textFormat: Text.PlainText
+        style: root.softwareRendering ? Text.Outline : Text.Normal
+        styleColor: root.softwareRendering ? Kirigami.Theme.backgroundColor : "transparent" //no outline, doesn't matter
+        font.family: Kirigami.Theme.fixedWidthFont.family
+        font.pointSize: Math.round(Kirigami.Theme.defaultFont.pointSize * 2.4)
+        renderType: Text.NativeRendering
+        Layout.alignment: Qt.AlignHCenter
+        Accessible.name: text
+    }
+
+    PlasmaClock.Clock {
+        id: timeSource
+        trackSeconds: Qt.locale().timeFormat(Locale.ShortFormat).includes("s")
+    }
+}
