@@ -533,4 +553,42 @@
         interval: 3000
         onTriggered: notificationMessage = ""
     }
+
+    // Meta+Alt+S starts the screen reader, the chord a Plasma session binds;
+    // the greeter's KWin runs without global shortcuts, so the greeter binds
+    // it here. The command is a fixed string with no shell syntax in it, which
+    // the executable engine's KProcess splits into a program and arguments and
+    // starts with no shell; nothing typed at the greeter ever reaches it.
+    Shortcut {
+        sequences: ["Meta+Alt+S"]
+        context: Qt.ApplicationShortcut
+        onActivated: screenReader.connectSource("orca --replace")
+    }
+
+    P5Support.DataSource {
+        id: screenReader
+        engine: "executable"
+        connectedSources: []
+        onNewData: sourceName => disconnectSource(sourceName)
+    }
+
+    // KDOS's power-on hands over through black at every stage: the greeter
+    // rises out of black when it appears and goes back to black on a login,
+    // so the next mode set lands inside a black frame. Black is not a scheme
+    // colour; it is the screen with nothing on it. The plate takes no input,
+    // and its opacity must not drive `visible`: an Animator writes the
+    // property only when it ends, so a binding on it would hide the fade.
+    Rectangle {
+        id: blackout
+        anchors.fill: parent
+        color: "black"
+        opacity: 1
+        Behavior on opacity {
+            OpacityAnimator {
+                duration: Kirigami.Units.veryLongDuration
+                easing.type: Easing.InOutQuad
+            }
+        }
+        Component.onCompleted: opacity = 0
+    }
 }
--- /dev/null
+++ b/MonoClock.qml
@@ -0,0 +1,53 @@
+/*
