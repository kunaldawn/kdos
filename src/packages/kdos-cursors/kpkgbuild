# description	: KDOS phosphor pixel-art cursor theme (generated Xcursor files)
# depends	: python3

name=kdos-cursors
version=1.0.0
release=1
source=""

build() {
	python3 "$PORT_SRC/gencursors.py" "$PKG/usr/share/icons/KDOS-cursors"
	# Distrobox apps share $HOME but not /usr/share/icons — a copy in
	# ~/.icons makes the theme visible inside the box too.
	mkdir -p "$PKG/etc/skel/.icons"
	cp -a "$PKG/usr/share/icons/KDOS-cursors" "$PKG/etc/skel/.icons/"
}
