# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------
#
# KK's soundtrack. Three tracker modules, vendored from The Mod Archive.
#
# Every one is taken from ModArchive's PUBLIC DOMAIN licence category and from
# nowhere else. That is not fussiness: KDOS ships a public ISO, and the bulk of
# ModArchive is all-rights-reserved — "freely downloadable" is not a licence to
# redistribute inside a distribution. The category is browsable at
#   https://modarchive.org/index.php?request=view_by_license&query=publicdomain
# and each module's own page states "Licensed under the Public Domain license".
#
# The MD5s below are the archive's, and they match the bytes committed here —
# checked at vendoring time, so a re-download can be verified against this file
# rather than against a memory of what was fetched.
#
# Files are named for their ROLE in the demo, not by their original filename;
# src/kk.h's SONG_* macros use these names. Swapping a track is a rename plus
# an edit here.
#
# Retrieved 2026-08-09.

[kk-intro.xm]
title    = Keygen 9000
artist   = Drozerix
genre    = Chiptune
licence  = Public Domain
source   = https://modarchive.org/index.php?request=view_by_moduleid&query=173938
download = https://api.modarchive.org/downloads.php?moduleid=173938
original = keygen_9000.xm
format   = XM, 8 channels, 36 patterns, 50 orders
md5      = 02b1f1dad70ea15a0b064c45468caa55
used_by  = stage 1 — the CRT power-on, the fractal precalc, the portrait

[kk-middle.xm]
title    = Ambient Starfield
artist   = Drozerix
genre    = Electronic - Ambient
licence  = Public Domain
source   = https://modarchive.org/index.php?request=view_by_moduleid&query=174160
download = https://api.modarchive.org/downloads.php?moduleid=174160
original = ambient_starfield.xm
format   = XM, 8 channels, 51 patterns, 46 orders
md5      = 6aed4f531c9a4e37355f84bebfdd008f
used_by  = stage 2 — the penguin, the zoomer, the rotozoomer, the scope

[kk-credits.xm]
title    = CHiP_OVERTURE
artist   = Drozerix
genre    = Chiptune
licence  = Public Domain
source   = https://modarchive.org/index.php?request=view_by_moduleid&query=172185
download = https://api.modarchive.org/downloads.php?moduleid=172185
original = chip_overture.xm
format   = XM, 10 channels, 20 patterns, 23 orders
md5      = 014c8c0ac159a573ae7e1f52079fc0b7
used_by  = stage 3 — the outro

# Note on loaders: all three are XM, and upstream BB registered only
# MikMod_RegisterLoader(&load_s3m) because the three modules it shipped were
# S3M. KK registers every loader (src/main.c) — with the S3M loader alone each
# of these fails inside Player_Load and the demo plays in silence.
