# description	: KDOS phosphor GTK theme — a recoloured adw-gtk3
# homepage	: https://github.com/lassekongo83/adw-gtk3
# depends	: python3

name=kdos-gtk-theme
version=6.5
release=1
source=""

build() {
	python3 "$PORT_SRC/gengtk.py" "$PKG/usr/share/themes/KDOS"

	# `kdos theme <accent>` re-runs the generator against $HOME, so the
	# generator and the vendored stylesheet ship with the system. That run is
	# also what produces ~/.themes/KDOS, which is the only theme path the
	# appbox can see (it shares $HOME, not /usr/share) and is why no
	# /etc/skel copy is installed here: 06_packaging/00_theme.sh runs
	# `kdos theme phosphor` against /etc/skel and generates it.
	install -Dm755 "$PORT_SRC/gengtk.py" "$PKG/usr/share/kdos/gtk-theme/gengtk.py"
	cp -a "$PORT_SRC/theme" "$PKG/usr/share/kdos/gtk-theme/theme"

	install -Dm644 "$PORT_SRC/LICENSE.notice" \
		"$PKG/usr/share/licenses/kdos-gtk-theme/LICENSE.notice"
}
