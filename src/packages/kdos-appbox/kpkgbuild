# description	: KDOS alien app runtime and appbox manager
# depends	: ncurses podman distrobox

name=kdos-appbox
version=1.0.0
release=1
source=""

build() {
	# Built in the work dir, never in $PORT_SRC — that is the repo.
	gcc $CFLAGS -O2 -std=c11 -D_GNU_SOURCE -Wall -Wextra -o kdos-appbox \
		"$PORT_SRC/main.c" "$PORT_SRC/util.c" "$PORT_SRC/box.c" \
		"$PORT_SRC/app.c" "$PORT_SRC/tui.c" $LDFLAGS -lncursesw
	install -Dm755 kdos-appbox "$PKG/usr/local/bin/kdos-appbox"
}
