# WHAT EVERY BOX PAYS FOR, and nothing else. Two things are deliberately out:
# mesa-vulkan-drivers is 241 MB and 26 packages for an API one application in
# this file might use, so it rides on that application; and libvte-*-common is
# distrobox's terminal integration, which a pack box does not have — kdos-boxinit
# is pid 1 here.
# A SECOND BASE, AND IT COSTS ONE LINE. `kdos-box create <n> base=image:<ref>`
# is an ONLINE operation and says so; the bases worth CARRYING are the ones
# that need no network. alpine is ~3 MB of busybox and musl — a clean scratch
# userland to try something in without touching the machine you are sitting on,
# and the one non-Debian rootfs small enough that carrying it is free.
#
# NO PACKAGES, DELIBERATELY. The image as it stands IS the deliverable. A row
# with an empty package list emits no apt line at all, which is the only way a
# non-Debian rootfs can be a row: everything below `FROM` in a generated
# Containerfile is apt, and against alpine it dies on `apt-get: not found`.
#
# Pinned to a POINT release, like every other version in this tree: `alpine:3`
# and `latest` are the same name for different bytes on different days.
image   alpine    alpine:3.24.1
base    alpine    -

# THE AUDIO CLIENT LIVES IN THE BASE, not on a runtime. A box carrying neither
# libpulse nor an /etc/asound.conf resolves ALSA's `default` to alsa-lib's
# built-in plug -> softvol -> dmix card chain, and `run.oci.keep_original_groups=1`
# keeps the host `audio` group alive through the user namespace — so that open
# SUCCEEDS, takes the card exclusively, and silences PipeWire and every other
# program on the machine until the box stops. libpulse0 is what cubeb, SDL
# and gstreamer's pulsesink dlopen; libasound2-plugins carries
# libasound_module_pcm_pulse.so, which is the plugin the `pcm.!default { type
# pulse }` kdos-boxinit writes into /etc/asound.conf names.
#
# THE TWO RIDE TOGETHER OR NEITHER DOES. libasound2-plugins cannot install
# without libasound2t64, so dropping the boxinit write while keeping this row
# puts alsa-lib AND its built-in card chain into every pack in the catalogue
# and leaves `default` pointing at the card — wider than the problem the row
# exists to close. NOT pipewire-alsa: it drags the daemon and libspa into every
# pack and puts a second sound server inside a box nothing starts.
#
# VA-API LIVES IN THE BASE FOR THE SAME REASON THE GL LOADER DOES. The render
# nodes are bound into every box, the DRI drivers are already here, and the
# cage composites a guest on the card wherever there is one — so the piece that
# decides whether a video is decoded by the card or by the CPU is the presence
# of libva and a `*_drv_video.so` beside it. Without them a boxed player or
# browser has nothing to dlopen, finds no hardware decoder and decodes every
# frame of every video on the CPU, on a machine that can do it in silicon.
#
# IT IS A BASE ROW AND NOT A RUNTIME ONE, because a pack's parent chain is a
# single line: a GTK application sits on rt-gtk, a media one on rt-media, and
# a driver set placed on either reaches half the catalogue. Carried once in the
# base, it is stored once and every box has it. `va-driver-all` rather than a
# named driver: which one a machine needs is the machine's to decide, and a
# pack baked against one card would be wrong on the next. vainfo is what makes
# the answer checkable from inside the box in one command.
base    base      -        bash bc bzip2 ca-certificates curl diffutils findutils gnupg2 less libnss-myhostname lsof man-db manpages mount ncurses-base passwd pinentry-curses procps sudo tar time tree tzdata unzip util-linux wget xz-utils zip libgl1-mesa-dri libegl1 libgl1 adwaita-icon-theme hicolor-icon-theme librsvg2-common fonts-dejavu fonts-liberation fonts-noto-core dbus-x11 xdg-utils desktop-file-utils shared-mime-info libglib2.0-bin libpulse0 libasound2-plugins libva2 libva-drm2 libva-wayland2 libva-x11-2 va-driver-all vainfo

# xfonts-base and x11-xserver-utils: an X11 application under Xwayland
# (grace) needs core fonts and `xhost`, and a
# box has neither unless its runtime carries them. Measured on the sweep:
# `Couldn't get font -adobe-helvetica…`, `xhost: command not found`.
runtime rt-gtk    base     libgtk-3-0t64 libgtk-4-1 libadwaita-1-0 gtk-update-icon-cache xfonts-base x11-xserver-utils

# Qt, and NOTHING KDE. qt6-wayland/qtwayland5 are the platform PLUGIN and are
# not optional: without them every Qt app falls back to xcb under an Xwayland
# built with no GLX. The qgtk3 platform THEME is what gives them the KDOS
# palette, read out of ~/.themes/KDOS in the home the box shares — which is why
# GTK is pulled in here, and it is 95 MB against plasma-integration's 284.
# xfonts-base: grass opens an xterm, which needs core X fonts under Xwayland.
runtime rt-qt     base     libqt5widgets5t64 libqt6widgets6 qt6-wayland qtwayland5 qt5-gtk-platformtheme qt6-gtk-platformtheme xfonts-base

# The KDE applications' own layer. plasma-integration is what makes
# QT_QPA_PLATFORMTHEME=kde work at all, and kio-extras with the two
# thumbnailers are what make a KDE file dialog show pictures rather than
# generic icons.
#
# IT IS A LAYER OVER rt-qt AND NOT PART OF IT. Measured on trixie: kio-extras
# and the thumbnailers are 392 MB and 215 packages, plasma-integration 284 MB
# more — all of which every Qt application on rt-qt would otherwise carry to
# draw a thumbnail in a file manager it does not have.
runtime rt-kde    rt-qt    plasma-integration kio kio-extras kde-cli-tools breeze breeze-icon-theme kimageformat-plugins ffmpegthumbs kdegraphics-thumbnailers

# THE CODECS AND THE PIPEWIRE CLIENT LIBRARIES.
# `pipewire-audio-client-libraries` is trixie's transitional name for
# pipewire-alsa and pipewire-jack, so this row carries an ALSA client of its
# own: pipewire-alsa symlinks its drop-in into /etc/alsa/conf.d, which the
# @hooks DO read, and that alone keeps an rt-media box off the card. The
# base's /etc/asound.conf is loaded after /etc/alsa/conf.d and so wins the
# `default` here too — `type pulse` rather than `type pipewire`, both of which
# land on the host's daemon through the shared runtime directory.
# pipewire-jack is what pw-jack puts in front of a JACK client so it reaches
# the host's PipeWire; nothing here starts a daemon inside the box.
runtime rt-media  base     ffmpeg gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-libav pipewire-audio-client-libraries pipewire-jack pipewire-bin

runtime rt-sci    base     python3 python3-numpy python3-scipy python3-matplotlib

# Electron's shared set. VSCodium needs --no-sandbox in the box regardless:
# chrome-sandbox wants a setuid helper and CLONE_NEWUSER, and gets neither.
runtime rt-electron base   libnss3 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 libdrm2 libxkbfile1 libsecret-1-0

# wine32 is i386-only; `bake` enables the architecture for a row that names
# one. Without it a 32-bit Windows binary — which most old ones are — has
# nothing to run on.
#
# rt-wine IS DEBIAN'S WINE, for whoever prefers it to the native `wine` port,
# and NO APP ROW SITS ON IT: a row's `wine` command shim in ~/.local/bin comes
# before /usr/bin on PATH and would shadow the host's own wine. winetricks is
# not here either — it is in `contrib`, and it fetches Windows runtimes from
# the network at run time, which an offline distro cannot promise and which is
# the same reason there are no corefonts for wine. `cabextract` is its support
# package and goes with it.
runtime rt-wine   base     wine wine64 wine32:i386

