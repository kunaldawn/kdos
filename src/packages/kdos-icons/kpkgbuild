# description	: KDOS phosphor icon theme derived from cosmic-icons
# depends	: cosmic-icons python3

name=kdos-icons
version=1.0.0
release=1
source=""

build() {
	python3 "$PORT_SRC/recolor.py" \
		/usr/share/icons/Cosmic/scalable \
		/usr/share/icons/hicolor/scalable/apps \
		"$PKG/usr/share/icons/KDOS"
	install -Dm644 "$PORT_SRC/kdos-icon-256.png" \
		"$PKG/usr/share/icons/KDOS/256x256/apps/distributor-logo-kdos.png"
	install -Dm644 "$PORT_SRC/kdos-icon-256.png" \
		"$PKG/usr/share/icons/KDOS/256x256/apps/start-here.png"
	# The dock's app-library button is the KDOS tux, not the stock grid.
	# The button applet shows the TARGET's icon (com.system76.CosmicAppLibrary),
	# not the applet's own. panel-tux.svg is pure <rect> pixel art (from the
	# splash penguin RLE) — resvg renders it without raster-image support.
	# hicolor is overwritten too so every lookup path lands on the tux.
	for n in com.system76.CosmicAppLibrary com.system76.CosmicPanelAppButton; do
		install -Dm644 "$PORT_SRC/panel-tux.svg" \
			"$PKG/usr/share/icons/KDOS/scalable/apps/$n.svg"
		install -Dm644 "$PORT_SRC/panel-tux.svg" \
			"$PKG/usr/share/icons/hicolor/scalable/apps/$n.svg"
	done
}
