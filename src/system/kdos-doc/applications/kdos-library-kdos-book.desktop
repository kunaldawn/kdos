[Desktop Entry]
Type=Application
Name=The KDOS Book
GenericName=Offline Book
Comment=How KDOS works and why, from the first boot to every command
Icon=distributor-logo-kdos
Exec=xdg-open file:///usr/share/doc/kdos/index.html
Categories=X-KDOS-Library;
Keywords=kdos;book;manual;documentation;help;
X-KDOS-Library-Kind=Books
X-KDOS-Library-Path=/usr/share/doc/kdos
