#!/bin/bash

# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   script/hooks/pre-push — refuse a push that breaks the ports layout, or
#   names a source the archive lacks
# ---------------------------------
#
# Enabled per clone with
#
#     git config core.hooksPath script/hooks
#
# which replaces .git/hooks entirely, git-lfs's own hooks included.
#
# THE LAYOUT comes first, and needs no network. At the tip of every pushed
# ref that the remotes do not already hold, read from git's tree and not the
# working copy:
#
#   - every kpkgbuild under ports/core is exactly
#     ports/core/<shelf>/<name>/kpkgbuild, nothing loose one level up and
#     nothing a level deeper
#   - every <shelf> is listed in that commit's ports/shelves
#   - every bare port name is unique across ports/core and src/<area>/
#   - no listed shelf is named `libs` or `core`, or after a port
#
# A port is found by bare name one shelf down, so a name held by two ports
# resolves to neither, and a loose or over-deep recipe is a port no build
# sees. Only the tip is checked, because only the tip is built: an
# intermediate commit a later one repairs passes. testing/preflight.sh checks
# the same and more; this holds when preflight is not run.
# KDOS_SKIP_LAYOUT_CHECK=1 bypasses it.
#
# A recipe's `sha256 =` is a promise that ports/fetch can find those bytes. A
# commit whose recipe names a hash the archive does not hold builds on the
# machine that wrote it and nowhere else, and nothing notices until somebody
# else's fetch fails. So for every ref pushed, each hash its recipes name that
# the remote side's recipes do not must appear in ports/sources.idx AS OF THE
# PUSHED COMMIT — the index is what tells fetch where a file lives, so an
# uncommitted index line is as good as no upload — and is then HEAD-checked at
# every asset that line names: the file, or each of its parts, in the release
# the line's tag names. One part missing is the file missing. An index at that
# commit that is not format 2 names nothing, so every new hash is reported as
# not in it. The push is refused while any is missing; `ports/publish` uploads
# them and writes the index lines to commit.
#
# The remote side is the remote's current sha for the ref; for a new branch,
# every refs/remotes/* tip. A file git itself carries at the pushed commit (a
# patch, a config file) is not archived and is not checked; a Git LFS pointer
# is not the file and is. Deleting a ref passes.
#
# AN UNREACHABLE ARCHIVE REFUSES THE PUSH, and so does one answering anything
# but 200 or 404. Offline or mid-outage, absence cannot be ruled out, and a
# silent pass is exactly the push this exists to stop.
# KDOS_SKIP_PUBLISH_CHECK=1 bypasses the archive check, and not the layout.

ROOT=$(git rev-parse --show-toplevel) || exit 1
# shellcheck source=ports/srclib.sh
. "$ROOT/ports/srclib.sh" || { echo "pre-push: cannot read ports/srclib.sh" >&2; exit 1; }

refuse() {
    echo "pre-push: $*" >&2
    echo "pre-push: (KDOS_SKIP_PUBLISH_CHECK=1 git push … skips this check)" >&2
    exit 1
}

mapfile -t LINES

# layout_problems <commit> — one line per breach of the ports layout at
# <commit>, nothing when it holds.
layout_problems() {
    local shelves
    shelves=$(git show "$1:ports/shelves" 2>/dev/null |
              awk '!/^[[:space:]]*(#|$)/ { print $1 }')
    git ls-tree -r --name-only "$1" -- ports/core src | awk -v shelves="$shelves" '
        BEGIN {
            n = split(shelves, s, "\n")
            for (i = 1; i <= n; i++) if (s[i] != "") { listed[s[i]] = 1; nlisted++ }
        }
        !/\/kpkgbuild$/ { next }
        {
            k = split($0, p, "/")
            if (p[1] == "ports") {
                if (k != 5) { print $0 ": not at ports/core/<shelf>/<name>/kpkgbuild"; next }
                if (nlisted && !(p[3] in listed)) bad[p[3]] = 1
            } else if (k != 4) {
                next
            }
            name = p[k - 1]
            if (name in at) print "port " name " is in two places: " at[name] " and " $0
            else at[name] = $0
        }
        END {
            if (!nlisted) print "ports/shelves is missing or lists no shelf"
            for (x in bad) print "shelf " x " is not listed in ports/shelves"
            for (x in listed) {
                if (x == "libs" || x == "core") print "shelf " x ": the name is reserved"
                else if (x !~ /^[a-z0-9-]+$/) print "shelf " x ": an id is lowercase letters, digits and -"
                if (x in at) print "shelf " x " shares its name with the port at " at[x]
            }
        }' | LC_ALL=C sort
}

if [ "${KDOS_SKIP_LAYOUT_CHECK:-}" != 1 ]; then
    declare -A LAID=()
    for line in "${LINES[@]}"; do
        read -r _lref lsha _rref _rsha <<< "$line"
        [ -n "$lsha" ] && [[ ! "$lsha" =~ ^0+$ ]] || continue
        [ -z "${LAID[$lsha]:-}" ] || continue
        LAID[$lsha]=1
        # A commit every remote already holds is published history, not
        # this push's to refuse.
        [ -n "$(git rev-list -1 "$lsha" --not --remotes 2>/dev/null)" ] || continue
        bad=$(layout_problems "$lsha")
        [ -z "$bad" ] && continue
        echo "pre-push: the ports layout is broken at $(git rev-parse --short "$lsha"):" >&2
        sed 's/^/  /' <<< "$bad" >&2
        echo "pre-push: (KDOS_SKIP_LAYOUT_CHECK=1 git push … skips this check)" >&2
        exit 1
    done
fi

[ "${KDOS_SKIP_PUBLISH_CHECK:-}" = 1 ] && exit 0

[ -n "$KDOS_SOURCES_BASE" ] || refuse "KDOS_SOURCES_BASE is empty, so no source can be confirmed archived"
# A directory holds a copy of the archive, and a push needs the published one.
src_base_local && refuse "KDOS_SOURCES_BASE is a local directory, so no source can be confirmed published"

LFS_POINTER='^version https://git-lfs.github.com/spec/v1'

IDX=$(mktemp) || exit 1
trap 'rm -f "$IDX"' EXIT

hashes_at() {
    git grep -h -o -E '\b[0-9a-f]{64}\b' "$1" -- 'ports/core/*/kpkgbuild' 2>/dev/null
}

declare -A CHECKED MISSING_LABEL
MISSING=()

for line in "${LINES[@]}"; do
    read -r _lref lsha _rref rsha <<< "$line"
    [ -n "$lsha" ] || continue
    [[ "$lsha" =~ ^0+$ ]] && continue

    if [[ ! "$rsha" =~ ^0+$ ]] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
        bases=("$rsha")
    else
        mapfile -t bases < <(git for-each-ref --format='%(objectname)' refs/remotes/)
    fi
    new=$(comm -23 <(hashes_at "$lsha" | LC_ALL=C sort -u) \
                   <(for b in "${bases[@]}"; do hashes_at "$b"; done | LC_ALL=C sort -u))
    [ -n "$new" ] || continue

    git show "$lsha:ports/sources.idx" > "$IDX" 2>/dev/null || : > "$IDX"
    src_index_load "$IDX"

    # "<hash> <port>/<file>" for every hash, the real path of that file, and
    # what git carries, at $lsha. The port is the directory holding the
    # kpkgbuild, whatever shelf it sits on; carried[] is keyed by real path.
    declare -A label=() lpath=() ptr=() carried=()
    while IFS= read -r m; do
        m=${m#"$lsha":}
        dir=${m%%:*}
        dir=${dir%/kpkgbuild}
        read -r h f <<< "${m#*:}"
        label[$h]=${dir##*/}/$f
        lpath[$h]=$dir/$f
    done < <(git grep -o -E '[0-9a-f]{64}[[:space:]]+[^[:space:]]+' "$lsha" -- 'ports/core/*/kpkgbuild')
    while IFS= read -r -d '' p; do ptr[${p#"$lsha":}]=1; done < <(
        git grep -l -z -I -e "$LFS_POINTER" "$lsha" -- ports/core 2>/dev/null)
    while IFS= read -r -d '' p; do [ -n "${ptr[$p]:-}" ] || carried[$p]=1; done < <(
        git ls-tree -r -z --name-only "$lsha" -- ports/core)

    while read -r h; do
        [ -n "${CHECKED[$h]:-}" ] && continue
        CHECKED[$h]=1
        l=${label[$h]:-?}
        [ -n "${lpath[$h]:-}" ] && [ -n "${carried[${lpath[$h]}]:-}" ] && continue
        if ! mapfile -t urls < <(src_urls "$h") || [ "${#urls[@]}" = 0 ]; then
            MISSING+=("$h"); MISSING_LABEL[$h]="$l — not in ports/sources.idx"
            continue
        fi
        # Only a 404 is absence. Any other status — a 403, a 5xx during an
        # outage — is an archive that cannot answer, and is reported as that,
        # not as a source to upload.
        for url in "${urls[@]}"; do
            rc=0
            code=$(curl -sIL -o /dev/null -w '%{http_code}' --connect-timeout 20 \
                        --max-time 120 --retry 2 "$url") || rc=$?
            [ "$rc" = 0 ] || refuse "cannot reach the source archive at $KDOS_SOURCES_BASE (curl exit $rc);
pre-push: whether $l ($h) is archived cannot be confirmed, so the push is refused"
            case $code in
                200) ;;
                404) MISSING+=("$h")
                     MISSING_LABEL[$h]="$l — indexed in ${SRC_TAG[$h]} as ${url##*/} but absent"
                     break ;;
                *)   refuse "source archive unreachable at $KDOS_SOURCES_BASE (HTTP $code);
pre-push: whether $l ($h) is archived cannot be confirmed, so the push is refused" ;;
            esac
        done
    done <<< "$new"
    unset label lpath ptr carried
done

[ "${#MISSING[@]}" = 0 ] && exit 0

echo "pre-push: these sources are named by a recipe but not in the archive at that commit:" >&2
declare -A PORTS
for h in "${MISSING[@]}"; do
    printf '  %s  (%s)\n' "${MISSING_LABEL[$h]}" "$h" >&2
    PORTS[${MISSING_LABEL[$h]%%/*}]=1
done
refuse "publish them and commit the index first:  ports/publish ${!PORTS[*]} && git commit ports/sources.idx"
