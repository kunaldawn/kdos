#!/bin/bash

# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------

# Shared by every phase. A phase.env sources this through env/host.env or
# env/chroot.env, after its base CFLAGS, CXXFLAGS and LDFLAGS are set: the
# lines below append to them, and a base assignment made afterwards would drop
# the reproducibility flags without a word.

# ── reproducible packages (P12) ───────────────────────────────────────────
#
# A package built twice from this tree must be byte-identical. kpkg normalises
# the ARCHIVE itself (sorted, uid/gid 0, --mtime from SOURCE_DATE_EPOCH, pinned
# xz); these are the five environment lines that normalise what goes INTO it.
#
# The epoch is pinned rather than taken from the clock or from git — the build
# container has no git, and "now" is the single largest source of drift. TZ and
# LC_ALL because a few configure scripts and doc generators embed a formatted
# date or sort a list by locale. -ffile-prefix-map rewrites the build directory
# out of __FILE__ and DWARF paths, and --build-id=sha1 makes the note a function
# of the contents instead of a random 128-bit value.
export SOURCE_DATE_EPOCH=1735689600
export TZ=UTC
export LC_ALL=C
export CFLAGS="$CFLAGS -ffile-prefix-map=/var/cache/kpkg/work=/build"
export CXXFLAGS="$CXXFLAGS -ffile-prefix-map=/var/cache/kpkg/work=/build"
export LDFLAGS="$LDFLAGS -Wl,--build-id=sha1"

# ── how many jobs ─────────────────────────────────────────────────────────
#
# KDOS_JOBS is the one job count: make reads it from MAKEFLAGS, `cmake --build`
# from CMAKE_BUILD_PARALLEL_LEVEL and cargo from CARGO_BUILD_JOBS. Unset or
# empty, it is the thread count clamped to one job per 2 GiB of MemTotal, at
# least 1, so a small host or an on-device `kdos rebuild` does not have its
# compilers OOM-killed; a value given from outside is used as it stands, and
# one that is not a positive integer stops the step here rather than as make's
# `-j` error at the first port.
# /proc/meminfo is read in bash because 20_selfhost has toybox and no awk.
#
# MAKEFLAGS stays exactly `-jN`: llvm, llvm21, chromium, qtwebengine,
# thunderbird, mkvtoolnix and ardour take the number out of it, and a load
# limit (-l) would both break that and follow the host's load average, which
# no container namespaces. Ninja reads none of the three: in the chroot
# phases script/bin/ninja, which chroot.env puts first on PATH, adds
# -j"$KDOS_JOBS" to every ninja call that names no job count, and so to
# `meson compile` and a CMake Ninja build too. The host phases have no such
# wrapper and build nothing with ninja.
if [ -z "${KDOS_JOBS:-}" ]; then
    KDOS_JOBS=$(nproc 2>/dev/null) || KDOS_JOBS=4
    [ -n "$KDOS_JOBS" ] || KDOS_JOBS=4
    if [ -r /proc/meminfo ]; then
        while read -r _kdos_k _kdos_v _; do
            if [ "$_kdos_k" = "MemTotal:" ]; then
                _kdos_v=$((_kdos_v / 2097152))
                [ "$_kdos_v" -ge "$KDOS_JOBS" ] || KDOS_JOBS=$_kdos_v
                break
            fi
        done < /proc/meminfo
    fi
    [ "$KDOS_JOBS" -ge 1 ] || KDOS_JOBS=1
    unset _kdos_k _kdos_v
fi
case $KDOS_JOBS in
    ''|*[!0-9]*|0*)
        echo "KDOS_JOBS must be a positive integer, got '$KDOS_JOBS'" >&2
        return 1 2>/dev/null || exit 1 ;;
esac
export KDOS_JOBS MAKEFLAGS="-j$KDOS_JOBS" CMAKE_BUILD_PARALLEL_LEVEL="$KDOS_JOBS" CARGO_BUILD_JOBS="$KDOS_JOBS"

# ── strict recipe matching ────────────────────────────────────────────────
#
# kpkg's skip-if-installed compares the RECIPE, not merely the presence of a
# database entry: a port whose kpkgbuild, build.sh, postinstall.sh, patches or
# any other file beside them that no `sha256 =` line names has changed is
# rebuilt without having to be named on the command line.
# Without it, an edited recipe on an incremental tree installs nothing and the
# build reports success.
#
# The comparison is kp_recipe_hash(), the same SHA-256 the binhost's `E:` uses,
# so there is one definition of "the recipe changed". A package with no
# recorded hash reads as UNKNOWN and is left alone, so a tree that predates the
# record is not rebuilt wholesale.
#
# Set for the build; an interactive `kpkg install` is unaffected. It does NOT
# cover a file under fs/ that a port installs — that is not part of the recipe
# hash, and `release = N` is still the lever for those.
export KPKG_STRICT_RECIPE=1
