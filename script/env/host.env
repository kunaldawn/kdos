#!/bin/bash

# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------

# Shared by the host phases, 00_cross and 10_bootstrap: they run in the build
# container, outside build/fs, and build with the cross toolchain into the
# sysroot. The phase sets its own MARK after sourcing this, since the mark
# directory is what makes that phase's steps skip.

export KDOS_TARGET=x86_64-kdos-linux-musl

# The build container mounts the tree at /workspace; `kdos rebuild` builds a
# copy elsewhere and names it in KDOS_WORKSPACE.
export WORKSPACE="${KDOS_WORKSPACE:-/workspace}"
export BUILD_DIR=$WORKSPACE/build
export SYSROOT=$BUILD_DIR/fs
export CROSS_SYSROOT=$BUILD_DIR/cross

mkdir -p $BUILD_DIR $SYSROOT $CROSS_SYSROOT
rm -rf $BUILD_DIR/tmp
mkdir -p $BUILD_DIR/tmp

export PKG_CONFIG_PATH=""
export PKG_CONFIG_LIBDIR=$SYSROOT/usr/lib/pkgconfig:$SYSROOT/usr/share/pkgconfig
export PKG_CONFIG_SYSROOT_DIR=$SYSROOT

export PATH=$CROSS_SYSROOT/bin:$CROSS_SYSROOT/usr/bin:$PATH

export CFLAGS="-O2 -pipe -std=gnu99"
export CXXFLAGS="-O2 -pipe"
export LDFLAGS=""

source "${BASH_SOURCE[0]%/*}/common.env"
