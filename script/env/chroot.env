#!/bin/bash

# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------

# Shared by the chroot phases, 20_selfhost onwards: they run inside build/fs,
# with the environment script/chroot/exec.sh cleared, and build with the
# system's own native compiler. A phase that differs unsets or overrides a
# line after sourcing this; it does not copy the file.
#
# CHROOT=1 is not set here. The orchestrator reads it from each phase.env's
# own text to pick the execution wrapper, and follows no `source`: set only in
# this file, it would run every chroot phase on the host.

export PKG_CONFIG_PATH="/usr/local/share/pkgconfig:/usr/local/lib/pkgconfig:/usr/local/lib64/pkgconfig:/usr/share/pkgconfig:/usr/lib/pkgconfig:/usr/lib64/pkgconfig"${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}

# THE COMPILER IS NAMED, NOT DISCOVERED. autoconf's AC_PROG_CC walks a
# preference list, and some of them put clang FIRST — potrace's does. clang is
# a port, so the moment it is installed those recipes silently change
# toolchain, and the failure is `C compiler cannot create executables` from a
# configure that had a working gcc in $PATH the whole time. A distro that
# builds itself cannot have its toolchain depend on which ports are installed.
export CC=gcc
export CXX=g++

# THE RELEASE FLAGS every port builds with; a recipe adds to them and never
# replaces them. The policy, and what is ruled out, is in decisions.md.
# - -O2 is the level. A recipe raises a hot port to -O3 with
#   ${CFLAGS/-O2/-O3}; CMake's Release -O3 comes after these and wins, meson's
#   -O3 comes before them and loses.
# - -fno-semantic-interposition. Under -fPIC, GCC may not inline or clone an
#   exported function into its callers, because a preloaded library could
#   replace it; with it, it may. Only a call within one translation unit is
#   affected: an LD_PRELOAD still replaces any function called from another
#   file, and exported data is still read through the GOT.
# - -fstack-clash-protection probes each large stack allocation page by page,
#   so it cannot step over the guard page.
# - -Wl,-O1,--sort-common: smaller hash tables and common symbols sorted by
#   alignment, at no cost.
# - --as-needed records a DT_NEEDED only for a library the object uses. A
#   port that names a library before the objects that use it, or needs a
#   library only for its constructor, adds -Wl,--no-as-needed.
# - -z,now makes the GOT read-only after load. It also stops musl deferring
#   an unresolved symbol in a library opened with RTLD_LAZY, so a plugin that
#   takes symbols from a library loaded after it adds -Wl,-z,lazy.
# - -z,pack-relative-relocs writes relative relocations as DT_RELR, which
#   musl's loader reads from 1.2.4 and binutils writes from 2.38. A C library
#   older than that cannot load what this tree links.
export CFLAGS="-O2 -pipe -std=gnu11 -fPIC -fno-semantic-interposition -fstack-clash-protection"
export CXXFLAGS="-O2 -pipe -fPIC -fno-semantic-interposition -fstack-clash-protection"
export LDFLAGS="-Wl,-O1,--sort-common,--as-needed,-z,now,-z,pack-relative-relocs"

source "${BASH_SOURCE[0]%/*}/common.env"

# Defaults for the build systems that do not read CFLAGS, set after
# common.env so the Go lines carry its -ffile-prefix-map and --build-id:
# - CMAKE_BUILD_TYPE is the type of a CMake project whose recipe names none
#   (CMake 3.22 and later read it). Without it such a build takes CFLAGS alone
#   and keeps assert() on.
# - CARGO_PROFILE_RELEASE_DEBUG=0 overrides a crate whose own release profile
#   turns debug information on; with debug off, cargo also strips the
#   standard library's. No global RUSTFLAGS: it replaces a project's own
#   .cargo/config flags, and rust's and firefox's builds depend on those.
# - GOFLAGS: -trimpath takes the build paths out of the binary, and
#   -buildvcs=false stops go asking git, which the chroot does not have. A
#   recipe that sets GOFLAGS itself keeps both in it.
# - CGO_*FLAGS: without them cgo compiles C with Go's own "-O2 -g", with
#   neither the prefix map nor the hardening above. GOAMD64 stays unset: v1.
export CMAKE_BUILD_TYPE=Release
export CARGO_PROFILE_RELEASE_DEBUG=0
export GOFLAGS="-trimpath -buildvcs=false"
export CGO_CFLAGS="$CFLAGS" CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"

# NINJA TAKES KDOS_JOBS through script/bin/ninja, which is put first on PATH
# here: it adds -j"$KDOS_JOBS" to any ninja call that names no job count and
# runs /usr/bin/ninja. The directory is resolved to an absolute path because
# a phase.env is sourced by a relative one and kpkg runs build.sh from the
# source directory. It goes on only once /usr/bin/ninja exists (30_foundation
# installs it): before that, a wrapper on PATH would answer `command -v ninja`
# for a ninja that is not there, and meson or a recipe's own probe would pick
# a generator that cannot run. Each step sources this afresh, so every step
# after ninja's install has it. The host phases source host.env and never
# see it.
if [ -x /usr/bin/ninja ]; then
    _kdos_bin=$(cd "${BASH_SOURCE[0]%/*}/../bin" && pwd -P) &&
        export PATH="$_kdos_bin:$PATH"
    unset _kdos_bin
fi

# THE COMPILER CACHE, for CMake projects only, through CMake's launcher
# variables: CMake reads CMAKE_<LANG>_COMPILER_LAUNCHER from the environment
# and still records /usr/bin/gcc as the compiler. It stays off until the ccache
# port is installed (30_foundation) and when KDOS_CCACHE=0. The cache lives in
# build/ccache, outside build/fs, and a hit is byte-identical to a compile:
# - NO CCACHE_BASEDIR. It rewrites the absolute paths in the command line to
#   relative ones, so -ffile-prefix-map stops matching them and the paths in
#   the objects, and the package bytes, change.
# - COMPILERCHECK IS A STRING, NEVER mtime. kpkg pins every file's mtime to
#   SOURCE_DATE_EPOCH, so a rebuilt gcc of the same size would look unchanged
#   and serve objects its predecessor compiled. The string is every compiler
#   port's recipe hash, gcc's version and the epoch; any of them moving misses
#   the whole cache.
# - NO MASQUERADE DIRECTORY ON PATH. CMake would record /usr/lib/ccache/gcc as
#   the compiler, and that path is written into shipped CMake and pkg-config
#   files.
# - CCACHE_DISABLE=1 when off, because meson and several projects use ccache
#   whenever they find it, and would fill /root/.cache/ccache inside build/fs.
if [ "${KDOS_CCACHE:-1}" = 1 ] && [ -x /usr/bin/ccache ]; then
    _cc_check=
    for _cc_port in gcc binutils llvm clang llvm21 clang21; do
        [ -r "/var/lib/kpkg/db/.recipe/$_cc_port" ] || continue
        while IFS= read -r _cc_line || [ -n "$_cc_line" ]; do
            _cc_check+="$_cc_port:$_cc_line;"
        done < "/var/lib/kpkg/db/.recipe/$_cc_port"
    done
    _cc_check+="gcc:$(gcc -dumpfullversion 2>/dev/null);epoch:$SOURCE_DATE_EPOCH"
    export CCACHE_DIR=/kdos/build/ccache
    export CCACHE_MAXSIZE=20G
    export CCACHE_COMPILERCHECK="string:$_cc_check"
    export CMAKE_C_COMPILER_LAUNCHER=ccache
    export CMAKE_CXX_COMPILER_LAUNCHER=ccache
    unset _cc_check _cc_port _cc_line
else
    export CCACHE_DISABLE=1
fi

# Autoconf's C++11 probe assigns a u8"" literal to a const char *, which GCC's
# default of C++20 rejects, so every autoconf configure would add -std=gnu++11
# to CXX and C++17 code (every Qt 6 program) would stop compiling. Set and
# empty, the cache variable records that no option is needed, and the compiler
# keeps its own default.
export ac_cv_prog_cxx_cxx11=

export TERM=dumb

# The manual index is not rebuilt per install inside the build: 70_image's
# 080_whatis.sh writes every mandoc.db from scratch over the finished tree,
# so each install's merge is thrown away. kpkg prints `index skipped: man`
# where it would have run. Every other index still runs on every install.
export KPKG_SKIP_INDEX=man

# The ports every package store key depends on whether or not a recipe names
# them: the toolchain and the base userland every build runs on. A change to
# any one of them misses every stored package.
export KPKG_STORE_BASE="musl gcc binutils make bash toybox coreutils sed gawk findutils diffutils patch tar xz gzip bzip2 file pkgconf m4 zlib"
