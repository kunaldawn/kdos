# Environment of the bootstrap phase.

# --- build-system metadata ---
# The orchestrator parses these from this file's own text and follows no
# `source`, so they stay here rather than in a shared file.
export KDOS_PHASE_TITLE="Base Userland"
export KDOS_PHASE_DESC="musl, toybox, bash, native gcc, kpkg, kinstall"
export KDOS_SNAPSHOT_PATHS="cross fs mark"
export KDOS_SNAPSHOT_EXCLUDE="fs/tmp/* fs/dev/* fs/proc/* fs/sys/* fs/run/* fs/kdos/* fs/ports/*"

source "${BASH_SOURCE[0]%/*}/../../env/host.env"

# A step whose mark exists here is skipped; KDOS_REPLAY=1 overrides that.
export MARK=$BUILD_DIR/mark/bootstrap
mkdir -p $MARK
