# Environment of the kernel phase.

# --- build-system metadata ---
# The orchestrator parses these from this file's own text and follows no
# `source`, so they stay here rather than in a shared file.
export KDOS_PHASE_TITLE="Kernel"
export KDOS_PHASE_DESC="linux kernel + modules for the target rootfs"
# No snapshot: this phase is re-run on the tree it finds, never restored.
export KDOS_SNAPSHOT_PATHS=""

export CHROOT=1
export PORT_REPO="/ports/core /kdos/src/system /kdos/src/art"

source "${BASH_SOURCE[0]%/*}/../../env/chroot.env"
