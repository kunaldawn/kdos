#!/bin/bash

# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------

# Environment of the image phase.

# --- build-system metadata ---
# The orchestrator parses these from this file's own text and follows no
# `source`, so they stay here rather than in a shared file.
export KDOS_PHASE_TITLE="Image"
export KDOS_PHASE_DESC="trim rootfs, build initramfs, assemble the ISO"
export KDOS_SNAPSHOT_PATHS="fs iso_root iso-build initramfs initramfs.cpio.gz"
export KDOS_SNAPSHOT_EXCLUDE="fs/tmp/* fs/var/cache/kpkg/work/* fs/dev/* fs/proc/* fs/sys/* fs/run/* fs/kdos/* fs/ports/* fs/home/kdos/.local/share/containers/*"

export CHROOT=1

# ── the accent the medium ships in ────────────────────────────────────────
#
# THE NAME IS SPELLED ONCE FOR THE SHELL AND CHECKED AGAINST THE COMPILED ONE.
# libkcolor's `KCOL_DEFAULT_ID` is what every C consumer falls back to and a
# shell script cannot read it, so `050_theme.sh` proves the two agree rather
# than trusting this line — a build whose seeded theme differs from the one an
# unconfigured program picks is a desktop that changes colour on first login.
export KDOS_ACCENT=bone

source "${BASH_SOURCE[0]%/*}/../../env/chroot.env"

# This phase builds no port: it takes no pkg-config search path and no answered
# C++ probe, so a tool it runs sees the chroot's own defaults.
unset PKG_CONFIG_PATH ac_cv_prog_cxx_cxx11
