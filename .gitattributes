*.tar.gz filter=lfs diff=lfs merge=lfs -text
ports/appbox/image/**/*.zst filter=lfs diff=lfs merge=lfs -text
*.tar.xz filter=lfs diff=lfs merge=lfs -text
*.tar.bz2 filter=lfs diff=lfs merge=lfs -text
*.tar.zst filter=lfs diff=lfs merge=lfs -text
*.tgz filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
src/packages/kdos-cursors/art/** filter=lfs diff=lfs merge=lfs -text
# The icon atlas: one binary object generated by genatlas.py on the host, the
# same shape as the cursors' art. Diffing it means nothing; carrying its
# history inline would mean carrying megabytes per regeneration.
src/packages/kdos-icons/atlas/** filter=lfs diff=lfs merge=lfs -text

# A pack is an EROFS image with a footer on the end — tens to hundreds of
# megabytes of already-compressed filesystem, and a rebake rewrites the whole
# file. Deltas are the same shape. Neither is diffable and neither belongs in a
# git object.
*.kpack filter=lfs diff=lfs merge=lfs -text
*.kdelta filter=lfs diff=lfs merge=lfs -text
