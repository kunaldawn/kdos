# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   testing/Dockerfile.qemu — the rig image, `kdos-qemu-py`
#
# What testing/vnc-shot.py needs and nothing else: a QEMU that can take
# /dev/kvm, the OVMF firmware an EFI boot needs, and python3. The harness
# speaks RFB by hand out of the standard library, so there is no pip step and
# no wheel to pin — the only versions that matter are QEMU's and OVMF's, and
# they come from the distribution.
#
# Built by testing/rig-image.sh, which is also what CLAUDE.md's `$R` line
# assumes has been run. Keeping the definition here is what makes a rig
# photograph reproducible from a clone rather than from one machine's history.

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        qemu-system-x86 \
        qemu-utils \
        ovmf \
        python3 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# vnc-shot.py looks for OVMF.fd under three spellings. Debian's `ovmf` package
# puts the split firmware — OVMF_CODE_4M.fd and its VARS — under
# /usr/share/OVMF, and the single combined image under /usr/share/**ovmf**,
# lowercase, which is the first of the three the probe tries. The uppercase
# directory holds no plain OVMF.fd at all.
#
# `qemu-utils` IS `qemu-img`, and it is here because the Makefile creates the
# qcow2 that testing/install-to-disk.sh writes into. `qemu-system-x86` does not
# carry it, so without this the rig can boot the ISO and can never install
# from it — which is the whole of the Wave 10 gate.
WORKDIR /kdos
CMD ["python3", "testing/vnc-shot.py", "--help"]
