# Compile-on-demand wrapper for kdos-portup, the shape ports/srclib.sh's
# src_kpkg_ensure uses for the on-demand kpkg reader: build once into a gitignored path,
# rebuild when any source it compiles — its own or a library's — is newer than
# the binary, then exec straight through. The libraries count: libkpkg decides
# where a port lives, and a binary built against a stale libkpkg walks the tree
# by a rule it does not follow, finds no port and reports nothing to update.
# kdos-portup's own find_repo_root() walks two directories up from
# /proc/self/exe, so this binary has to live at exactly <repo_root>/ports/.portup
# for that to resolve — unlike ports/.kpkg-meta's reader, the binary's own
# NAME does not matter to any dispatcher here.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
BIN="$SCRIPT_DIR/.portup"
SRC="$REPO_ROOT/src/devtools/kdos-portup"
LIBS="$REPO_ROOT/src/libs"

if [ ! -x "$BIN" ] || [ -n "$(find "$SRC" "$LIBS/libkbase" "$LIBS/libkpkg" "$LIBS/libkbuild" \
        -newer "$BIN" -name '*.[ch]' 2>/dev/null)" ]; then
    echo "==> Building the port updater..." >&2
    cc -O2 -std=gnu11 -D_GNU_SOURCE -Wall -Wextra -Werror \
       -I"$LIBS/libkbase" -I"$LIBS/libkpkg" -I"$LIBS/libkbuild" -I"$SRC" \
       -o "$BIN" "$SRC"/*.c "$LIBS"/libkbase/*.c "$LIBS"/libkpkg/*.c \
       "$LIBS"/libkbuild/*.c
fi
exec "$BIN" "$@"
