#!/bin/bash

# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   ports/publish — put every source a recipe names into the archive
# ---------------------------------
#
#   ports/publish [--dry-run | --check] [--history] [port…]
#   ports/publish --plan [--dry-run]
#   ports/publish --describe [--dry-run]
#   ports/publish --rehome [--dry-run] [port…]
#   ports/publish --retire [--dry-run]
#   ports/publish --orphans [--prune=yes-delete]
#   ports/publish --freeze <kdos-tag> [--dry-run | --check]
#   ports/publish --release <kdos-tag> [--iso <path>] [--key <path> | --unsigned]
#                 [--publish] [--dry-run]
#
# THE ARCHIVE is a run of numbered volumes on $KDOS_SOURCES_REPO, GitHub
# pre-releases tagged sources-1, sources-2, …; ports/shelves gives each shelf
# its volume. Its addressing is ports/srclib.sh's, and ports/sources.idx says
# where each file is. A file's identity is never its name: every file is the
# bytes of a recipe's `sha256 =`.
#
# THE WANTED SET is every `sha256 =` file named by a recipe under ports/core
# (or by the named ports) that git does not carry. --history adds every Git
# LFS object under ports/core that any ref's history names and the local LFS
# store or the cache holds; it seeds the archive with what old commits'
# recipes point at. Objects this clone never downloaded are counted and
# skipped, not failed; without git-lfs no object can be labelled, so none is
# uploaded.
#
# THE BYTES come from the port directory, the cache (ports/.srccache) or the
# LFS store, and are hashed again immediately before each upload: an asset
# whose bytes are not the hash its index line names poisons every checkout
# that asks for it.
#
# WHERE A NEW FILE GOES. Recipes are walked shelf by shelf, port by port, in
# C-locale order; a hash belongs to the shelf of the first port that names it,
# takes its label <port>/<file> from that port, and goes to that shelf's
# volume. A file no current recipe names (--history) is shelved as `attic` and
# goes to the highest volume. A volume holds at most $SRC_RELEASE_CAP assets,
# parts counted: a file its volume has no room for goes to the lowest-numbered
# volume with room, or else opens the next volume, and the run prints a
# `spilled` line. A file the index names in a volume but GitHub lacks goes
# back to the volume and asset name its line records; one whose line names a
# legacy src-<name> release is placed afresh.
#
# ITS NAME is <shelf>--<file> as GitHub will store it (every character
# outside [A-Za-z0-9._-] becomes `.`). When that name is taken in the volume —
# by another hash's index line, or by an asset of other bytes — the next of
# <shelf>--<port>--<file> and <shelf>--<port>--<hash12>--<file> is tried. The
# upload carries the label <port>/<file>, which the release page shows. The
# index records the name GitHub RETURNED, never the one asked for.
#
# A FILE LARGER THAN $SRC_PART_SIZE is split, under $KDOS_SRCCACHE/.parts/,
# into parts of that size, uploaded as <asset>.part01 … <asset>.partNN; its
# index line carries every part's hash and is written only after every part
# is stored with a verified digest. A run that stops leaves the parts it
# stored, and the next run adopts them.
#
# PRESENCE means ports/sources.idx names the hash AND an anonymous HEAD on the
# asset's download URL (on every part's) answers 200; a HEAD costs no API
# quota. A hash the index does not name is unpublished without asking. A 404
# is absence; any other status or a network failure stops the run, since it
# proves nothing.
#
# THE INDEX is rewritten, sorted and checked against the format-2 rules after
# each verified upload, so a run that dies keeps every line it earned. THE
# INDEX MUST BE COMMITTED — fetch and the pre-push hook read it from the tree,
# and an upload no committed line names is invisible.
#
# RELEASE NOTES. Every archive release a run touches has its notes rewritten
# from the index, and a volume its title too: `Sources N: <first shelf> …
# <last shelf>` over the shelves ports/shelves maps to it. The notes hold one
# section per shelf — its name and description from ports/shelves — and under
# it a table of port, version, file (linked to its asset or parts), size and
# SHA-256.
#
#   --check     presence only: print what is missing, exit 1 if anything is
#   --dry-run   print each upload's volume, predicted asset name, parts and
#               size; makes no network call and needs no token, and takes
#               every indexed file as present and the index's own count of
#               each volume as its assets
#   --plan      give every shelf ports/shelves lists without a volume one:
#               those shelves, in C order, join the highest volume while its
#               planned file count (each recipe hash its shelf owns, parts
#               counted) stays within $KDOS_VOLUME_FILL (default 650), and
#               then open new volumes. A shelf that has a volume keeps it. It
#               rewrites ports/shelves and reads no network; with --dry-run
#               it only prints the plan
#   --describe  rewrite the title and notes of every release the index
#               names; upload nothing
#   --rehome    move each archived file that is not at home into its home:
#               its shelf's volume under its <shelf>-- name. A file in a
#               legacy src-<name> release always moves (one no current recipe
#               names goes to the highest volume as attic--<file>); a file
#               that spilled into another volume moves only when its own has
#               room. Then delete old copies the pushed index no longer names
#   --retire    delete every legacy src-<name> release that holds no asset,
#               and its tag; refuse, and list, any that still holds assets.
#               A src-<name> tag left without a release is deleted too.
#               Volumes and v* releases are never touched. With --dry-run it
#               reads the archive and deletes nothing
#   --orphans   list index lines no current recipe names, with no network;
#               --prune=yes-delete deletes the unprotected ones
#   --freeze    write build/freeze/sources-<tag>.sha256 for ports/core at
#               <tag>, require every hash in it to be archived, and attach it
#               as `sources.sha256` to release <tag> on $KDOS_REPO, creating a
#               DRAFT release when none exists. The list is a readable roll-call
#               of what the tag needs; the tag's own recipes are what pin the
#               hashes, since git cannot rewrite them without changing the tag.
#   --release   put the system release <tag> on $KDOS_REPO: the tag must be on
#               origin at the same commit and every source it names archived.
#               It uploads the ISO (--iso, default build/iso-build/kdos.iso) as
#               kdos-<tag>.iso, or in parts kdos-<tag>.iso.partNN when it is
#               larger than $SRC_PART_SIZE bytes; sources.sha256; a SHA256SUMS over
#               the whole ISO, each part and the rest; SHA256SUMS.sig, signed by
#               `kpkg sign` with --key, $KDOS_RELEASE_KEY or
#               build/keys/kdos-release.key; and that key's kdos-release.pub.
#               --unsigned leaves the last two out. The files are written to
#               build/release/<tag>/ (the parts are removed when the run ends).
#               The release is a DRAFT until --publish makes it public and
#               Latest, which is then confirmed by an anonymous query. Assets
#               are append-only here too: a same-name asset with other bytes
#               stops the run with exit 2. --dry-run prints the plan with no
#               network and no token.
#
# EXIT: 0 everything is archived, 1 something is missing or failed, 2 a name
# or asset holds bytes other than the ones asked for and could not be
# resolved.
#
# THE TOKEN is $KDOS_SOURCES_TOKEN or ~/.config/kdos/sources-token, which is
# refused when its group or others can read it. It reaches curl only through
# a mode-600 header file (`-H @file`), never an argument, so no process list
# shows it, and it is removed from the environment before any child starts.
#
# PACING. GitHub throttles content creation separately from its hourly quota:
# at least $KDOS_PUBLISH_DELAY (default 8) seconds pass between creating,
# changing and deleting calls, which holds a long run under 75 per minute and
# 480 per hour. A 403 or 429 carrying retry-after or x-ratelimit-reset waits
# and retries; a bare 429, or a 403 naming a secondary rate limit, waits 60
# seconds. An upload meeting a 5xx or a dropped connection is retried twice. A
# run that stops is resumed by running it again: presence is checked first,
# and an asset already holding the right bytes is adopted, not sent again.
#
# DELETION. The archive is append-only. An asset is deleted only when it is an
# upload GitHub never completed (`starter`); when it sits at a name the index
# gives this hash, or was just uploaded by this run, and holds other bytes
# (corrupt: deleted and uploaded once more); by --rehome, once the new copy is
# verified and the pushed index no longer names the old one; and by
# --prune=yes-delete. A release is deleted only by --retire, and only when it
# is a legacy src-<name> release holding no asset. An unknown digest is asked
# for again and then hashed from a download, and is never a reason to delete.
#
# KDOS_GITHUB_API and KDOS_GITHUB_UPLOADS replace the two GitHub endpoints,
# for running this against a local stand-in.

set -e

# Taken out of the environment before the first child process, and with any
# xtrace off: `bash -x ports/publish` would otherwise print it.
{ _xt=$-; set +x; } 2>/dev/null
SRC_TOK=${KDOS_SOURCES_TOKEN:-}
# Never exported, even when the caller's environment happens to export a
# SRC_TOK of its own: assigning to it would keep the export.
export -n SRC_TOK
unset KDOS_SOURCES_TOKEN
if [[ $_xt == *x* ]]; then set -x; fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=ports/srclib.sh
. "$SCRIPT_DIR/srclib.sh"
REPO_ROOT="$SRCLIB_ROOT"

GH_API="${KDOS_GITHUB_API:-https://api.github.com}"
GH_UPLOADS="${KDOS_GITHUB_UPLOADS:-https://uploads.github.com}"
KDOS_REPO="${KDOS_REPO:-kunaldawn/kdos}"
DELAY="${KDOS_PUBLISH_DELAY:-8}"
LFS_POINTER='^version https://git-lfs.github.com/spec/v1'

die() { echo "ports/publish: $*" >&2; exit 1; }

usage() {
    cat <<'EOF'
usage: ports/publish [--dry-run | --check] [--history] [port…]
       ports/publish --plan [--dry-run]
       ports/publish --describe [--dry-run]
       ports/publish --rehome [--dry-run] [port…]
       ports/publish --retire [--dry-run]
       ports/publish --orphans [--prune=yes-delete]
       ports/publish --freeze <kdos-tag> [--dry-run | --check]
       ports/publish --release <kdos-tag> [--iso <path>] [--key <path> | --unsigned]
                     [--publish] [--dry-run]
EOF
}

DRY=0 CHECK=0 HISTORY=0 DESCRIBE=0 FREEZE="" REHOME=0 ORPHANS=0 PRUNE="" PLAN=0 RETIRE=0
RELEASE="" ISO="" KEY="" UNSIGNED=0 PUBLISH=0
PORTS=()
while [ $# -gt 0 ]; do
    case $1 in
        --dry-run)  DRY=1 ;;
        --check)    CHECK=1 ;;
        --history)  HISTORY=1 ;;
        --describe) DESCRIBE=1 ;;
        --rehome)   REHOME=1 ;;
        --plan)     PLAN=1 ;;
        --retire)   RETIRE=1 ;;
        --orphans)  ORPHANS=1 ;;
        --prune=*)  PRUNE=${1#--prune=}; [ -n "$PRUNE" ] || PRUNE="(empty)" ;;
        --prune)    PRUNE="(none)" ;;
        --freeze)   [ -n "${2:-}" ] || die "--freeze needs a tag"
                    FREEZE=$2; shift ;;
        --release)  [ -n "${2:-}" ] || die "--release needs a tag"
                    RELEASE=$2; shift ;;
        --iso)      [ -n "${2:-}" ] || die "--iso needs a path"
                    ISO=$2; shift ;;
        --key)      [ -n "${2:-}" ] || die "--key needs a path"
                    KEY=$2; shift ;;
        --unsigned) UNSIGNED=1 ;;
        --publish)  PUBLISH=1 ;;
        -h|--help)  usage; exit 0 ;;
        -*)         die "unknown option $1" ;;
        *)          PORTS+=("$1") ;;
    esac
    shift
done

MODES=$(( DESCRIBE + REHOME + ORPHANS + PLAN + RETIRE + (${#FREEZE} > 0) + (${#RELEASE} > 0) ))
[ "$MODES" -le 1 ] || die "--plan, --describe, --rehome, --retire, --orphans, --freeze and --release are one per run"
[ "$DRY" = 0 ] || [ "$CHECK" = 0 ] || die "--dry-run and --check are one per run"
if [ -n "$PRUNE" ]; then
    [ "$ORPHANS" = 1 ] || die "--prune works only with --orphans"
    [ "$PRUNE" = yes-delete ] || die "--prune=$PRUNE: deleting orphans takes exactly --prune=yes-delete"
fi
if [ -z "$RELEASE" ] && { [ -n "$ISO$KEY" ] || [ "$UNSIGNED" = 1 ] || [ "$PUBLISH" = 1 ]; }; then
    die "--iso, --key, --unsigned and --publish go with --release"
fi
[ -z "$KEY" ] || [ "$UNSIGNED" = 0 ] || die "--key and --unsigned contradict each other"
[ "$CHECK" = 0 ] || [ "$MODES" = 0 ] || [ -n "$FREEZE" ] || die "--check works alone or with --freeze"
[ "$HISTORY" = 0 ] || [ "$MODES" = 0 ] || die "--history works only in a plain run"
[ "${#PORTS[@]}" = 0 ] || [ "$MODES" = 0 ] || [ "$REHOME" = 1 ] ||
    die "ports can be named only in a plain run or with --rehome"
[ "$ORPHANS" = 0 ] || [ "$DRY" = 0 ] || die "--orphans alone makes no network call; it takes no --dry-run"

# Listing orphans and planning volumes read only the tree; everything else
# reads or writes the published archive, which a directory base could not
# confirm.
if { [ "$ORPHANS" = 0 ] || [ -n "$PRUNE" ]; } && [ "$PLAN" = 0 ]; then
    [ -n "$KDOS_SOURCES_BASE" ] || die "KDOS_SOURCES_BASE is empty; there is no archive to publish to"
    src_base_local && die "KDOS_SOURCES_BASE is a local directory; publish checks the published archive"
fi

GIT_DIR_ABS=$(git -C "$REPO_ROOT" rev-parse --absolute-git-dir) || die "not a git checkout"
KDOS_LFS_STORE="${KDOS_LFS_STORE:-$GIT_DIR_ABS/lfs/objects}"

TMP=$(mktemp -d "${TMPDIR:-/tmp}/kdos-publish.XXXXXX")
chmod 700 "$TMP"
# Split files are staged beside the cache, never in $TMP: a part is up to
# $SRC_PART_SIZE bytes, and a small tmpfs cannot hold one.
STAGED=()
cleanup() {
    local d
    for d in "${STAGED[@]}"; do rm -rf "$d"; done
    rm -rf "$TMP"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

RC=0
fail()     { echo "  FAILED   $*" >&2; [ "$RC" = 2 ] || RC=1; }
conflict() { echo "  CONFLICT $*" >&2; RC=2; }
human()    { numfmt --to=iec --suffix=B "$1"; }

# ── what git carries ──────────────────────────────────────────────────────
#
# A path git tracks is not archived — unless the tracked blob is a Git LFS
# pointer, which is 130 bytes of text naming the file, not the file. A commit
# that stores its archives as LFS objects tracks every one of them that way,
# so a check that treats "tracked" as "carried" would find nothing to archive
# in exactly the commits --history and --freeze exist for.
declare -A CARRIED
load_carried() {  # <commit>, or nothing for the index
    local p
    declare -A ptr=()
    CARRIED=()
    if [ -n "${1:-}" ]; then
        while IFS= read -r -d '' p; do ptr[${p#"$1":}]=1; done < <(
            git -C "$REPO_ROOT" grep -l -z -I -e "$LFS_POINTER" "$1" -- ports/core || true)
        while IFS= read -r -d '' p; do [ -n "${ptr[$p]:-}" ] || CARRIED[$p]=1; done < <(
            git -C "$REPO_ROOT" ls-tree -r -z --name-only "$1" -- ports/core)
    else
        while IFS= read -r -d '' p; do ptr[$p]=1; done < <(
            git -C "$REPO_ROOT" grep -l -z -I --cached -e "$LFS_POINTER" -- ports/core || true)
        while IFS= read -r -d '' p; do [ -n "${ptr[$p]:-}" ] || CARRIED[$p]=1; done < <(
            git -C "$REPO_ROOT" ls-files -z -- ports/core)
    fi
}

# ── the recipes ───────────────────────────────────────────────────────────
#
# recipe_lines <dir holding ports/core> — "<hash> <shelf> <port> <version>
# <file>" for every uncarried `sha256 =` file, in walk order: shelves, then
# ports, both in C-locale order, which is what makes "the first port that
# names a hash" the same on every machine. A port with no shelf gives the
# shelf `-`, a recipe with no version the version `-`. CARRIED is keyed by
# the real path, shelf included, and must be loaded. An unreadable recipe is
# reported through $TMP/badport, since a caller may run this in a subshell.
badport() { echo "  FAILED   $*" >&2; : > "$TMP/badport"; }
recipe_lines() {
    local LC_ALL=C core=$1/ports/core d port shelf rel meta ver sums i
    local -a tok
    while IFS= read -r d; do
        port=${d##*/}
        rel=ports/core/${d#"$core"/}
        shelf=${d%/*}; shelf=${shelf##*/}
        [ "${d%/*}" != "$core" ] || shelf=-
        meta=$(cd "$d" && "$KPKG" meta . 2>/dev/null) || { badport "$port: kpkg cannot read its recipe"; continue; }
        { IFS= read -r ver; IFS= read -r sums; } < <(
            unset version sha256; eval "$meta"; printf '%s\n%s\n' "${version:-}" "${sha256:-}")
        read -ra tok <<< "$sums"
        for ((i = 0; i + 1 < ${#tok[@]}; i += 2)); do
            [ -n "${CARRIED[$rel/${tok[i+1]}]:-}" ] && continue
            printf '%s %s %s %s %s\n' "${tok[i]}" "$shelf" "$port" "${ver:--}" "${tok[i+1]}"
        done
    done < <(src_port_dirs "$core")
}

# read_recipes — the working tree's recipes, into
#
#   R_ORDER       every named hash, in walk order
#   R_LABEL[h]    <port>/<file> from the first port naming h
#   R_SHELF[h]    that port's shelf: the owner of h
#   R_SHELVES[h]  " s1 s2 … ": every shelf a port naming h sits on
#   R_PORTS[h]    " p1 p2 … ": every port naming h
#   R_VER[port]   the port's version
R_ORDER=()
declare -A R_LABEL=() R_SHELF=() R_SHELVES=() R_PORTS=() R_VER=()
read_recipes() {
    local h shelf port ver file
    src_kpkg_ensure || die "cannot build the recipe reader"
    load_carried
    while read -r h shelf port ver file; do
        src_is_hash "$h" || continue
        R_VER[$port]=$ver
        if [ -z "${R_LABEL[$h]:-}" ]; then
            R_ORDER+=("$h")
            R_LABEL[$h]=$port/$file
            R_SHELF[$h]=$shelf
        fi
        case ${R_SHELVES[$h]:- } in *" $shelf "*) ;; *) R_SHELVES[$h]="${R_SHELVES[$h]:- }$shelf " ;; esac
        R_PORTS[$h]="${R_PORTS[$h]:- }$port "
    done < <(recipe_lines "$REPO_ROOT")
    return 0
}

# ── volumes ───────────────────────────────────────────────────────────────
#
# VOL[shelf] is the volume ports/shelves gives the shelf. IDX_N[tag] is how
# many assets the index places in release <tag>, parts counted one by one; a
# dry run takes it for the release's own count, and every index write keeps
# it current.
VOLUME_FILL=${KDOS_VOLUME_FILL:-650}
declare -A VOL=() IDX_N=()
load_volumes() {
    local s v
    VOL=()
    while read -r s v; do VOL[$s]=$v; done < <(src_shelf_volumes)
    return 0
}
idx_count_load() {
    local h
    IDX_N=()
    for h in "${!SRC_TAG[@]}"; do
        IDX_N[${SRC_TAG[$h]}]=$(( ${IDX_N[${SRC_TAG[$h]}]:-0} + SRC_NPARTS[$h] ))
    done
    return 0
}

# top_volume — the highest volume ports/shelves maps or the index names, 0
# when neither names one. A volume a full one spilled into is mapped to no
# shelf and still counts.
top_volume() {
    local t=0 v k
    for v in "${VOL[@]}"; do [ "$v" -le "$t" ] || t=$v; done
    for k in "${!IDX_N[@]}"; do
        [[ $k =~ ^sources-([1-9][0-9]*)$ ]] || continue
        [ "${BASH_REMATCH[1]}" -le "$t" ] || t=${BASH_REMATCH[1]}
    done
    echo "$t"
}

# home_tag <shelf> — the volume a file of <shelf> belongs in; for `attic`,
# the highest volume. Fails for a shelf with no volume.
home_tag() {
    local v
    if [ "$1" = attic ]; then
        v=$(top_volume)
        [ "$v" -gt 0 ] || v=1
    else
        v=${VOL[$1]:-}
        [ -n "$v" ] || return 1
    fi
    src_volume_tag "$v"
}

# cand_tags <shelf> [home] — the volumes a new file of <shelf> may go to, in
# the order they are tried: its home, every other volume from 1 up, then the
# next volume, which does not exist yet. With `home`, its home only.
cand_tags() {
    local home t i
    home=$(home_tag "$1") || return 1
    printf '%s\n' "$home"
    [ "${2:-}" != home ] || return 0
    t=$(top_volume)
    for ((i = 1; i <= t + 1; i++)); do
        [ "sources-$i" = "$home" ] || src_volume_tag "$i"
    done
}

# placement <hash> — set PL to where the index puts an archived file, and
# PL_SHELF to the shelf whose name it carries:
#
#   home     the volume of a shelf whose port names it, under <shelf>--
#   spilled  another volume, under the <shelf>-- of a shelf naming it
#   attic    a volume, when no current recipe names it: it stays where it is
#   (empty)  anything else — a legacy src-<name> release, or a name no
#            current shelf of its ports gives it
#
# A hash two shelves name is at home under either, so --rehome never moves
# it back and forth.
PL="" PL_SHELF=""
placement() {
    local h=$1 tag=${SRC_TAG[$1]:-} asset=${SRC_ASSET[$1]:-} s
    PL="" PL_SHELF=""
    [[ $tag =~ ^sources-[1-9][0-9]*$ ]] || return 0
    if [ -z "${R_LABEL[$h]:-}" ]; then PL=attic; return 0; fi
    for s in ${R_SHELVES[$h]:-}; do
        [[ $asset == "$s--"* ]] || continue
        if [ -n "${VOL[$s]:-}" ] && [ "$tag" = "sources-${VOL[$s]}" ]; then
            PL=home PL_SHELF=$s
            return 0
        fi
    done
    for s in ${R_SHELVES[$h]:-}; do
        [[ $asset == "$s--"* ]] || continue
        [ -n "${VOL[$s]:-}" ] || continue
        PL=spilled PL_SHELF=$s
        return 0
    done
    return 0
}

# volume_shelves <N> — the shelves ports/shelves maps to volume <N>, in C
# order.
volume_shelves() {
    local s
    for s in "${!VOL[@]}"; do [ "${VOL[$s]}" != "$1" ] || echo "$s"; done | LC_ALL=C sort
}

# release_title <tag> — "Sources N: <first shelf> … <last shelf>" for a
# volume; a legacy release keeps the title it was created with, so this is
# only asked for volumes.
release_title() {
    local v first last
    local -a sh
    v=$(src_tag_volume "$1") || return 1
    mapfile -t sh < <(volume_shelves "$v")
    case ${#sh[@]} in
        0) echo "Sources $v" ;;
        1) echo "Sources $v: ${sh[0]}" ;;
        *) first=${sh[0]} last=${sh[${#sh[@]}-1]}
           echo "Sources $v: $first … $last" ;;
    esac
}

# named_ports <port…> — fill NAMED[port] for each port that exists; an
# unknown one fails the run.
declare -A NAMED=()
named_ports() {
    local p
    for p in "$@"; do
        src_port_dir "$REPO_ROOT/ports/core" "$p" >/dev/null || { fail "$p: no such port"; continue; }
        NAMED[$p]=1
    done
    return 0
}

# names_named <hash> — true when a port NAMED holds names the hash.
names_named() {
    local p
    for p in ${R_PORTS[$1]:-}; do [ -z "${NAMED[$p]:-}" ] || return 0; done
    return 1
}

# ── the wanted set ────────────────────────────────────────────────────────
W_HASH=() W_LABEL=()
declare -A SEEN=() W_SHELF=()
want() {  # <hash> <label> <shelf>
    src_is_hash "$1" || return 0
    [ -z "${SEEN[$1]:-}" ] || return 0
    SEEN[$1]=1
    W_HASH+=("$1"); W_LABEL+=("$2"); W_SHELF[$1]=$3
}

# ── local bytes ───────────────────────────────────────────────────────────

# find_bytes <hash> <label> — a local file holding exactly those bytes. The
# label's port is found by name, on whatever shelf it sits.
find_bytes() {
    local c d=""
    d=$(src_port_dir "$REPO_ROOT/ports/core" "${2%%/*}" 2>/dev/null) && d=$d/${2#*/}
    for c in ${d:+"$d"} "$(src_cache_path "$1")" \
             "$KDOS_LFS_STORE/${1:0:2}/${1:2:2}/$1"; do
        if src_hash_ok "$c" "$1"; then printf '%s\n' "$c"; return 0; fi
    done
    return 1
}

# local_size <hash> <label> — the size of a local copy, unverified, or
# nothing. Release notes want a size, not a proof, and hashing every file of
# a release to print one would take minutes.
local_size() {
    local c d=""
    d=$(src_port_dir "$REPO_ROOT/ports/core" "${2%%/*}" 2>/dev/null) && d=$d/${2#*/}
    for c in "$(src_cache_path "$1")" ${d:+"$d"}; do
        [ -s "$c" ] && { stat -c %s "$c"; return 0; }
    done
    return 0
}

# fetch_archived <hash> — download the archive's copy of an indexed file
# anonymously, part by part, join and verify it, enter it into the cache and
# print the cache path. --rehome uses it when no local copy exists.
fetch_archived() {
    local h=$1 dir i n p
    local -a urls
    mapfile -t urls < <(src_urls "$h")
    n=${#urls[@]}
    [ "$n" -gt 0 ] || return 1
    dir="$KDOS_SRCCACHE/.parts/$h"
    rm -rf "$dir"; mkdir -p "$dir"
    STAGED+=("$dir")
    for ((i = 1; i <= n; i++)); do
        printf -v p '%s/%02d' "$dir" "$i"
        curl -sSfL --connect-timeout 20 --retry 2 -o "$p" "${urls[i-1]}" || { rm -rf "$dir"; return 1; }
        if [ "$n" -ge 2 ] && ! src_hash_ok "$p" "${SRC_PHASH[$h,$i]}"; then
            rm -rf "$dir"; return 1
        fi
    done
    for ((i = 1; i <= n; i++)); do printf -v p '%s/%02d' "$dir" "$i"; cat "$p"; done > "$dir/whole"
    src_hash_ok "$dir/whole" "$h" || { rm -rf "$dir"; return 1; }
    src_cache_put "$dir/whole" "$h"
    rm -rf "$dir"
    src_hash_ok "$(src_cache_path "$h")" "$h" || return 1
    src_cache_path "$h"
}

# ── presence ──────────────────────────────────────────────────────────────
#
# Only a 404 is evidence of absence. GitHub's download host answers a few of
# thousands of HEADs with a 5xx or a dropped connection, so such an answer is
# asked again, after 10, 30 and 60 seconds; one that persists (an outage, a
# 403) says the archive cannot answer, and publish stops, naming the URL,
# rather than report archived files missing or upload blind. A file in parts
# is present only when every part is.
present() {
    local rc code url wait
    local -a urls
    mapfile -t urls < <(src_urls "$1")
    [ "${#urls[@]}" -gt 0 ] || return 1
    for url in "${urls[@]}"; do
        for wait in 10 30 60 0; do
            rc=0
            code=$(curl -sIL -o /dev/null -w '%{http_code}' --connect-timeout 20 \
                        --max-time 120 --retry 2 "$url") || rc=$?
            [ "$rc" != 0 ] || [ "${code:0:1}" != 5 ] || rc=-1
            [ "$rc" != 0 ] && [ "$wait" != 0 ] || break
            sleep "$wait"
        done
        [ "$rc" -le 0 ] || die "cannot reach the archive for $url (curl exit $rc)"
        case $code in
            200) ;;
            404) return 1 ;;
            *)   die "archive unreachable for $url (HTTP $code)" ;;
        esac
    done
    return 0
}

# ── the API ───────────────────────────────────────────────────────────────
#
# Xtrace is off for the whole function: the token passes through variables,
# a test and a printf, and a trace would print it at each.
load_token() {
    { local xt=$-; set +x; } 2>/dev/null
    local tok="$SRC_TOK" f="$HOME/.config/kdos/sources-token" mode
    SRC_TOK=""
    if [ -z "$tok" ]; then
        [ -f "$f" ] || die "no token: set KDOS_SOURCES_TOKEN or write $f (mode 600)"
        mode=$(stat -c %a "$f")
        (( 8#$mode & 8#077 )) && die "refusing $f: mode $mode lets others read it (chmod 600 it)"
        tok=$(< "$f")
    fi
    tok=${tok//[$'\r\n\t ']/}
    [ -n "$tok" ] || die "the token is empty"
    ( umask 077; printf 'Authorization: Bearer %s\n' "$tok" > "$TMP/auth" )
    tok=""
    if [[ $xt == *x* ]]; then set -x; fi
}

# json_str <key> — the first string value of <key> in $TMP/body.
json_str() {
    grep -o "\"$1\": *\"[^\"]*\"" "$TMP/body" | head -1 | sed 's/.*: *"//; s/"$//'
}

# json_text <file> — the file's text as one JSON string, quotes included.
json_text() {
    awk 'BEGIN { ORS = ""; print "\"" }
         { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, ""); print $0 "\\n" }
         END { print "\"" }' "$1"
}

# release_from_body — the release id, taken from upload_url, the one field
# that names it and nothing nested.
release_from_body() {
    json_str upload_url | grep -o '/releases/[0-9]*/assets' | tr -dc 0-9
}

# retry_wait — seconds to wait before retrying a 403/429, empty for a 403
# that is a refusal rather than a throttle.
retry_wait() {
    local ra rem reset now
    ra=$(grep -i '^retry-after:' "$TMP/hdr" | tail -1 | tr -dc 0-9)
    [ -n "$ra" ] && { echo "$ra"; return; }
    rem=$(grep -i '^x-ratelimit-remaining:' "$TMP/hdr" | tail -1 | tr -dc 0-9)
    reset=$(grep -i '^x-ratelimit-reset:' "$TMP/hdr" | tail -1 | tr -dc 0-9)
    if [ "$rem" = 0 ] && [ -n "$reset" ]; then
        now=$(date +%s)
        echo $(( reset > now ? reset - now + 1 : 1 ))
        return
    fi
    # A secondary limit may carry neither header; GitHub asks for at least a
    # minute before the next try.
    if [ "$HTTP" = 429 ] || grep -qi 'secondary rate limit' "$TMP/body" 2>/dev/null; then
        echo 60
    fi
}

# gh <method> <url> [curl args…] — sets HTTP; body in $TMP/body.
HTTP=000
gh() {
    local method=$1 url=$2 tries=0 wait
    shift 2
    while :; do
        HTTP=$(curl -sS -X "$method" -H @"$TMP/auth" \
                    -H 'Accept: application/vnd.github+json' \
                    -H 'X-GitHub-Api-Version: 2022-11-28' -H 'Expect:' \
                    --connect-timeout 20 -D "$TMP/hdr" -o "$TMP/body" \
                    -w '%{http_code}' "$@" "$url") || HTTP=000
        case $HTTP in 403|429) ;; *) return 0 ;; esac
        wait=$(retry_wait)
        [ -n "$wait" ] && [ "$tries" -lt 6 ] || return 0
        echo "  throttled (HTTP $HTTP); waiting ${wait}s" >&2
        sleep "$wait"
        tries=$((tries + 1))
    done
}

# Microseconds, so the gap is never a second short of $DELAY. EPOCHREALTIME
# carries the locale's decimal separator (a comma under de_DE), so every
# non-digit is stripped, and 10# keeps a leading zero from reading as octal.
LAST_CREATE=0
usec_now() { local t=${EPOCHREALTIME//[!0-9]/}; echo $(( 10#$t )); }
pace() {
    local now w
    now=$(usec_now)
    w=$(( LAST_CREATE + DELAY * 1000000 - now ))
    if [ "$w" -gt 0 ]; then sleep "$(printf '%d.%06d' $((w / 1000000)) $((w % 1000000)))"; fi
    LAST_CREATE=$(usec_now)
}

# releases_list <repo> — "<id>␟<tag>" for every release, drafts included,
# which the by-tag lookup never returns. A release's own "url" ends in
# /releases/<id>, an asset's in /releases/assets/<id>, so only records that
# open with digits are releases.
releases_list() {
    local page=1
    while [ "$page" -le 50 ]; do
        gh GET "$GH_API/repos/$1/releases?per_page=100&page=$page"
        [ "$HTTP" = 200 ] || { echo "  listing releases on $1: HTTP $HTTP" >&2; return 1; }
        grep -q '"tag_name"' "$TMP/body" || break
        awk 'BEGIN { RS = "\"url\": *\"[^\"]*/releases/"; OFS = "\037" }
             /^[0-9]+"/ && match($0, /"tag_name": *"[^"]*"/) {
                 t = substr($0, RSTART, RLENGTH); sub(/^"tag_name": *"/, "", t); sub(/"$/, "", t)
                 id = $0; sub(/".*/, "", id); print id, t
             }' "$TMP/body"
        page=$((page + 1))
    done
    return 0
}

# release_intro <tag> — the paragraphs that open an archive release's notes.
release_intro() {
    local v
    if v=$(src_tag_volume "$1"); then
        echo "Volume $v of the KDOS source archive: the upstream sources of the ports on the shelves below,"
        echo "each file stored as <shelf>--<file>. A file no current recipe names is kept as attic--<file>."
    else
        echo "Upstream sources from the archive's older layout, one release per shelf. ports/publish --rehome"
        echo "moves each file into a numbered volume, sources-N, and this release is retired once it is empty."
    fi
    echo
    echo "This is an archive, not a KDOS release. ports/fetch finds each file through"
    echo "ports/sources.idx and checks its SHA-256 before use; a file in parts is joined"
    echo "in order and checked as a whole."
}

# archive_release <tag> [nocreate] — sets REL_ID to the id of archive release
# <tag>, creating it on 404 unless told not to; a 404 left alone sets
# REL_ABSENT. Only a volume is ever created. Every archive release is a
# pre-release that is never "latest", so the repository's latest release is
# always a KDOS system release; one found otherwise is changed to that. It
# runs in this shell, not a substitution, so the id cache and the pacing
# clock survive it.
declare -A RID=()
REL_ID="" REL_ABSENT=0
archive_release() {
    local tag=$1 id="" try title
    REL_ABSENT=0
    REL_ID=${RID[$tag]:-}
    [ -n "$REL_ID" ] && return 0
    for try in 1 2; do
        gh GET "$GH_API/repos/$KDOS_SOURCES_REPO/releases/tags/$tag"
        if [ "$HTTP" = 200 ]; then
            id=$(release_from_body)
            if [ -n "$id" ] && grep -Eq '"prerelease": *false' "$TMP/body"; then
                pace
                gh PATCH "$GH_API/repos/$KDOS_SOURCES_REPO/releases/$id" \
                    -H 'Content-Type: application/json' \
                    --data '{"prerelease":true,"make_latest":"false"}'
                [ "$HTTP" = 200 ] || { echo "  release $tag: marking it a pre-release: HTTP $HTTP" >&2; return 1; }
                echo "  release  $tag was a full release; it is now a pre-release" >&2
            fi
            break
        fi
        [ "$HTTP" = 404 ] || { echo "  release $tag: HTTP $HTTP" >&2; return 1; }
        if [ "${2:-}" = nocreate ]; then REL_ABSENT=1; return 1; fi
        title=$(release_title "$tag") || { echo "  release $tag: only a volume is created" >&2; return 1; }
        release_intro "$tag" > "$TMP/intro"
        printf '{"tag_name":"%s","name":"%s","body":%s,"draft":false,"prerelease":true,"make_latest":"false"}' \
            "$tag" "$title" "$(json_text "$TMP/intro")" > "$TMP/create.json"
        pace
        gh POST "$GH_API/repos/$KDOS_SOURCES_REPO/releases" \
            -H 'Content-Type: application/json' --data-binary @"$TMP/create.json"
        if [ "$HTTP" = 201 ]; then
            echo "  created  release $tag" >&2
            id=$(release_from_body); break
        fi
        # 422: another run created it between the GET and the POST.
        [ "$HTTP" = 422 ] || { echo "  release $tag: create HTTP $HTTP $(json_str message)" >&2; return 1; }
    done
    [ -n "$id" ] || return 1
    RID[$tag]=$id
    REL_ID=$id
}

# ── a release's assets ────────────────────────────────────────────────────
#
# release_assets <repo> <rid> [refresh] — GitHub's listing of the release,
# read once per run (again with refresh) into RA_*, keyed "<rid>/<name in
# lower case>": GitHub refuses a second asset whose name differs only in
# case, so that is the key a clash is judged by.
#
#   RA_ID RA_NAME RA_DIG ("sha256:<hex>" or null) RA_SIZE RA_STATE RA_LABEL
#   RA_KEYS[rid]  the release's keys, one per line
#   RA_N[rid]     how many assets it holds
#
# The listing is split on each asset's own "url", so the nested uploader
# object never lends an asset its fields; the asset's name and label come
# before the uploader, so the first match of each is the asset's.
declare -A RA_ID=() RA_NAME=() RA_DIG=() RA_SIZE=() RA_STATE=() RA_LABEL=() RA_KEYS=() RA_N=() RA_LOADED=()
ra_set() {  # <rid> <id> <name> <digest> <size> <state> <label>
    local k="$1/${3,,}"
    if [ -z "${RA_ID[$k]:-}" ]; then
        RA_KEYS[$1]+="${3,,}"$'\n'
        RA_N[$1]=$(( ${RA_N[$1]:-0} + 1 ))
    fi
    RA_ID[$k]=$2 RA_NAME[$k]=$3 RA_DIG[$k]=${4:-null} RA_SIZE[$k]=${5:-0} RA_STATE[$k]=$6 RA_LABEL[$k]=$7
}
ra_unset() {  # <rid> <name>
    local k="$1/${2,,}" keys
    [ -n "${RA_ID[$k]:-}" ] || return 0
    unset "RA_ID[$k]" "RA_NAME[$k]" "RA_DIG[$k]" "RA_SIZE[$k]" "RA_STATE[$k]" "RA_LABEL[$k]"
    keys=$(grep -vxF -- "${2,,}" <<< "${RA_KEYS[$1]:-}" || true)
    RA_KEYS[$1]=${keys:+$keys$'\n'}
    RA_N[$1]=$(( ${RA_N[$1]:-1} - 1 ))
}
release_assets() {
    local repo=$1 rid=$2 page=1 n id name dig size st lb k
    [ "${3:-}" != refresh ] && [ -n "${RA_LOADED[$rid]:-}" ] && return 0
    while IFS= read -r k; do
        [ -z "$k" ] || ra_unset "$rid" "$k"
    done <<< "${RA_KEYS[$rid]:-}"
    RA_KEYS[$rid]="" RA_N[$rid]=0
    while :; do
        gh GET "$GH_API/repos/$repo/releases/$rid/assets?per_page=100&page=$page"
        [ "$HTTP" = 200 ] || { echo "  release $rid: listing assets: HTTP $HTTP" >&2; return 1; }
        n=0
        while IFS=$'\037' read -r id name dig size st lb; do
            [ -n "$id" ] && [ -n "$name" ] || continue
            n=$((n + 1))
            ra_set "$rid" "$id" "$name" "$dig" "$size" "$st" "$lb"
        done < <(awk '
            function str(k,  v) { if (match($0, "\"" k "\": *\"[^\"]*\"")) { v = substr($0, RSTART, RLENGTH); sub(/^"[^"]*": *"/, "", v); sub(/"$/, "", v); return v } return "" }
            function num(k,  v) { if (match($0, "\"" k "\": *[0-9]+")) { v = substr($0, RSTART, RLENGTH); sub(/.*: */, "", v); return v } return 0 }
            BEGIN { RS = "\"url\": *\"[^\"]*/releases/assets/"; OFS = "\037" }
            NR > 1 {
                id = $0; sub(/[^0-9].*/, "", id)
                d = str("digest"); if (d == "") d = "null"
                print id, str("name"), d, num("size"), str("state"), str("label")
            }' "$TMP/body")
        [ "$n" -lt 100 ] && break
        page=$((page + 1))
    done
    RA_LOADED[$rid]=1
}

# asset_info <rid> <name> — "<id>␟<name>␟<digest>␟<size>␟<state>␟<label>"
# from the loaded listing, or nothing. The name is compared literally,
# ignoring case, never as a pattern: an asset name is full of dots.
asset_info() {
    local k="$1/${2,,}"
    [ -n "${RA_ID[$k]:-}" ] || return 0
    printf '%s\037%s\037%s\037%s\037%s\037%s\n' "${RA_ID[$k]}" "${RA_NAME[$k]}" \
        "${RA_DIG[$k]}" "${RA_SIZE[$k]}" "${RA_STATE[$k]}" "${RA_LABEL[$k]}"
}

# asset_by_bytes <rid> <digest> <label> — the name of a completed asset in
# the loaded listing holding exactly <digest> under <label>, or nothing. When
# GitHub stores a name other than the one asked for, a run stopped before its
# index line was written finds the upload under that other name only: asking
# for the requested name again answers 422 and the listing has no such name.
# While PUT_TAG names the archive release being written, a name the index
# already holds there is skipped: that is a file's current copy, which a move
# within one volume must not take for its new one.
PUT_TAG=""
asset_by_bytes() {
    local k
    [ -n "$3" ] || return 0
    while IFS= read -r k; do
        [ -n "$k" ] || continue
        [ -z "$PUT_TAG" ] || [ -z "${HELD[$PUT_TAG/$k]:-}" ] || continue
        if [ "${RA_DIG[$1/$k]:-}" = "$2" ] && [ "${RA_LABEL[$1/$k]:-}" = "$3" ] &&
           [ "${RA_STATE[$1/$k]:-}" = uploaded ]; then
            printf '%s\n' "${RA_NAME[$1/$k]}"
            return 0
        fi
    done <<< "${RA_KEYS[$1]:-}"
    return 0
}

# asset_delete <repo> <rid> <asset id> <name> — paced; drops it from RA_*.
asset_delete() {
    pace
    gh DELETE "$GH_API/repos/$1/releases/assets/$3"
    case $HTTP in
        204|404) ra_unset "$2" "$4"; return 0 ;;
        *) echo "  $4: delete HTTP $HTTP" >&2; return 1 ;;
    esac
}

# known_digest <repo> <asset id> — the digest of an uploaded asset whose
# digest GitHub reported as null or left out, which its schema allows. The
# asset is asked for again after a short wait; if it still has none, it is
# downloaded and hashed. Prints "sha256:<hex>", or "null" when neither
# answers. An unknown digest is never grounds for deletion.
known_digest() {
    local d try
    for try in 1 2 3; do
        sleep 2
        gh GET "$GH_API/repos/$1/releases/assets/$2"
        [ "$HTTP" = 200 ] || break
        d=$(json_str digest)
        [ -n "$d" ] && { echo "$d"; return 0; }
    done
    rm -f "$TMP/dl"
    curl -sSfL -H @"$TMP/auth" -H 'Accept: application/octet-stream' \
         --connect-timeout 20 -o "$TMP/dl" "$GH_API/repos/$1/releases/assets/$2" 2>/dev/null &&
        [ -s "$TMP/dl" ] && { echo "sha256:$(sha256sum "$TMP/dl" | cut -d' ' -f1)"; rm -f "$TMP/dl"; return 0; }
    rm -f "$TMP/dl"
    echo null
}

# put_asset <repo> <rid> <name> <file> <sha256> <content-type> <owned> [label]
#
# Store <file> as asset <name> and set PUT_NAME to the name GitHub holds it
# under. 0 stored (or already there with that digest), 1 failed, 2 the name
# is held by other bytes that are not this run's to remove. <owned> is 1 when
# ports/sources.idx gives this name, in this release, to this hash: an asset
# there with other bytes is corrupt, and is deleted and uploaded once more.
# An upload GitHub answers with other bytes than were sent is this run's own
# and is treated the same way.
#
# The file is hashed again immediately before every upload. An asset the
# loaded listing already shows with this digest is adopted without sending a
# byte, which is how a stopped run resumes; so is one holding this digest
# under this label at another name, which is where GitHub put it when it
# rewrote the name differently than asked. A 5xx or a dropped connection is
# retried twice within an attempt; such an upload can leave a `starter` asset
# holding the name, which the next attempt meets as a 422 and deletes.
PUT_NAME=""
put_asset() {
    local repo=$1 rid=$2 name=$3 file=$4 h=$5 want=sha256:$5 ctype=$6 owned=$7 label=${8:-}
    local attempt try info aid digest state mine redone=0 asize alabel
    local -a q=(--url-query "name=$name")
    [ -z "$label" ] || q+=(--url-query "label=$label")
    PUT_NAME=""
    info=$(asset_info "$rid" "$name")
    if [ -n "$info" ]; then
        IFS=$'\037' read -r aid PUT_NAME digest asize state alabel <<< "$info"
        [ "$digest" = "$want" ] && [ "$state" = uploaded ] && return 0
        PUT_NAME=""
    else
        PUT_NAME=$(asset_by_bytes "$rid" "$want" "$label")
        [ -z "$PUT_NAME" ] || return 0
    fi
    for attempt in 1 2 3 4; do
        src_hash_ok "$file" "$h" || { echo "  $name: $file no longer hashes to $h" >&2; return 1; }
        for try in 1 2 3; do
            pace
            gh POST "$GH_UPLOADS/repos/$repo/releases/$rid/assets" "${q[@]}" \
                -H "Content-Type: $ctype" -T "$file"
            case $HTTP in 000|5??) ;; *) break ;; esac
            [ "$try" = 3 ] || echo "  $name: upload HTTP $HTTP; retrying" >&2
        done
        if [ "$HTTP" = 201 ]; then
            aid=$(grep -o '/releases/assets/[0-9]*"' "$TMP/body" | head -1 | tr -dc 0-9)
            PUT_NAME=$(json_str name)
            digest=$(json_str digest)
            state=$(json_str state)
            state=${state:-uploaded} asize=$(stat -c %s "$file") alabel=$label
            ra_set "$rid" "$aid" "${PUT_NAME:-$name}" "$digest" "$asize" "$state" "$alabel"
            mine=1
        elif [ "$HTTP" = 422 ] && grep -q already_exists "$TMP/body"; then
            release_assets "$repo" "$rid" refresh || return 1
            info=$(asset_info "$rid" "$name")
            if [ -z "$info" ]; then
                PUT_NAME=$(asset_by_bytes "$rid" "$want" "$label")
                [ -z "$PUT_NAME" ] || return 0
                echo "  $name: 422 already_exists, but no such asset is listed" >&2
                return 1
            fi
            IFS=$'\037' read -r aid PUT_NAME digest asize state alabel <<< "$info"
            mine=$owned
        else
            echo "  $name: upload HTTP $HTTP $(json_str message)" >&2
            return 1
        fi
        if [ "$state" = starter ]; then
            echo "  deleting asset $aid ($name): an upload GitHub never completed" >&2
            asset_delete "$repo" "$rid" "$aid" "$name" || return 1
            continue
        fi
        [ "$digest" = "$want" ] && return 0
        # A null or absent digest on a completed asset is unknown, not wrong.
        if [ -z "$digest" ] || [ "$digest" = null ]; then
            digest=$(known_digest "$repo" "$aid")
            if [ "$digest" = "$want" ]; then
                ra_set "$rid" "$aid" "$PUT_NAME" "$digest" "$asize" uploaded "$alabel"
                return 0
            fi
            if [ "$digest" = null ]; then
                echo "  $name: neither GitHub nor a download confirms asset $aid's digest; left in place" >&2
                return 1
            fi
        fi
        if [ "$mine" != 1 ]; then
            echo "  $name: held by asset $aid of other bytes ($digest)" >&2
            return 2
        fi
        echo "  deleting asset $aid ($name): digest $digest, expected $want" >&2
        asset_delete "$repo" "$rid" "$aid" "$name" || return 2
        [ "$redone" = 0 ] || { echo "  $name: GitHub stored other bytes twice" >&2; return 1; }
        redone=1
    done
    return 1
}

# ── the index ─────────────────────────────────────────────────────────────
#
# HELD["<tag>/<name in lower case>"] is the hash whose index line holds that
# asset name: a whole file's name, and a split file's bare name and each part.
IDX_HEADER="$SRC_INDEX_MARKER
# ports/sources.idx — where the KDOS source archive keeps each file.
#
#   <sha256> <tag> <asset> <port>/<file> [parts=<N>:<h1>,<h2>,…,<hN>]
#
# <tag> is the GitHub release on kunaldawn/kdos that holds the file: sources-<N>,
# the volume ports/shelves gives the shelf of the first port that names it, or
# another volume when that one was full. A src-<name> tag is the older layout,
# one release per shelf, still read until ports/publish --rehome moves the file.
# <asset> is the name GitHub stored, which is what the download URL uses:
# <shelf>--<file>, longer when that is taken, attic--<file> for a file only old
# history names. The file's own name is <port>/<file>. A file larger than
# 1900 MiB is stored as <asset>.part01 … <asset>.partNN, whose SHA-256s are listed in
# order after parts=. ports/fetch joins them and checks <sha256> over the whole.
# One line per hash, sorted by hash. Written by ports/publish; the only hand edit
# is deleting a line."

declare -A HELD=()
held_names() {  # <asset> <nparts> — every name the line holds, lower case
    local i p
    printf '%s\n' "${1,,}"
    for ((i = 1; $2 >= 2 && i <= $2; i++)); do
        printf -v p '%s.part%02d' "$1" "$i"
        printf '%s\n' "${p,,}"
    done
}
held_set() {  # <tag> <asset> <nparts> <hash, or empty to clear>
    local nm
    while IFS= read -r nm; do
        if [ -n "$4" ]; then HELD[$1/$nm]=$4; else unset "HELD[$1/$nm]"; fi
    done < <(held_names "$2" "$3")
}
held_load() {
    local h
    HELD=()
    for h in "${!SRC_TAG[@]}"; do held_set "${SRC_TAG[$h]}" "${SRC_ASSET[$h]}" "${SRC_NPARTS[$h]}" "$h"; done
    return 0
}

# index_ready — refuse to write an index that is not format 2, or that
# breaks its rules before this run touches it, and hold the index's lock for
# the rest of the run. Two runs writing one index each rewrite the whole file
# from what they last read, so the second drops the first's lines; the lock
# (flock on <index>.lock, released when the run exits however it exits) makes
# a second writer stop at once instead.
index_ready() {
    local first="" p
    if command -v flock >/dev/null 2>&1; then
        exec 9> "$KDOS_SOURCES_INDEX.lock"
        flock -n 9 || die "another ports/publish is writing ${KDOS_SOURCES_INDEX#"$REPO_ROOT"/}; let it finish first"
    fi
    if [ -s "$KDOS_SOURCES_INDEX" ]; then
        IFS= read -r first < "$KDOS_SOURCES_INDEX" || true
        [ "$first" = "$SRC_INDEX_MARKER" ] ||
            die "${KDOS_SOURCES_INDEX#"$REPO_ROOT"/} is not format 2; replace it with the format-2 header before publishing"
    fi
    p=$(src_index_problems "$KDOS_SOURCES_INDEX")
    [ -z "$p" ] || { printf '  %s\n' "$p" >&2; die "${KDOS_SOURCES_INDEX#"$REPO_ROOT"/} breaks its rules; fix it first"; }
}

# index_write <hash> [line] — replace the hash's line with [line], or drop
# it, keeping the header, and sort by hash. Removing the old line first is
# what lets a plain sort keep one line per hash. The result is checked before
# it replaces the index; one that would break a rule, or that does not hold
# exactly the lines it should (every other hash's, plus [line]), is not
# written and the run stops, since every later line would be judged against
# it. The scratch file is this run's own, beside the index so the rename is
# atomic.
INDEX_CHANGED=0
index_write() {
    local f=$KDOS_SOURCES_INDEX first="" p was want got
    [ ! -s "$f" ] || { IFS= read -r first < "$f" || true; }
    was=0
    [ "$first" != "$SRC_INDEX_MARKER" ] || was=$(grep -c '^[0-9a-f]' "$f" || true)
    want=$was
    if [ "$first" = "$SRC_INDEX_MARKER" ] && grep -q "^$1 " "$f"; then want=$((want - 1)); fi
    [ -z "${2:-}" ] || want=$((want + 1))
    {
        if [ "$first" = "$SRC_INDEX_MARKER" ]; then
            awk '/^[0-9a-f]/ { exit } { print }' "$f"
        else
            printf '%s\n' "$IDX_HEADER"
        fi
        {
            [ "$first" != "$SRC_INDEX_MARKER" ] || awk -v h="$1" '/^[0-9a-f]/ && $1 != h' "$f"
            [ -z "${2:-}" ] || printf '%s\n' "$2"
        } | LC_ALL=C sort -k1,1
    } > "$f.tmp.$$"
    p=$(src_index_problems "$f.tmp.$$")
    got=$(grep -c '^[0-9a-f]' "$f.tmp.$$" || true)
    [ "$got" = "$want" ] || p="${p:+$p
}it would hold $got lines where $want are due ($was before)"
    if [ -n "$p" ]; then
        printf '  %s\n' "$p" >&2
        rm -f "$f.tmp.$$"
        echo "ports/publish: writing $1 would break ${f#"$REPO_ROOT"/}; stopped" >&2
        exit 2
    fi
    # A line rewritten to what it already was (a repaired asset) is no change
    # to commit.
    if cmp -s "$f.tmp.$$" "$f"; then rm -f "$f.tmp.$$"; else mv -f "$f.tmp.$$" "$f"; INDEX_CHANGED=1; fi
    if [ -n "${SRC_TAG[$1]:-}" ]; then
        held_set "${SRC_TAG[$1]}" "${SRC_ASSET[$1]}" "${SRC_NPARTS[$1]}" ""
        IDX_N[${SRC_TAG[$1]}]=$(( ${IDX_N[${SRC_TAG[$1]}]:-0} - SRC_NPARTS[$1] ))
        unset "SRC_TAG[$1]" "SRC_ASSET[$1]" "SRC_NAME[$1]" "SRC_NPARTS[$1]"
    fi
}

# index_put <hash> <tag> <asset> <label> [part hash…]
index_put() {
    local h=$1 tag=$2 asset=$3 label=$4 i n line
    shift 4
    n=$#
    line="$h $tag $asset $label"
    [ "$n" -lt 2 ] || line+=" parts=$n:$(IFS=,; echo "$*")"
    index_write "$h" "$line"
    SRC_TAG[$h]=$tag SRC_ASSET[$h]=$asset SRC_NAME[$h]=$label
    SRC_NPARTS[$h]=$(( n < 2 ? 1 : n ))
    for ((i = 1; n >= 2 && i <= n; i++)); do SRC_PHASH[$h,$i]=${!i}; done
    held_set "$tag" "$asset" "${SRC_NPARTS[$h]}" "$h"
    IDX_N[$tag]=$(( ${IDX_N[$tag]:-0} + SRC_NPARTS[$h] ))
}

# index_del <hash>
index_del() {
    index_write "$1"
}

# ── names ─────────────────────────────────────────────────────────────────
#
# name_tiers <hash> <label> <shelf> — the candidate asset names, in order,
# as GitHub will store them. The shelf prefix keeps every shelf's names
# apart in a volume that holds many.
name_tiers() {
    local port=${2%%/*} file=${2#*/}
    src_asset_sanitize "$3--$file"
    src_asset_sanitize "$3--$port--$file"
    src_asset_sanitize "$3--$port--${1:0:12}--$file"
}

# name_free <tag> <rid|""> <name> <nparts> <hash> — true when <name> may
# hold <hash> in <tag> (for a split file: its bare name and every part). A
# name is taken when another hash's index line holds it, or when the release
# listing (read when <rid> is given) shows it holding other bytes — unless
# the index gives that name to this hash, where other bytes are corruption
# put_asset repairs. An unfinished upload and an unknown digest do not take a
# name; put_asset settles both. Part hashes come from NEW_PH.
NEW_PH=()
name_free() {
    local tag=$1 rid=$2 base=$3 n=$4 h=$5 nm i=0 exp info dig st
    while IFS= read -r nm; do
        if [ "$i" = 0 ]; then exp=sha256:$h; else exp=sha256:${NEW_PH[i]:-}; fi
        i=$((i + 1))
        [ -z "${HELD[$tag/$nm]:-}" ] || [ "${HELD[$tag/$nm]}" = "$h" ] || return 1
        [ -n "$rid" ] || continue
        info=$(asset_info "$rid" "$nm")
        [ -n "$info" ] || continue
        IFS=$'\037' read -r _ _ dig _ st _ <<< "$info"
        [ "$st" != starter ] || continue
        [ "$dig" != null ] || continue
        # A split file's bare name is reserved, never an asset of its own.
        if [ "$dig" = "$exp" ] && { [ "$n" -lt 2 ] || [ "$i" -gt 1 ]; }; then continue; fi
        [ "${HELD[$tag/$nm]:-}" = "$h" ] && continue
        return 1
    done < <(held_names "$base" "$n")
    return 0
}

# predict <hash> <label> <shelf> <nparts> [home] — the volume (PRED_TAG) and
# name (PRED) a dry run expects, from the index alone, reserved for the rest
# of the plan. The index's count of each volume stands for GitHub's, so a
# full volume spills as it would. PRED is empty when every tier is held in
# the volume with room, PRED_TAG too when no volume has room ([home]: the
# home volume only) or the shelf has no volume.
PRED="" PRED_TAG=""
predict() {
    local c t
    local -a tags
    PRED="" PRED_TAG=""
    mapfile -t tags < <(cand_tags "$3" ${5:+"$5"})
    for t in "${tags[@]}"; do
        [ $(( ${IDX_N[$t]:-0} + $4 )) -le "$SRC_RELEASE_CAP" ] || continue
        PRED_TAG=$t
        while IFS= read -r c; do
            name_free "$t" "" "$c" "$4" "$1" && { PRED=$c; break; }
        done < <(name_tiers "$1" "$2" "$3")
        break
    done
    [ -n "$PRED" ] || return 0
    held_set "$PRED_TAG" "$PRED" "$4" "$1"
    IDX_N[$PRED_TAG]=$(( ${IDX_N[$PRED_TAG]:-0} + $4 ))
}

# ── uploading one file ────────────────────────────────────────────────────
#
# split_file <hash> <file> — for a file larger than $SRC_PART_SIZE, stage its
# parts under $KDOS_SRCCACHE/.parts/<hash>/ (PART_DIR) and fill NEW_PH with
# their hashes, 1-based; for a smaller one, empty NEW_PH.
PART_DIR=""
split_file() {
    local h=$1 file=$2 size n i p
    NEW_PH=() PART_DIR=""
    size=$(stat -c %s "$file")
    n=$(( (size + SRC_PART_SIZE - 1) / SRC_PART_SIZE ))
    [ "$n" -ge 2 ] || return 0
    [ "$n" -le 99 ] || { echo "  $h: $n parts of $SRC_PART_SIZE bytes; a file has at most 99" >&2; return 1; }
    PART_DIR="$KDOS_SRCCACHE/.parts/$h"
    rm -rf "$PART_DIR"
    mkdir -p "$PART_DIR"
    STAGED+=("$PART_DIR")
    echo "  split    $h into $n parts"
    split -b "$SRC_PART_SIZE" -a 2 --numeric-suffixes=1 "$file" "$PART_DIR/" || return 1
    # The parts are cut from the file as it is now: hash the whole again, so
    # a file that changed while it was cut is never published in pieces.
    src_hash_ok "$file" "$h" || { echo "  $h: $file changed while it was split" >&2; return 1; }
    NEW_PH=("")
    for ((i = 1; i <= n; i++)); do
        printf -v p '%s/%02d' "$PART_DIR" "$i"
        [ -s "$p" ] || { echo "  $h: splitting gave no part $i" >&2; return 1; }
        NEW_PH+=("$(sha256sum "$p" | cut -d' ' -f1)")
    done
}

# store <hash> <file> <label> <shelf> [home | <tag> <asset>] — upload one
# file into the archive, whole or in parts, and write its index line. With
# <tag> and <asset> (the place its index line already gives it) it goes
# there and nowhere else. Otherwise the volumes cand_tags names are tried in
# order, each under the first free name tier, and a volume with no room for
# it is passed over; with `home`, only its home volume is tried. 0 stored,
# 1 failed, 2 no name would take it, 3 no volume tried had room.
declare -A TOUCHED=()
store() {
    local h=$1 file=$2 label=$3 shelf=$4 fixed="" only="" n tag rc first=""
    local -a tags
    case ${5:-} in
        "")   ;;
        home) only=home ;;
        *)    tags=("$5"); fixed=$6 ;;
    esac
    if [ -z "$fixed" ]; then
        mapfile -t tags < <(cand_tags "$shelf" ${only:+"$only"})
        [ "${#tags[@]}" -gt 0 ] || { echo "  $label: shelf $shelf has no volume; run ports/publish --plan" >&2; return 1; }
    fi
    split_file "$h" "$file" || return 1
    n=1
    [ "${#NEW_PH[@]}" -lt 3 ] || n=$(( ${#NEW_PH[@]} - 1 ))
    if [ -n "$fixed" ] && [ "$n" != "${SRC_NPARTS[$h]}" ]; then
        echo "  $label: the index stores it in ${SRC_NPARTS[$h]} part(s); KDOS_PART_SIZE=$SRC_PART_SIZE cuts $n" >&2
        return 1
    fi
    for tag in "${tags[@]}"; do
        [ -n "$first" ] || first=$tag
        rc=0
        store_in "$h" "$file" "$label" "$shelf" "$tag" "$n" "$fixed" || rc=$?
        PUT_TAG=""
        [ "$rc" = 3 ] && [ -z "$fixed" ] && continue
        [ "$rc" = 0 ] || return "$rc"
        [ "$tag" = "$first" ] || echo "  spilled  $label: $first is full; stored in $tag"
        return 0
    done
    echo "  $label: no volume tried has room for $n more asset(s)" >&2
    return 3
}

# store_in <hash> <file> <label> <shelf> <tag> <nparts> [asset] — store's
# work in one release; the file is already split. 3 when the release has no
# room for it.
store_in() {
    local h=$1 file=$2 label=$3 shelf=$4 tag=$5 n=$6 fixed=${7:-} rid i cand rc new owned p stored
    local -a cands
    archive_release "$tag" || { echo "  $label: no release $tag" >&2; return 1; }
    rid=$REL_ID
    release_assets "$KDOS_SOURCES_REPO" "$rid" || return 1
    PUT_TAG=$tag
    if [ -n "$fixed" ]; then
        for ((i = 1; n >= 2 && i <= n; i++)); do
            [ "${NEW_PH[i]}" = "${SRC_PHASH[$h,$i]}" ] && continue
            echo "  $label: part $i does not hash as the index says; set KDOS_PART_SIZE to the size it was cut with" >&2
            return 1
        done
        cands=("$fixed")
    else
        mapfile -t cands < <(name_tiers "$h" "$label" "$shelf")
    fi
    for cand in "${cands[@]}"; do
        [ -n "$cand" ] || continue
        if [ -z "$fixed" ] && ! name_free "$tag" "$rid" "$cand" "$n" "$h"; then
            continue
        fi
        # The cap counts parts; a name the listing already holds is not new.
        new=0
        while IFS= read -r p; do
            [ "$n" -ge 2 ] && [ "$p" = "${cand,,}" ] && continue
            [ -n "$(asset_info "$rid" "$p")" ] || new=$((new + 1))
        done < <(held_names "$cand" "$n")
        if [ $(( ${RA_N[$rid]:-0} + new )) -gt "$SRC_RELEASE_CAP" ]; then
            echo "  $label: $tag holds ${RA_N[$rid]:-0} assets; $new more would pass $SRC_RELEASE_CAP" >&2
            return 3
        fi
        owned=0
        [ "${HELD[$tag/${cand,,}]:-}" != "$h" ] || owned=1
        rc=0
        if [ "$n" -lt 2 ]; then
            put_asset "$KDOS_SOURCES_REPO" "$rid" "$cand" "$file" "$h" application/octet-stream "$owned" "$label" || rc=$?
            if [ "$rc" = 2 ] && [ -z "$fixed" ]; then continue; fi
            [ "$rc" = 0 ] || return "$rc"
            stored=${PUT_NAME:-$cand}
            [ "$stored" = "$cand" ] || echo "  note     GitHub stored $cand as $stored"
            index_put "$h" "$tag" "$stored" "$label"
        else
            for ((i = 1; i <= n; i++)); do
                printf -v p '%s.part%02d' "$cand" "$i"
                put_asset "$KDOS_SOURCES_REPO" "$rid" "$p" "$(printf '%s/%02d' "$PART_DIR" "$i")" \
                    "${NEW_PH[i]}" application/octet-stream "$owned" "$label" || { rc=$?; break; }
                if [ "$PUT_NAME" != "$p" ]; then
                    echo "  $label: GitHub stored part $i as $PUT_NAME, not $p; a split file needs its exact part names" >&2
                    rc=2; break
                fi
            done
            if [ "$rc" = 2 ] && [ -z "$fixed" ]; then continue; fi
            [ "$rc" = 0 ] || return "$rc"
            index_put "$h" "$tag" "$cand" "$label" "${NEW_PH[@]:1}"
            rm -rf "$PART_DIR"
        fi
        TOUCHED[$tag]=1
        return 0
    done
    echo "  $label: every name for it in $tag is held by other bytes" >&2
    return 2
}

# ── release notes ─────────────────────────────────────────────────────────
#
# describe <tag> — rewrite archive release <tag>'s notes from the index, and
# a volume's title. The notes hold one section per shelf: its name and its
# description from ports/shelves, then its table. A file sits in the section
# of the shelf its asset name starts with (attic, last, for attic--), or in a
# legacy src-<name> release under <name>. A body holds 125,000 characters:
# past 120,000 the tables drop their links and show 16 hex digits of each
# hash, and past that again they are cut short with a pointer to the index,
# which is complete. The version is the recipe's of the port that names the
# hash today, or — when none does.
describe() {
    local tag=$1 h lab port ver size urls n nm rid sec key desc title=""
    declare -A secs=()
    archive_release "$tag" nocreate || { echo "  $tag: no such release" >&2; return 1; }
    rid=$REL_ID
    : > "$TMP/rows"
    for h in "${!SRC_TAG[@]}"; do
        [ "${SRC_TAG[$h]}" = "$tag" ] || continue
        lab=${SRC_NAME[$h]}
        port=${R_LABEL[$h]:-}; port=${port%%/*}
        ver=—
        [ -z "$port" ] || [ "${R_VER[$port]:--}" = - ] || ver=${R_VER[$port]}
        n=${SRC_NPARTS[$h]}
        size=$(local_size "$h" "$lab")
        if [ -z "$size" ]; then
            release_assets "$KDOS_SOURCES_REPO" "$rid" || return 1
            size=0
            while IFS= read -r nm; do
                size=$(( size + ${RA_SIZE[$rid/$nm]:-0} ))
            done < <(held_names "${SRC_ASSET[$h]}" "$n")
        fi
        urls=$(src_urls "$h" | tr '\n' ' ')
        case $tag in
            src-*) sec=${tag#src-} ;;
            *)     sec=${SRC_ASSET[$h]%%--*}; [ "$sec" != "${SRC_ASSET[$h]}" ] || sec=attic ;;
        esac
        secs[$sec]=1
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$lab" "$ver" "$n" "$size" "$h" "${urls% }" \
            "$([ "$sec" = attic ] && echo 2 || echo 1)$sec" >> "$TMP/rows"
    done
    : > "$TMP/secs"
    for sec in "${!secs[@]}"; do
        if [ "$sec" = attic ]; then
            desc="Files no current recipe names: ports that are gone, and older sources of ports that have moved on."
        else
            desc=$(src_shelf_desc "$sec" 2>/dev/null) || desc="A shelf ports/shelves no longer lists."
        fi
        key=$([ "$sec" = attic ] && echo 2 || echo 1)$sec
        printf '%s\t%s\t%s\n' "$key" "$sec" "$desc" >> "$TMP/secs"
    done
    LC_ALL=C sort -t$'\t' -k7,7 -k1,1 -o "$TMP/rows" "$TMP/rows"
    n=$(wc -l < "$TMP/rows")
    release_intro "$tag" > "$TMP/intro"
    awk -F'\t' -v limit=120000 '
        function hsize(b,  u, i) {
            if (b + 0 <= 0) return "—"
            split("B KiB MiB GiB TiB", u, " ")
            for (i = 1; b >= 1024 && i < 5; i++) b /= 1024
            return (i == 1) ? sprintf("%d B", b) : sprintf("%.1f %s", b, u[i])
        }
        function row(i, full,   port, file, f, u, k, m, hs) {
            port = lab[i]; sub(/\/.*/, "", port)
            file = lab[i]; sub(/^[^\/]*\//, "", file)
            m = split(urls[i], u, " ")
            if (np[i] > 1) {
                f = file ", " np[i] " parts"
                if (full) { f = f ":"; for (k = 1; k <= m; k++) f = f " [" k "](" u[k] ")" }
            } else f = full ? "[" file "](" u[1] ")" : file
            hs = full ? hash[i] : substr(hash[i], 1, 16)
            return "| " port " | " ver[i] " | " f " | " hsize(size[i]) " | `" hs "` |\n"
        }
        function heading(k) {
            return "\n## " sname[k] "\n\n" sdesc[k] "\n\n| Port | Version | File | Size | SHA-256 |\n|---|---|---|---|---|\n"
        }
        function build(full, cut,   b, i, r, tail, cur) {
            b = intro; cur = ""
            for (i = 1; i <= n; i++) {
                r = row(i, full)
                if (sec[i] != cur) { r = heading(sec[i]) r; cur = sec[i] }
                tail = "\n… " (n - i + 1) " more; ports/sources.idx lists every file.\n"
                if (cut && length(b) + length(r) + length(tail) > limit) return b tail
                b = b r
            }
            return b
        }
        FILENAME == ARGV[1] { intro = intro $0 "\n"; next }
        FILENAME == ARGV[2] { sname[$1] = $2; sdesc[$1] = $3; next }
        { n++; lab[n] = $1; ver[n] = $2; np[n] = $3; size[n] = $4; hash[n] = $5; urls[n] = $6; sec[n] = $7 }
        END {
            b = build(1, 0)
            if (length(b) > limit) b = build(0, 0)
            if (length(b) > limit) b = build(0, 1)
            printf "%s", b
        }' "$TMP/intro" "$TMP/secs" "$TMP/rows" > "$TMP/notes.md"
    if title=$(release_title "$tag"); then
        printf '{"name":"%s","body":%s}' "$title" "$(json_text "$TMP/notes.md")" > "$TMP/notes.json"
    else
        printf '{"body":%s}' "$(json_text "$TMP/notes.md")" > "$TMP/notes.json"
    fi
    pace
    gh PATCH "$GH_API/repos/$KDOS_SOURCES_REPO/releases/$rid" \
        -H 'Content-Type: application/json' --data-binary @"$TMP/notes.json"
    [ "$HTTP" = 200 ] || { echo "  $tag: notes HTTP $HTTP $(json_str message)" >&2; return 1; }
    echo "  notes    $tag  ($n files${title:+, \"$title\"})"
}

describe_touched() {
    local tag
    for tag in $(printf '%s\n' "${!TOUCHED[@]}" | LC_ALL=C sort); do
        describe "$tag" || RC=1
    done
    return 0
}

# ── --freeze ──────────────────────────────────────────────────────────────
#
# The list is computed from the recipes AT THE TAG, not the working tree, so
# it states what that release was built from whatever has been bumped since.

# freeze_list <tag> [nocheck] — write build/freeze/sources-<tag>.sha256 and
# set FREEZE_FILE and FREEZE_COMMIT; with no second argument, stop the run
# unless every hash in it is archived. nocheck skips that check, which is the
# only part that needs the network. The index must be loaded.
FREEZE_FILE="" FREEZE_COMMIT=""
freeze_list() {
    local tag=$1 safe tree missing=0 h f
    local recipes=()
    FREEZE_COMMIT=$(git -C "$REPO_ROOT" rev-parse -q --verify "refs/tags/$tag^{commit}" ||
                    git -C "$REPO_ROOT" rev-parse -q --verify "$tag^{commit}") ||
        die "no such tag: $tag"
    mapfile -t recipes < <(git -C "$REPO_ROOT" ls-tree -r --name-only "$FREEZE_COMMIT" -- ports/core |
                           grep -E '^ports/core/([^/]+/)?[^/]+/kpkgbuild$')
    [ "${#recipes[@]}" -gt 0 ] || die "$tag has no ports/core"
    src_kpkg_ensure || die "cannot build the recipe reader"
    safe=${tag//\//-}
    tree="$REPO_ROOT/build/freeze/tree-$safe"
    FREEZE_FILE="$REPO_ROOT/build/freeze/sources-$safe.sha256"
    rm -rf "$tree"; mkdir -p "$tree"
    git -C "$REPO_ROOT" archive "$FREEZE_COMMIT" -- "${recipes[@]}" | tar -x -C "$tree"
    load_carried "$FREEZE_COMMIT"
    recipe_lines "$tree" | awk '{ print $1 "  " $3 "/" $5 }' | LC_ALL=C sort -u > "$FREEZE_FILE"
    rm -rf "$tree"
    [ ! -e "$TMP/badport" ] || die "could not read every recipe at $tag"
    echo "==> $tag: $(wc -l < "$FREEZE_FILE") sources -> ${FREEZE_FILE#"$REPO_ROOT"/}"
    if [ "${2:-}" = nocheck ]; then
        echo "  (not checked against the archive: --dry-run uses no network)"
        return 0
    fi
    while read -r h f; do
        present "$h" || { echo "  missing  $h  $f"; missing=$((missing + 1)); }
    done < "$FREEZE_FILE"
    [ "$missing" = 0 ] || die "$missing sources are not archived; run ports/publish first"
}

# release_by_tag_any <tag> [<payload.json>] — set REL_ID and REL_DRAFT (1 or
# 0) for the release of <tag> on $KDOS_REPO. A DRAFT is invisible to the
# by-tag lookup, so the listing is searched instead. With a payload, a tag
# that has no release gets one created from it; without one, it is an error.
REL_DRAFT=0
release_by_tag_any() {
    local tag=$1 page=1 hit=""
    REL_ID=""
    while [ -z "$hit" ] && [ "$page" -le 20 ]; do
        gh GET "$GH_API/repos/$KDOS_REPO/releases?per_page=100&page=$page"
        [ "$HTTP" = 200 ] || die "listing releases on $KDOS_REPO: HTTP $HTTP"
        grep -q '"tag_name"' "$TMP/body" || break
        hit=$(awk -v tag="$tag" '
            BEGIN { RS = "\"url\": *\"[^\"]*/releases/" }
            /^[0-9]+"/ && match($0, /"tag_name": *"[^"]*"/) {
                t = substr($0, RSTART, RLENGTH); sub(/^"tag_name": *"/, "", t); sub(/"$/, "", t)
                if (t != tag) next
                id = $0; sub(/".*/, "", id)
                print id, ($0 ~ /"draft": *true/) ? 1 : 0; exit
            }' "$TMP/body")
        page=$((page + 1))
    done
    if [ -n "$hit" ]; then
        read -r REL_ID REL_DRAFT <<< "$hit"
        return 0
    fi
    [ -n "${2:-}" ] || die "$KDOS_REPO has no release for $tag"
    pace
    gh POST "$GH_API/repos/$KDOS_REPO/releases" -H 'Content-Type: application/json' \
        --data-binary @"$2"
    [ "$HTTP" = 201 ] || die "creating the draft release $tag on $KDOS_REPO: HTTP $HTTP $(json_str message)"
    REL_ID=$(release_from_body) REL_DRAFT=1
    echo "  created  draft release $tag on $KDOS_REPO"
}

src_index_load
held_load
idx_count_load
load_volumes

if [ -n "$FREEZE" ]; then
    if [ "$DRY" = 1 ]; then freeze_list "$FREEZE" nocheck; else freeze_list "$FREEZE"; fi
    list=$FREEZE_FILE
    if [ "$DRY" = 1 ] || [ "$CHECK" = 1 ]; then
        echo "==> would attach sources.sha256 ($(human "$(stat -c %s "$list")")) to $KDOS_REPO release $FREEZE"
        exit 0
    fi
    load_token
    printf '{"tag_name":"%s","target_commitish":"%s","name":"%s","draft":true,"prerelease":false}' \
        "$FREEZE" "$FREEZE_COMMIT" "$FREEZE" > "$TMP/create.json"
    release_by_tag_any "$FREEZE" "$TMP/create.json"
    # Listed first, so a list already attached is adopted, not sent again.
    release_assets "$KDOS_REPO" "$REL_ID" || die "cannot list the assets of release $FREEZE"
    rc=0
    put_asset "$KDOS_REPO" "$REL_ID" sources.sha256 "$list" \
        "$(sha256sum "$list" | cut -d' ' -f1)" text/plain 0 || rc=$?
    case $rc in
        0) echo "==> sources.sha256 is on $KDOS_REPO release $FREEZE" ;;
        2) echo "ports/publish: release $FREEZE already carries a different sources.sha256;" >&2
           echo "               delete it by hand only while the release is still a draft" >&2
           exit 2 ;;
        *) exit 1 ;;
    esac
    exit 0
fi

# ── --release ─────────────────────────────────────────────────────────────
#
# A system release is the GitHub release of a KDOS tag: the ISO (in parts
# when it is larger than $SRC_PART_SIZE, since GitHub refuses an asset of 2 GiB),
# the tag's sources.sha256, a SHA256SUMS over all of them, and that list's
# signature with the public key that checks it. Every asset goes up
# append-only: a same-name asset with other bytes stops the run, because
# the release is what people download and nothing replaces a file under them
# silently. It stays a DRAFT, visible only to the repository's writers,
# until --publish makes it public and Latest.
if [ -n "$RELEASE" ]; then
    tag=$RELEASE
    safe=${tag//\//-}
    commit=$(git -C "$REPO_ROOT" rev-parse -q --verify "refs/tags/$tag^{commit}") ||
        die "no such tag: $tag (tag the commit, push the tag, then release it)"
    # The release names a commit people can check out; a tag that exists
    # only here, or that points elsewhere on GitHub, would describe a tree
    # nobody else has.
    if [ "$DRY" = 1 ]; then
        echo "==> $tag is $commit (not checked against origin: --dry-run uses no network)"
    else
        refs=$(git -C "$REPO_ROOT" ls-remote --tags origin "refs/tags/$tag" "refs/tags/$tag^{}") ||
            die "cannot ask origin for tag $tag"
        # An annotated tag lists the tag object and, as <tag>^{}, the commit.
        remote=$(awk -v t="refs/tags/$tag" '{ c[$2] = $1 }
                     END { print ((t "^{}") in c) ? c[t "^{}"] : c[t] }' <<< "$refs")
        [ -n "$remote" ] || die "origin has no tag $tag; push it first"
        [ "$remote" = "$commit" ] || die "tag $tag is $commit here but $remote on origin"
        echo "==> $tag is $commit, as on origin"
    fi

    if [ "$DRY" = 1 ]; then freeze_list "$tag" nocheck; else freeze_list "$tag"; fi

    iso=${ISO:-$REPO_ROOT/build/iso-build/kdos.iso}
    [ -f "$iso" ] || die "no ISO at $iso (build one, or pass --iso <path>)"
    iso_name="kdos-$safe.iso"
    iso_size=$(stat -c %s "$iso")
    nparts=1
    [ "$iso_size" -lt "$SRC_PART_SIZE" ] || nparts=$(( (iso_size + SRC_PART_SIZE - 1) / SRC_PART_SIZE ))

    key="" pub=""
    if [ "$UNSIGNED" = 0 ]; then
        key=${KEY:-${KDOS_RELEASE_KEY:-$REPO_ROOT/build/keys/kdos-release.key}}
        pub=${key%.key}.pub
    fi
    out="$REPO_ROOT/build/release/$safe"

    if [ "$DRY" = 1 ]; then
        echo "==> would release $tag on $KDOS_REPO as a $([ "$PUBLISH" = 1 ] && echo "PUBLISHED, Latest" || echo DRAFT) release"
        if [ "$nparts" = 1 ]; then
            printf '  asset    %-28s %s\n' "$iso_name" "$(human "$iso_size")"
        else
            printf '  ISO      %-28s %s, in %d parts of at most %s\n' "$iso_name" "$(human "$iso_size")" \
                "$nparts" "$(human "$SRC_PART_SIZE")"
            for i in $(seq 1 "$nparts"); do
                sz=$SRC_PART_SIZE
                [ "$i" -lt "$nparts" ] || sz=$(( iso_size - (nparts - 1) * SRC_PART_SIZE ))
                printf '  asset    %-28s %s\n' "$(src_part_name "$iso_name" "$i")" "$(human "$sz")"
            done
        fi
        printf '  asset    %-28s %s\n' sources.sha256 "$(human "$(stat -c %s "$FREEZE_FILE")")"
        printf '  asset    %s\n' SHA256SUMS
        if [ "$UNSIGNED" = 1 ]; then
            echo "  unsigned (--unsigned): no SHA256SUMS.sig, no kdos-release.pub"
        elif [ -f "$key" ] && [ -f "$pub" ]; then
            printf '  asset    %-28s signed with %s\n' SHA256SUMS.sig "${key#"$REPO_ROOT"/}"
            printf '  asset    %s\n' kdos-release.pub
        else
            echo "  signing key ${key#"$REPO_ROOT"/} or its .pub is missing; the real run would refuse"
            RC=1
        fi
        exit "$RC"
    fi

    if [ "$UNSIGNED" = 0 ]; then
        [ -f "$key" ] || die "no release key at $key; make one: kpkg keygen build/keys/kdos-release, or pass --unsigned"
        [ -f "$pub" ] || die "no public key beside $key (expected $pub)"
    fi

    # The parts are 2 GiB copies of the ISO; they are cut again on every run
    # and never outlive it.
    rm -rf "$out"; mkdir -p "$out"
    trap 'rm -f "$out"/*.part[0-9][0-9]; cleanup' EXIT
    echo "==> hashing $iso ($(human "$iso_size"))"
    iso_hash=$(sha256sum "$iso" | cut -d' ' -f1)
    ASSETS=()   # "<name>|<path>|<sha256>|<content-type>", in upload order
    if [ "$nparts" = 1 ]; then
        ASSETS+=("$iso_name|$iso|$iso_hash|application/x-iso9660-image")
    else
        split -b "$SRC_PART_SIZE" -d -a 2 --numeric-suffixes=1 "$iso" "$out/$iso_name.part"
        for i in $(seq 1 "$nparts"); do
            p=$(src_part_name "$iso_name" "$i")
            [ -f "$out/$p" ] || die "splitting $iso did not give $p"
            ASSETS+=("$p|$out/$p|$(sha256sum "$out/$p" | cut -d' ' -f1)|application/octet-stream")
        done
    fi
    cp "$FREEZE_FILE" "$out/sources.sha256"
    ASSETS+=("sources.sha256|$out/sources.sha256|$(sha256sum "$out/sources.sha256" | cut -d' ' -f1)|text/plain")
    [ "$UNSIGNED" = 1 ] || cp "$pub" "$out/kdos-release.pub"

    # SHA256SUMS names the whole ISO even when only its parts are assets: it
    # is what `sha256sum -c` checks after the parts are joined.
    ( cd "$out"
      printf '%s  %s\n' "$iso_hash" "$iso_name"
      for a in "${ASSETS[@]}"; do
          IFS='|' read -r n _ h _ <<< "$a"
          [ "$n" = "$iso_name" ] || printf '%s  %s\n' "$h" "$n"
      done
      [ "$UNSIGNED" = 1 ] || sha256sum kdos-release.pub
    ) > "$out/SHA256SUMS"
    ASSETS+=("SHA256SUMS|$out/SHA256SUMS|$(sha256sum "$out/SHA256SUMS" | cut -d' ' -f1)|text/plain")

    keyid=""
    if [ "$UNSIGNED" = 0 ]; then
        src_kpkg_ensure || die "cannot build kpkg"
        signed=$("$KPKG" sign "$out/SHA256SUMS" "$key" 2>&1) || die "signing SHA256SUMS: $signed"
        keyid=$(grep -o 'key [0-9a-f]*' <<< "$signed" | cut -d' ' -f2)
        # Checked here the way a downloader checks it, against a keyring
        # holding only this public key: a key pair whose halves do not match
        # would otherwise publish a signature nothing verifies.
        mkdir -p "$TMP/ring"; cp "$pub" "$TMP/ring/kdos-release.pub"
        KPKG_KEYRING="$TMP/ring" "$KPKG" verify-pkg "$out/SHA256SUMS" >/dev/null 2>&1 ||
            die "SHA256SUMS.sig does not verify against $pub"
        ASSETS+=("SHA256SUMS.sig|$out/SHA256SUMS.sig|$(sha256sum "$out/SHA256SUMS.sig" | cut -d' ' -f1)|text/plain")
        ASSETS+=("kdos-release.pub|$out/kdos-release.pub|$(sha256sum "$out/kdos-release.pub" | cut -d' ' -f1)|text/plain")
        echo "==> SHA256SUMS signed with key $keyid"
    fi

    { echo "KDOS $tag, built from commit $commit."
      echo
      echo "## Download"
      echo
      if [ "$nparts" = 1 ]; then
          echo "The installer image is \`$iso_name\` ($(human "$iso_size"))."
      else
          echo "The installer image is \`$iso_name\` ($(human "$iso_size")). GitHub holds no file of 2 GiB or more, so it is stored in $nparts parts; download every \`$iso_name.partNN\` and join them in order:"
          echo
          echo '```'
          echo "cat $iso_name.part* > $iso_name"
          echo '```'
      fi
      echo
      echo "## Check"
      echo
      echo "Download \`SHA256SUMS\` beside the image and run:"
      echo
      echo '```'
      echo "sha256sum -c SHA256SUMS --ignore-missing"
      echo '```'
      echo
      if [ "$UNSIGNED" = 0 ]; then
          echo "\`SHA256SUMS.sig\` is an Ed25519 signature over \`SHA256SUMS\` by key \`$keyid\`, whose public half is \`kdos-release.pub\`. On a KDOS system, with that key in a directory of its own:"
          echo
          echo '```'
          echo "KPKG_KEYRING=<dir holding kdos-release.pub> kpkg verify-pkg SHA256SUMS"
          echo '```'
          echo
          echo "A key downloaded beside the file it vouches for proves only that the two agree; compare the key id with one you obtained another way."
          echo
      fi
      echo "## Sources"
      echo
      echo "\`sources.sha256\` lists every upstream source file the recipes at $tag name, as \`<sha256>  <port>/<file>\`. Each is kept in the numbered \`sources-N\` pre-releases of this repository, and \`ports/fetch\` finds it through \`ports/sources.idx\`."
    } > "$out/notes.md"

    load_token
    printf '{"tag_name":"%s","target_commitish":"%s","name":"KDOS %s","draft":true,"prerelease":false,"body":%s}' \
        "$tag" "$commit" "$tag" "$(json_text "$out/notes.md")" > "$TMP/create.json"
    release_by_tag_any "$tag" "$TMP/create.json"
    # The notes follow the assets while the release is a draft; once it is
    # public they are left as whoever published it last wrote them.
    if [ "$REL_DRAFT" = 1 ]; then
        printf '{"body":%s}' "$(json_text "$out/notes.md")" > "$TMP/notes.json"
        pace
        gh PATCH "$GH_API/repos/$KDOS_REPO/releases/$REL_ID" \
            -H 'Content-Type: application/json' --data-binary @"$TMP/notes.json"
        [ "$HTTP" = 200 ] || die "writing the notes of $tag: HTTP $HTTP $(json_str message)"
    fi

    # Listed first, so a rerun adopts every asset already stored instead of
    # sending 2 GiB again only to be told the name is taken.
    release_assets "$KDOS_REPO" "$REL_ID" || die "cannot list the assets of release $tag"

    # Hashed again here: an ISO rebuilt since SHA256SUMS was written would
    # otherwise go up under a list it does not match.
    if [ "$nparts" -gt 1 ]; then
        src_hash_ok "$iso" "$iso_hash" || die "$iso changed while the release was prepared"
    fi
    for a in "${ASSETS[@]}"; do
        IFS='|' read -r n f h ct <<< "$a"
        src_hash_ok "$f" "$h" || die "$n changed on disk before its upload"
        rc=0 PUT_NAME=""
        put_asset "$KDOS_REPO" "$REL_ID" "$n" "$f" "$h" "$ct" 0 || rc=$?
        case $rc in
            0) [ -z "$PUT_NAME" ] || [ "$PUT_NAME" = "$n" ] ||
                   die "GitHub stored $n as $PUT_NAME; SHA256SUMS names $n"
               printf '  stored   %-28s %s\n' "$n" "$(human "$(stat -c %s "$f")")" ;;
            2) echo "ports/publish: release $tag already carries a different $n;" >&2
               echo "               delete it by hand only while the release is a draft" >&2
               exit 2 ;;
            *) die "uploading $n to release $tag failed" ;;
        esac
    done

    if [ "$PUBLISH" = 0 ]; then
        if [ "$REL_DRAFT" = 1 ]; then
            echo "==> $tag is a draft on $KDOS_REPO; check it, then run again with --publish"
        else
            echo "==> $tag is already public on $KDOS_REPO and carries every asset"
        fi
        exit 0
    fi
    pace
    gh PATCH "$GH_API/repos/$KDOS_REPO/releases/$REL_ID" -H 'Content-Type: application/json' \
        --data '{"draft":false,"prerelease":false,"make_latest":"true"}'
    [ "$HTTP" = 200 ] || die "publishing $tag: HTTP $HTTP $(json_str message)"
    # Asked anonymously, as a visitor asks: the token sees drafts, and the
    # question is what everyone else is sent to.
    latest=$(curl -sS --connect-timeout 20 --max-time 60 \
                  -H 'Accept: application/vnd.github+json' \
                  "$GH_API/repos/$KDOS_REPO/releases/latest" |
             grep -o '"tag_name": *"[^"]*"' | head -1 | sed 's/.*: *"//; s/"$//') || latest=""
    if [ "$latest" != "$tag" ]; then
        echo "ports/publish: WARNING: $tag is published, but GitHub's latest release is '${latest:-nothing}'" >&2
        exit 1
    fi
    echo "==> $tag is published on $KDOS_REPO and is the latest release"
    exit 0
fi


# ── --describe ────────────────────────────────────────────────────────────
if [ "$DESCRIBE" = 1 ]; then
    [ "${#SRC_TAG[@]}" -gt 0 ] || die "ports/sources.idx names no archived file"
    for h in "${!SRC_TAG[@]}"; do TOUCHED[${SRC_TAG[$h]}]=1; done
    if [ "$DRY" = 1 ]; then
        echo "==> would rewrite the notes of ${#TOUCHED[@]} releases:"
        for tag in $(printf '%s\n' "${!TOUCHED[@]}" | LC_ALL=C sort); do
            title=$(release_title "$tag") || title="(title kept)"
            printf '  %-20s %s\n' "$tag" "$title"
        done
        exit 0
    fi
    read_recipes
    load_token
    describe_touched
    exit "$RC"
fi

# ── --retire ──────────────────────────────────────────────────────────────
#
# A legacy src-<name> release goes once --rehome has emptied it: the release
# first, then its tag, which deleting a release leaves behind. A src-<name>
# tag with no release — one a stopped run deleted the release of — goes too.
# A release still holding any asset, a starter included, is refused: its
# files may be the only copy a pushed index names. Volumes and system
# releases never match src-*, and nothing here touches them.
if [ "$RETIRE" = 1 ]; then
    load_token
    declare -A TAGRID=() SEEN_REF=()
    releases_list "$KDOS_SOURCES_REPO" > "$TMP/rels" || die "cannot list the releases of $KDOS_SOURCES_REPO"
    while IFS=$'\037' read -r id t; do
        case $t in src-*) TAGRID[$t]=$id ;; esac
    done < "$TMP/rels"
    # delete_tag <tag> — the git ref; one already gone is no failure.
    delete_tag() {
        if [ "$DRY" = 1 ]; then echo "  would delete tag $1"; return 0; fi
        pace
        gh DELETE "$GH_API/repos/$KDOS_SOURCES_REPO/git/refs/tags/$1"
        case $HTTP in
            204|404|422) echo "  deleted  tag $1" ;;
            *) fail "tag $1: delete HTTP $HTTP $(json_str message)"; return 1 ;;
        esac
    }
    nret=0 nheld=0
    for t in $(printf '%s\n' "${!TAGRID[@]}" | LC_ALL=C sort); do
        r=${TAGRID[$t]}
        release_assets "$KDOS_SOURCES_REPO" "$r" || { fail "cannot list $t"; continue; }
        if [ "${RA_N[$r]:-0}" -gt 0 ]; then
            echo "  holds    $t  ${RA_N[$r]} assets; kept (make publish-rehome empties it)"
            nheld=$((nheld + 1)); RC=1
            continue
        fi
        if [ "$DRY" = 1 ]; then
            echo "  would retire $t (empty)"
        else
            pace
            gh DELETE "$GH_API/repos/$KDOS_SOURCES_REPO/releases/$r"
            case $HTTP in
                204|404) echo "  retired  $t" ;;
                *) fail "$t: delete HTTP $HTTP $(json_str message)"; continue ;;
            esac
        fi
        delete_tag "$t" || continue
        SEEN_REF[$t]=1
        nret=$((nret + 1))
    done
    # Tags whose release is already gone. The listing is asked for page by
    # page and read until a page adds no tag, whether or not GitHub pages it.
    page=1
    while [ "$page" -le 50 ]; do
        gh GET "$GH_API/repos/$KDOS_SOURCES_REPO/git/matching-refs/tags/src-?per_page=100&page=$page"
        [ "$HTTP" = 200 ] || { fail "listing src-* tags: HTTP $HTTP"; break; }
        added=0
        while IFS= read -r t; do
            [ -n "$t" ] && [ -z "${SEEN_REF[$t]:-}" ] || continue
            SEEN_REF[$t]=1 added=1
            [ -z "${TAGRID[$t]:-}" ] || continue
            delete_tag "$t" && nret=$((nret + 1))
        done < <(grep -o '"ref": *"refs/tags/src-[^"]*"' "$TMP/body" | sed 's/.*refs\/tags\///; s/"$//')
        [ "$added" = 1 ] || break
        page=$((page + 1))
    done
    if [ "$DRY" = 1 ]; then
        echo "==> would retire $nret src-* releases or tags; $nheld still hold assets"
    else
        echo "==> retired $nret src-* releases or tags; $nheld still hold assets"
    fi
    exit "$RC"
fi

read_recipes
[ ! -e "$TMP/badport" ] || RC=1

# ── --plan ────────────────────────────────────────────────────────────────
#
# A shelf's planned count is every recipe hash it owns (the first port to
# name a hash owns it), parts counted: from the index for an archived file,
# from a local copy's size otherwise, and 1 when there is neither. Shelves
# without a volume are taken in C order and join the highest volume
# ports/shelves maps while its count stays within $VOLUME_FILL; then the
# next volume opens, numbered past any volume the index already names. A
# shelf larger than the fill has a volume to itself. The fill sits well under
# the 1000-asset cap so a volume has room for the versions to come.
if [ "$PLAN" = 1 ]; then
    [[ $VOLUME_FILL =~ ^[1-9][0-9]*$ ]] || die "KDOS_VOLUME_FILL=$VOLUME_FILL is not a positive integer"
    declare -A CNT=() FILL=() NEWV=()
    for h in "${R_ORDER[@]}"; do
        sh=${R_SHELF[$h]}
        n=${SRC_NPARTS[$h]:-}
        if [ -z "$n" ]; then
            size=$(local_size "$h" "${R_LABEL[$h]}")
            n=1
            [ -z "$size" ] || [ "$size" -le "$SRC_PART_SIZE" ] || n=$(( (size + SRC_PART_SIZE - 1) / SRC_PART_SIZE ))
        fi
        CNT[$sh]=$(( ${CNT[$sh]:-0} + n ))
    done
    cur=0
    for sh in "${!VOL[@]}"; do
        v=${VOL[$sh]}
        FILL[$v]=$(( ${FILL[$v]:-0} + ${CNT[$sh]:-0} ))
        [ "$v" -le "$cur" ] || cur=$v
    done
    top=$(top_volume)
    mapfile -t ALL < <(src_shelves | LC_ALL=C sort)
    for sh in "${ALL[@]}"; do
        [ -z "${VOL[$sh]:-}" ] || continue
        c=${CNT[$sh]:-0}
        if [ "$cur" -gt 0 ] && [ $(( ${FILL[$cur]:-0} + c )) -le "$VOLUME_FILL" ]; then
            v=$cur
        else
            [ "$top" -ge "$cur" ] || top=$cur
            top=$((top + 1)); v=$top; cur=$v
        fi
        VOL[$sh]=$v NEWV[$sh]=1
        FILL[$v]=$(( ${FILL[$v]:-0} + c ))
    done
    norph=0
    for h in "${!SRC_TAG[@]}"; do [ -n "${R_LABEL[$h]:-}" ] || norph=$((norph + 1)); done
    for v in $(printf '%s\n' "${VOL[@]}" | sort -nu); do
        mapfile -t sh < <(volume_shelves "$v")
        nnew=0
        for x in "${sh[@]}"; do [ -z "${NEWV[$x]:-}" ] || nnew=$((nnew + 1)); done
        printf '  %-11s %4d files  %3d shelves%s  %s\n' "sources-$v" "${FILL[$v]:-0}" "${#sh[@]}" \
            "$([ "$nnew" = 0 ] || echo " ($nnew new)")" "$(release_title "sources-$v")"
        printf '%s\n' "${sh[@]}" | fmt -w 92 | sed 's/^/                /'
    done
    echo "==> ${#NEWV[@]} shelves given a volume, fill $VOLUME_FILL; $norph indexed files no recipe names stay where they are, or go to the highest volume as attic--<file> when --rehome moves them"
    if [ "${#NEWV[@]}" = 0 ]; then
        echo "==> every shelf already has a volume"
        exit "$RC"
    fi
    if [ "$DRY" = 1 ]; then
        echo "==> dry run: ports/shelves unchanged"
        exit "$RC"
    fi
    f=$SRCLIB_PORTS/shelves
    for sh in "${!NEWV[@]}"; do printf '%s %s\n' "$sh" "${VOL[$sh]}"; done > "$TMP/newv"
    # Only the lines given a volume are rewritten: id, volume, description,
    # the id padded as the file pads it. A `-` placeholder is replaced; a
    # line with no volume field has one inserted before its description.
    awk 'FNR == NR { nv[$1] = $2; next }
         /^[[:space:]]*(#|$)/ || !($1 in nv) { print; next }
         {
             id = $1; rest = $0
             sub(/^[[:space:]]*[^[:space:]]+[[:space:]]*/, "", rest)
             if ($2 == "-") sub(/^-[[:space:]]*/, "", rest)
             printf "%-17s %-2s %s\n", id, nv[id], rest
         }' "$TMP/newv" "$f" > "$TMP/shelves"
    cat "$TMP/shelves" > "$f"
    echo "==> ports/shelves now maps ${#NEWV[@]} more shelves — commit it"
    exit "$RC"
fi

# ── --orphans ─────────────────────────────────────────────────────────────
#
# An orphan is an index line no current recipe names. It is PROTECTED when a
# recipe at any v* tag names it, or a build/freeze/*.sha256 lists it: a
# released system is rebuilt from those. --prune=yes-delete deletes every
# unprotected orphan's assets, each checked against its index hash first,
# then its line; a checkout older than the pruning that still names one of
# those files goes upstream for it.
if [ "$ORPHANS" = 1 ]; then
    declare -A PROT=()
    while IFS= read -r t; do
        while IFS= read -r h; do PROT[$h]=1; done < <(
            git -C "$REPO_ROOT" grep -h -o -E '[0-9a-f]{64}' "$t" -- ':(glob)ports/core/**/kpkgbuild' 2>/dev/null |
            grep -oE '[0-9a-f]{64}$' || true)
    done < <(git -C "$REPO_ROOT" tag -l 'v*')
    for f in "$REPO_ROOT"/build/freeze/*.sha256; do
        [ -f "$f" ] || continue
        while read -r h _; do
            if src_is_hash "$h"; then PROT[$h]=1; fi
        done < "$f"
    done
    ORPH=() nprot=0
    for h in $(printf '%s\n' "${!SRC_TAG[@]}" | LC_ALL=C sort); do
        [ -z "${R_LABEL[$h]:-}" ] || continue
        mark=""
        if [ -n "${PROT[$h]:-}" ]; then mark="  protected"; nprot=$((nprot + 1)); else ORPH+=("$h"); fi
        echo "$h ${SRC_TAG[$h]} ${SRC_ASSET[$h]} ${SRC_NAME[$h]}$mark"
    done
    echo "==> $(( ${#ORPH[@]} + nprot )) orphans, $nprot protected"
    [ -n "$PRUNE" ] || exit "$RC"
    [ "${#ORPH[@]}" -gt 0 ] || { echo "==> nothing to prune"; exit "$RC"; }
    index_ready
    load_token
    for h in "${ORPH[@]}"; do
        tag=${SRC_TAG[$h]} ok=1 i=0
        # A release that no longer exists holds nothing to delete.
        if archive_release "$tag" nocreate; then
            rid=$REL_ID
            release_assets "$KDOS_SOURCES_REPO" "$rid" || { fail "$h: cannot list $tag"; continue; }
            while IFS= read -r nm; do
                if [ "$i" = 0 ]; then exp=sha256:$h; else exp=sha256:${SRC_PHASH[$h,$i]}; fi
                i=$((i + 1))
                [ "${SRC_NPARTS[$h]}" -lt 2 ] || [ "$i" -gt 1 ] || continue
                info=$(asset_info "$rid" "$nm")
                [ -n "$info" ] || continue
                IFS=$'\037' read -r aid anm dig _ st _ <<< "$info"
                if [ "$dig" = null ] && [ "$st" != starter ]; then dig=$(known_digest "$KDOS_SOURCES_REPO" "$aid"); fi
                if [ "$dig" != "$exp" ] && [ "$st" != starter ]; then
                    fail "$h: $tag/$anm holds $dig, not $exp; kept"
                    ok=0; continue
                fi
                asset_delete "$KDOS_SOURCES_REPO" "$rid" "$aid" "$anm" || { fail "$h: deleting $tag/$anm"; ok=0; continue; }
                echo "  deleted  $tag/$anm"
            done < <(held_names "${SRC_ASSET[$h]}" "${SRC_NPARTS[$h]}")
        fi
        [ "$ok" = 1 ] || continue
        index_del "$h"
        TOUCHED[$tag]=1
        echo "  pruned   $h"
    done
    describe_touched
    [ "$INDEX_CHANGED" = 0 ] || echo "==> ports/sources.idx changed — commit it"
    exit "$RC"
fi

# ── --rehome ──────────────────────────────────────────────────────────────
#
# PHASE 1 moves each archived file that is not at home (placement) into its
# home: uploaded and verified there, then its index line rewritten. A file in
# a legacy src-<name> release, or under a name no current shelf of its ports
# gives it, is placed as a new file is, and spills when its volume is full; a
# file no current recipe names goes from a legacy release to the highest
# volume as attic--<file>, and one already in a volume stays, which is
# --orphans' business. A file that spilled moves to its own volume only when
# that has room, and otherwise stays where it is.
#
# PHASE 2 deletes old copies. An asset X in release T goes only when its
# digest is an indexed file's (or one of its parts'), both the working index
# and the pushed one (@{upstream}, as this clone last fetched or pushed it)
# place that file somewhere other than (T, X), and GitHub lists the working
# index's place with the right digests. Nothing is deleted until an index
# naming the new place is pushed, so a checkout of the pushed tree always
# finds its file. An asset whose digest no line names is a stray: reported,
# never deleted.
if [ "$REHOME" = 1 ]; then
    named_ports "${PORTS[@]}"
    MOVE=()
    declare -A M_SHELF=() M_LABEL=() M_ONLY=()
    for h in $(printf '%s\n' "${!SRC_TAG[@]}" | LC_ALL=C sort); do
        if [ -n "${R_LABEL[$h]:-}" ]; then
            [ "${#PORTS[@]}" = 0 ] || names_named "$h" || continue
        else
            [ "${#PORTS[@]}" = 0 ] || continue
        fi
        placement "$h"
        case $PL in
            home|attic) continue ;;
            spilled) M_SHELF[$h]=$PL_SHELF M_LABEL[$h]=${R_LABEL[$h]} M_ONLY[$h]=home ;;
            *) if [ -n "${R_LABEL[$h]:-}" ]; then
                   M_SHELF[$h]=${R_SHELF[$h]} M_LABEL[$h]=${R_LABEL[$h]}
               else
                   M_SHELF[$h]=attic M_LABEL[$h]=${SRC_NAME[$h]}
               fi ;;
        esac
        MOVE+=("$h")
    done
    if [ "$DRY" = 1 ]; then
        nstay=0
        for h in "${MOVE[@]}"; do
            n=${SRC_NPARTS[$h]}
            predict "$h" "${M_LABEL[$h]}" "${M_SHELF[$h]}" "$n" "${M_ONLY[$h]:-}"
            if [ -z "$PRED_TAG" ] && [ -n "${M_ONLY[$h]:-}" ]; then
                printf '  stays    %s  %s/%s: %s is full\n' "$h" "${SRC_TAG[$h]}" "${SRC_ASSET[$h]}" "$(home_tag "${M_SHELF[$h]}")"
                nstay=$((nstay + 1)); continue
            fi
            printf '  move     %s  %s/%s -> %s/%s (predicted)%s\n' "$h" "${SRC_TAG[$h]}" "${SRC_ASSET[$h]}" \
                "${PRED_TAG:-(no volume)}" "${PRED:-(no free name)}" "$([ "$n" -lt 2 ] || echo ", $n parts")"
        done
        echo "==> would move $(( ${#MOVE[@]} - nstay )) files; a run after the index is pushed deletes the old copies"
        exit "$RC"
    fi
    index_ready
    load_token
    nmoved=0 nstay=0
    for h in "${MOVE[@]}"; do
        old=${SRC_TAG[$h]}
        file=$(find_bytes "$h" "${M_LABEL[$h]}") || file=$(fetch_archived "$h") ||
            { fail "$h  ${M_LABEL[$h]}: no local copy, and the archive's did not verify"; continue; }
        rc=0
        store "$h" "$file" "${M_LABEL[$h]}" "${M_SHELF[$h]}" ${M_ONLY[$h]:+"${M_ONLY[$h]}"} || rc=$?
        case $rc in
            0) TOUCHED[$old]=1; nmoved=$((nmoved + 1))
               echo "  moved    $h  $old -> ${SRC_TAG[$h]}/${SRC_ASSET[$h]}" ;;
            2) conflict "$h  ${M_LABEL[$h]}" ;;
            3) if [ -n "${M_ONLY[$h]:-}" ]; then
                   echo "  stays    $h  $old/${SRC_ASSET[$h]}: its own volume is full"
                   nstay=$((nstay + 1))
               else
                   fail "$h  ${M_LABEL[$h]}"
               fi ;;
            *) fail "$h  ${M_LABEL[$h]}" ;;
        esac
    done
    echo "==> phase 1: $nmoved of $(( ${#MOVE[@]} - nstay )) files moved$([ "$nstay" = 0 ] || echo "; $nstay spilled files stay")"

    if ! up=$(git -C "$REPO_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) ||
       ! git -C "$REPO_ROOT" show "@{upstream}:ports/sources.idx" > "$TMP/upidx" 2>/dev/null; then
        echo "==> phase 2: no upstream branch; push the index, then run --rehome again"
    else
        # The pushed index, format 2 only: any other names no place.
        declare -A U_TAG=() U_ASSET=() D2H=() TAGRID=()
        if [ "$(head -1 "$TMP/upidx")" = "$SRC_INDEX_MARKER" ]; then
            while read -r h t a _; do
                if src_is_hash "$h"; then U_TAG[$h]=$t U_ASSET[$h]=$a; fi
            done < "$TMP/upidx"
        fi
        # Digest -> "<hash> <part>", part 0 for a whole file.
        for h in "${!SRC_TAG[@]}"; do
            D2H[$h]="$h 0"
            np=${SRC_NPARTS[$h]}
            for ((i = 1; np >= 2 && i <= np; i++)); do
                D2H[${SRC_PHASH[$h,$i]}]="$h $i"
            done
        done
        while IFS=$'\037' read -r id t; do
            case $t in src-*|sources-*) TAGRID[$t]=$id ;; esac
        done < <(releases_list "$KDOS_SOURCES_REPO")
        for t in "${!TAGRID[@]}"; do
            RID[$t]=${TAGRID[$t]}
            release_assets "$KDOS_SOURCES_REPO" "${TAGRID[$t]}" || { fail "cannot list $t"; unset "TAGRID[$t]"; }
        done
        # place <tag> <asset> <part> — "<tag>/<name in lower case>" of part
        # <part> (0: the whole) of a file stored as <asset> in <tag>.
        place() {
            local p=$2
            [ "$3" = 0 ] || printf -v p '%s.part%02d' "$2" "$3"
            printf '%s/%s\n' "$1" "${p,,}"
        }
        # at_home <hash> — the working index's place for the hash is listed
        # with the right digest, every part of it.
        at_home() {
            local h=$1 r=${TAGRID[${SRC_TAG[$1]}]:-} nm i=0 exp
            [ -n "$r" ] || return 1
            while IFS= read -r nm; do
                if [ "$i" = 0 ]; then exp=sha256:$h; else exp=sha256:${SRC_PHASH[$h,$i]}; fi
                i=$((i + 1))
                [ "${SRC_NPARTS[$h]}" -lt 2 ] || [ "$i" -gt 1 ] || continue
                [ "${RA_DIG[$r/$nm]:-}" = "$exp" ] || return 1
            done < <(held_names "${SRC_ASSET[$h]}" "${SRC_NPARTS[$h]}")
            return 0
        }
        swept=0 strays=0
        for t in $(printf '%s\n' "${!TAGRID[@]}" | LC_ALL=C sort); do
            r=${TAGRID[$t]}
            while IFS= read -r k; do
                [ -n "$k" ] && [ -n "${RA_ID[$r/$k]:-}" ] || continue
                aid=${RA_ID[$r/$k]} anm=${RA_NAME[$r/$k]} dig=${RA_DIG[$r/$k]} st=${RA_STATE[$r/$k]}
                if [ "$st" = starter ]; then
                    asset_delete "$KDOS_SOURCES_REPO" "$r" "$aid" "$anm" &&
                        echo "  deleted  $t/$anm (an upload GitHub never completed)"
                    continue
                fi
                hi=${D2H[${dig#sha256:}]:-}
                if [ "$dig" = null ] || [ -z "$hi" ]; then
                    echo "  stray    $t/$anm  ($dig)"
                    strays=$((strays + 1)); continue
                fi
                read -r h i <<< "$hi"
                [ "$t/$k" != "$(place "${SRC_TAG[$h]}" "${SRC_ASSET[$h]}" "$i")" ] || continue
                [ -n "${U_TAG[$h]:-}" ] || continue
                [ "$t/$k" != "$(place "${U_TAG[$h]}" "${U_ASSET[$h]}" "$i")" ] || continue
                at_home "$h" || continue
                asset_delete "$KDOS_SOURCES_REPO" "$r" "$aid" "$anm" || { fail "deleting $t/$anm"; continue; }
                echo "  deleted  $t/$anm (kept in ${SRC_TAG[$h]})"
                TOUCHED[$t]=1
                swept=$((swept + 1))
            done <<< "${RA_KEYS[$r]:-}"
        done
        echo "==> phase 2: $swept old copies deleted against $up, $strays strays left"
    fi
    describe_touched
    [ "$INDEX_CHANGED" = 0 ] || echo "==> ports/sources.idx changed — commit and push it, then run --rehome again"
    exit "$RC"
fi

# ── the archive ───────────────────────────────────────────────────────────
if [ "${#PORTS[@]}" -gt 0 ]; then
    named_ports "${PORTS[@]}"
    for h in "${R_ORDER[@]}"; do
        if names_named "$h"; then want "$h" "${R_LABEL[$h]}" "${R_SHELF[$h]}"; fi
    done
else
    for h in "${R_ORDER[@]}"; do want "$h" "${R_LABEL[$h]}" "${R_SHELF[$h]}"; done
fi

# History names objects this clone never downloaded: old versions, and paths
# outside ports/core. Only a ports/core object is wanted — the archive serves
# what a recipe hashes, and nothing asks it for anything else — and only one
# held in the LFS store or the cache; the rest are counted and left to a clone
# that holds them. A path in history may carry a shelf or not; each is
# labelled <port>/<file> and goes to its port's shelf today, or, when the
# port is gone, to the highest volume as attic--<file>. Without git-lfs no object can be labelled, and an
# unlabelled file has no name to be stored under.
if [ "$HISTORY" = 1 ]; then
    if git -C "$REPO_ROOT" lfs version >/dev/null 2>&1; then
        declare -A NOCOPY=()
        while read -r h _ f; do
            src_is_hash "$h" || continue
            case $f in ports/core/*) ;; *) continue ;; esac
            [ -z "${SEEN[$h]:-}" ] || continue
            if [ -f "$KDOS_LFS_STORE/${h:0:2}/${h:2:2}/$h" ] || [ -f "$(src_cache_path "$h")" ]; then
                lab=$(src_label "$f")
                sh=$(src_port_shelf "${lab%%/*}" 2>/dev/null) || sh=attic
                want "$h" "$lab" "$sh"
            else
                NOCOPY[$h]=1
            fi
        done < <(git -C "$REPO_ROOT" lfs ls-files --all -l)
        [ "${#NOCOPY[@]}" = 0 ] ||
            echo "==> ${#NOCOPY[@]} objects history names are in neither the LFS store nor the cache; skipped"
    else
        nlfs=$(find "$KDOS_LFS_STORE" -mindepth 3 -maxdepth 3 -type f 2>/dev/null | wc -l)
        echo "==> $nlfs objects in the LFS store skipped: install git-lfs to label them"
    fi
fi

MISS_I=()
if [ "$DRY" = 1 ]; then
    # No network: an indexed file is taken as present, and only what the
    # index does not name is planned.
    nidx=0
    for i in "${!W_HASH[@]}"; do
        if [ -n "${SRC_TAG[${W_HASH[$i]}]:-}" ]; then nidx=$((nidx + 1)); else MISS_I+=("$i"); fi
    done
    echo "==> ${#W_HASH[@]} sources wanted; $nidx indexed, taken as present (a dry run asks no server)"
else
    echo "==> ${#W_HASH[@]} sources wanted; checking the archive"
    for i in "${!W_HASH[@]}"; do
        present "${W_HASH[$i]}" || MISS_I+=("$i")
    done
fi

if [ "$CHECK" = 1 ]; then
    for i in "${MISS_I[@]}"; do
        h=${W_HASH[$i]}
        why="not in ports/sources.idx"
        [ -z "${SRC_TAG[$h]:-}" ] || why="indexed in ${SRC_TAG[$h]} as ${SRC_ASSET[$h]} but absent"
        printf '  missing  %s  %s  (%s)\n' "$h" "${W_LABEL[$i]}" "$why"
    done
    echo "==> ${#MISS_I[@]} of ${#W_HASH[@]} missing"
    [ "${#MISS_I[@]}" = 0 ] && [ "$RC" = 0 ] && exit 0
    exit 1
fi

# Hash order, so a run's uploads are reproducible.
PLAN=() total=0
while read -r i; do
    [ -n "$i" ] || continue
    h=${W_HASH[$i]}
    if ! file=$(find_bytes "$h" "${W_LABEL[$i]}"); then
        fail "$h  ${W_LABEL[$i]}: no local copy hashes to it (run ports/fetch)"
        continue
    fi
    size=$(stat -c %s "$file")
    total=$((total + size))
    PLAN+=("$h|$file|${W_LABEL[$i]}|$size")
done < <(for i in "${MISS_I[@]}"; do echo "${W_HASH[$i]} $i"; done | LC_ALL=C sort | cut -d' ' -f2)

if [ "$DRY" = 1 ]; then
    declare -A TARGETS=()
    for p in "${PLAN[@]}"; do
        IFS='|' read -r h file label size <<< "$p"
        n=$(( (size + SRC_PART_SIZE - 1) / SRC_PART_SIZE ))
        [ "$n" -ge 2 ] || n=1
        predict "$h" "$label" "${W_SHELF[$h]}" "$n"
        if [ -z "$PRED_TAG" ]; then
            printf '  upload   %s  %s: shelf %s has no volume; run ports/publish --plan\n' "$h" "$label" "${W_SHELF[$h]}"
            RC=1; continue
        fi
        home=$(home_tag "${W_SHELF[$h]}")
        [ "$PRED_TAG" = "$home" ] || echo "  spilled  $label: $home is full; $PRED_TAG has room"
        TARGETS[$PRED_TAG]=1
        printf '  upload   %-12s %8s  %s  %s -> %s (predicted)%s\n' "$PRED_TAG" "$(human "$size")" "$h" "$label" \
            "${PRED:-(no free name)}" "$([ "$n" -lt 2 ] || echo ", $n parts")"
    done
    echo "==> would upload ${#PLAN[@]} files, $(human "$total"), into ${#TARGETS[@]} volumes"
    exit "$RC"
fi

[ "${#PLAN[@]}" = 0 ] && { echo "==> nothing to upload"; exit "$RC"; }
index_ready
load_token
n=0
for p in "${PLAN[@]}"; do
    IFS='|' read -r h file label size <<< "$p"
    n=$((n + 1))
    rc=0
    # A line naming a volume is repaired in place; one naming a legacy
    # release is placed afresh, since no legacy release is ever created.
    if [[ ${SRC_TAG[$h]:-} =~ ^sources-[1-9][0-9]*$ ]]; then
        store "$h" "$file" "${SRC_NAME[$h]}" "${W_SHELF[$h]}" "${SRC_TAG[$h]}" "${SRC_ASSET[$h]}" || rc=$?
    else
        store "$h" "$file" "$label" "${W_SHELF[$h]}" || rc=$?
    fi
    case $rc in
        0) printf '  [%d/%d] %s/%s  %s  %s\n' "$n" "${#PLAN[@]}" "${SRC_TAG[$h]}" "${SRC_ASSET[$h]}" "$(human "$size")" "$label" ;;
        2) conflict "$h  $label" ;;
        *) fail "$h  $label" ;;
    esac
done
describe_touched
echo "==> done: $n planned, exit $RC"
[ "$INDEX_CHANGED" = 0 ] || echo "==> ports/sources.idx changed — commit it with the recipes that need it"
exit "$RC"
