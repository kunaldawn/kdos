# Smart fetch - Download sources to ports directories
# Reads kpkgbuild files to determine what to download
#
# A recipe is a config file, not a shell script, so this cannot source it any
# more. `kpkg meta` prints the same fields as shell assignments and this evals
# those instead — one parser, in C, shared with the build. kpkg is compiled
# here on the host for that, the way ports/appbox/fetch already compiles
# kdos-appbox for `image pack`: it links nothing but libc and takes a second.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT_REPO="$SCRIPT_DIR/core"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
# kdos-kpkg's PRIMARY dispatch is argv[0]'s basename (main.c's `self`); the
# argv[1] fallback it also has is one dispatcher refactor away from silently
# breaking every caller that relies on it, the way it already broke this
# script's own `.kpkg-meta meta .` once. So the on-demand build's OUTPUT
# NAME is what has to be "kpkg" — not an extra argv token at the call site.
KPKG="${KPKG_BIN:-$SCRIPT_DIR/.kpkgbin/kpkg}"

if [ ! -x "$KPKG" ]; then
    echo "==> Building the recipe reader..."
    mkdir -p "$(dirname "$KPKG")"
    # kdos-kpkg links libkbase, libkpkg AND libksig — kdos-kpkg.h includes
    # ksig.h. The same command line lives in src/tools/kdos-portup/main.c and
    # testing/selftest.sh; all three must list the same set, or the recipe
    # reader fails to compile and this exits before downloading anything.
    ${CC:-cc} -O2 -std=gnu11 -D_GNU_SOURCE \
        -I"$REPO_ROOT/src/libs/libkbase" -I"$REPO_ROOT/src/libs/libkpkg" \
        -I"$REPO_ROOT/src/libs/libksig" \
        -I"$REPO_ROOT/src/packages/kdos-kpkg" -o "$KPKG" \
        "$REPO_ROOT"/src/packages/kdos-kpkg/*.c \
        "$REPO_ROOT"/src/libs/libkbase/*.c "$REPO_ROOT"/src/libs/libkpkg/*.c \
        "$REPO_ROOT"/src/libs/libksig/*.c "$REPO_ROOT"/src/libs/libksig/monocypher/*.c
fi

echo "==> Fetching sources for all ports..."

fetch_port() {
    # `if fetch_port …` disables set -e for this whole function, so every
    # fallible step has to report failure itself. Without this a failed
    # cargo vendor returns the last echo's status — 0 — and kdos-portup's
    # accept path sees success, never reverts, and leaves a bumped recipe
    # beside a broken vendor bundle.
    local portdir=$1
    local portname=$(basename "$portdir")

    cd "$portdir" || return 1
    
    # Check if kpkgbuild exists
    if [ ! -f "./kpkgbuild" ]; then
        echo "⚠  $portname: No kpkgbuild found"
        return 0
    fi
    
    # Ask kpkg for the metadata; it prints shell assignments. $KPKG's own
    # basename is literally "kpkg", so this resolves through kdos-kpkg's
    # PRIMARY dispatch (argv[0] -> front_main), not its argv[1] fallback.
    unset name version release source sha256 vendoring pypackages
    local meta
    meta=$("$KPKG" meta . 2>/dev/null) || {
        echo "⚠  $portname: Failed to read kpkgbuild"
        return 0
    }
    eval "$meta"
    
    [ -z "$source" ] && [ -z "$pypackages" ] && {
        echo "⚠  $portname: No source or pypackages defined"
        return 0
    }
    
    # Download each source
    src_idx=0
    for src in $source; do
        case $src in
            *::*)
                # Format: filename::url
                filename="${src%%::*}"
                url="${src#*::}"
                ;;
            http://*|https://*|ftp://*)
                # Automatic renaming to name-version.ext
                url="$src"
                
                # Default filename to basename
                filename=$(basename "$url")

                # Detect extension
                if [[ "$url" =~ \.tar\.gz$ || "$url" =~ \.tgz$ ]]; then
                    ext="tar.gz"
                elif [[ "$url" =~ \.tar\.bz2$ || "$url" =~ \.tbz2$ ]]; then
                    ext="tar.bz2"
                elif [[ "$url" =~ \.tar\.xz$ || "$url" =~ \.txz$ ]]; then
                    ext="tar.xz"
                elif [[ "$url" =~ \.tar\.zst$ ]]; then
                    ext="tar.zst"
                elif [[ "$url" =~ \.zip$ ]]; then
                    ext="zip"
                else
                    ext=""
                fi
                
                if [ -n "$ext" ] && [ $src_idx -eq 0 ]; then
                    filename="$name-$version.$ext"
                fi
                ;;
            *)
                # Local file or plain filename
                filename="$src"
                
                # If it's just a filename (no path separators), checks if it exists
                if [[ "$filename" != */* ]]; then
                    echo "⊙  $portname: $src (local file)"
                    continue
                else
                    # It might be a path relative to port dir? 
                    echo "⊙  $portname: $src (local file path)"
                    continue
                fi
                ;;
        esac
        
        # A ZERO-BYTE FILE IS NOT A DOWNLOAD. An interrupted or refused
        # transfer leaves the -O target created and empty, and treating it as
        # present makes every later run skip the fetch — while sha256sum of
        # nothing is a perfectly stable digest, so a recipe written from that
        # state verifies clean and the build is the first thing to notice.
        if [ -f "./$filename" ] && [ ! -s "./$filename" ]; then
            echo "⚠  $portname: $filename is empty — refetching"
            rm -f "./$filename"
        fi

        if [ -f "./$filename" ]; then
            echo "✓  $portname: $filename exists"
        else
            echo "⬇  $portname: Downloading $filename..."
            wget -q --show-progress -O "./$filename" "$url" || {
                echo "✗  $portname: Failed to download $filename"
                rm -f "./$filename"
                return 1
            }
            # A server can answer 200 with nothing; wget is content with that.
            if [ ! -s "./$filename" ]; then
                echo "✗  $portname: $filename came back empty"
                rm -f "./$filename"
                return 1
            fi
            echo "✓  $portname: Downloaded $filename"
        fi

        # Verify against the recipe's sha256, if it names one for this file.
        # A freshly downloaded tarball is the ONLY moment the bytes are not
        # yet pinned by git, so this is where a substituted upstream would
        # get caught. `kpkg meta` emits $sha256 as alternating
        # "<hex> <name>" tokens.
        if [ -n "$sha256" ]; then
            want=$(echo "$sha256" | tr -s ' \t' '\n\n' | awk -v f="$filename" \
                   'NR%2==1{h=$0} NR%2==0 && $0==f {print h; exit}')
            if [ -n "$want" ]; then
                got=$(sha256sum "./$filename" | cut -d" " -f1)
                if [ "$got" != "$want" ]; then
                    echo "✗  $portname: sha256 MISMATCH for $filename"
                    echo "   expected $want"
                    echo "   got      $got"
                    rm -f "./$filename"
                    return 1
                fi
                echo "✓  $portname: sha256 verified"
            elif [ -z "${KDOS_ALLOW_UNVERIFIED:-}" ]; then
                echo "⚠  $portname: no sha256 for $filename in the recipe"
            fi
        fi

        src_idx=$((src_idx + 1))
    done
    
    # Handle vendoring if requested
    if [ "$vendoring" = "rust" ]; then
        vendor_file="${name}-vendor-${version}.tar.xz"
        if [ -f "./$vendor_file" ]; then
             echo "✓  $portname: Vendor file $vendor_file exists"
        else
            echo "⚙  $portname: Generating vendor tarball..."
            
            # Create temp dir
            tmp_dir=$(mktemp -d)
            
            # Extract main source (assume first source is main)
            first_src=$(echo $source | cut -d' ' -f1)
            case $first_src in
                *::*) filename="${first_src%%::*}" ;;
                http://*|https://*|ftp://*)
                     url="$first_src"
                     if [[ "$url" =~ \.tar\.gz$ || "$url" =~ \.tgz$ ]]; then ext="tar.gz"
                     elif [[ "$url" =~ \.tar\.bz2$ || "$url" =~ \.tbz2$ ]]; then ext="tar.bz2"
                     elif [[ "$url" =~ \.tar\.xz$ || "$url" =~ \.txz$ ]]; then ext="tar.xz"
                     elif [[ "$url" =~ \.tar\.zst$ ]]; then ext="tar.zst"
                     elif [[ "$url" =~ \.zip$ ]]; then ext="zip"
                     else ext=""; fi
                     
                     if [ -n "$ext" ]; then
                         filename="$name-$version.$ext"
                     else
                         filename=$(basename "$url")
                     fi
                     ;;
                *) filename="$first_src" ;;
            esac
            
            tar xf "$filename" -C "$tmp_dir" --strip-components=1 || {
                echo "✗  $portname: Failed to extract $filename"
                rm -rf "$tmp_dir"
                return 1
            }

            # Vendor dependencies
            pushd "$tmp_dir" >/dev/null
            mkdir -p .cargo
            cargo vendor > .cargo/config.toml || {
                echo "✗  $portname: cargo vendor failed"
                popd >/dev/null
                rm -rf "$tmp_dir"
                return 1
            }

            # Create vendor tarball
            if [ -f Cargo.lock ]; then
                tar -cJf "$portdir/$vendor_file" vendor .cargo Cargo.lock || {
                    echo "✗  $portname: Failed to create $vendor_file"
                    popd >/dev/null
                    rm -rf "$tmp_dir"
                    return 1
                }
            else
                tar -cJf "$portdir/$vendor_file" vendor .cargo || {
                    echo "✗  $portname: Failed to create $vendor_file"
                    popd >/dev/null
                    rm -rf "$tmp_dir"
                    return 1
                }
            fi
            popd >/dev/null

            # Cleanup
            rm -rf "$tmp_dir"
            echo "✓  $portname: Created $vendor_file"
        fi
    elif [ "$vendoring" = "go" ]; then
        vendor_file="${name}-vendor-${version}.tar.xz"
        if [ -f "./$vendor_file" ]; then
             echo "✓  $portname: Vendor file $vendor_file exists"
        else
            echo "⚙  $portname: Generating vendor tarball (Go)..."
            tmp_dir=$(mktemp -d)
            first_src=$(echo $source | cut -d' ' -f1)
            case $first_src in
                *::*) filename="${first_src%%::*}" ;;
                http://*|https://*|ftp://*)
                     url="$first_src"
                     if [[ "$url" =~ \.tar\.gz$ || "$url" =~ \.tgz$ ]]; then ext="tar.gz"
                     elif [[ "$url" =~ \.tar\.bz2$ || "$url" =~ \.tbz2$ ]]; then ext="tar.bz2"
                     elif [[ "$url" =~ \.tar\.xz$ || "$url" =~ \.txz$ ]]; then ext="tar.xz"
                     elif [[ "$url" =~ \.tar\.zst$ ]]; then ext="tar.zst"
                     elif [[ "$url" =~ \.zip$ ]]; then ext="zip"
                     else ext=""; fi
                     
                     if [ -n "$ext" ]; then
                         filename="$name-$version.$ext"
                     else
                         filename=$(basename "$url")
                     fi
                     ;;
                *) filename="$first_src" ;;
            esac
            
            tar xf "$filename" -C "$tmp_dir" --strip-components=1 || {
                echo "✗  $portname: Failed to extract $filename"
                rm -rf "$tmp_dir"
                return 1
            }

            pushd "$tmp_dir" >/dev/null
            go mod vendor || {
                echo "✗  $portname: go mod vendor failed"
                popd >/dev/null
                rm -rf "$tmp_dir"
                return 1
            }
            tar -cJf "$portdir/$vendor_file" vendor || {
                echo "✗  $portname: Failed to create $vendor_file"
                popd >/dev/null
                rm -rf "$tmp_dir"
                return 1
            }
            popd >/dev/null

            rm -rf "$tmp_dir"
            echo "✓  $portname: Created $vendor_file"
        fi
    elif [ "$vendoring" = "node" ]; then
        vendor_file="${name}-vendor-${version}.tar.xz"
        if [ -f "./$vendor_file" ]; then
             echo "✓  $portname: Vendor file $vendor_file exists"
        else
            echo "⚙  $portname: Generating vendor tarball (Node)..."
            tmp_dir=$(mktemp -d)
            first_src=$(echo $source | cut -d' ' -f1)
            case $first_src in
                *::*) filename="${first_src%%::*}" ;;
                http://*|https://*|ftp://*)
                     url="$first_src"
                     if [[ "$url" =~ \.tar\.gz$ || "$url" =~ \.tgz$ ]]; then ext="tar.gz"
                     elif [[ "$url" =~ \.tar\.bz2$ || "$url" =~ \.tbz2$ ]]; then ext="tar.bz2"
                     elif [[ "$url" =~ \.tar\.xz$ || "$url" =~ \.txz$ ]]; then ext="tar.xz"
                     elif [[ "$url" =~ \.tar\.zst$ ]]; then ext="tar.zst"
                     elif [[ "$url" =~ \.zip$ ]]; then ext="zip"
                     else ext=""; fi
                     
                     if [ -n "$ext" ]; then
                         filename="$name-$version.$ext"
                     else
                         filename=$(basename "$url")
                     fi
                     ;;
                *) filename="$first_src" ;;
            esac
            
            tar xf "$filename" -C "$tmp_dir" --strip-components=1 || {
                echo "✗  $portname: Failed to extract $filename"
                rm -rf "$tmp_dir"
                return 1
            }

            pushd "$tmp_dir" >/dev/null
            npm install --ignore-scripts --no-audit --no-fund || {
                echo "✗  $portname: npm install failed"
                popd >/dev/null
                rm -rf "$tmp_dir"
                return 1
            }
            tar -cJf "$portdir/$vendor_file" node_modules || {
                echo "✗  $portname: Failed to create $vendor_file"
                popd >/dev/null
                rm -rf "$tmp_dir"
                return 1
            }
            popd >/dev/null

            rm -rf "$tmp_dir"
            echo "✓  $portname: Created $vendor_file"
        fi
    elif [ "$vendoring" = "python" ] || [ -n "$pypackages" ]; then
        vendor_file="${name}-vendor-${version}.tar.xz"
        if [ -f "./$vendor_file" ]; then
             echo "✓  $portname: Vendor file $vendor_file exists"
        else
            echo "⚙  $portname: Generating vendor tarball (Python)..."
            tmp_dir=$(mktemp -d)
            
            # Extract main source if it exists
            if [ -n "$source" ]; then
                first_src=$(echo $source | cut -d' ' -f1)
                case $first_src in
                    *::*) filename="${first_src%%::*}" ;;
                    http://*|https://*|ftp://*)
                         url="$first_src"
                         if [[ "$url" =~ \.tar\.gz$ || "$url" =~ \.tgz$ ]]; then ext="tar.gz"
                         elif [[ "$url" =~ \.tar\.bz2$ || "$url" =~ \.tbz2$ ]]; then ext="tar.bz2"
                         elif [[ "$url" =~ \.tar\.xz$ || "$url" =~ \.txz$ ]]; then ext="tar.xz"
                         elif [[ "$url" =~ \.tar\.zst$ ]]; then ext="tar.zst"
                         elif [[ "$url" =~ \.zip$ ]]; then ext="zip"
                         else ext=""; fi
                         
                         if [ -n "$ext" ]; then
                             filename="$name-$version.$ext"
                         else
                             filename=$(basename "$url")
                         fi
                         ;;
                    *) filename="$first_src" ;;
                esac
                
                if [ -f "$filename" ]; then
                    tar xf "$filename" -C "$tmp_dir" --strip-components=1 || {
                        echo "✗  $portname: Failed to extract $filename"
                        rm -rf "$tmp_dir"
                        return 1
                    }
                fi
            fi
            case $first_src in
                *::*) filename="${first_src%%::*}" ;;
                http://*|https://*|ftp://*)
                     url="$first_src"
                     if [[ "$url" =~ \.tar\.gz$ || "$url" =~ \.tgz$ ]]; then ext="tar.gz"
                     elif [[ "$url" =~ \.tar\.bz2$ || "$url" =~ \.tbz2$ ]]; then ext="tar.bz2"
                     elif [[ "$url" =~ \.tar\.xz$ || "$url" =~ \.txz$ ]]; then ext="tar.xz"
                     elif [[ "$url" =~ \.tar\.zst$ ]]; then ext="tar.zst"
                     elif [[ "$url" =~ \.zip$ ]]; then ext="zip"
                     else ext=""; fi
                     
                     if [ -n "$ext" ]; then
                         filename="$name-$version.$ext"
                     else
                         filename=$(basename "$url")
                     fi
                     ;;
                *) filename="$first_src" ;;
            esac
            
            pushd "$tmp_dir" >/dev/null
            mkdir -p vendor
            
            # Download pypackages if defined. This — and the setup.py/
            # pyproject.toml branch below it — is the python equivalent of
            # `cargo vendor`/`go mod vendor`: the one call that has to
            # succeed for the bundle to be worth anything, so unlike the
            # best-effort recursive build-dependency crawl further down
            # (which may legitimately find nothing for a given package),
            # its failure has to abort the whole vendor step.
            if [ -n "$pypackages" ]; then
                echo "   Downloading requested pypackages..."
                # Convert pkg:ver -> pkg==ver
                reqs=""
                for pkg in $pypackages; do
                    req=$(echo "$pkg" | sed 's/:/==/g' | sed 's/=/==/g' | sed 's/====/==/g')
                    reqs="$reqs $req"
                done
                pip3 download --no-binary :all: --dest vendor $reqs || {
                    echo "✗  $portname: pypackages download failed"
                    popd >/dev/null
                    rm -rf "$tmp_dir"
                    return 1
                }
            elif [ -f "setup.py" ] || [ -f "pyproject.toml" ]; then
                echo "   Downloading runtime dependencies (source only)..."
                pip3 download --no-binary :all: --dest vendor . || {
                    echo "✗  $portname: runtime dependency download failed"
                    popd >/dev/null
                    rm -rf "$tmp_dir"
                    return 1
                }
            fi
            
            if [ -f "requirements.txt" ]; then
                echo "   Found requirements.txt, downloading dependencies..."
                pip3 download --no-binary :all: --dest vendor -r requirements.txt || echo "⚠  requirements.txt dependency download failed"
            fi

            # Check main package build dependencies
            if [ -f "pyproject.toml" ]; then
                echo "   Checking pyproject.toml for build-system requires..."
                build_reqs=$(python3 -c "import sys; import tomllib; print('\n'.join(tomllib.load(sys.stdin.buffer).get('build-system', {}).get('requires', [])))" < pyproject.toml 2>/dev/null || true)

                if [ -n "$build_reqs" ]; then
                    echo "   Downloading build dependencies (source only)..."
                    echo "$build_reqs" > requirements.txt
                    pip3 download --no-binary :all: --dest vendor -r requirements.txt || echo "⚠  Build dependency download failed"
                    rm requirements.txt
                fi
            fi

            # Recursive build dependency fetching
            echo "   Recursively fetching build dependencies..."
            touch processed.txt
            while true; do
                initial_count=$(ls vendor | wc -l)
                found_new=false
                rm -f batch_requirements.txt
                touch batch_requirements.txt
                
                # Iterate over all tarballs in vendor
                for tarball in vendor/*.tar.gz vendor/*.tar.bz2 vendor/*.tar.xz vendor/*.zip; do
                    [ -f "$tarball" ] || continue
                    basename=$(basename "$tarball")
                    
                    # Skip if already processed
                    if grep -Fxq "$basename" processed.txt; then
                        continue
                    fi
                    
                    found_new=true
                    
                    # Extract pyproject.toml to a temp location
                    if tar -tf "$tarball" | grep -q "pyproject.toml"; then
                        sub_tmp=$(mktemp -d)
                        tar -xf "$tarball" -C "$sub_tmp" --wildcards "*/pyproject.toml" --strip-components=1 2>/dev/null || tar -xf "$tarball" -C "$sub_tmp" --wildcards "*/pyproject.toml" 2>/dev/null
                        
                        if [ -f "$sub_tmp/pyproject.toml" ]; then
                            # Parse build-system.requires
                            build_reqs=$(python3 -c "import sys; import tomllib; print('\n'.join(tomllib.load(sys.stdin.buffer).get('build-system', {}).get('requires', [])))" < "$sub_tmp/pyproject.toml" 2>/dev/null || true)
                            
                            if [ -n "$build_reqs" ]; then
                                echo "$build_reqs" >> batch_requirements.txt
                                echo "     Found dependencies in $tarball: $build_reqs"
                            fi
                        fi
                        rm -rf "$sub_tmp"
                    fi
                    
                    # Mark as processed
                    echo "$basename" >> processed.txt
                done
                
                # If we collected any requirements in this batch, download them all at once
                if [ -s "batch_requirements.txt" ]; then
                    echo "   Downloading batched build dependencies..."
                    pip3 download --no-binary :all: --dest vendor -r batch_requirements.txt || echo "⚠  Batched build dependency download failed"
                    rm batch_requirements.txt
                fi

                # If we didn't find any new tarballs to process, break
                if [ "$found_new" = false ]; then
                    break
                fi
                
                final_count=$(ls vendor | wc -l)
                echo "   Fetched new build dependencies (total: $final_count)..."
            done
            rm processed.txt

            tar -cJf "$portdir/$vendor_file" vendor || {
                echo "✗  $portname: Failed to create $vendor_file"
                popd >/dev/null
                rm -rf "$tmp_dir"
                return 1
            }
            popd >/dev/null

            rm -rf "$tmp_dir"
            echo "✓  $portname: Created $vendor_file"
        fi
    fi

    return 0
}

# Fetch all ports, or only the ones named on the command line — a single
# accepted version bump (kdos-portup) has no business re-fetching all ~390.
total=0
success=0
failed=0

wanted() {
    local name=$1
    shift
    # $# is the FILTER list, name already shifted off — checking it before
    # the shift counted the name itself as a "filter" and excluded every
    # port when the script was run with no arguments at all.
    [ $# -eq 0 ] && return 0
    local w
    for w in "$@"; do
        [ "$w" = "$name" ] && return 0
    done
    return 1
}

for portdir in "$PORT_REPO"/*; do
    [ -d "$portdir" ] || continue
    wanted "$(basename "$portdir")" "$@" || continue
    total=$((total + 1))

    if fetch_port "$portdir"; then
        success=$((success + 1))
    else
        failed=$((failed + 1))
    fi
done

if [ $# -gt 0 ] && [ "$total" -eq 0 ]; then
    echo "==> No port under $PORT_REPO matches: $*"
    exit 1
fi

echo ""
echo "==> Summary: $success/$total successful, $failed failed"
[ $failed -eq 0 ] || exit 1

