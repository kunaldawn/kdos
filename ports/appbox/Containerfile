# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------
#
# The kdos-apps distrobox image: the offline software library. One best-of
# open-source GUI app per professional/student/home need — the whole point is
# a fat Knoppix-style bootable stick that works with no internet, ever. Built
# on the HOST with `make fetch-apps` (the sandboxed ISO build has no network),
# loaded into the kdos user's podman storage by script/06_packaging/01_appbox.sh.
#
# Debian trixie base: alpine 3.23 has no slicer (prusa/cura), no VSCode build,
# no calibre/gtkwave — debian has the lot, glibc means AppImages and vendor
# binaries also run. --no-install-recommends everywhere, with the data packages
# that actually matter added back explicitly (kicad-{symbols,footprints,
# templates} yes, kicad-packages3d's 5 GB no).
#
# The distrobox prerequisite block pre-installs what `distrobox enter` would
# otherwise apt-get on first entry, and /.containersetupdone tells
# distrobox-init to skip its package-setup phase entirely — without both, the
# first launch needs network, which defeats the point.

FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

# distrobox runtime prerequisites (distrobox-init's debian list + basics)
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash bc bzip2 ca-certificates curl diffutils findutils gnupg2 less \
        libnss-myhostname libvte-2.91-common libvte-common lsof man-db \
        manpages mount ncurses-base passwd pinentry-curses procps sudo tar \
        time tree tzdata unzip util-linux wget xz-utils zip \
    && rm -rf /var/lib/apt/lists/*

# GUI plumbing: GL/EGL, icons, fonts, mime, dbus
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1-mesa-dri libegl1 libgl1 mesa-vulkan-drivers \
        adwaita-icon-theme hicolor-icon-theme librsvg2-common \
        fonts-dejavu fonts-liberation fonts-noto-core \
        dbus-x11 xdg-utils desktop-file-utils shared-mime-info \
        qt5-gtk-platformtheme qt6-gtk-platformtheme \
    && rm -rf /var/lib/apt/lists/*

# Read by kdos-appbox: it only sets QT_STYLE_OVERRIDE=Fusion when the image can
# actually supply a palette through qgtk3. Declared here, in the same layer that
# installs the platform themes, so the two can never disagree — Fusion without
# them falls back to Qt's built-in LIGHT palette.
LABEL kdos.qt-gtk-theme=1

# Ebooks, PDF, office, notes
RUN apt-get update && apt-get install -y --no-install-recommends \
        zathura zathura-pdf-poppler zathura-djvu zathura-cb sioyek \
        calibre foliate pdfarranger xournalpp \
        libreoffice libreoffice-gtk3 gnucash zim mousepad \
    && rm -rf /var/lib/apt/lists/*

# Graphics / photo / publishing suite
RUN apt-get update && apt-get install -y --no-install-recommends \
        gimp inkscape krita darktable scribus drawing gthumb \
        blender fontforge font-manager simple-scan \
    && rm -rf /var/lib/apt/lists/*

# CAD, 3D printing, electronics
RUN apt-get update && apt-get install -y --no-install-recommends \
        freecad openscad prusa-slicer solvespace \
        kicad kicad-symbols kicad-footprints kicad-templates \
        gtkwave ngspice \
    && rm -rf /var/lib/apt/lists/*

# Science & maths
RUN apt-get update && apt-get install -y --no-install-recommends \
        octave gnuplot qalculate-gtk stellarium maxima wxmaxima \
        python3-numpy python3-scipy python3-matplotlib python3-sympy \
    && rm -rf /var/lib/apt/lists/*

# Audio: editing, DAWs, music production, tagging
RUN apt-get update && apt-get install -y --no-install-recommends \
        audacity audacious ardour hydrogen lmms easyeffects musescore picard \
    && rm -rf /var/lib/apt/lists/*

# Video: player, editors, capture, transcode, burn
RUN apt-get update && apt-get install -y --no-install-recommends \
        mpv shotcut kdenlive frei0r-plugins obs-studio handbrake xfburn \
    && rm -rf /var/lib/apt/lists/*

# Internet & communication
RUN apt-get update && apt-get install -y --no-install-recommends \
        firefox-esr claws-mail transmission-gtk dino-im hexchat remmina \
        wireshark \
    && rm -rf /var/lib/apt/lists/*

# Development
RUN apt-get update && apt-get install -y --no-install-recommends \
        geany meld ghex zeal git sqlitebrowser \
    && rm -rf /var/lib/apt/lists/*

# VSCodium — the open-source VS Code build (MIT, no telemetry); not in debian
RUN apt-get update \
    && url=$(curl -s https://api.github.com/repos/VSCodium/vscodium/releases/latest \
        | grep browser_download_url | grep 'amd64.deb"' | grep -v insiders | cut -d'"' -f4 | head -1) \
    && curl -Lo /tmp/codium.deb "$url" \
    && apt-get install -y --no-install-recommends /tmp/codium.deb \
    && rm -f /tmp/codium.deb && rm -rf /var/lib/apt/lists/*

# Utilities and backup. NO gparted, gnome-disk-utility, gsmartcontrol or
# testdisk: they need raw block devices and this box is rootless podman, so
# each opens a window it cannot do anything in. Partitioning, SMART and
# recovery are native rows on the host, which is where root is.
RUN apt-get update && apt-get install -y --no-install-recommends \
        pcmanfm xarchiver keepassxc baobab \
        bleachbit deja-dup grsync goldendict-ng \
    && rm -rf /var/lib/apt/lists/*

# Games (offline classics)
RUN apt-get update && apt-get install -y --no-install-recommends \
        supertux supertuxkart wesnoth openttd luanti \
        gnome-chess aisleriot gnome-mines gnome-sudoku quadrapassel \
    && rm -rf /var/lib/apt/lists/*

# Emulators
RUN apt-get update && apt-get install -y --no-install-recommends \
        retroarch retroarch-assets libretro-core-info \
        libretro-nestopia libretro-gambatte libretro-mgba libretro-desmume \
        dosbox mgba-qt desmume scummvm mednafen \
    && rm -rf /var/lib/apt/lists/*

# Windows software — wine, and it belongs HERE rather than in ports/.
#
# The rule is "KDOS builds the desktop, applications live in boxes", and a
# Windows application is still an application. The cost of the other choice is
# concrete rather than stylistic: wine's PE modules are built by a mingw-w64
# cross compiler, so a musl-native port needs TWO cross toolchains — i686 and
# x86_64 targeting w64-mingw32 — ported first, and `--without-mingw` builds the
# ELF-format modules upstream deprecated. Debian has that build done properly.
#
# `dpkg --add-architecture i386` is what makes 32-bit Windows programs work,
# which is most of the ones anybody still has lying around, and it is only
# possible in the box: KDOS itself has no multilib and never will.
#
# No corefonts: winetricks fetches those from the network at run time, and
# nothing in this image is allowed to depend on that.
RUN dpkg --add-architecture i386 \
    && apt-get update && apt-get install -y --no-install-recommends \
        wine wine64 wine32:i386 winetricks cabextract \
    && rm -rf /var/lib/apt/lists/*

# KDE — the "I want a real desktop's applications" segment.
#
# NOT kde-full: that is Plasma itself plus everything, and it would roughly
# double an image that is already ~4 G. This is the application half only, which
# is the half that has no equal elsewhere — dolphin, okular, kate and gwenview
# are each better than what the rest of this file could substitute, and none of
# them needs Plasma running to work.
#
# plasma-integration is the Qt platform theme named "kde": with it, and with the
# kdeglobals `kdos theme` writes into the SHARED home, every Qt app in this image
# reads the KDOS palette directly. Both Qt majors are installed because trixie
# still ships Qt5 apps and a missing platform theme is a silently unthemed app.
# kio-extras/ffmpegthumbs/kdegraphics-thumbnailers are what make dolphin show
# thumbnails rather than generic icons — the difference between "KDE is here"
# and "KDE is here but broken".
RUN apt-get update && apt-get install -y --no-install-recommends \
        dolphin konsole kate okular gwenview ark kcalc spectacle \
        digikam elisa kdeconnect kdevelop k3b filelight kwalletmanager \
        kio kio-extras ffmpegthumbs kdegraphics-thumbnailers \
        kimageformat-plugins breeze breeze-icon-theme kde-cli-tools \
        plasma-integration plasma-integration5 \
    && rm -rf /var/lib/apt/lists/*

# Read by kdos-appbox, exactly like kdos.qt-gtk-theme above and declared in the
# same layer that installs the thing it promises. With this label it exports
# QT_QPA_PLATFORMTHEME=kde instead of gtk3, because the kde platform theme reads
# the palette kdeglobals already carries and needs no bridge at all.
LABEL kdos.qt-kde-theme=1

# Tools the recommends-less install dropped that apps ask for at runtime:
# kdenlive's first-run wizard (DVD authoring chain), and obs-plugins — debian
# splits OBS's plugins out, and linux-pipewire.so (the ONLY Wayland screen
# capture path) lives there.
RUN apt-get update && apt-get install -y --no-install-recommends \
        dvdauthor genisoimage obs-plugins \
    && rm -rf /var/lib/apt/lists/*

# Warm every cache a GUI app would otherwise build on ITS first run, inside the
# user's home, while the user waits and the window is not up yet. With ~90 apps
# and debian's font set that is the difference between a first launch measured
# in seconds and one measured in tens of seconds.
RUN fc-cache --force --system-only \
    && update-mime-database /usr/share/mime \
    && update-desktop-database /usr/share/applications \
    && glib-compile-schemas /usr/share/glib-2.0/schemas \
    && gdk-pixbuf-query-loaders --update-cache \
    && ldconfig

# distrobox-init: skip the package-setup phase — everything is pre-baked
RUN touch /.containersetupdone
