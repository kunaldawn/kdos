#!/bin/bash
# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   ports/appbox/fetch
#
# Build the kdos-apps distrobox image on the HOST (the sandboxed ISO build has
# no network) and leave two artifacts next to this script, both gitignored:
#
#   appbox.tar   the image, docker-archive format, for `podman load` in chroot
#   icons/       the apps' icons, for the host launcher entries
#
# Run via `make fetch-apps`.

set -e
cd "$(dirname "$0")"

IMAGE=localhost/kdos-appbox:latest

ENGINE="${ENGINE:-}"
if [ -z "$ENGINE" ]; then
	if command -v docker >/dev/null 2>&1; then ENGINE=docker
	elif command -v podman >/dev/null 2>&1; then ENGINE=podman
	else echo "appbox/fetch: need docker or podman on the host" >&2; exit 1
	fi
fi

echo "==> Building $IMAGE with $ENGINE"
$ENGINE build -t "$IMAGE" -f Containerfile .

echo "==> Saving image archive"
rm -f appbox.tar
$ENGINE save -o appbox.tar "$IMAGE"

echo "==> Chunking archive into image/ (git-committable, LFS-sized)"
# kdos-appbox is a TARGET binary, and this runs on the host — so build a host
# copy of it for the one subcommand needed here. It links nothing but libc, so
# this is a two-second compile and not a toolchain.
REPO="$(cd ../.. && pwd)"
HOSTBIN="$(mktemp -d)/kdos-appbox"
cc -O2 -std=c11 -D_GNU_SOURCE -o "$HOSTBIN" \
	-I"$REPO/src/libs/libkbase" -I"$REPO/src/libs/libktui" \
	-I"$REPO/src/libs/libkcolor" -I"$REPO/src/libs/libkxdg" \
	-I"$REPO/src/packages/kdos-appbox" \
	"$REPO"/src/packages/kdos-appbox/*.c "$REPO"/src/libs/libkbase/*.c \
	"$REPO"/src/libs/libktui/*.c "$REPO"/src/libs/libkcolor/*.c \
	"$REPO"/src/libs/libkxdg/*.c
"$HOSTBIN" image pack appbox.tar image
rm -rf "$(dirname "$HOSTBIN")"

echo "==> Extracting app icons"
# Every Icon= any .desktop in the image references, wherever the file lives —
# guessing icon names cost one debug cycle already.
rm -rf icons && mkdir -p icons
$ENGINE run --rm "$IMAGE" sh -c '
	names="$(sed -n "s/^Icon=//p" /usr/share/applications/*.desktop | sort -u) folder"
	for n in $names; do
		find /usr/share/icons /usr/share/pixmaps \
		     \( -name "$n.png" -o -name "$n.svg" -o -name "$n.xpm" \) \
		     2>/dev/null
	done | sort -u | tar -cf - -T - 2>/dev/null
' | tar -xf - -C icons

echo "==> Done:"
du -sh appbox.tar icons
