# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   ports/appbox/pack
#
# Explode appbox.tar (docker-archive) into per-member zstd files under image/,
# so the 11G image fits git LFS's 2G/file limit and a segment rebuild only
# changes that segment's layer blob. `assemble` streams the tar back.
#
#   usage: pack <appbox.tar> <image-dir>

import json
import os
import shutil
import subprocess
import sys
import tarfile

CHUNK = 1536 * 1024 * 1024  # split compressed output at 1.5G, under LFS's 2G

def main(tar_path, out_dir):
    if os.path.isdir(out_dir):
        shutil.rmtree(out_dir)
    os.makedirs(out_dir)

    index = []
    with tarfile.open(tar_path, "r|") as tf:
        for m in tf:
            if not m.isreg():
                continue
            src = tf.extractfile(m)
            base = os.path.join(out_dir, m.name)
            os.makedirs(os.path.dirname(base), exist_ok=True)

            z = subprocess.Popen(
                ["zstd", "-q", "-T0", "-8", "-o", base + ".zst"],
                stdin=subprocess.PIPE)
            shutil.copyfileobj(src, z.stdin, 4 * 1024 * 1024)
            z.stdin.close()
            if z.wait() != 0:
                sys.exit("pack: zstd failed on " + m.name)

            chunks = [m.name + ".zst"]
            if os.path.getsize(base + ".zst") > CHUNK:
                chunks = []
                with open(base + ".zst", "rb") as f:
                    n = 0
                    while True:
                        buf = f.read(CHUNK)
                        if not buf:
                            break
                        part = "%s.p%02d.zst" % (m.name, n)
                        with open(os.path.join(out_dir, part), "wb") as p:
                            p.write(buf)
                        chunks.append(part)
                        n += 1
                os.unlink(base + ".zst")

            index.append({"name": m.name, "size": m.size, "chunks": chunks})
            print("  %-72s %d -> %s" % (m.name, m.size, ", ".join(chunks)))

    with open(os.path.join(out_dir, "INDEX.json"), "w") as f:
        json.dump(index, f, indent=1)
    print("packed %d members" % len(index))

if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.exit("usage: pack <appbox.tar> <image-dir>")
    main(sys.argv[1], sys.argv[2])
