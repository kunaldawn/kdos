# description	: wmbattery — Window Maker dock applet showing laptop battery status
# homepage	: https://salsa.debian.org/wmaker-team/wmbattery
# depends	: libx11 libxext libxpm

name=wmbattery
version=2.56
release=1
source="https://salsa.debian.org/wmaker-team/wmbattery/-/archive/upstream/$version/wmbattery-upstream-$version.tar.gz"

build() {
	# upower isn't in kdos; the ACPI sysfs driver in acpi.c is always
	# compiled and reads /sys/class/power_supply/ directly, which is
	# all a modern laptop needs.
	./configure \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--disable-upower
	make
	make DESTDIR=$PKG install
}
