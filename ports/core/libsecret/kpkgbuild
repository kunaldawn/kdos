# description	: Library for storing/retrieving passwords via the org.freedesktop.Secrets D-Bus API
# homepage	: https://gitlab.gnome.org/GNOME/libsecret
# depends	: meson glib libgcrypt libgpg-error

name=libsecret
version=0.21.7
release=1
source="https://download.gnome.org/sources/libsecret/${version%.*}/libsecret-$version.tar.xz"

build() {
	meson setup build \
		--prefix=/usr --sysconfdir=/etc --libdir=lib \
		--buildtype=release \
		-Dintrospection=false \
		-Dgtk_doc=false \
		-Dmanpage=false \
		-Dvapi=false \
		-Dbash_completion=disabled
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
