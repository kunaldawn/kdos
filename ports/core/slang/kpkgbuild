# description	: S-Lang library — multi-platform programmer's library for text-mode UIs (newt dep)
# homepage	: https://www.jedsoft.org/slang/

name=slang
version=2.3.3
release=1
source="https://www.jedsoft.org/releases/slang/slang-$version.tar.bz2"

build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--with-readline=gnu
	make -j1
	make DESTDIR=$PKG install
}
