# description	: Authoritative DNS server for container networks (Rust)
# homepage	: https://github.com/containers/aardvark-dns
# depends	: rust

name=aardvark-dns
version=1.17.1
release=1
source="https://github.com/containers/aardvark-dns/archive/refs/tags/v$version.tar.gz"
vendoring=rust

build() {
	tar xf $PORT_SRC/${name}-vendor-${version}.tar.xz
	export CARGO_HOME="$SRC_ROOT/.cargo"
	export RUSTFLAGS="-C target-feature=-crt-static"
	export LIBCLANG_PATH=/usr/lib
	cargo build --release --frozen --offline
	install -Dm755 target/release/aardvark-dns "$PKG/usr/libexec/podman/aardvark-dns"
}
