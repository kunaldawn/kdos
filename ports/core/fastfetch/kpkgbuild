# description	: fastfetch — system information tool, ships KDOS ASCII branding
# homepage	: https://github.com/fastfetch-cli/fastfetch
# depends	: cmake pciutils dbus libdrm wayland glib sqlite

name=fastfetch
version=2.62.1
release=1
source="https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/$version.tar.gz
	$PORT_SRC/kdos.txt
	$PORT_SRC/config.jsonc"

build() {
	mkdir -p build
	cd build
	cmake .. \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DENABLE_X11=OFF \
		-DENABLE_XCB=OFF \
		-DENABLE_XCB_RANDR=OFF \
		-DENABLE_XRANDR=OFF \
		-DENABLE_WAYLAND=ON \
		-DENABLE_SYSTEM_YYJSON=OFF \
		-DBUILD_TESTS=OFF
	make
	make DESTDIR=$PKG install
	cd ..

	install -Dm644 $SRC/kdos.txt $PKG/usr/share/fastfetch/logos/kdos.txt
	install -Dm644 $SRC/config.jsonc $PKG/etc/xdg/fastfetch/config.jsonc
}
