# description	: XCB utility convenience functions
# homepage	: https://xcb.freedesktop.org/
# depends	: libxcb

name=xcb-util
version=0.4.1
release=1
source="https://www.x.org/releases/individual/xcb/$name-$version.tar.xz"

build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--disable-static
	make
	make DESTDIR=$PKG install
}
