# description	: Library that loads and renders images, used by nsxiv and feh
# homepage	: https://docs.enlightenment.org/api/imlib2/html/
# depends	: libx11 libxext libpng libjpeg-turbo libtiff giflib libid3tag freetype2 bzip2

name=imlib2
version=1.12.6
release=1
source="https://downloads.sourceforge.net/enlightenment/imlib2-$version.tar.xz"

build() {
	./configure \
		--prefix=/usr \
		--disable-static \
		--with-x \
		--enable-shared
	make
	make DESTDIR=$PKG install
}
