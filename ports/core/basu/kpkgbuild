# description	: sd-bus library extracted from systemd (no-systemd sd-bus provider)
# homepage	: https://sr.ht/~emersion/basu/
# depends	: meson ninja libcap

name=basu
version=0.2.0
release=1
source="https://github.com/emersion/basu/releases/download/v$version/basu-$version.tar.gz"

build() {
	sed -i "s|if not meson.is_cross_build()|if false|" meson.build
	meson setup build \
		--prefix=/usr --sysconfdir=/etc --libdir=lib \
		--buildtype=release \
		-Daudit=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
