# description	: Rootless X server that runs X11 clients on a Wayland compositor
# homepage	: https://gitlab.freedesktop.org/xorg/xserver
# depends	: meson wayland wayland-protocols libdrm mesa pixman libxcvt libxkbcommon xorgproto xtrans libXau libXfont2 libxshmfence libepoxy xkbcomp xkeyboard-config

name=xwayland
version=24.1.13
release=1
source="https://www.x.org/releases/individual/xserver/$name-$version.tar.xz"

build() {
	meson setup build \
		--prefix=/usr --sysconfdir=/etc --libdir=lib \
		--buildtype=release \
		-Dxvfb=false \
		-Dsecure-rpc=false \
		-Dxwayland_ei=false \
		-Dlibdecor=false \
		-Dsystemd_notify=false \
		-Dglamor=true \
		-Ddri3=true \
		-Dglx=false \
		-Dxkb_dir=/usr/share/X11/xkb \
		-Dxkb_output_dir=/var/lib/xkb \
		-Dxkb_bin_dir=/usr/bin \
		-Ddocs=false \
		-Ddevel-docs=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	install -dm755 $PKG/var/lib/xkb
}
