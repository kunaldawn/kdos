# description	: nmap — Network exploration tool and security scanner
# homepage	: https://nmap.org/
# depends	: openssl libpcap pcre2 lua python3

name=nmap
version=7.99
release=1
source="https://nmap.org/dist/nmap-$version.tar.bz2"

build() {
	./configure \
		--prefix=/usr \
		--without-zenmap \
		--without-ndiff \
		--without-nmap-update \
		--with-openssl \
		--with-libpcre=included \
		--with-liblua=included
	make
	make DESTDIR=$PKG install
}
