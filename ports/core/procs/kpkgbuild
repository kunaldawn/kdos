# description	: procs — a modern replacement for ps
# homepage	: https://github.com/dalance/procs
# depends	: rust

name=procs
version=0.14.11
release=1
source="https://github.com/dalance/procs/archive/v$version.tar.gz"
vendoring=rust

build() {
	tar xf $PORT_SRC/${name}-vendor-${version}.tar.xz

	cargo build --release --frozen --offline
	install -Dm755 target/release/procs $PKG/usr/bin/procs
}
