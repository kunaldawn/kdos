# description	: Wayland protocol XML definitions (xdg-shell, layer-shell, etc.)
# homepage	: https://gitlab.freedesktop.org/wayland/wayland-protocols
# depends	: wayland meson

name=wayland-protocols
version=1.48
release=1
source="https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/$version/downloads/wayland-protocols-$version.tar.xz"

build() {
	meson setup build \
		--prefix=/usr --sysconfdir=/etc --libdir=lib \
		-Dtests=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
