musl and the kernel headers both define `struct statx`, so including
<linux/stat.h> on top of <sys/stat.h> is a redefinition error and the build
stops in every file that reaches io_uring_engine.h.

The include is there for the one `struct statx *` in the io_uring pending-op
union and for the io_uring_prep_statx() beside it, both already inside
`#ifndef WITHOUT_URING`. With no liburing the header is pulled in for a member
nothing declares and nothing uses, so it moves inside the same guard.

--- a/io_uring_engine.h
+++ b/io_uring_engine.h
@@ -7,10 +7,10 @@
 #include <string_view>
 #include <sys/socket.h>
 #include <sys/types.h>
-#include <linux/stat.h>
 
 struct io_uring_sqe;
 #ifndef WITHOUT_URING
+#include <linux/stat.h>
 #include <liburing.h>
 #endif
 
