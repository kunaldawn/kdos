# description	: FFmpeg — record, convert, and stream audio/video
# homepage	: https://ffmpeg.org/
# depends	: alsa-lib zlib bzip2 xz gnutls libdrm libxml2 freetype2 fontconfig harfbuzz fribidi libwebp

name=ffmpeg
version=8.1.1
release=1
source="https://ffmpeg.org/releases/$name-$version.tar.xz"

build() {
	./configure \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--disable-static \
		--disable-stripping \
		--enable-shared \
		--enable-pic \
		--enable-pthreads \
		--enable-version3 \
		--enable-gnutls \
		--enable-libdrm \
		--enable-libfontconfig \
		--enable-libfreetype \
		--enable-libfribidi \
		--enable-libharfbuzz \
		--enable-libwebp \
		--enable-libxml2
	make
	make DESTDIR=$PKG install
}
