# description	: Shared memory fences library
# homepage	: https://gitlab.freedesktop.org/xorg/lib/libxshmfence
# depends	: xorgproto

name=libxshmfence
version=1.3.3
release=1
source="https://www.x.org/releases/individual/lib/$name-$version.tar.xz"

build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--disable-static
	make
	make DESTDIR=$PKG install
}
