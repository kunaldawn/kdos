Subject: Close the sound device after each utterance instead of at termination

A program speaking straight to the device (espeak_Initialize with
AUDIO_OUTPUT_PLAYBACK) held the PCM open from its first word until
espeak_ng_Terminate. Open it on the first samples of an utterance, close
it once they drain or are cancelled, and reopen at the same rate on the
next.

--- a/src/libespeak-ng/speech.c
+++ b/src/libespeak-ng/speech.c
@@ -73,6 +73,18 @@
 static long count_samples;
 #if USE_LIBPCAUDIO
 static struct audio_object *my_audio = NULL;
+// The device is held only while an utterance plays: it is opened on the
+// first samples and closed once they have drained or been cancelled, so an
+// idle speaker never keeps the sound card from other programs.
+static int audio_is_open = 0;
+
+static void close_audio(void)
+{
+	if (audio_is_open) {
+		audio_object_close(my_audio);
+		audio_is_open = 0;
+	}
+}
 #endif
 
 static unsigned int my_unique_identifier = 0;
@@ -92,7 +104,7 @@
 {
 #if USE_LIBPCAUDIO
 	if ((my_mode & ENOUTPUT_MODE_SPEAK_AUDIO) == ENOUTPUT_MODE_SPEAK_AUDIO) {
-		audio_object_flush(my_audio);
+		close_audio();
 	}
 #endif
 }
@@ -121,7 +133,7 @@
 #if USE_LIBPCAUDIO
 				if (out_samplerate != 0) {
 					// sound was previously open with a different sample rate
-					audio_object_close(my_audio);
+					close_audio();
 					out_samplerate = 0;
 				}
 #endif
@@ -132,6 +144,7 @@
 					err = ENS_AUDIO_ERROR;
 					return -1;
 				}
+				audio_is_open = 1;
 #endif
 				out_samplerate = voice_samplerate;
 #if USE_ASYNC
@@ -142,14 +155,16 @@
 		}
 
 #if USE_LIBPCAUDIO
-		if (out_samplerate == 0) {
-			int error = audio_object_open(my_audio, AUDIO_OBJECT_FORMAT_S16LE, voice_samplerate, 1);
+		if (out_samplerate == 0 || !audio_is_open) {
+			int rate = out_samplerate != 0 ? out_samplerate : voice_samplerate;
+			int error = audio_object_open(my_audio, AUDIO_OBJECT_FORMAT_S16LE, rate, 1);
 			if (error != 0) {
 				fprintf(stderr, "error: %s\n", audio_object_strerror(my_audio, error));
 				err = ENS_AUDIO_ERROR;
 				return -1;
 			}
-			out_samplerate = voice_samplerate;
+			audio_is_open = 1;
+			out_samplerate = rate;
 		}
 #endif
 
@@ -423,6 +438,23 @@
 
 #pragma GCC visibility pop
 
+// Ends an utterance played to the sound device: lets what was written play
+// out, unless it was stopped, and releases the device.
+static espeak_ng_STATUS finish_audio(espeak_ng_STATUS status)
+{
+#if USE_LIBPCAUDIO
+	if ((my_mode & ENOUTPUT_MODE_SPEAK_AUDIO) == ENOUTPUT_MODE_SPEAK_AUDIO) {
+		if (status != ENS_SPEECH_STOPPED && audio_is_open) {
+			int error = audio_object_drain(my_audio);
+			if (error != 0)
+				fprintf(stderr, "error: %s\n", audio_object_strerror(my_audio, error));
+		}
+		close_audio();
+	}
+#endif
+	return status;
+}
+
