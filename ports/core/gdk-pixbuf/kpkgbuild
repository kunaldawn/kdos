# description	: gdk-pixbuf — image-loading library used by GTK and many notification daemons
# homepage	: https://gitlab.gnome.org/GNOME/gdk-pixbuf
# depends	: glib libpng libjpeg-turbo libtiff shared-mime-info meson

name=gdk-pixbuf
version=2.44.6
release=1
source="https://download.gnome.org/sources/gdk-pixbuf/${version%.*}/$name-$version.tar.xz"

build() {
	meson setup build \
		--prefix=/usr --sysconfdir=/etc --libdir=lib \
		-D glycin=disabled \
		-D introspection=disabled \
		-D documentation=false \
		-D man=false \
		-D tests=false \
		-D installed_tests=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
