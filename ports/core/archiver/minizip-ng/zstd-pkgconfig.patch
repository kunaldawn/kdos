--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -400,6 +400,12 @@
     # Check if zstd is present
     if(NOT MZ_FORCE_FETCH_LIBS)
         find_package(zstd QUIET CONFIG)
+        if(NOT zstd_FOUND)
+            find_package(PkgConfig QUIET)
+            if(PKG_CONFIG_FOUND)
+                pkg_check_modules(ZSTD_PC IMPORTED_TARGET GLOBAL libzstd)
+            endif()
+        endif()
     endif()
 
     if(zstd_FOUND AND NOT MZ_FORCE_FETCH_LIBS)
@@ -412,6 +418,12 @@
         endif()
 
         set(PC_PRIVATE_LIBS "${PC_PRIVATE_LIBS} -lzstd")
+    elseif(ZSTD_PC_FOUND AND NOT MZ_FORCE_FETCH_LIBS)
+        message(STATUS "Using ZSTD ${ZSTD_PC_VERSION} (pkg-config)")
+
+        list(APPEND MINIZIP_LIB PkgConfig::ZSTD_PC)
+
+        set(PC_PRIVATE_LIBS "${PC_PRIVATE_LIBS} -lzstd")
     elseif(MZ_FETCH_LIBS)
         set(ZSTD_BUILD_PROGRAMS OFF CACHE BOOL "Build zstd programs")
 
