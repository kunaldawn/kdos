+/* private
+ *
+ * Describes the FAT filesystem mounted at @mount_path without udisks: the
+ * partition number, start and size come from the kernel's sysfs node for the
+ * mounted device, and the partition UUID and type from the udev database. A
+ * directory that is not itself a mount point is refused, because its device
+ * is the root filesystem's and a boot entry built from it would name the wrong
+ * partition. A partition the udev database has no entry for still returns a
+ * volume, with no UUID, so a capsule-on-disk update can use it and a boot
+ * entry cannot be built from it. */
+FuVolume *
+fu_volume_new_esp_from_mount_path(const gchar *mount_path, GError **error)
+{
+#ifdef __linux__
+	struct stat st_mnt = {0};
+	struct stat st_up = {0};
+	struct statfs st_fs = {0};
+	guint maj;
+	guint min;
+	guint64 tmp = 0;
+	g_autofree gchar *up = NULL;
+	g_autofree gchar *sysdir = NULL;
+	g_autofree gchar *udevdb = NULL;
+	g_autofree gchar *uevent = NULL;
+	g_autofree gchar *devname = NULL;
+	g_autofree gchar *number = NULL;
+	g_autofree gchar *start = NULL;
+	g_autofree gchar *size = NULL;
+	g_autoptr(FuVolume) self = NULL;
+
+	g_return_val_if_fail(mount_path != NULL, NULL);
+	g_return_val_if_fail(error == NULL || *error == NULL, NULL);
+
+	up = g_build_filename(mount_path, "..", NULL);
+	if (stat(mount_path, &st_mnt) != 0 || stat(up, &st_up) != 0) {
+		g_set_error(error,
+			    FWUPD_ERROR,
+			    FWUPD_ERROR_NOT_FOUND,
+			    "%s: %s",
+			    mount_path,
+			    fwupd_strerror(errno));
+		return NULL;
+	}
+	if (st_mnt.st_dev == st_up.st_dev) {
+		g_set_error(error,
+			    FWUPD_ERROR,
+			    FWUPD_ERROR_NOT_FOUND,
+			    "%s is not a mount point",
+			    mount_path);
+		return NULL;
+	}
+	if (statfs(mount_path, &st_fs) != 0 || st_fs.f_type != 0x4d44) {
+		g_set_error(error,
+			    FWUPD_ERROR,
+			    FWUPD_ERROR_NOT_SUPPORTED,
+			    "%s is not a FAT filesystem",
+			    mount_path);
+		return NULL;
+	}
+
+	maj = major(st_mnt.st_dev);
+	min = minor(st_mnt.st_dev);
+	sysdir = g_strdup_printf("/sys/dev/block/%u:%u", maj, min);
+	number = fu_volume_read_line(sysdir, "partition");
+	if (number == NULL) {
+		g_set_error(error,
+			    FWUPD_ERROR,
+			    FWUPD_ERROR_NOT_SUPPORTED,
+			    "%s is not on a partition",
+			    mount_path);
+		return NULL;
+	}
+
+	self = g_object_new(FU_TYPE_VOLUME, NULL);
+	self->mount_path = g_strdup(mount_path);
+	if (fu_strtoull(number, &tmp, 1, G_MAXUINT32, FU_INTEGER_BASE_10, NULL))
+		self->partition_number = (guint32)tmp;
+	start = fu_volume_read_line(sysdir, "start");
+	if (start != NULL && fu_strtoull(start, &tmp, 0, G_MAXUINT64 / 512, FU_INTEGER_BASE_10, NULL))
+		self->partition_offset = tmp * 512;
+	size = fu_volume_read_line(sysdir, "size");
+	if (size != NULL && fu_strtoull(size, &tmp, 0, G_MAXUINT64 / 512, FU_INTEGER_BASE_10, NULL))
+		self->partition_size = tmp * 512;
+	uevent = g_build_filename(sysdir, "uevent", NULL);
+	devname = fu_volume_read_key(uevent, "DEVNAME=");
+	if (devname != NULL)
+		self->device_name = g_build_filename("/dev", devname, NULL);
+
+	udevdb = g_strdup_printf("/run/udev/data/b%u:%u", maj, min);
+	self->partition_uuid = fu_volume_read_key(udevdb, "E:ID_PART_ENTRY_UUID=");
+	self->partition_kind = fu_volume_read_key(udevdb, "E:ID_PART_ENTRY_TYPE=");
+	return g_steal_pointer(&self);
+#else
+	g_set_error_literal(error,
+			    FWUPD_ERROR,
+			    FWUPD_ERROR_NOT_SUPPORTED,
+			    "probing a mount path needs Linux sysfs");
+	return NULL;
+#endif
+}
