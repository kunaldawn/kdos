+#ifdef __linux__
+static gchar *
+fu_volume_read_line(const gchar *dir, const gchar *attr)
+{
+	g_autofree gchar *fn = g_build_filename(dir, attr, NULL);
+	gchar *buf = NULL;
+	if (!g_file_get_contents(fn, &buf, NULL, NULL))
+		return NULL;
+	return g_strstrip(buf);
+}
+
+static gchar *
+fu_volume_read_key(const gchar *fn, const gchar *prefix)
+{
+	g_autofree gchar *buf = NULL;
+	g_auto(GStrv) lines = NULL;
+	if (!g_file_get_contents(fn, &buf, NULL, NULL))
+		return NULL;
+	lines = g_strsplit(buf, "\n", -1);
+	for (guint i = 0; lines[i] != NULL; i++) {
+		if (g_str_has_prefix(lines[i], prefix))
+			return g_strdup(lines[i] + strlen(prefix));
+	}
+	return NULL;
+}
+#endif
