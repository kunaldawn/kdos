# description	: GStreamer base plugin set (provides gstreamer-pbutils, audio/video conversion, file I/O)
# homepage	: https://gstreamer.freedesktop.org/
# depends	: gstreamer alsa-lib pango cairo libdrm wayland mesa

name=gst-plugins-base
version=1.28.0
release=1
source="https://gstreamer.freedesktop.org/src/$name/$name-$version.tar.xz"

build() {
	meson setup build \
		--prefix=/usr --sysconfdir=/etc --libdir=lib --libexecdir=/usr/lib \
		--buildtype=release \
		-Dintrospection=disabled \
		-Ddoc=disabled \
		-Dexamples=disabled \
		-Dtests=disabled \
		-Dnls=disabled \
		-Dx11=disabled \
		-Dxshm=disabled \
		-Dxvideo=disabled
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
