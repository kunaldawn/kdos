# description	: Keymap compiler and support library (Wayland-only build)
# depends	: xkeyboard-config meson libxml2 wayland wayland-protocols

name=libxkbcommon
version=1.13.1
release=1
source="https://github.com/xkbcommon/libxkbcommon/archive/refs/tags/xkbcommon-$version.tar.gz"

build() {
	meson setup build \
		--prefix=/usr --sysconfdir=/etc --libdir=lib \
		-Denable-wayland=true \
		-Denable-x11=false \
		-Denable-docs=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
