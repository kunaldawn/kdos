# description	: dunst — lightweight notification daemon (X11-only, no GTK linkage)
# homepage	: https://dunst-project.org/
# depends	: cairo pango glib gdk-pixbuf dbus libxinerama libxrandr libxscrnsaver libxext libxft

name=dunst
version=1.13.2
release=1
source="https://github.com/dunst-project/dunst/archive/v$version.tar.gz"

build() {
	# WAYLAND=0 drops the wayland-{client,cursor,protocols} pkg-config
	# checks; X11 path uses libxinerama/xrandr/xscrnsaver/xext/xft.
	# DUNSTIFY=0 skips the notify-send replacement (needs libnotify);
	# dunstctl provides scriptable control without that dep.
	make WAYLAND=0 DUNSTIFY=0 PREFIX=/usr SYSCONFDIR=/etc dunst dunstctl
	make WAYLAND=0 DUNSTIFY=0 PREFIX=/usr SYSCONFDIR=/etc DESTDIR=$PKG install
}
