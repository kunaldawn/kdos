# description	: Text layout and rendering library (Wayland-only build, no X11/Xft)
# depends	: cairo harfbuzz fribidi fontconfig glib meson

name=pango
version=1.57.0
release=3
source="https://ftp.gnome.org/pub/gnome/sources/pango/${version%.*}/$name-$version.tar.xz"

build() {
	meson setup build --prefix=/usr --sysconfdir=/etc --libdir=lib \
		-Dintrospection=disabled \
		-Dxft=disabled \
		-Dlibthai=disabled
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
