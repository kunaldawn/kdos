# description	: Region selector for Wayland compositors (pairs with grim for area screenshots)
# homepage	: https://github.com/emersion/slurp
# depends	: meson scdoc wayland wayland-protocols cairo libxkbcommon

name=slurp
version=1.5.0
release=1
source="https://github.com/emersion/slurp/archive/refs/tags/v$version.tar.gz"

build() {
	meson setup build --prefix=/usr --libdir=lib
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
