From: KDOS <kunal.dawn@gmail.com>
Subject: tzset: re-read a zone file that was replaced since it was loaded

---
--- a/src/time/__tz.c
+++ b/src/time/__tz.c
@@ -5,6 +5,8 @@
 #include <string.h>
 #include <sys/mman.h>
 #include <ctype.h>
+#include <fcntl.h>
+#include <sys/stat.h>
 #include "libc.h"
 #include "lock.h"
 #include "fork_impl.h"
@@ -35,6 +37,16 @@
 static char *old_tz = old_tz_buf;
 static size_t old_tz_size = sizeof old_tz_buf;
 
+/* The identity of the zone file a path-form TZ names, taken when it was
+ * loaded. tzset() compares it with the file the path names now, so a running
+ * program follows a replaced /etc/localtime; zi_from_path is 0 for a POSIX
+ * rule or a zone name, which name no file that is replaced in place. */
+static int zi_from_path, zi_have_id;
+static dev_t zi_dev;
+static ino_t zi_ino;
+static off_t zi_fsize;
+static struct timespec zi_mtim;
+
 static volatile int lock[1];
 volatile int *const __timezone_lockptr = lock;
 
@@ -122,7 +134,19 @@
 	return y;
 }
 
-static void do_tzset()
+static int zi_same_file(const char *s)
+{
+	struct stat st;
+	if (*s == ':') s++;
+	/* A path that cannot be read now keeps the zone already loaded. */
+	if (__fstatat(AT_FDCWD, s, &st, 0)) return 1;
+	return zi_have_id && st.st_dev == zi_dev && st.st_ino == zi_ino
+		&& st.st_size == zi_fsize
+		&& st.st_mtim.tv_sec == zi_mtim.tv_sec
+		&& st.st_mtim.tv_nsec == zi_mtim.tv_nsec;
+}
+
+static void do_tzset(int recheck)
 {
 	char buf[NAME_MAX+25], *pathname=buf+24;
 	const char *try, *s, *p;
@@ -135,11 +159,19 @@
 	if (!s) s = "/etc/localtime";
 	if (!*s) s = __utc;
 
-	if (old_tz && !strcmp(s, old_tz)) return;
+	int same_tz = old_tz && !strcmp(s, old_tz);
+	if (same_tz && (!recheck || !zi_from_path || zi_same_file(s)))
+		return;
+
+	zi_from_path = zi_have_id = 0;
 
 	for (i=0; i<5; i++) r0[i] = r1[i] = 0;
 
-	if (zi) __munmap((void *)zi, map_size);
+	/* A zone re-read under the same TZ leaves the old map mapped, one
+	 * map per change: tm_zone in every struct tm already filled points
+	 * into its abbreviations, as __tzname[] does for a file with no
+	 * POSIX footer, and other threads read both without the lock. */
+	if (zi && !same_tz) __munmap((void *)zi, map_size);
 
 	/* Cache the old value of TZ to check if it has changed. Avoid
 	 * free so as not to pull it into static programs. Growth
@@ -171,8 +203,20 @@
 	if (!posix_form) {
 		if (*s == ':') s++;
 		if (*s == '/' || *s == '.') {
-			if (!libc.secure || !strcmp(s, "/etc/localtime"))
+			if (!libc.secure || !strcmp(s, "/etc/localtime")) {
+				struct stat st;
+				zi_from_path = 1;
+				/* Before the map: a file replaced between the
+				 * two is seen as changed by the next tzset(). */
+				if (!__fstatat(AT_FDCWD, s, &st, 0)) {
+					zi_have_id = 1;
+					zi_dev = st.st_dev;
+					zi_ino = st.st_ino;
+					zi_fsize = st.st_size;
+					zi_mtim = st.st_mtim;
+				}
 				map = __map_file(s, &map_size);
+			}
 		} else {
 			size_t l = strlen(s);
 			if (l <= NAME_MAX && !strchr(s, '.')) {
@@ -365,7 +409,7 @@
 {
 	LOCK(lock);
 
-	do_tzset();
+	do_tzset(0);
 
 	if (zi) {
 		size_t alt, i = scan_trans(t, local, &alt);
@@ -416,10 +460,14 @@
 	UNLOCK(lock);
 }
 
+/* Only the public tzset() re-reads a zone file that a path-form TZ names
+ * (TZ unset, ":/etc/localtime", an absolute or "./" path), and only when
+ * the file it names is no longer the one loaded: one stat per call, none
+ * on the conversion path, which keeps its zone until tzset() is called. */
 static void __tzset()
 {
 	LOCK(lock);
-	do_tzset();
+	do_tzset(1);
 	UNLOCK(lock);
 }
 
@@ -429,7 +477,7 @@
 {
 	const void *p = tm->__tm_zone;
 	LOCK(lock);
-	do_tzset();
+	do_tzset(0);
 	if (p != __utc && p != __tzname[0] && p != __tzname[1] &&
 	    (!zi || (uintptr_t)p-(uintptr_t)abbrevs >= abbrevs_end - abbrevs))
 		p = "";
