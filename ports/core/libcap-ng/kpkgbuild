# description	: Alternate POSIX capabilities library (cleaner API; required by openvpn 2.6+)
# homepage	: https://github.com/stevegrubb/libcap-ng

name=libcap-ng
version=0.9.3
release=1
source="https://github.com/stevegrubb/libcap-ng/archive/refs/tags/v$version.tar.gz"

build() {
	./autogen.sh
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--without-python \
		--without-python3 \
		--disable-static
	make
	make DESTDIR=$PKG install
}
