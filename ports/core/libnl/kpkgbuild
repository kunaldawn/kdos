# description	: Netlink protocol library (kernel <-> userspace networking)
# homepage	: https://github.com/thom311/libnl

name=libnl
version=3.12.0
release=1
_tag=libnl${version//./_}
source="https://github.com/thom311/libnl/releases/download/$_tag/libnl-$version.tar.gz"

build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--disable-static
	make
	make DESTDIR=$PKG install
}
