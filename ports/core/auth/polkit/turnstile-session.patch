Subject: Answer a turnstile session's processes for the user's display session

turnstiled registers each user's services as one session of their own,
with the PAM service name "turnstiled" and no seat. On KDOS the session
bus is one of those services, so every program the bus starts
(plasma-shutdown, krunner and what it launches, ksystemstats) is in
that session, and polkit answers for it as for a session with no seat:
allow_any, never allow_active, with no authentication agent, which is
registered for the display session.

When a process's session is a turnstile session, take the user from
that session (sd_session_get_uid) and answer for the user's display
session (sd_uid_get_display); with no display session the process has
no session. The owner-uid lookups polkit falls back to cannot stand in:
under elogind they fail for a process in a session's /cN/session
cgroup leaf. Every other session is used as before. Chimera Linux's
polkit turnstile.patch skips the turnstile session in the same place.
---
--- a/src/polkitbackend/polkitbackendsessionmonitor-systemd.c	2026-11-09 10:35:29.293694513 +0530
+++ b/src/polkitbackend/polkitbackendsessionmonitor-systemd.c	2026-11-09 10:35:29.316283671 +0530
@@ -330,6 +330,50 @@
   return ret;
 }
 
+/* turnstiled opens one session per user for the user's services, with the
+ * PAM service name "turnstiled" and no seat, and the session bus and every
+ * program it starts run in it. Such a session is shared by every login of
+ * the user and is never local, so a process in it is answered for the
+ * user's display session (sd_uid_get_display) instead. The user is taken
+ * from the session itself: elogind's sd_pid_get_owner_uid fails for a
+ * process in a session's cgroup leaf, so the owner-uid lookups below never
+ * reach a display session.
+ */
+static gboolean
+session_is_turnstile (const char *session_id)
+{
+  char *service = NULL;
+  gboolean ret;
+
+  if (sd_session_get_service (session_id, &service) < 0)
+    return FALSE;
+  ret = g_strcmp0 (service, "turnstiled") == 0;
+  free (service);
+  return ret;
+}
+
+/* The session a process in @session_id is answered for: @session_id itself,
+ * or its user's display session for a turnstile session, or %NULL when a
+ * turnstile session's user has none.
+ */
+static PolkitSubject *
+session_for_session_id (const char *session_id)
+{
+  char *display = NULL;
+  PolkitSubject *session = NULL;
+  uid_t uid;
+
+  if (!session_is_turnstile (session_id))
+    return polkit_unix_session_new (session_id);
+
+  if (sd_session_get_uid (session_id, &uid) < 0)
+    return NULL;
+  if (sd_uid_get_display (uid, &display) >= 0)
+    session = polkit_unix_session_new (display);
+  free (display);
+  return session;
+}
+
 /**
  * polkit_backend_session_monitor_get_session_for_subject:
  * @monitor: A #PolkitBackendSessionMonitor.
@@ -384,7 +428,7 @@
     {
       if (sd_pidfd_get_session (pidfd, &session_id) >= 0)
         {
-          session = polkit_unix_session_new (session_id);
+          session = session_for_session_id (session_id);
           goto out;
         }
     }
@@ -396,7 +440,7 @@
 
   if (sd_pid_get_session (pid, &session_id) >= 0)
     {
-      session = polkit_unix_session_new (session_id);
+      session = session_for_session_id (session_id);
       goto out;
     }
 
