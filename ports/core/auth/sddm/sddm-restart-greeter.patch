+    bool Display::greeterWanted() const {
+        // A login on this display, or a return to a running session, ends
+        // the greeter on purpose.
+        return m_started && !m_auth->isActive() && m_reuseSessionId.isNull();
+    }
+
+    void Display::slotGreeterExited() {
+        // A greeter that ends while nobody logs in leaves the display with
+        // nothing drawn and no password field until sddm itself restarts.
+        // Three exits in a row, each within a minute of its start, are a
+        // greeter that cannot run, and the display is left to the console.
+        if (!greeterWanted())
+            return;
+        if (m_greeterRunning.isValid() && m_greeterRunning.elapsed() >= 60000)
+            m_greeterRestarts = 0;
+        if (++m_greeterRestarts >= 3) {
+            qCritical() << "Greeter exited three times within a minute of its start, not starting it again";
+            return;
+        }
+        qWarning().noquote() << QStringLiteral("Greeter exited with no login, starting it again (restart %1 of 2)").arg(m_greeterRestarts);
+        restartGreeter();
+    }
+
+    void Display::restartGreeter() {
+        if (!greeterWanted() || m_greeter->isRunning())
+            return;
+
+        // sddm-helper activates the greeter's VT as it starts it, which would
+        // pull whoever switched to a text console back to this one. Wait until
+        // this display's VT is in front again.
+        if (m_seat->name() == QLatin1String("seat0") && m_terminalId > 0) {
+            const int activeVt = VirtualTerminal::currentVt();
+            if (activeVt > 0 && activeVt != m_terminalId) {
+                QTimer::singleShot(1000, this, &Display::restartGreeter);
+                return;
+            }
+        }
+
+        if (m_greeter->start())
+            m_greeterRunning.start();
+    }
+
