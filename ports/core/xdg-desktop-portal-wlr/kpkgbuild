# description	: wlroots-compatible portal backend (screencast, file-picker — no GTK)
# homepage	: https://github.com/emersion/xdg-desktop-portal-wlr
# depends	: meson scdoc xdg-desktop-portal wayland wayland-protocols pipewire libdrm libgbm dbus inih

name=xdg-desktop-portal-wlr
version=0.7.1
release=1
source="https://github.com/emersion/xdg-desktop-portal-wlr/releases/download/v$version/xdg-desktop-portal-wlr-$version.tar.gz"

build() {
	meson setup build \
		--prefix=/usr --sysconfdir=/etc --libdir=lib --libexecdir=/usr/lib \
		-Dsd-bus-provider=basu \
		-Dsystemd=disabled
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
