Subject: QQuickWidget: announce the item a Tab or Backtab into the widget reaches

QQuickWidget::focusInEvent() moves the scene's focus to its first item on
a Tab and to its last on a Backtab. That item sends its accessible focus
event at once, from QQuickItem::focusInEvent(), and QWidget::setFocus()
sends the QQuickWidget's own focus event only after the FocusIn has been
delivered. The screen reader's last focus event is therefore the
QQuickWidget, which has no name ("layered pane" in Orca), and the control
that holds the focus is never read.

While accessibility is active, a Tab or Backtab focus-in records the item
it reached and the count of the offscreen window's active-focus changes,
and queues a call that runs after the widget has been announced. The call
sends the item's focus event again if the widget still holds the focus,
the count is unchanged and the item is not the window's content item. A
handler that moves the focus on in between (KCMUtils' KCModuleQml does, on
a Backtab entering a settings page) has announced its own item, and the
count keeps the call silent, so no item is announced twice.

---
diff --git a/src/quickwidgets/qquickwidget.cpp b/src/quickwidgets/qquickwidget.cpp
index 8bf1e6f..a905322 100644
--- a/src/quickwidgets/qquickwidget.cpp
+++ b/src/quickwidgets/qquickwidget.cpp
@@ -8,6 +8,9 @@
 
 #include "private/qquickwindow_p.h"
 #include "private/qquickitem_p.h"
+#if QT_CONFIG(accessibility)
+#include "private/qquickaccessibleattached_p.h"
+#endif
 #include "private/qquickitemchangelistener_p.h"
 #include "private/qquickrendercontrol_p.h"
 #include "private/qsgrhisupport_p.h"
@@ -197,6 +200,8 @@ void QQuickWidgetPrivate::initOffscreenWindow()
 
 #if QT_CONFIG(accessibility)
     QAccessible::installFactory(&qAccessibleQuickWidgetFactory);
+    QObject::connect(offscreenWindow, &QQuickWindow::activeFocusItemChanged, q,
+                     [this] { ++activeFocusSerial; });
 #endif
 }
 
@@ -1781,8 +1786,41 @@ void QQuickWidget::focusInEvent(QFocusEvent * event)
     }
 
     d->offscreenWindow->focusInEvent(event);
+
+#if QT_CONFIG(accessibility)
+    // The item reached above sent its accessible focus event already, and
+    // QWidget::setFocus() sends this widget's own once this handler returns,
+    // so a screen reader would read the widget last and the item never. The
+    // item is announced again after the widget, unless the focus has moved
+    // in the meantime, and then whoever moved it announced the new item.
+    if ((reason == Qt::TabFocusReason || reason == Qt::BacktabFocusReason)
+        && QAccessible::isActive()) {
+        d->tabEntryItem = d->offscreenWindow->activeFocusItem();
+        d->tabEntrySerial = d->activeFocusSerial;
+        QMetaObject::invokeMethod(this, [this] { d_func()->announceTabEntry(); },
+                                  Qt::QueuedConnection);
+    }
+#endif
 }
 
+#if QT_CONFIG(accessibility)
+void QQuickWidgetPrivate::announceTabEntry()
+{
+    Q_Q(QQuickWidget);
+    QQuickItem *item = tabEntryItem;
+    tabEntryItem.clear();
+    if (!item || !q->hasFocus() || tabEntrySerial != activeFocusSerial || !offscreenWindow
+        || item == offscreenWindow->contentItem() || !QQuickItemPrivate::get(item)->isAccessible
+        || !QAccessible::isActive()) {
+        return;
+    }
+    if (QObject *acc = QQuickAccessibleAttached::findAccessible(item)) {
+        QAccessibleEvent ev(acc, QAccessible::Focus);
+        QAccessible::updateAccessibility(&ev);
+    }
+}
+#endif
+
 /*!
    \reimp
 */
diff --git a/src/quickwidgets/qquickwidget_p.h b/src/quickwidgets/qquickwidget_p.h
index bd2a7e8..81cb9aa 100644
--- a/src/quickwidgets/qquickwidget_p.h
+++ b/src/quickwidgets/qquickwidget_p.h
@@ -76,6 +76,9 @@ public:
     void handleWindowAboutToChange();
     void handleWindowChange();
     void invalidateRenderControl();
+#if QT_CONFIG(accessibility)
+    void announceTabEntry();
+#endif
 
     QSize rootObjectSize() const;
 
@@ -116,6 +119,15 @@ public:
     QBackingStoreRhiSupport offscreenRenderer;
 
     QVariantMap initialProperties;
+
+#if QT_CONFIG(accessibility)
+    // The item a Tab or Backtab focus-in moved the scene's focus to, and the
+    // focus-change count at that moment; announceTabEntry() speaks the item
+    // only while the count is unchanged.
+    QPointer<QQuickItem> tabEntryItem;
+    quint64 activeFocusSerial = 0;
+    quint64 tabEntrySerial = 0;
+#endif
 };
 
 class QQuickWidgetOffscreenWindowPrivate;
