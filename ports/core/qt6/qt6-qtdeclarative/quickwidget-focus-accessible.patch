     void dontRecreateRootElementOnWindowChange();
@@ -1464,6 +1469,125 @@ void tst_qquickwidget::accessibleWindowUnderNativeParent()
     // presents the other
     QCOMPARE(rectIface->window(), quickWidgetIface->window());
 }
+
+static QObject *lastAccessibleFocus()
+{
+    QObject *object = nullptr;
+    for (QAccessibleEvent *event : QTestAccessibility::events()) {
+        if (event->type() == QAccessible::Focus)
+            object = event->object();
+    }
+    return object;
+}
+
+static int accessibleFocusCount(QObject *object)
+{
+    int count = 0;
+    for (QAccessibleEvent *event : QTestAccessibility::events()) {
+        if (event->type() == QAccessible::Focus && event->object() == object)
+            ++count;
+    }
+    return count;
+}
+
+/*
+    A Tab or Backtab into a QQuickWidget moves the scene's focus to its first
+    or last item, whose focus event is sent before the QQuickWidget's own.
+    The last focus event a screen reader receives must be the item's, or it
+    reads the unnamed widget and never the control that holds the focus.
+*/
+void tst_qquickwidget::accessibleFocusOnTabEntry_data()
+{
+    QTest::addColumn<bool>("forward");
+    QTest::addColumn<QString>("target");
+    QTest::newRow("tab") << true << "first";
+    QTest::newRow("backtab") << false << "last";
+}
+
+void tst_qquickwidget::accessibleFocusOnTabEntry()
+{
+    QFETCH(bool, forward);
+    QFETCH(QString, target);
+    if (!initAccessibility())
+        QSKIP("This platform does not support accessibility");
+
+    QWidget window;
+    auto *layout = new QVBoxLayout(&window);
+    auto *before = new QLineEdit(&window);
+    auto *quickWidget = new QQuickWidget(&window);
+    auto *after = new QLineEdit(&window);
+    layout->addWidget(before);
+    layout->addWidget(quickWidget);
+    layout->addWidget(after);
+    quickWidget->setSource(testFileUrl("tabEntry.qml"));
+    window.show();
+    QVERIFY(QTest::qWaitForWindowActive(&window));
+
+    QQuickItem *item = quickWidget->rootObject()->findChild<QQuickItem *>(target);
+    QVERIFY(item);
+    QWidget *start = forward ? before : after;
+    start->setFocus(Qt::OtherFocusReason);
+    QTRY_VERIFY(start->hasFocus());
+    QTestAccessibility::clearEvents();
+
+    QTest::keyClick(start, Qt::Key_Tab, forward ? Qt::NoModifier : Qt::ShiftModifier);
+    QTRY_VERIFY(quickWidget->hasFocus());
+    QVERIFY(item->hasActiveFocus());
+    QTRY_COMPARE(lastAccessibleFocus(), item);
+    QTestAccessibility::clearEvents();
+}
+
+/*
+    When the focus moves on inside the scene before the queued announcement,
+    the item the focus-in reached is not announced after the widget: the
+    move announced its own item, and that stays the last focus event.
+*/
+void tst_qquickwidget::accessibleFocusOnTabEntryMovedOn()
+{
+    if (!initAccessibility())
+        QSKIP("This platform does not support accessibility");
+
+    QWidget window;
+    auto *layout = new QVBoxLayout(&window);
+    auto *before = new QLineEdit(&window);
+    auto *quickWidget = new QQuickWidget(&window);
+    layout->addWidget(before);
+    layout->addWidget(quickWidget);
+    quickWidget->setSource(testFileUrl("tabEntry.qml"));
+    window.show();
+    QVERIFY(QTest::qWaitForWindowActive(&window));
+
+    QQuickItem *first = quickWidget->rootObject()->findChild<QQuickItem *>("first");
+    QQuickItem *last = quickWidget->rootObject()->findChild<QQuickItem *>("last");
+    QVERIFY(first);
+    QVERIFY(last);
+    before->setFocus(Qt::OtherFocusReason);
+    QTRY_VERIFY(before->hasFocus());
+
+    class Mover : public QObject
+    {
+    public:
+        explicit Mover(QQuickItem *target) : m_target(target) { }
+        bool eventFilter(QObject *, QEvent *event) override
+        {
+            if (event->type() == QEvent::FocusIn)
+                QTimer::singleShot(0, m_target, [t = m_target] { t->forceActiveFocus(); });
+            return false;
+        }
+        QQuickItem *m_target;
+    } mover(last);
+    quickWidget->installEventFilter(&mover);
+    QTestAccessibility::clearEvents();
+
+    QTest::keyClick(before, Qt::Key_Tab);
+    QTRY_VERIFY(last->hasActiveFocus());
+    QTest::qWait(50);
+    QCOMPARE(lastAccessibleFocus(), last);
+    QCOMPARE(accessibleFocusCount(first), 1);
+    QCOMPARE(accessibleFocusCount(last), 1);
+    quickWidget->removeEventFilter(&mover);
+    QTestAccessibility::clearEvents();
+}
 #endif
 
 class CreateDestroyWidget : public QWidget
