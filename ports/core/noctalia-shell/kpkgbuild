# description	: Noctalia desktop shell — bars, panels, notifications, lock screen (QML on Quickshell)
# homepage	: https://github.com/noctalia-dev/noctalia-shell
# depends	: noctalia-qs

name=noctalia-shell
version=4.7.6
release=1
source="https://github.com/noctalia-dev/noctalia-shell/archive/refs/tags/v$version.tar.gz"

build() {
	# Noctalia is QML; the install is a tree of .qml files plus assets.
	# Layout follows the upstream `nix` recipe: shell tree under
	# /usr/share/noctalia-shell, launcher wrapper at /usr/bin/noctalia.
	# Drop the Sway backend: its Quickshell.I3 module is X11-only and cannot build on
	# a Wayland-only host. niri is detected first (NIRI_SOCKET), so Sway never runs;
	# neutralizing the type reference lets the shell compile without Quickshell.I3.
	sed -i 's/SwayService {/Item {/' Services/Compositor/CompositorService.qml
	if grep -q 'SwayService {' Services/Compositor/CompositorService.qml; then
		echo "ERROR: noctalia Sway-drop patch did not apply"; exit 1
	fi

	install -dm755 "$PKG/usr/share/noctalia-shell"
	cp -a Assets Commons Helpers Modules Scripts Services Shaders Widgets shell.qml \
		"$PKG/usr/share/noctalia-shell/"
	# Wrapper that points qs at the installed shell tree
	install -dm755 "$PKG/usr/bin"
	cat > "$PKG/usr/bin/noctalia" <<'EOF'
#!/bin/sh
export QS_CONFIG_PATH=/usr/share/noctalia-shell
export NOCTALIA_PAM_SERVICE=noctalia
# virgl WITHOUT blob resources can't share Qt's GPU dmabufs with the compositor,
# so QtQuick surfaces render blank -> force software GL there. When the host
# exposes blob (VIRTIO_GPU_F_RESOURCE_BLOB, e.g. QEMU >=9 blob=true), dmabuf
# sharing works and we keep native HW GL + the threaded loop.
# Real GPUs have no virtio_gpu module.
if [ -d /sys/module/virtio_gpu ]; then
	# Detect blob support via dmesg (root, CAP_SYSLOG) or sysfs (non-root).
	# VIRTIO_GPU_F_RESOURCE_BLOB = virtio feature bit 2 (value 4).
	blob=0
	dmesg 2>/dev/null | grep -q '+resource_blob' && blob=1
	if [ "$blob" = 0 ] && [ -d /sys/bus/virtio/devices ]; then
		for f in /sys/bus/virtio/devices/*/features; do
			[ -r "$f" ] || continue
			fval=$(head -1 "$f" 2>/dev/null)
			fval="${fval#0x}"
			fval="${fval%%[$'\t ']*}"
			case "$fval" in *[!0-9a-fA-F]*|'') continue;; esac
			hex=$((16#$fval)) 2>/dev/null || continue
			[ $((hex & 4)) -eq 0 ] 2>/dev/null || { blob=1; break; }
		done
	fi
	if [ "$blob" = 0 ]; then
		export LIBGL_ALWAYS_SOFTWARE=1
		export QSG_RENDER_LOOP=basic
	fi
fi
exec qs --path /usr/share/noctalia-shell "$@"
EOF
	chmod 755 "$PKG/usr/bin/noctalia"
}
