name        = openocd
version     = 0.12.0
release     = 1
# The `::` form is required, not stylistic: a SourceForge URL ends in
# `/download`, so the basename kpkg would otherwise derive is the literal word
# `download` — a filename nothing on disk matches.
source      = $name-$version.tar.bz2::https://sourceforge.net/projects/$name/files/$name/$version/$name-$version.tar.bz2/download
sha256      = af254788be98861f2bd9103fe6e60a774ec96a8c374744eef9197f6043075afa  openocd-0.12.0.tar.bz2
description = On-chip debugging and flashing over JTAG or SWD
