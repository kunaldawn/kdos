# description	: X protocol C-language binding
# homepage	: https://gitlab.freedesktop.org/xorg/lib/libxcb
# depends	: xcb-proto libXau libXdmcp

name=libxcb
version=1.17.0
release=1
source="https://www.x.org/releases/individual/lib/$name-$version.tar.xz"

build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--disable-static
	make
	make DESTDIR=$PKG install
}
