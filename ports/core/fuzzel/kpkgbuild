# description	: Application launcher for wlroots-based Wayland compositors
# homepage	: https://codeberg.org/dnkl/fuzzel
# depends	: meson scdoc wayland wayland-protocols cairo libpng pixman fcft fontconfig libxkbcommon

name=fuzzel
version=1.12.0
release=1
source="https://codeberg.org/dnkl/fuzzel/archive/$version.tar.gz"

build() {
	meson setup build \
		--prefix=/usr --libdir=lib \
		-Denable-cairo=enabled \
		-Dpng-backend=libpng \
		-Dsvg-backend=none
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
