# description	: EDID and DisplayID parser used by Wayland compositors
# homepage	: https://gitlab.freedesktop.org/emersion/libdisplay-info
# depends	: meson hwdata

name=libdisplay-info
version=0.2.0
release=1
source="https://gitlab.freedesktop.org/emersion/libdisplay-info/-/releases/$version/downloads/libdisplay-info-$version.tar.bz2"

build() {
	meson setup build \
		--prefix=/usr --sysconfdir=/etc --libdir=lib
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
