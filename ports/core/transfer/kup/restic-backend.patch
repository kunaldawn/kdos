+#ifndef KUP_RESTIC_H
+#define KUP_RESTIC_H
+
+#include <QByteArray>
+#include <QDateTime>
+#include <QProcessEnvironment>
+#include <QString>
+#include <QStringList>
+#include <qwindowdefs.h>
+
+class BackupPlan;
+class QProcess;
+
+namespace Solid
+{
+class Device;
+}
+
+// Everything the restic backend shares between the daemon, the settings
+// module and the KIO worker: how a repository is recognised, how restic is
+// started and how its password reaches it.
+namespace Restic
+{
+
+// restic's documented exit codes.
+enum ExitCode {
+    ExitSuccess = 0,
+    ExitFatal = 1,
+    ExitIncomplete = 3,
+    ExitNoRepository = 10,
+    ExitLocked = 11,
+    ExitWrongPassword = 12,
+};
+
+// Every snapshot Kup saves carries this tag, and pruning only ever considers
+// snapshots that carry it, so snapshots saved into the same repository by
+// other programs are never removed by Kup.
+QString snapshotTag();
+
+// A local restic repository: a config file beside the keys, data and
+// snapshots folders.
+bool isRepository(const QString &pPath);
+
+// The identity Kup gives a storage volume: its filesystem UUID, or for a
+// volume without one (vfat) the drive's description and the volume label.
+// Must give the same string as EDExecutor::deviceAdded and DriveSelection,
+// which store it as "External drive UUID".
+QString volumeIdentity(const Solid::Device &pVolumeDevice);
+
+// Escapes a literal path for restic's --exclude, which reads its argument as
+// a glob: a folder named "a*b" would otherwise exclude every name it matches.
+QString escapePattern(const QString &pPath);
+
+// The retention policy of "Remove old backups automatically" and of the
+// applet's prune action, as restic forget arguments.
+QStringList forgetArguments();
+
+// A timestamp restic writes in its JSON output (RFC 3339, nanoseconds).
+QDateTime parseTime(const QString &pTime);
+
+// The environment restic runs in: the session's, without the RESTIC_*
+// variables that would name another repository or take precedence over the
+// password Kup passes (RESTIC_PASSWORD_COMMAND outranks --password-file).
+QProcessEnvironment environment();
+
+// The first line of `restic version`, or empty when restic cannot be run.
+QString programVersion();
+
+// KWallet holds the passwords in this folder of the network wallet.
+QString walletFolder();
+bool walletHasPassword(const QString &pKey);
+bool readWalletPassword(const QString &pKey, QString &pPassword, WId pWindow, QString &pError);
+bool writeWalletPassword(const QString &pKey, const QString &pPassword, WId pWindow, QString &pError);
+
+// How restic gets the password of one repository. A password from KWallet
+// never becomes an argument or an environment variable: each process gets it
+// through its own pipe, at file descriptor 3, which restic reads as its
+// password file. A configured password file is passed as it is.
+class Credentials
+{
+public:
+    Credentials() = default;
+    ~Credentials();
+    Credentials(const Credentials &) = delete;
+    Credentials &operator=(const Credentials &) = delete;
+
+    void setPassword(const QString &pPassword);
+    void setPasswordFile(const QString &pPath);
+    bool isSet() const;
+
+    // Loads what pPlan says: the password file, which must exist and be
+    // readable by no one else, or the KWallet entry. Fills pError with a
+    // sentence for a notification on failure.
+    bool loadForPlan(const BackupPlan &pPlan, WId pWindow, QString &pError);
+
+    // Sets program, arguments and environment of pProcess so that it runs
+    // `restic -r <pRepository> --password-file <...> <pArguments>`, and
+    // prepares the pipe that carries the password. Call release() as soon as
+    // the process has been started.
+    bool prepare(QProcess &pProcess, const QString &pRepository, const QStringList &pArguments);
+
+    // Closes this side's copy of the password pipe. A started child keeps its
+    // own copy; one that never started reads nothing.
+    void release();
+
+private:
+    QString mPasswordFile;
+    QByteArray mPassword;
+    int mPipeRead = -1;
+};
+
+}
+
+#endif // KUP_RESTIC_H
