+
+void BackupPlanWidget::saveResticPassword()
+{
+    if (mBackupPlan->mBackupType != BackupType::ResticType) {
+        mResticPasswordEdit->clear();
+        mResticPasswordChanged = false;
+        return;
+    }
+    if (mBackupPlan->mResticUsePasswordFile) {
+        mResticPasswordChanged = false;
+        return;
+    }
+    const QString lKey = mBackupPlan->resticWalletKey();
+    const QString lPassword = mResticPasswordEdit->password();
+    if (mResticPasswordChanged && !lPassword.isEmpty()) {
+        // restic strips white space around a password it reads from a file,
+        // which is how Kup hands it over; such a password could never open
+        // a repository made with it at a terminal.
+        if (lPassword != lPassword.trimmed()) {
+            KMessageBox::error(this,
+                               xi18nc("@info", "The repository password cannot begin or end with a space."),
+                               xi18nc("@title:window", "Warning"));
+            return;
+        }
+        QString lError;
+        if (!Restic::writeWalletPassword(lKey, lPassword, window()->winId(), lError)) {
+            KMessageBox::error(this, lError, xi18nc("@title:window", "Warning"));
+            return;
+        }
+        mResticPasswordEdit->clear();
+        mResticPasswordChanged = false;
+        updateResticPasswordPlaceholder();
+        return;
+    }
+    mResticPasswordChanged = false;
+    if (!Restic::walletHasPassword(lKey)) {
+        KMessageBox::information(this,
+                                 xi18nc("@info %1 is the name of the backup plan",
+                                        "%1 has no repository password!<nl/>"
+                                        "No backups will be saved by this plan.",
+                                        mBackupPlan->mDescription),
+                                 xi18nc("@title:window", "Warning"),
+                                 QString(),
+                                 KMessageBox::Dangerous);
+    }
+}
