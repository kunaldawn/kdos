+bool ResticWorker::loadPlanCredentials(const QString &pRepository)
+{
+    KSharedConfigPtr lConfig = KSharedConfig::openConfig(QStringLiteral("kuprc"));
+    KupSettings lSettings(lConfig);
+    for (int i = 0; i < lSettings.mNumberOfPlans; ++i) {
+        BackupPlan lPlan(i + 1, lConfig);
+        if (lPlan.mBackupType != BackupType::ResticType) {
+            continue;
+        }
+        bool lMatches = false;
+        if (lPlan.mDestinationType == 0) {
+            lMatches = QDir::cleanPath(lPlan.mFilesystemDestinationPath.toLocalFile()) == pRepository;
+        } else if (lPlan.mDestinationType == 1) {
+            // A drive is mounted wherever the system puts it; the plan names
+            // the volume and a folder on it.
+            const Solid::Device lDevice = Solid::Device::storageAccessFromPath(pRepository);
+            const auto *lAccess = lDevice.as<Solid::StorageAccess>();
+            if (lAccess != nullptr && !lAccess->filePath().isEmpty()) {
+                const QString lCandidate = QDir::cleanPath(lAccess->filePath() + QLatin1Char('/') + lPlan.mExternalDestinationPath);
+                lMatches = lCandidate == pRepository && Restic::volumeIdentity(lDevice) == lPlan.mExternalUUID;
+            }
+        }
+        if (!lMatches) {
+            continue;
+        }
+        QString lError;
+        if (mCredentials.loadForPlan(lPlan, 0, lError)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+KIO::WorkerResult ResticWorker::verifyPassword(const QString &pPassword, bool &pAccepted)
+{
+    mCredentials.setPassword(pPassword);
+    QByteArray lOutput;
+    const KIO::WorkerResult lResult = runRestic({QStringLiteral("cat"), QStringLiteral("config")}, lOutput);
+    pAccepted = lResult.success();
+    if (!lResult.success() && lResult.error() != KIO::ERR_CANNOT_AUTHENTICATE) {
+        return lResult;
+    }
+    return KIO::WorkerResult::pass();
+}
+
+KIO::WorkerResult ResticWorker::openRepository(const QString &pRepository)
+{
+    if (pRepository == mRepository && mCredentials.isSet()) {
+        return KIO::WorkerResult::pass();
+    }
+    mRepository = pRepository;
+    mCredentials.setPassword(QString());
+    mSnapshots.clear();
+    mTrees.clear();
+
+    QString lError;
+    if (loadPlanCredentials(pRepository)) {
+        QByteArray lOutput;
+        const KIO::WorkerResult lResult = runRestic({QStringLiteral("cat"), QStringLiteral("config")}, lOutput);
+        if (lResult.success()) {
+            return lResult;
+        }
+        if (lResult.error() != KIO::ERR_CANNOT_AUTHENTICATE) {
+            mRepository.clear();
+            return lResult;
+        }
+        lError = i18n("The password stored for this backup plan does not open the repository.");
+    }
+
+    // A repository no backup plan names, or one whose stored password is
+    // wrong: ask, the way every KIO worker asks, and let the password server
+    // keep the answer in KWallet when the person ticks "Remember".
+    KIO::AuthInfo lInfo;
+    QUrl lUrl;
+    lUrl.setScheme(QStringLiteral("restic"));
+    lUrl.setPath(pRepository);
+    lInfo.url = lUrl;
+    lInfo.username = QStringLiteral("restic");
+    lInfo.readOnly = true;
+    lInfo.keepPassword = true;
+    lInfo.caption = i18n("Backup Password");
+    lInfo.prompt = i18n("Enter the password of the restic repository at %1.", pRepository);
+    lInfo.setExtraField(QStringLiteral("hide-username-line"), true);
+
+    if (lError.isEmpty() && checkCachedAuthentication(lInfo)) {
+        bool lAccepted = false;
+        const KIO::WorkerResult lResult = verifyPassword(lInfo.password, lAccepted);
+        if (!lResult.success()) {
+            mRepository.clear();
+            return lResult;
+        }
+        if (lAccepted) {
+            return KIO::WorkerResult::pass();
+        }
+        lError = i18n("The remembered password does not open the repository.");
+    }
+
+    while (true) {
+        const int lDialogResult = openPasswordDialog(lInfo, lError);
+        if (lDialogResult != 0) {
+            mRepository.clear();
+            mCredentials.setPassword(QString());
+            return KIO::WorkerResult::fail(lDialogResult, pRepository);
+        }
+        bool lAccepted = false;
+        const KIO::WorkerResult lResult = verifyPassword(lInfo.password, lAccepted);
+        if (!lResult.success()) {
+            mRepository.clear();
+            return lResult;
+        }
+        if (lAccepted) {
+            if (lInfo.keepPassword) {
+                cacheAuthentication(lInfo);
+            }
+            return KIO::WorkerResult::pass();
+        }
+        lError = i18n("Wrong password. Please try again.");
+    }
+}
+
+KIO::WorkerResult ResticWorker::failFor(int pExitCode, const QByteArray &pErrors)
+{
+    const QString lErrors = QString::fromUtf8(pErrors).trimmed();
+    switch (pExitCode) {
+    case Restic::ExitWrongPassword:
+        return KIO::WorkerResult::fail(KIO::ERR_CANNOT_AUTHENTICATE, mRepository);
+    case Restic::ExitNoRepository:
+        return KIO::WorkerResult::fail(KIO::ERR_DOES_NOT_EXIST, mRepository);
+    default:
+        break;
+    }
+    if (lErrors.contains(QStringLiteral("not found")) || lErrors.contains(QStringLiteral("no matching ID found"))) {
+        return KIO::WorkerResult::fail(KIO::ERR_DOES_NOT_EXIST, lErrors);
+    }
+    return KIO::WorkerResult::fail(KIO::ERR_WORKER_DEFINED, i18n("restic failed:\n%1", lErrors));
+}
+
+KIO::WorkerResult ResticWorker::runRestic(const QStringList &pArguments, QByteArray &pOutput)
+{
+    QProcess lProcess;
+    if (!mCredentials.prepare(lProcess, mRepository, QStringList{QStringLiteral("--no-lock")} + pArguments)) {
+        return KIO::WorkerResult::fail(KIO::ERR_CANNOT_AUTHENTICATE, mRepository);
+    }
+    lProcess.start();
+    mCredentials.release();
+    if (!lProcess.waitForStarted(-1)) {
+        return KIO::WorkerResult::fail(KIO::ERR_CANNOT_LAUNCH_PROCESS, QStringLiteral("restic"));
+    }
+    lProcess.waitForFinished(-1);
+    pOutput = lProcess.readAllStandardOutput();
+    if (lProcess.exitStatus() != QProcess::NormalExit) {
+        return KIO::WorkerResult::fail(KIO::ERR_WORKER_DIED, QStringLiteral("restic"));
+    }
+    if (lProcess.exitCode() != 0) {
+        return failFor(lProcess.exitCode(), lProcess.readAllStandardError());
+    }
+    return KIO::WorkerResult::pass();
+}
