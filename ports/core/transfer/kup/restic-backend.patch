+
+#ifndef RESTICMAINTENANCEJOB_H
+#define RESTICMAINTENANCEJOB_H
+
+#include "resticjob.h"
+
+// The jobs on a restic repository that save nothing: the integrity check, the
+// repair, and removing the snapshots the retention policy no longer keeps.
+class ResticMaintenanceJob : public ResticBaseJob
+{
+    Q_OBJECT
+
+public:
+    enum Mode { Check, Repair, Prune };
+
+    ResticMaintenanceJob(Mode pMode, BackupPlan &pBackupPlan, const QString &pDestinationPath, const QString &pLogFilePath, KupDaemon *pKupDaemon);
+
+protected slots:
+    void performJob() override;
+    void slotFirstStepDone(int pExitCode, QProcess::ExitStatus pExitStatus);
+    void slotCheckAfterRepairDone(int pExitCode, QProcess::ExitStatus pExitStatus);
+
+protected:
+    void collectOutput(KProcess &pProcess, int pExitCode);
+    void finishCheck(int pExitCode, QProcess::ExitStatus pExitStatus);
+
+    Mode mMode;
+    KProcess mStepProcess;
+    KProcess mCheckProcess;
+};
+
+#endif // RESTICMAINTENANCEJOB_H
