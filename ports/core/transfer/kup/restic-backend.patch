+void PlanExecutor::startPruneJob()
+{
+    discardPruneQuestion();
+    if (mPlan->mBackupType != BackupType::ResticType || busy() || !destinationAvailable()) {
+        return;
+    }
+    KJob *lJob = new ResticMaintenanceJob(ResticMaintenanceJob::Prune, *mPlan, mDestinationPath, mLogFilePath, mKupDaemon);
+    connect(lJob, &KJob::result, this, &PlanExecutor::pruneFinished);
+    lJob->start();
+    mLastState = mState;
+    mState = ExecutorState::PRUNING;
+    emit stateChanged();
+    startSleepInhibit();
+}
+
+// Removing snapshots cannot be undone, so the applet's action asks first and
+// names what the policy keeps.
+void PlanExecutor::askToPrune()
+{
+    discardPruneQuestion();
+    mPruneQuestion = new KNotification(QStringLiteral("StartBackup"), KNotification::Persistent);
+    mPruneQuestion->setTitle(mPlan->mDescription);
+    mPruneQuestion->setText(xi18nc("@info",
+                                   "Remove the old backups this plan no longer needs?\n"
+                                   "Kept are every backup from the last two days, one a day for a month, "
+                                   "one a week for six months, one a month for two years and one a year after that."));
+
+    KNotificationAction *yes = mPruneQuestion->addAction(xi18nc("@action:button", "Remove Old Backups"));
+    connect(yes, &KNotificationAction::activated, this, &PlanExecutor::startPruneJob);
+
+    KNotificationAction *no = mPruneQuestion->addAction(xi18nc("@action:button", "Cancel"));
+    connect(no, &KNotificationAction::activated, this, &PlanExecutor::discardPruneQuestion);
+
+    connect(mPruneQuestion, &KNotification::closed, this, &PlanExecutor::discardPruneQuestion);
+    connect(mPruneQuestion, &KNotification::ignored, this, &PlanExecutor::discardPruneQuestion);
+    mPruneQuestion->sendEvent();
+}
+
+void PlanExecutor::discardPruneQuestion()
+{
+    if (mPruneQuestion) {
+        mPruneQuestion->deleteLater();
+        mPruneQuestion = nullptr;
+    }
+}
+
+void PlanExecutor::pruneFinished(KJob *pJob)
+{
+    endSleepInhibit();
+    discardPruneNotification();
+    mPruneNotification = new KNotification(pJob->error() ? QStringLiteral("BackupFailed") : QStringLiteral("BackupSucceeded"));
+    if (pJob->error()) {
+        mPruneNotification->setTitle(xi18nc("@title:window", "Removing Old Backups Failed"));
+        mPruneNotification->setText(pJob->errorText());
+        KNotificationAction *showLogFile = mPruneNotification->addAction(xi18nc("@action:button", "Show log file"));
+        connect(showLogFile, &KNotificationAction::activated, this, [this]() {
+            showLog(mPruneNotification ? mPruneNotification->xdgActivationToken() : QString());
+        });
+    } else {
+        mPruneNotification->setTitle(xi18nc("@title:window", "Old Backups Removed"));
+        mPruneNotification->setText(xi18nc("@info notification", "The backups the plan no longer keeps were removed."));
+    }
+    connect(mPruneNotification, &KNotification::closed, this, &PlanExecutor::discardPruneNotification);
+    connect(mPruneNotification, &KNotification::ignored, this, &PlanExecutor::discardPruneNotification);
+    mPruneNotification->sendEvent();
+
+    if (mState == ExecutorState::PRUNING) { // only restore if nothing has changed during the run
+        mState = mLastState;
+    }
+    emit stateChanged();
+}
+
+void PlanExecutor::discardPruneNotification()
+{
+    if (mPruneNotification) {
+        mPruneNotification->deleteLater();
+        mPruneNotification = nullptr;
+    }
+}
