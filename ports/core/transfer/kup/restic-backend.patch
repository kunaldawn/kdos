+ResticBaseJob::ResticBaseJob(BackupPlan &pBackupPlan, const QString &pDestinationPath, const QString &pLogFilePath, KupDaemon *pKupDaemon)
+    : BackupJob(pBackupPlan, pDestinationPath, pLogFilePath, pKupDaemon)
+{
+    setCapabilities(KJob::Suspendable | KJob::Killable);
+}
+
+bool ResticBaseJob::prepareRestic()
+{
+    if (Restic::programVersion().isEmpty()) {
+        jobFinishedError(ErrorWithoutLog,
+                         xi18nc("@info notification",
+                                "The <application>restic</application> program is needed but could not be found, "
+                                "maybe it is not installed?"));
+        return false;
+    }
+    QString lError;
+    if (!mCredentials.loadForPlan(mBackupPlan, 0, lError)) {
+        jobFinishedError(ErrorPasswordConfig, lError);
+        return false;
+    }
+    return true;
+}
+
+void ResticBaseJob::watchProcess(KProcess &pProcess)
+{
+    pProcess.setOutputChannelMode(KProcess::SeparateChannels);
+    connect(&pProcess, &KProcess::started, this, [this, &pProcess] {
+        makeNice(static_cast<int>(pProcess.processId()));
+    });
+    mProcesses.append(&pProcess);
+}
+
+bool ResticBaseJob::startRestic(KProcess &pProcess, const QStringList &pArguments)
+{
+    if (!mCredentials.prepare(pProcess, mDestinationPath, pArguments)) {
+        mLogStream << QStringLiteral("Kup could not hand the repository password to restic.") << Qt::endl;
+        return false;
+    }
+    mLogStream << quoteArgs(pProcess.program()) << Qt::endl;
+    pProcess.start();
+    mCredentials.release();
+    return true;
+}
+
+int ResticBaseJob::executeRestic(KProcess &pProcess, const QStringList &pArguments)
+{
+    pProcess.setOutputChannelMode(KProcess::SeparateChannels);
+    if (!mCredentials.prepare(pProcess, mDestinationPath, pArguments)) {
+        mLogStream << QStringLiteral("Kup could not hand the repository password to restic.") << Qt::endl;
+        return -1;
+    }
+    mLogStream << quoteArgs(pProcess.program()) << Qt::endl;
+    pProcess.start();
+    mCredentials.release();
+    if (!pProcess.waitForFinished(-1) || pProcess.exitStatus() != QProcess::NormalExit) {
+        return -1;
+    }
+    return pProcess.exitCode();
+}
+
+void ResticBaseJob::logErrors(KProcess &pProcess)
+{
+    const QString lErrors = QString::fromUtf8(pProcess.readAllStandardError());
+    if (!lErrors.isEmpty()) {
+        mLogStream << lErrors << Qt::endl;
+    }
+}
+
+bool ResticBaseJob::finishOnCommonError(int pExitCode)
+{
+    switch (pExitCode) {
+    case Restic::ExitNoRepository:
+        mLogStream << QStringLiteral("Kup found no restic repository at the destination.") << Qt::endl;
+        jobFinishedError(ErrorWithLog, xi18nc("@info notification", "There is no restic repository at the backup destination. See log file for more details."));
+        return true;
+    case Restic::ExitLocked:
+        mLogStream << QStringLiteral("The restic repository is locked by another restic process.") << Qt::endl;
+        jobFinishedError(ErrorWithLog,
+                         xi18nc("@info notification",
+                                "The backup destination is in use by another restic process. "
+                                "Try again when it has finished. See log file for more details."));
+        return true;
+    case Restic::ExitWrongPassword:
+        mLogStream << QStringLiteral("The password does not open the restic repository.") << Qt::endl;
+        jobFinishedError(ErrorPasswordConfig,
+                         xi18nc("@info notification",
+                                "The password does not open the restic repository at the backup destination. "
+                                "Please open settings and enter the repository's password."));
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool ResticBaseJob::doKill()
+{
+    setError(KilledJobError);
+    for (KProcess *lProcess : std::as_const(mProcesses)) {
+        if (lProcess->state() == KProcess::Running) {
+            // SIGINT lets restic remove its lock from the repository before it
+            // exits; a killed restic leaves a stale lock behind.
+            if (0 == ::kill(static_cast<pid_t>(lProcess->processId()), SIGINT)) {
+                return lProcess->waitForFinished();
+            }
+            return false;
+        }
+    }
+    return true;
+}
+
+bool ResticBaseJob::doSuspend()
+{
+    for (KProcess *lProcess : std::as_const(mProcesses)) {
+        if (lProcess->state() == KProcess::Running) {
+            return 0 == ::kill(static_cast<pid_t>(lProcess->processId()), SIGSTOP);
+        }
+    }
+    return false;
+}
+
+bool ResticBaseJob::doResume()
+{
+    for (KProcess *lProcess : std::as_const(mProcesses)) {
+        if (lProcess->state() == KProcess::Running) {
+            return 0 == ::kill(static_cast<pid_t>(lProcess->processId()), SIGCONT);
+        }
+    }
+    return false;
+}
+
+ResticJob::ResticJob(BackupPlan &pBackupPlan, const QString &pDestinationPath, const QString &pLogFilePath, KupDaemon *pKupDaemon)
+    : ResticBaseJob(pBackupPlan, pDestinationPath, pLogFilePath, pKupDaemon)
+{
+    watchProcess(mCheckProcess);
+    watchProcess(mSaveProcess);
+    watchProcess(mForgetProcess);
+    connect(&mCheckProcess, qOverload<int, QProcess::ExitStatus>(&QProcess::finished), this, &ResticJob::slotCheckingDone);
+    connect(&mSaveProcess, qOverload<int, QProcess::ExitStatus>(&QProcess::finished), this, &ResticJob::slotSavingDone);
+    connect(&mSaveProcess, &KProcess::readyReadStandardOutput, this, &ResticJob::slotReadSaveOutput);
+    connect(&mSaveProcess, &KProcess::readyReadStandardError, this, &ResticJob::slotReadSaveErrors);
+    connect(&mForgetProcess, qOverload<int, QProcess::ExitStatus>(&QProcess::finished), this, &ResticJob::slotForgettingDone);
+}
+
+void ResticJob::performJob()
+{
+    if (!prepareRestic()) {
+        return;
+    }
+    mLogStream << QStringLiteral("Kup is starting restic backup job at ") << QLocale().toString(QDateTime::currentDateTime()) << Qt::endl << Qt::endl;
+
+    if (!Restic::isRepository(mDestinationPath)) {
+        // restic init writes its folders beside whatever is there; a folder
+        // that already holds other files would end up mixed with the
+        // repository, so only an empty one is initialised.
+        const QDir lDestination(mDestinationPath);
+        if (!lDestination.entryList(QDir::AllEntries | QDir::Hidden | QDir::System | QDir::NoDotAndDotDot).isEmpty()) {
+            mLogStream << QStringLiteral("The destination is not empty and holds no restic repository: ") << mDestinationPath << Qt::endl;
+            jobFinishedError(ErrorWithLog,
+                             xi18nc("@info notification",
+                                    "The backup destination is not empty and is not a restic repository. "
+                                    "Please choose an empty folder or an existing restic repository."));
+            return;
+        }
+        emit description(this, i18n("Initializing backup destination"));
+        KProcess lInitProcess;
+        const int lExitCode = executeRestic(lInitProcess, {QStringLiteral("init")});
+        if (lExitCode != 0) {
+            logErrors(lInitProcess);
+            mLogStream << QStringLiteral(
+                "Kup did not successfully complete the restic backup job: "
+                "failed to initialize backup destination.")
+                       << Qt::endl;
+            jobFinishedError(ErrorWithLog,
+                             xi18nc("@info notification",
+                                    "Backup destination could not be initialised. "
+                                    "See log file for more details."));
+            return;
+        }
+        mLogStream << QString::fromUtf8(lInitProcess.readAllStandardOutput()) << Qt::endl;
+    }
+
+    if (mBackupPlan.mCheckBackups) {
+        emit description(this, i18n("Checking backup integrity"));
+        if (!startRestic(mCheckProcess, {QStringLiteral("--retry-lock"), QStringLiteral("1m"), QStringLiteral("check")})) {
+            jobFinishedError(ErrorWithLog, xi18nc("@info notification", "Failed to save backup. See log file for more details."));
+        }
+    } else {
+        startSaving();
+    }
+}
+
+void ResticJob::slotCheckingDone(int pExitCode, QProcess::ExitStatus pExitStatus)
+{
+    mLogStream << QString::fromUtf8(mCheckProcess.readAllStandardOutput());
+    logErrors(mCheckProcess);
+    mLogStream << "Exit code: " << pExitCode << Qt::endl;
+    if (pExitStatus == QProcess::NormalExit && finishOnCommonError(pExitCode)) {
+        return;
+    }
+    if (pExitStatus != QProcess::NormalExit || pExitCode != 0) {
+        mLogStream << QStringLiteral(
+            "Kup did not successfully complete the restic backup job: "
+            "failed integrity check. Your backups could be "
+            "corrupted! See above for details.")
+                   << Qt::endl;
+        jobFinishedError(ErrorSuggestRepair,
+                         xi18nc("@info notification",
+                                "Failed backup integrity check. Your backups could be corrupted! "
+                                "See log file for more details. Do you want to try repairing the backup files?"));
+        return;
+    }
+    startSaving();
+}
+
+QStringList ResticJob::excludeArguments()
+{
+    QStringList lArguments;
+    if (mBackupPlan.mExcludeCaches) {
+        lArguments << QStringLiteral("--exclude-caches");
+    }
+
+    DynamicExclusions lDynExclusions;
+    lDynExclusions.setFromPlan(mBackupPlan);
+    QStringList lExcludes = mBackupPlan.mPathsExcluded + lDynExclusions.pathsExcluded(mBackupPlan.mPathsIncluded);
+
+    // A repository inside a source folder would be saved into itself on
+    // every run, and grow by its own size each time.
+    const QString lRepository = QDir::cleanPath(mDestinationPath);
+    for (const QString &lInclude : std::as_const(mBackupPlan.mPathsIncluded)) {
+        QString lIncludeWithSlash = lInclude;
+        ensureTrailingSlash(lIncludeWithSlash);
+        if (lRepository.startsWith(lIncludeWithSlash)) {
+            lExcludes << lRepository;
+            break;
+        }
+    }
+
+    lExcludes.removeDuplicates();
+    for (const QString &lExclude : std::as_const(lExcludes)) {
+        if (!lExclude.isEmpty()) {
+            lArguments << QStringLiteral("--exclude") << Restic::escapePattern(lExclude);
+        }
+    }
+
+    const QString lExcludesPath = mBackupPlan.absoluteExcludesFilePath();
+    if (mBackupPlan.mExcludePatterns && QFileInfo::exists(lExcludesPath)) {
+        lArguments << QStringLiteral("--exclude-file") << lExcludesPath;
+    }
+    return lArguments;
+}
+
+void ResticJob::startSaving()
+{
+    QStringList lArguments{QStringLiteral("--retry-lock"),
+                           QStringLiteral("1m"),
+                           QStringLiteral("backup"),
+                           QStringLiteral("--json"),
+                           QStringLiteral("--tag"),
+                           Restic::snapshotTag()};
+    lArguments << excludeArguments();
+    lArguments << QStringLiteral("--");
+    lArguments << mBackupPlan.mPathsIncluded;
+
+    emit description(this, i18n("Saving backup"));
+    mInfoRateLimiter.start();
+    if (!startRestic(mSaveProcess, lArguments)) {
+        jobFinishedError(ErrorWithLog, xi18nc("@info notification", "Failed to save backup. See log file for more details."));
+    }
+}
+
+void ResticJob::takeLines(QByteArray &pPending, const QByteArray &pRead, bool pFlush)
+{
+    pPending += pRead;
+    qsizetype lEnd;
+    while ((lEnd = pPending.indexOf('\n')) >= 0) {
+        const QByteArray lLine = pPending.left(lEnd).trimmed();
+        pPending.remove(0, lEnd + 1);
+        if (!lLine.isEmpty()) {
+            handleJsonLine(lLine);
+        }
+    }
+    if (pFlush) {
+        const QByteArray lLast = pPending.trimmed();
+        pPending.clear();
+        if (!lLast.isEmpty()) {
+            handleJsonLine(lLast);
+        }
+    }
+}
+
+void ResticJob::slotReadSaveOutput()
+{
+    takeLines(mPendingOutput, mSaveProcess.readAllStandardOutput(), false);
+}
+
+// With --json, restic writes its error messages as JSON lines on standard
+// error, not standard output; they are what decides whether an exit code 3 is
+// harmless, so they are read as they come, like the status lines.
+void ResticJob::slotReadSaveErrors()
+{
+    takeLines(mPendingErrors, mSaveProcess.readAllStandardError(), false);
+}
+
+void ResticJob::handleJsonLine(const QByteArray &pLine)
+{
+    QJsonParseError lParseError;
+    const QJsonDocument lDocument = QJsonDocument::fromJson(pLine, &lParseError);
+    if (lParseError.error != QJsonParseError::NoError || !lDocument.isObject()) {
+        mLogStream << QString::fromUtf8(pLine) << Qt::endl;
+        return;
+    }
+    const QJsonObject lMessage = lDocument.object();
+    const QString lType = lMessage.value(QStringLiteral("message_type")).toString();
+
+    if (lType == QStringLiteral("status")) {
+        if (!mInfoRateLimiter.hasExpired(200)) {
+            return;
+        }
+        mInfoRateLimiter.start();
+        const auto lTotalBytes = static_cast<qulonglong>(lMessage.value(QStringLiteral("total_bytes")).toDouble());
+        const auto lBytesDone = static_cast<qulonglong>(lMessage.value(QStringLiteral("bytes_done")).toDouble());
+        const auto lTotalFiles = static_cast<qulonglong>(lMessage.value(QStringLiteral("total_files")).toDouble());
+        const auto lFilesDone = static_cast<qulonglong>(lMessage.value(QStringLiteral("files_done")).toDouble());
+        const double lElapsed = lMessage.value(QStringLiteral("seconds_elapsed")).toDouble();
+        const double lPercentDone = lMessage.value(QStringLiteral("percent_done")).toDouble();
+        if (lTotalFiles != 0) {
+            setPercent(qMax(static_cast<unsigned long>(lPercentDone * 100.0), 1UL));
+            setTotalAmount(KJob::Bytes, lTotalBytes);
+            setTotalAmount(KJob::Files, lTotalFiles);
+            setProcessedAmount(KJob::Bytes, lBytesDone);
+            setProcessedAmount(KJob::Files, lFilesDone);
+            if (lElapsed > 0.0) {
+                emitSpeed(static_cast<unsigned long>(static_cast<double>(lBytesDone) / lElapsed));
+            }
+        }
+        const QJsonArray lCurrentFiles = lMessage.value(QStringLiteral("current_files")).toArray();
+        if (!lCurrentFiles.isEmpty()) {
+            emit description(this,
+                             i18n("Saving backup"),
+                             qMakePair(i18nc("Label for file currently being copied", "File"), lCurrentFiles.first().toString()));
+        }
+    } else if (lType == QStringLiteral("error")) {
+        ++mErrorCount;
+        const QString lText = lMessage.value(QStringLiteral("error")).toObject().value(QStringLiteral("message")).toString();
+        // A file deleted between restic's scan and its read is not lost
+        // data; anything else (permission denied, an I/O error) is.
+        if (lText.contains(QStringLiteral("no such file or directory"))) {
+            ++mHarmlessErrorCount;
+        }
+        mLogStream << QStringLiteral("Error during ") << lMessage.value(QStringLiteral("during")).toString() << QStringLiteral(": ")
+                   << lMessage.value(QStringLiteral("item")).toString() << QStringLiteral(": ") << lText << Qt::endl;
+    } else if (lType == QStringLiteral("summary")) {
+        const KFormat lFormat;
+        mLogStream << QStringLiteral("Saved snapshot ") << lMessage.value(QStringLiteral("snapshot_id")).toString() << QStringLiteral(": ")
+                   << lMessage.value(QStringLiteral("files_new")).toInt() << QStringLiteral(" new, ") << lMessage.value(QStringLiteral("files_changed")).toInt()
+                   << QStringLiteral(" changed, ") << lMessage.value(QStringLiteral("files_unmodified")).toInt() << QStringLiteral(" unmodified files; ")
+                   << lFormat.formatByteSize(lMessage.value(QStringLiteral("data_added")).toDouble()) << QStringLiteral(" added to the repository.")
+                   << Qt::endl;
+    } else if (lType != QStringLiteral("verbose_status")) {
+        mLogStream << QString::fromUtf8(pLine) << Qt::endl;
+    }
+}
+
+void ResticJob::slotSavingDone(int pExitCode, QProcess::ExitStatus pExitStatus)
+{
+    takeLines(mPendingOutput, mSaveProcess.readAllStandardOutput(), true);
+    takeLines(mPendingErrors, mSaveProcess.readAllStandardError(), true);
+    mLogStream << "Exit code: " << pExitCode << Qt::endl;
+    if (pExitStatus == QProcess::NormalExit && finishOnCommonError(pExitCode)) {
+        return;
+    }
+    if (pExitStatus == QProcess::NormalExit && pExitCode == Restic::ExitIncomplete && mErrorCount > 0 && mErrorCount == mHarmlessErrorCount) {
+        mLogStream << QStringLiteral("Only harmless errors detected by Kup.") << Qt::endl;
+    } else if (pExitStatus == QProcess::NormalExit && pExitCode == Restic::ExitIncomplete) {
+        mLogStream << QStringLiteral(
+            "Kup did not successfully complete the restic backup job: "
+            "some files could not be read, the snapshot is incomplete.")
+                   << Qt::endl;
+        jobFinishedError(ErrorWithLog,
+                         xi18nc("@info notification",
+                                "Some files could not be read and are missing from the backup. "
+                                "See log file for more details."));
+        return;
+    } else if (pExitStatus != QProcess::NormalExit || pExitCode != 0) {
+        mLogStream << QStringLiteral(
+            "Kup did not successfully complete the restic backup job: "
+            "failed to save everything.")
+                   << Qt::endl;
+        jobFinishedError(ErrorWithLog,
+                         xi18nc("@info notification",
+                                "Failed to save backup. "
+                                "See log file for more details."));
+        return;
+    }
+
+    if (mBackupPlan.mResticForget) {
+        emit description(this, i18n("Removing old backups"));
+        if (startRestic(mForgetProcess, QStringList{QStringLiteral("--retry-lock"), QStringLiteral("2m")} + Restic::forgetArguments())) {
+            return;
+        }
+    }
+    finishSaved();
+}
+
+void ResticJob::slotForgettingDone(int pExitCode, QProcess::ExitStatus pExitStatus)
+{
+    mLogStream << QString::fromUtf8(mForgetProcess.readAllStandardOutput());
+    logErrors(mForgetProcess);
+    mLogStream << "Exit code: " << pExitCode << Qt::endl;
+    // The snapshot is saved by now, so a failed thinning-out does not make
+    // the backup fail: it is reported on its own and tried again next time.
+    if (pExitStatus != QProcess::NormalExit || pExitCode != 0) {
+        mLogStream << QStringLiteral("Kup could not remove old backups after saving the new one.") << Qt::endl;
+        KNotification::event(KNotification::Warning,
+                             xi18nc("@title:window", "Problem"),
+                             xi18nc("@info notification", "The backup was saved, but old backups could not be removed. See log file for more details."));
+    }
+    finishSaved();
+}
+
+void ResticJob::finishSaved()
+{
+    mLogStream << QStringLiteral("Kup successfully completed the restic backup job at ") << QLocale().toString(QDateTime::currentDateTime()) << Qt::endl;
+    jobFinishedSuccess();
+}
