+KIO::WorkerResult ResticWorker::locate(const QUrl &pUrl, Location &pLocation)
+{
+    // Accept the same sloppy forms the bup worker does: restic:/path,
+    // restic://path and restic:///path all name /path.
+    QString lPath;
+    if (!pUrl.host().isEmpty()) {
+        lPath = QStringLiteral("/") + pUrl.host() + pUrl.path();
+    } else {
+        lPath = pUrl.path();
+    }
+    lPath = QDir::cleanPath(QStringLiteral("/") + lPath);
+
+    QStringList lParts = lPath.split(QLatin1Char('/'), Qt::SkipEmptyParts);
+    QString lRepository;
+    bool lFound = false;
+    if (!mRepository.isEmpty() && (lPath == mRepository || lPath.startsWith(mRepository + QLatin1Char('/')))) {
+        lRepository = mRepository;
+        lParts = lPath.mid(mRepository.length()).split(QLatin1Char('/'), Qt::SkipEmptyParts);
+        lFound = true;
+    } else {
+        QString lCandidate;
+        while (!lParts.isEmpty()) {
+            lCandidate += QLatin1Char('/') + lParts.takeFirst();
+            if (Restic::isRepository(lCandidate)) {
+                lRepository = lCandidate;
+                lFound = true;
+                break;
+            }
+        }
+    }
+    if (!lFound) {
+        return KIO::WorkerResult::fail(KIO::ERR_WORKER_DEFINED, i18n("No restic repository found.\n%1", pUrl.toDisplayString()));
+    }
+
+    const KIO::WorkerResult lOpened = openRepository(lRepository);
+    if (!lOpened.success()) {
+        return lOpened;
+    }
+    pLocation.mRepository = lRepository;
+    pLocation.mSnapshotName = lParts.isEmpty() ? QString() : lParts.takeFirst();
+    pLocation.mPath = QStringLiteral("/") + lParts.join(QLatin1Char('/'));
+    return KIO::WorkerResult::pass();
+}
