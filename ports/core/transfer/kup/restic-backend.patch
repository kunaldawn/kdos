--- a/daemon/resticjob.h	1970-01-01 05:30:00.000000000 +0530
+++ b/daemon/resticjob.h	2026-11-09 13:42:31.295043307 +0530
@@ -0,0 +1,79 @@
+// SPDX-FileCopyrightText: 2026 Kunal Dawn <kunal.dawn@gmail.com>
+//
+// SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+#ifndef RESTICJOB_H
+#define RESTICJOB_H
+
+#include "backupjob.h"
+#include "restic.h"
+
+#include <KProcess>
+#include <QElapsedTimer>
+
+class KupDaemon;
+
+// What every job on a restic repository shares: finding restic, loading the
+// repository password, starting restic with it, and the exit codes all restic
+// commands have in common.
+class ResticBaseJob : public BackupJob
+{
+    Q_OBJECT
+
+protected:
+    ResticBaseJob(BackupPlan &pBackupPlan, const QString &pDestinationPath, const QString &pLogFilePath, KupDaemon *pKupDaemon);
+
+    // Finishes the job with a reason and returns false when restic is missing
+    // or the password is not available.
+    bool prepareRestic();
+    void watchProcess(KProcess &pProcess);
+    bool startRestic(KProcess &pProcess, const QStringList &pArguments);
+    int executeRestic(KProcess &pProcess, const QStringList &pArguments);
+    void logErrors(KProcess &pProcess);
+    // Finishes the job when the exit code is one every restic command shares
+    // (no repository, locked, wrong password) and returns true then.
+    bool finishOnCommonError(int pExitCode);
+
+    bool doKill() override;
+    bool doSuspend() override;
+    bool doResume() override;
+
+    Restic::Credentials mCredentials;
+    QList<KProcess *> mProcesses;
+};
+
+class ResticJob : public ResticBaseJob
+{
+    Q_OBJECT
+
+public:
+    ResticJob(BackupPlan &pBackupPlan, const QString &pDestinationPath, const QString &pLogFilePath, KupDaemon *pKupDaemon);
+
+protected slots:
+    void performJob() override;
+    void slotCheckingDone(int pExitCode, QProcess::ExitStatus pExitStatus);
+    void startSaving();
+    void slotSavingDone(int pExitCode, QProcess::ExitStatus pExitStatus);
+    void slotReadSaveOutput();
+    void slotReadSaveErrors();
+    void slotForgettingDone(int pExitCode, QProcess::ExitStatus pExitStatus);
+
+protected:
+    QStringList excludeArguments();
+    // Hands every complete line of pRead, after what pPending held, to
+    // handleJsonLine; with pFlush also the unterminated rest.
+    void takeLines(QByteArray &pPending, const QByteArray &pRead, bool pFlush);
+    void handleJsonLine(const QByteArray &pLine);
+    void finishSaved();
+
+    KProcess mCheckProcess;
+    KProcess mSaveProcess;
+    KProcess mForgetProcess;
+    QByteArray mPendingOutput;
+    QByteArray mPendingErrors;
+    QElapsedTimer mInfoRateLimiter;
+    int mErrorCount = 0;
+    int mHarmlessErrorCount = 0;
+};
+
+#endif // RESTICJOB_H
diff -ruN a/daemon/resticmaintenancejob.cpp b/daemon/resticmaintenancejob.cpp
--- a/daemon/resticmaintenancejob.cpp	1970-01-01 05:30:00.000000000 +0530
+++ b/daemon/resticmaintenancejob.cpp	2026-11-09 13:42:31.295160710 +0530
@@ -0,0 +1,151 @@
+// SPDX-FileCopyrightText: 2026 Kunal Dawn <kunal.dawn@gmail.com>
+//
+// SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+#include "resticmaintenancejob.h"
+
+#include <KLocalizedString>
+
+ResticMaintenanceJob::ResticMaintenanceJob(Mode pMode,
+                                           BackupPlan &pBackupPlan,
+                                           const QString &pDestinationPath,
+                                           const QString &pLogFilePath,
+                                           KupDaemon *pKupDaemon)
+    : ResticBaseJob(pBackupPlan, pDestinationPath, pLogFilePath, pKupDaemon)
+    , mMode(pMode)
+{
+    watchProcess(mStepProcess);
+    watchProcess(mCheckProcess);
+    connect(&mStepProcess, qOverload<int, QProcess::ExitStatus>(&QProcess::finished), this, &ResticMaintenanceJob::slotFirstStepDone);
+    connect(&mCheckProcess, qOverload<int, QProcess::ExitStatus>(&QProcess::finished), this, &ResticMaintenanceJob::slotCheckAfterRepairDone);
+}
+
+void ResticMaintenanceJob::performJob()
+{
+    if (!prepareRestic()) {
+        return;
+    }
+    if (!Restic::isRepository(mDestinationPath)) {
+        jobFinishedError(ErrorWithoutLog, xi18nc("@info notification", "There is no restic repository at the backup destination."));
+        return;
+    }
+
+    QStringList lArguments;
+    switch (mMode) {
+    case Check:
+        mLogStream << QStringLiteral("Kup is starting restic verification job at ") << QLocale().toString(QDateTime::currentDateTime()) << Qt::endl << Qt::endl;
+        emit description(this, i18n("Checking backup integrity"));
+        lArguments << QStringLiteral("--retry-lock") << QStringLiteral("1m") << QStringLiteral("check");
+        break;
+    case Repair:
+        // The index is what restic rebuilds from the data it actually holds;
+        // repairing snapshots would cut damaged files out of them, which is a
+        // decision about lost data left to the person, not to this job.
+        mLogStream << QStringLiteral("Kup is starting restic repair job at ") << QLocale().toString(QDateTime::currentDateTime()) << Qt::endl << Qt::endl;
+        emit description(this, i18n("Repairing backups"));
+        lArguments << QStringLiteral("--retry-lock") << QStringLiteral("2m") << QStringLiteral("repair") << QStringLiteral("index");
+        break;
+    case Prune:
+        mLogStream << QStringLiteral("Kup is starting restic prune job at ") << QLocale().toString(QDateTime::currentDateTime()) << Qt::endl << Qt::endl;
+        emit description(this, i18n("Removing old backups"));
+        lArguments << QStringLiteral("--retry-lock") << QStringLiteral("2m") << Restic::forgetArguments();
+        break;
+    }
+    if (!startRestic(mStepProcess, lArguments)) {
+        jobFinishedError(ErrorWithLog, xi18nc("@info notification", "The restic program could not be started. See log file for more details."));
+    }
+}
+
+void ResticMaintenanceJob::collectOutput(KProcess &pProcess, int pExitCode)
+{
+    mLogStream << QString::fromUtf8(pProcess.readAllStandardOutput());
+    logErrors(pProcess);
+    mLogStream << "Exit code: " << pExitCode << Qt::endl;
+}
+
+void ResticMaintenanceJob::slotFirstStepDone(int pExitCode, QProcess::ExitStatus pExitStatus)
+{
+    collectOutput(mStepProcess, pExitCode);
+    if (pExitStatus == QProcess::NormalExit && finishOnCommonError(pExitCode)) {
+        return;
+    }
+    const bool lSucceeded = pExitStatus == QProcess::NormalExit && pExitCode == 0;
+
+    switch (mMode) {
+    case Check:
+        finishCheck(pExitCode, pExitStatus);
+        return;
+    case Repair:
+        if (!lSucceeded) {
+            mLogStream << QStringLiteral(
+                "Repair failed. Your backups could still be "
+                "corrupted! See above for details.")
+                       << Qt::endl;
+            jobFinishedError(ErrorWithLog,
+                             xi18nc("@info notification",
+                                    "Backup repair failed. Your backups could still be corrupted! "
+                                    "See log file for more details."));
+            return;
+        }
+        emit description(this, i18n("Checking backup integrity"));
+        if (!startRestic(mCheckProcess, {QStringLiteral("--retry-lock"), QStringLiteral("1m"), QStringLiteral("check")})) {
+            jobFinishedError(ErrorWithLog, xi18nc("@info notification", "The restic program could not be started. See log file for more details."));
+        }
+        return;
+    case Prune:
+        if (!lSucceeded) {
+            mLogStream << QStringLiteral("Removing old backups failed. See above for details.") << Qt::endl;
+            jobFinishedError(ErrorWithLog, xi18nc("@info notification", "Old backups could not be removed. See log file for more details."));
+            return;
+        }
+        mLogStream << QStringLiteral("Kup successfully removed old backups at ") << QLocale().toString(QDateTime::currentDateTime()) << Qt::endl;
+        jobFinishedSuccess();
+        return;
+    }
+}
+
+void ResticMaintenanceJob::slotCheckAfterRepairDone(int pExitCode, QProcess::ExitStatus pExitStatus)
+{
+    collectOutput(mCheckProcess, pExitCode);
+    if (pExitStatus == QProcess::NormalExit && finishOnCommonError(pExitCode)) {
+        return;
+    }
+    if (pExitStatus == QProcess::NormalExit && pExitCode == 0) {
+        mLogStream << QStringLiteral("Repair succeeded. See above for details.") << Qt::endl;
+        jobFinishedError(ErrorWithLog, xi18nc("@info notification", "Success! Backup repair worked. See log file for more details."));
+    } else {
+        mLogStream << QStringLiteral(
+            "Repair failed. Your backups could still be "
+            "corrupted! See above for details.")
+                   << Qt::endl;
+        jobFinishedError(ErrorWithLog,
+                         xi18nc("@info notification",
+                                "Backup repair failed. Your backups could still be corrupted! "
+                                "See log file for more details."));
+    }
+}
+
+void ResticMaintenanceJob::finishCheck(int pExitCode, QProcess::ExitStatus pExitStatus)
+{
+    // As with bup, a finished check is reported through the error text, so
+    // that the notification carries the verdict and a link to the log.
+    if (pExitStatus == QProcess::NormalExit && pExitCode == 0) {
+        mLogStream << QStringLiteral(
+            "Backup integrity test was successful. "
+            "Your backups are fine. See above for details.")
+                   << Qt::endl;
+        jobFinishedError(ErrorWithLog,
+                         xi18nc("@info notification",
+                                "Backup integrity test was successful. "
+                                "Your backups are fine."));
+        return;
+    }
+    mLogStream << QStringLiteral(
+        "Integrity check failed. Your backups are "
+        "corrupted! See above for details.")
+               << Qt::endl;
+    jobFinishedError(ErrorSuggestRepair,
+                     xi18nc("@info notification",
+                            "Failed backup integrity check. Your backups are corrupted! "
+                            "See log file for more details. Do you want to try repairing the backup files?"));
+}
