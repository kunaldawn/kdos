+struct ResticNode {
+    QString mName;
+    mode_t mType = S_IFREG;
+    mode_t mPermissions = 0644;
+    qint64 mSize = 0;
+    qint64 mMtime = 0;
+    qint64 mAtime = 0;
+    QString mUser;
+    QString mGroup;
+    QString mLinkTarget;
+};
+
+struct ResticSnapshot {
+    QString mId;
+    QString mName;
+    QDateTime mTime;
+};
+
+// Go's os.FileMode keeps the special bits above the permission bits.
+const quint32 cGoModeSetuid = 1U << 23;
+const quint32 cGoModeSetgid = 1U << 22;
+const quint32 cGoModeSticky = 1U << 20;
+
+// How many directory listings one worker keeps; each costs one restic run to
+// refill, and a worker browses one repository at a time.
+const int cTreeCacheLimit = 512;
+
+// Symbolic links inside a snapshot are followed at most this deep.
+const int cMaxLinkDepth = 16;
+
+// "latest" is answered from the snapshot list only while it is this young; a
+// backup saved since then would otherwise stay hidden behind the older
+// snapshot for as long as the worker lives.
+const qint64 cLatestMaxAgeMs = 10000;
+
+QString latestName()
+{
+    return QStringLiteral("latest");
+}
+
+mode_t fileTypeOf(const QString &pType)
+{
+    if (pType == QStringLiteral("dir")) {
+        return S_IFDIR;
+    }
+    if (pType == QStringLiteral("symlink")) {
+        return S_IFLNK;
+    }
+    if (pType == QStringLiteral("dev")) {
+        return S_IFBLK;
+    }
+    if (pType == QStringLiteral("chardev")) {
+        return S_IFCHR;
+    }
+    if (pType == QStringLiteral("fifo")) {
+        return S_IFIFO;
+    }
+    if (pType == QStringLiteral("socket")) {
+        return S_IFSOCK;
+    }
+    return S_IFREG;
+}
+
+mode_t permissionsOf(quint32 pGoMode)
+{
+    mode_t lMode = pGoMode & 0777;
+    if (pGoMode & cGoModeSetuid) {
+        lMode |= S_ISUID;
+    }
+    if (pGoMode & cGoModeSetgid) {
+        lMode |= S_ISGID;
+    }
+    if (pGoMode & cGoModeSticky) {
+        lMode |= S_ISVTX;
+    }
+    return lMode;
+}
+
+QString joinPath(const QString &pDirectory, const QString &pName)
+{
+    if (pDirectory.endsWith(QLatin1Char('/'))) {
+        return pDirectory + pName;
+    }
+    return pDirectory + QLatin1Char('/') + pName;
+}
+
+QString parentPath(const QString &pPath)
+{
+    const qsizetype lSlash = pPath.lastIndexOf(QLatin1Char('/'));
+    return lSlash <= 0 ? QStringLiteral("/") : pPath.left(lSlash);
+}
+
+QString namePart(const QString &pPath)
+{
+    return pPath.mid(pPath.lastIndexOf(QLatin1Char('/')) + 1);
+}
+
+}
+
+// Browses a local restic repository: restic:///<repository>/ lists one folder
+// per snapshot, named by the local time it was taken, plus "latest", a link to
+// the newest; below a snapshot folder are the files as they were saved. It
+// reads through restic itself, so it needs restic and the repository's
+// password, and it never writes or locks the repository.
+class ResticWorker : public WorkerBase
+{
+public:
+    ResticWorker(const QByteArray &pPoolSocket, const QByteArray &pAppSocket);
+    KIO::WorkerResult get(const QUrl &pUrl) override;
+    KIO::WorkerResult listDir(const QUrl &pUrl) override;
+    KIO::WorkerResult stat(const QUrl &pUrl) override;
+    KIO::WorkerResult mimetype(const QUrl &pUrl) override;
+
+private:
+    struct Location {
+        QString mRepository;
+        QString mSnapshotName; // empty for the repository folder itself
+        QString mPath; // absolute path inside the snapshot
+    };
+
+    KIO::WorkerResult locate(const QUrl &pUrl, Location &pLocation);
+    KIO::WorkerResult openRepository(const QString &pRepository);
+    bool loadPlanCredentials(const QString &pRepository);
+    KIO::WorkerResult verifyPassword(const QString &pPassword, bool &pAccepted);
+    KIO::WorkerResult runRestic(const QStringList &pArguments, QByteArray &pOutput);
+    KIO::WorkerResult loadSnapshots();
+    KIO::WorkerResult findSnapshot(const QString &pName, ResticSnapshot &pSnapshot);
+    KIO::WorkerResult listTree(const ResticSnapshot &pSnapshot, const QString &pPath, QList<ResticNode> &pNodes);
+    KIO::WorkerResult findNode(const ResticSnapshot &pSnapshot, const QString &pPath, bool pFollowLinks, ResticNode &pNode, QString &pResolvedPath);
+    KIO::WorkerResult failFor(int pExitCode, const QByteArray &pErrors);
+    void fillEntry(const ResticNode &pNode, UDSEntry &pEntry, int pDetails);
+    void fillDirectoryEntry(const QString &pName, const QDateTime &pTime, UDSEntry &pEntry);
+    int details();
+
+    QString mRepository;
+    Restic::Credentials mCredentials;
+    QList<ResticSnapshot> mSnapshots;
+    QElapsedTimer mSnapshotsAge;
+    QHash<QString, QList<ResticNode>> mTrees;
+    QMimeDatabase mMimeDatabase;
+};
+
+ResticWorker::ResticWorker(const QByteArray &pPoolSocket, const QByteArray &pAppSocket)
+    : WorkerBase("restic", pPoolSocket, pAppSocket)
+{
+}
