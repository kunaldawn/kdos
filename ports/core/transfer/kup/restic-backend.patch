+KIO::WorkerResult ResticWorker::loadSnapshots()
+{
+    QByteArray lOutput;
+    const KIO::WorkerResult lResult = runRestic({QStringLiteral("snapshots"), QStringLiteral("--json")}, lOutput);
+    if (!lResult.success()) {
+        return lResult;
+    }
+    const QJsonArray lArray = QJsonDocument::fromJson(lOutput).array();
+    QList<ResticSnapshot> lSnapshots;
+    for (const QJsonValue &lValue : lArray) {
+        const QJsonObject lObject = lValue.toObject();
+        ResticSnapshot lSnapshot;
+        lSnapshot.mId = lObject.value(QStringLiteral("id")).toString();
+        lSnapshot.mTime = Restic::parseTime(lObject.value(QStringLiteral("time")).toString());
+        if (!lSnapshot.mId.isEmpty() && lSnapshot.mTime.isValid()) {
+            lSnapshots.append(lSnapshot);
+        }
+    }
+    std::sort(lSnapshots.begin(), lSnapshots.end(), [](const ResticSnapshot &a, const ResticSnapshot &b) {
+        return a.mTime < b.mTime;
+    });
+
+    // Names are the minute a snapshot was taken, as the bup worker names its
+    // saves; two in the same minute get seconds, and two in the same second
+    // the start of their ID, so every name is unique and stable.
+    QHash<QString, int> lCount;
+    for (ResticSnapshot &lSnapshot : lSnapshots) {
+        lSnapshot.mName = lSnapshot.mTime.toLocalTime().toString(QStringLiteral("yyyy-MM-dd hh:mm"));
+        ++lCount[lSnapshot.mName];
+    }
+    for (ResticSnapshot &lSnapshot : lSnapshots) {
+        if (lCount.value(lSnapshot.mName) > 1) {
+            lSnapshot.mName = lSnapshot.mTime.toLocalTime().toString(QStringLiteral("yyyy-MM-dd hh:mm:ss"));
+        }
+    }
+    lCount.clear();
+    for (const ResticSnapshot &lSnapshot : std::as_const(lSnapshots)) {
+        ++lCount[lSnapshot.mName];
+    }
+    for (ResticSnapshot &lSnapshot : lSnapshots) {
+        if (lCount.value(lSnapshot.mName) > 1) {
+            lSnapshot.mName += QLatin1Char(' ') + lSnapshot.mId.left(8);
+        }
+    }
+    mSnapshots = lSnapshots;
+    mSnapshotsAge.start();
+    return KIO::WorkerResult::pass();
+}
+
+KIO::WorkerResult ResticWorker::findSnapshot(const QString &pName, ResticSnapshot &pSnapshot)
+{
+    for (int lAttempt = 0; lAttempt < 2; ++lAttempt) {
+        const bool lLatestIsStale = pName == latestName() && (!mSnapshotsAge.isValid() || mSnapshotsAge.hasExpired(cLatestMaxAgeMs));
+        if (lAttempt == 1 || mSnapshots.isEmpty() || lLatestIsStale) {
+            const KIO::WorkerResult lResult = loadSnapshots();
+            if (!lResult.success()) {
+                return lResult;
+            }
+        }
+        if (pName == latestName() && !mSnapshots.isEmpty()) {
+            pSnapshot = mSnapshots.last();
+            return KIO::WorkerResult::pass();
+        }
+        for (const ResticSnapshot &lSnapshot : std::as_const(mSnapshots)) {
+            if (lSnapshot.mName == pName) {
+                pSnapshot = lSnapshot;
+                return KIO::WorkerResult::pass();
+            }
+        }
+    }
+    return KIO::WorkerResult::fail(KIO::ERR_DOES_NOT_EXIST, pName);
+}
+
+KIO::WorkerResult ResticWorker::listTree(const ResticSnapshot &pSnapshot, const QString &pPath, QList<ResticNode> &pNodes)
+{
+    const QString lKey = pSnapshot.mId + QLatin1Char(':') + pPath;
+    const auto lCached = mTrees.constFind(lKey);
+    if (lCached != mTrees.constEnd()) {
+        pNodes = *lCached;
+        return KIO::WorkerResult::pass();
+    }
+
+    QByteArray lOutput;
+    const KIO::WorkerResult lResult = runRestic({QStringLiteral("cat"), QStringLiteral("tree"), lKey}, lOutput);
+    if (!lResult.success()) {
+        return lResult;
+    }
+    pNodes.clear();
+    const QJsonArray lArray = QJsonDocument::fromJson(lOutput).object().value(QStringLiteral("nodes")).toArray();
+    for (const QJsonValue &lValue : lArray) {
+        const QJsonObject lObject = lValue.toObject();
+        ResticNode lNode;
+        lNode.mName = lObject.value(QStringLiteral("name")).toString();
+        if (lNode.mName.isEmpty()) {
+            continue;
+        }
+        lNode.mType = fileTypeOf(lObject.value(QStringLiteral("type")).toString());
+        lNode.mPermissions = permissionsOf(static_cast<quint32>(lObject.value(QStringLiteral("mode")).toDouble()));
+        lNode.mSize = static_cast<qint64>(lObject.value(QStringLiteral("size")).toDouble());
+        lNode.mMtime = Restic::parseTime(lObject.value(QStringLiteral("mtime")).toString()).toSecsSinceEpoch();
+        lNode.mAtime = Restic::parseTime(lObject.value(QStringLiteral("atime")).toString()).toSecsSinceEpoch();
+        lNode.mUser = lObject.value(QStringLiteral("user")).toString();
+        if (lNode.mUser.isEmpty()) {
+            lNode.mUser = QString::number(lObject.value(QStringLiteral("uid")).toInt());
+        }
+        lNode.mGroup = lObject.value(QStringLiteral("group")).toString();
+        if (lNode.mGroup.isEmpty()) {
+            lNode.mGroup = QString::number(lObject.value(QStringLiteral("gid")).toInt());
+        }
+        lNode.mLinkTarget = lObject.value(QStringLiteral("linktarget")).toString();
+        pNodes.append(lNode);
+    }
+    if (mTrees.size() >= cTreeCacheLimit) {
+        mTrees.clear();
+    }
+    mTrees.insert(lKey, pNodes);
+    return KIO::WorkerResult::pass();
+}
+
+KIO::WorkerResult ResticWorker::findNode(const ResticSnapshot &pSnapshot, const QString &pPath, bool pFollowLinks, ResticNode &pNode, QString &pResolvedPath)
+{
+    QString lPath = pPath;
+    for (int lDepth = 0; lDepth <= cMaxLinkDepth; ++lDepth) {
+        if (lPath == QStringLiteral("/")) {
+            pNode = ResticNode();
+            pNode.mName = QStringLiteral("/");
+            pNode.mType = S_IFDIR;
+            pNode.mPermissions = 0755;
+            pNode.mMtime = pSnapshot.mTime.toSecsSinceEpoch();
+            pNode.mAtime = pNode.mMtime;
+            pResolvedPath = lPath;
+            return KIO::WorkerResult::pass();
+        }
+        QList<ResticNode> lNodes;
+        const KIO::WorkerResult lResult = listTree(pSnapshot, parentPath(lPath), lNodes);
+        if (!lResult.success()) {
+            return lResult;
+        }
+        const QString lName = namePart(lPath);
+        auto lNode = std::find_if(lNodes.cbegin(), lNodes.cend(), [&lName](const ResticNode &pCandidate) {
+            return pCandidate.mName == lName;
+        });
+        if (lNode == lNodes.cend()) {
+            return KIO::WorkerResult::fail(KIO::ERR_DOES_NOT_EXIST, lPath);
+        }
+        if (!pFollowLinks || lNode->mType != S_IFLNK) {
+            pNode = *lNode;
+            pResolvedPath = lPath;
+            return KIO::WorkerResult::pass();
+        }
+        const QString lTarget = lNode->mLinkTarget;
+        lPath = QDir::cleanPath(lTarget.startsWith(QLatin1Char('/')) ? lTarget : joinPath(parentPath(lPath), lTarget));
+    }
+    return KIO::WorkerResult::fail(KIO::ERR_CYCLIC_LINK, pPath);
+}
+
+void ResticWorker::fillDirectoryEntry(const QString &pName, const QDateTime &pTime, UDSEntry &pEntry)
+{
+    pEntry.clear();
+    pEntry.fastInsert(KIO::UDSEntry::UDS_NAME, pName);
+    pEntry.fastInsert(KIO::UDSEntry::UDS_FILE_TYPE, S_IFDIR);
+    pEntry.fastInsert(KIO::UDSEntry::UDS_ACCESS, 0555);
+    pEntry.fastInsert(KIO::UDSEntry::UDS_MIME_TYPE, QStringLiteral("inode/directory"));
+    if (pTime.isValid()) {
+        pEntry.fastInsert(KIO::UDSEntry::UDS_MODIFICATION_TIME, pTime.toSecsSinceEpoch());
+    }
+}
+
+void ResticWorker::fillEntry(const ResticNode &pNode, UDSEntry &pEntry, int pDetails)
+{
+    pEntry.clear();
+    pEntry.fastInsert(KIO::UDSEntry::UDS_NAME, pNode.mName);
+    pEntry.fastInsert(KIO::UDSEntry::UDS_FILE_TYPE, pNode.mType);
+    pEntry.fastInsert(KIO::UDSEntry::UDS_ACCESS, pNode.mPermissions);
+    if (!pNode.mLinkTarget.isEmpty()) {
+        pEntry.fastInsert(KIO::UDSEntry::UDS_LINK_DEST, pNode.mLinkTarget);
+    }
+    if (pDetails > 0) {
+        pEntry.fastInsert(KIO::UDSEntry::UDS_SIZE, pNode.mType == S_IFREG ? pNode.mSize : 0);
+        if (pNode.mType == S_IFDIR) {
+            pEntry.fastInsert(KIO::UDSEntry::UDS_MIME_TYPE, QStringLiteral("inode/directory"));
+        } else if (pNode.mType == S_IFREG) {
+            pEntry.fastInsert(KIO::UDSEntry::UDS_MIME_TYPE, mMimeDatabase.mimeTypeForFile(pNode.mName, QMimeDatabase::MatchExtension).name());
+        }
+        pEntry.fastInsert(KIO::UDSEntry::UDS_MODIFICATION_TIME, pNode.mMtime);
+        pEntry.fastInsert(KIO::UDSEntry::UDS_ACCESS_TIME, pNode.mAtime);
+        pEntry.fastInsert(KIO::UDSEntry::UDS_USER, pNode.mUser);
+        pEntry.fastInsert(KIO::UDSEntry::UDS_GROUP, pNode.mGroup);
+    }
+}
+
+KIO::WorkerResult ResticWorker::listDir(const QUrl &pUrl)
+{
+    Location lLocation;
+    KIO::WorkerResult lResult = locate(pUrl, lLocation);
+    if (!lResult.success()) {
+        return lResult;
+    }
+
+    UDSEntry lEntry;
+    if (lLocation.mSnapshotName.isEmpty()) {
+        // The repository folder is listed fresh every time, so a backup
+        // saved while it is open shows up on reload.
+        lResult = loadSnapshots();
+        if (!lResult.success()) {
+            return lResult;
+        }
+        fillDirectoryEntry(QStringLiteral("."), QDateTime(), lEntry);
+        listEntry(lEntry);
+        for (const ResticSnapshot &lSnapshot : std::as_const(mSnapshots)) {
+            fillDirectoryEntry(lSnapshot.mName, lSnapshot.mTime, lEntry);
+            listEntry(lEntry);
+        }
+        if (!mSnapshots.isEmpty()) {
+            fillDirectoryEntry(latestName(), mSnapshots.last().mTime, lEntry);
+            lEntry.fastInsert(KIO::UDSEntry::UDS_LINK_DEST, mSnapshots.last().mName);
+            listEntry(lEntry);
+        }
+        return KIO::WorkerResult::pass();
+    }
+
+    ResticSnapshot lSnapshot;
+    lResult = findSnapshot(lLocation.mSnapshotName, lSnapshot);
+    if (!lResult.success()) {
+        return lResult;
+    }
+    ResticNode lNode;
+    QString lResolved;
+    lResult = findNode(lSnapshot, lLocation.mPath, true, lNode, lResolved);
+    if (!lResult.success()) {
+        return lResult;
+    }
+    if (lNode.mType != S_IFDIR) {
+        return KIO::WorkerResult::fail(KIO::ERR_IS_FILE, pUrl.toDisplayString());
+    }
+    QList<ResticNode> lNodes;
+    lResult = listTree(lSnapshot, lResolved, lNodes);
+    if (!lResult.success()) {
+        return lResult;
+    }
+    const int lDetails = details();
+    lNode.mName = QStringLiteral(".");
+    lNode.mLinkTarget.clear();
+    fillEntry(lNode, lEntry, lDetails);
+    listEntry(lEntry);
+    for (const ResticNode &lChild : std::as_const(lNodes)) {
+        ResticNode lShown = lChild;
+        if (lChild.mType == S_IFLNK && lDetails > 1) {
+            // Show a link with the type of what it points to, as the bup
+            // worker does, so a link to a folder opens as a folder.
+            ResticNode lTarget;
+            QString lTargetPath;
+            if (findNode(lSnapshot, joinPath(lResolved, lChild.mName), true, lTarget, lTargetPath).success()) {
+                lShown = lTarget;
+                lShown.mName = lChild.mName;
+                lShown.mLinkTarget = lChild.mLinkTarget;
+            }
+        }
+        fillEntry(lShown, lEntry, lDetails);
+        listEntry(lEntry);
+    }
+    return KIO::WorkerResult::pass();
+}
+
+KIO::WorkerResult ResticWorker::stat(const QUrl &pUrl)
+{
+    Location lLocation;
+    KIO::WorkerResult lResult = locate(pUrl, lLocation);
+    if (!lResult.success()) {
+        return lResult;
+    }
+
+    UDSEntry lEntry;
+    if (lLocation.mSnapshotName.isEmpty()) {
+        fillDirectoryEntry(namePart(lLocation.mRepository), QDateTime(), lEntry);
+        statEntry(lEntry);
+        return KIO::WorkerResult::pass();
+    }
+    ResticSnapshot lSnapshot;
+    lResult = findSnapshot(lLocation.mSnapshotName, lSnapshot);
+    if (!lResult.success()) {
+        return lResult;
+    }
+    if (lLocation.mPath == QStringLiteral("/")) {
+        fillDirectoryEntry(lLocation.mSnapshotName, lSnapshot.mTime, lEntry);
+        if (lLocation.mSnapshotName == latestName()) {
+            lEntry.fastInsert(KIO::UDSEntry::UDS_LINK_DEST, lSnapshot.mName);
+        }
+        statEntry(lEntry);
+        return KIO::WorkerResult::pass();
+    }
+
+    ResticNode lNode;
+    QString lResolved;
+    lResult = findNode(lSnapshot, lLocation.mPath, false, lNode, lResolved);
+    if (!lResult.success()) {
+        return lResult;
+    }
+    if (lNode.mType == S_IFLNK && details() > 1) {
+        ResticNode lTarget;
+        QString lTargetPath;
+        if (findNode(lSnapshot, lLocation.mPath, true, lTarget, lTargetPath).success()) {
+            const QString lLinkTarget = lNode.mLinkTarget;
+            const QString lName = lNode.mName;
+            lNode = lTarget;
+            lNode.mName = lName;
+            lNode.mLinkTarget = lLinkTarget;
+        }
+    }
+    fillEntry(lNode, lEntry, details());
+    statEntry(lEntry);
+    return KIO::WorkerResult::pass();
+}
+
+KIO::WorkerResult ResticWorker::mimetype(const QUrl &pUrl)
+{
+    Location lLocation;
+    KIO::WorkerResult lResult = locate(pUrl, lLocation);
+    if (!lResult.success()) {
+        return lResult;
+    }
+    if (lLocation.mSnapshotName.isEmpty() || lLocation.mPath == QStringLiteral("/")) {
+        mimeType(QStringLiteral("inode/directory"));
+        return KIO::WorkerResult::pass();
+    }
+    ResticSnapshot lSnapshot;
+    lResult = findSnapshot(lLocation.mSnapshotName, lSnapshot);
+    if (!lResult.success()) {
+        return lResult;
+    }
+    ResticNode lNode;
+    QString lResolved;
+    lResult = findNode(lSnapshot, lLocation.mPath, true, lNode, lResolved);
+    if (!lResult.success()) {
+        return lResult;
+    }
+    mimeType(lNode.mType == S_IFDIR ? QStringLiteral("inode/directory") : mMimeDatabase.mimeTypeForFile(lNode.mName, QMimeDatabase::MatchExtension).name());
+    return KIO::WorkerResult::pass();
+}
+
+KIO::WorkerResult ResticWorker::get(const QUrl &pUrl)
+{
+    Location lLocation;
+    KIO::WorkerResult lResult = locate(pUrl, lLocation);
+    if (!lResult.success()) {
+        return lResult;
+    }
+    if (lLocation.mSnapshotName.isEmpty() || lLocation.mPath == QStringLiteral("/")) {
+        return KIO::WorkerResult::fail(KIO::ERR_IS_DIRECTORY, pUrl.toDisplayString());
+    }
+    ResticSnapshot lSnapshot;
+    lResult = findSnapshot(lLocation.mSnapshotName, lSnapshot);
+    if (!lResult.success()) {
+        return lResult;
+    }
+
+    // Kio never calls get() on a link it means to copy as a link, so the
+    // link is followed, as in the bup worker.
+    ResticNode lNode;
+    QString lResolved;
+    lResult = findNode(lSnapshot, lLocation.mPath, true, lNode, lResolved);
+    if (!lResult.success()) {
+        return lResult;
+    }
+    if (lNode.mType == S_IFDIR) {
+        return KIO::WorkerResult::fail(KIO::ERR_IS_DIRECTORY, pUrl.toDisplayString());
+    }
+    if (lNode.mType != S_IFREG) {
+        return KIO::WorkerResult::fail(KIO::ERR_CANNOT_READ, pUrl.toDisplayString());
+    }
+
+    mimeType(mMimeDatabase.mimeTypeForFile(lNode.mName, QMimeDatabase::MatchExtension).name());
+    totalSize(static_cast<KIO::filesize_t>(lNode.mSize));
+
+    // restic dump streams from the start of the file; a resumed copy skips
+    // what the other side already has.
+    KIO::filesize_t lSkip = 0;
+    const QString lResumeOffset = metaData(QStringLiteral("resume"));
+    if (!lResumeOffset.isEmpty()) {
+        bool lOk = false;
+        const quint64 lOffset = lResumeOffset.toULongLong(&lOk);
+        if (lOk && lOffset > 0 && lOffset < static_cast<quint64>(lNode.mSize)) {
+            canResume();
+            lSkip = lOffset;
+        }
+    }
+
+    QProcess lProcess;
+    if (!mCredentials.prepare(lProcess, mRepository, {QStringLiteral("--no-lock"), QStringLiteral("dump"), lSnapshot.mId, lResolved})) {
+        return KIO::WorkerResult::fail(KIO::ERR_CANNOT_AUTHENTICATE, mRepository);
+    }
+    lProcess.start();
+    mCredentials.release();
+    if (!lProcess.waitForStarted(-1)) {
+        return KIO::WorkerResult::fail(KIO::ERR_CANNOT_LAUNCH_PROCESS, QStringLiteral("restic"));
+    }
+
+    KIO::filesize_t lProcessed = lSkip;
+    KIO::filesize_t lToSkip = lSkip;
+    auto lDeliver = [&](QByteArray pChunk) {
+        if (lToSkip > 0 && !pChunk.isEmpty()) {
+            const auto lDrop = static_cast<qsizetype>(qMin<KIO::filesize_t>(lToSkip, static_cast<KIO::filesize_t>(pChunk.size())));
+            pChunk.remove(0, lDrop);
+            lToSkip -= static_cast<KIO::filesize_t>(lDrop);
+        }
+        if (!pChunk.isEmpty()) {
+            data(pChunk);
+            lProcessed += static_cast<KIO::filesize_t>(pChunk.size());
+            processedSize(lProcessed);
+        }
+    };
+    while (lProcess.state() != QProcess::NotRunning) {
+        if (wasKilled()) {
+            lProcess.terminate();
+            lProcess.waitForFinished();
+            return KIO::WorkerResult::pass();
+        }
+        lProcess.waitForReadyRead(1000);
+        lDeliver(lProcess.readAllStandardOutput());
+    }
+    lDeliver(lProcess.readAllStandardOutput());
+    if (lProcess.exitStatus() != QProcess::NormalExit) {
+        return KIO::WorkerResult::fail(KIO::ERR_WORKER_DIED, QStringLiteral("restic"));
+    }
+    if (lProcess.exitCode() != 0) {
+        return failFor(lProcess.exitCode(), lProcess.readAllStandardError());
+    }
+    data(QByteArray());
+    return KIO::WorkerResult::pass();
+}
+
+extern "C" int Q_DECL_EXPORT kdemain(int pArgc, char **pArgv)
+{
+    QCoreApplication lApp(pArgc, pArgv);
+    QCoreApplication::setApplicationName(QStringLiteral("kio_restic"));
+    KLocalizedString::setApplicationDomain("kup");
+
+    if (pArgc != 4) {
+        fprintf(stderr, "Usage: kio_restic protocol domain-socket1 domain-socket2\n");
+        exit(-1);
+    }
+
+    ResticWorker lWorker(pArgv[2], pArgv[3]);
+    lWorker.dispatchLoop();
+
+    return 0;
+}
