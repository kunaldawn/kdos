+// restic reads its password file once, at start, from the descriptor the
+// child inherits here. A descriptor number restic or the Go runtime opens
+// itself is always above the inherited ones, so 3 cannot be taken.
+static const int cPasswordFd = 3;
+
+QString snapshotTag()
+{
+    return QStringLiteral("kup");
+}
+
+bool isRepository(const QString &pPath)
+{
+    const QDir lDir(pPath);
+    return QFileInfo(lDir.filePath(QStringLiteral("config"))).isFile() && QFileInfo(lDir.filePath(QStringLiteral("keys"))).isDir()
+        && QFileInfo(lDir.filePath(QStringLiteral("data"))).isDir() && QFileInfo(lDir.filePath(QStringLiteral("snapshots"))).isDir();
+}
+
+QString volumeIdentity(const Solid::Device &pVolumeDevice)
+{
+    const auto *lVolume = pVolumeDevice.as<Solid::StorageVolume>();
+    if (lVolume == nullptr) {
+        return QString();
+    }
+    QString lIdentity = lVolume->uuid();
+    if (lIdentity.isEmpty()) {
+        const Solid::Device lDriveDevice = pVolumeDevice.is<Solid::StorageDrive>() ? pVolumeDevice : pVolumeDevice.parent();
+        lIdentity += lDriveDevice.description();
+        lIdentity += QStringLiteral("|");
+        lIdentity += lVolume->label();
+    }
+    return lIdentity;
+}
+
+QString escapePattern(const QString &pPath)
+{
+    QString lEscaped;
+    lEscaped.reserve(pPath.size() + 8);
+    for (const QChar lChar : pPath) {
+        if (lChar == QLatin1Char('*') || lChar == QLatin1Char('?') || lChar == QLatin1Char('[') || lChar == QLatin1Char('\\')) {
+            lEscaped += QLatin1Char('\\');
+        }
+        lEscaped += lChar;
+    }
+    return lEscaped;
+}
+
+QStringList forgetArguments()
+{
+    // Durations count back from the newest snapshot of each group, not from
+    // now, so a drive left in a drawer for a year keeps its history until new
+    // backups replace it.
+    return {QStringLiteral("forget"),
+            QStringLiteral("--prune"),
+            QStringLiteral("--tag"),
+            snapshotTag(),
+            QStringLiteral("--keep-within"),
+            QStringLiteral("2d"),
+            QStringLiteral("--keep-within-daily"),
+            QStringLiteral("1m"),
+            QStringLiteral("--keep-within-weekly"),
+            QStringLiteral("6m"),
+            QStringLiteral("--keep-within-monthly"),
+            QStringLiteral("2y"),
+            QStringLiteral("--keep-yearly"),
+            QStringLiteral("unlimited")};
+}
+
+QDateTime parseTime(const QString &pTime)
+{
+    // restic writes nanoseconds; Qt reads at most milliseconds, so the
+    // fraction is cut to three digits before parsing.
+    static const QRegularExpression lFraction(QStringLiteral("\\.(\\d{1,3})\\d*"));
+    QString lTime = pTime;
+    lTime.replace(lFraction, QStringLiteral(".\\1"));
+    QDateTime lResult = QDateTime::fromString(lTime, Qt::ISODateWithMs);
+    if (!lResult.isValid()) {
+        lResult = QDateTime::fromString(lTime, Qt::ISODate);
+    }
+    return lResult;
+}
+
+QProcessEnvironment environment()
+{
+    QProcessEnvironment lEnv = QProcessEnvironment::systemEnvironment();
+    static const char *const cDropped[] = {
+        "RESTIC_REPOSITORY",
+        "RESTIC_REPOSITORY_FILE",
+        "RESTIC_PASSWORD",
+        "RESTIC_PASSWORD_FILE",
+        "RESTIC_PASSWORD_COMMAND",
+        "RESTIC_KEY_HINT",
+        "RESTIC_HOST",
+    };
+    for (const char *lName : cDropped) {
+        lEnv.remove(QString::fromLatin1(lName));
+    }
+    // JSON status lines arrive ten times a second by default; the job shows
+    // them at most five times a second.
+    lEnv.insert(QStringLiteral("RESTIC_PROGRESS_FPS"), QStringLiteral("4"));
+    return lEnv;
+}
+
+QString programVersion()
+{
+    QProcess lProcess;
+    lProcess.setProcessEnvironment(environment());
+    lProcess.start(QStringLiteral("restic"), {QStringLiteral("version")});
+    if (!lProcess.waitForStarted() || !lProcess.waitForFinished(10000) || lProcess.exitStatus() != QProcess::NormalExit || lProcess.exitCode() != 0) {
+        return QString();
+    }
+    return QString::fromUtf8(lProcess.readAllStandardOutput()).section(QLatin1Char('\n'), 0, 0).trimmed();
+}
+
+QString walletFolder()
+{
+    return QStringLiteral("Kup");
+}
+
+bool walletHasPassword(const QString &pKey)
+{
+    // keyDoesNotExist() answers false for a disabled wallet, which would
+    // claim a password is stored where none can be.
+    return KWallet::Wallet::isEnabled() && !KWallet::Wallet::keyDoesNotExist(KWallet::Wallet::NetworkWallet(), walletFolder(), pKey);
+}
+
+static KWallet::Wallet *openWallet(WId pWindow, QString &pError)
+{
+    if (!KWallet::Wallet::isEnabled()) {
+        pError = xi18nc("@info notification",
+                        "The KDE Wallet is turned off, so the password of the restic repository cannot be stored or read. "
+                        "Turn the wallet on, or set a password file in the backup plan's settings.");
+        return nullptr;
+    }
+    KWallet::Wallet *lWallet = KWallet::Wallet::openWallet(KWallet::Wallet::NetworkWallet(), pWindow, KWallet::Wallet::Synchronous);
+    if (lWallet == nullptr) {
+        pError = xi18nc("@info notification", "The KDE Wallet could not be opened, so the password of the restic repository is not available.");
+    }
+    return lWallet;
+}
+
+bool readWalletPassword(const QString &pKey, QString &pPassword, WId pWindow, QString &pError)
+{
+    // A disabled wallet takes openWallet()'s error: the "enter it in the
+    // plan's settings" advice below names a field that cannot store a
+    // password while the wallet is off.
+    if (!KWallet::Wallet::isEnabled()) {
+        openWallet(pWindow, pError);
+        return false;
+    }
+    if (!walletHasPassword(pKey)) {
+        pError = xi18nc("@info notification",
+                        "No password is stored for this restic repository. "
+                        "Enter it in the backup plan's settings.");
+        return false;
+    }
+    KWallet::Wallet *lWallet = openWallet(pWindow, pError);
+    if (lWallet == nullptr) {
+        return false;
+    }
+    bool lOk = lWallet->setFolder(walletFolder()) && lWallet->readPassword(pKey, pPassword) == 0 && !pPassword.isEmpty();
+    delete lWallet;
+    if (!lOk) {
+        pError = xi18nc("@info notification", "The password of the restic repository could not be read from the KDE Wallet.");
+    }
+    return lOk;
+}
+
+bool writeWalletPassword(const QString &pKey, const QString &pPassword, WId pWindow, QString &pError)
+{
+    KWallet::Wallet *lWallet = openWallet(pWindow, pError);
+    if (lWallet == nullptr) {
+        return false;
+    }
+    if (!lWallet->hasFolder(walletFolder())) {
+        lWallet->createFolder(walletFolder());
+    }
+    bool lOk = lWallet->setFolder(walletFolder()) && lWallet->writePassword(pKey, pPassword) == 0;
+    delete lWallet;
+    if (!lOk) {
+        pError = xi18nc("@info", "The password of the restic repository could not be stored in the KDE Wallet.");
+    }
+    return lOk;
+}
+
+Credentials::~Credentials()
+{
+    release();
+}
+
+void Credentials::setPassword(const QString &pPassword)
+{
+    mPasswordFile.clear();
+    mPassword = pPassword.toUtf8();
+}
+
+void Credentials::setPasswordFile(const QString &pPath)
+{
+    mPassword.clear();
+    mPasswordFile = pPath;
+}
+
+bool Credentials::isSet() const
+{
+    return !mPasswordFile.isEmpty() || !mPassword.isEmpty();
+}
+
+bool Credentials::loadForPlan(const BackupPlan &pPlan, WId pWindow, QString &pError)
+{
+    if (pPlan.mResticUsePasswordFile) {
+        const QString lPath = pPlan.absoluteResticPasswordFilePath();
+        const QFileInfo lInfo(lPath);
+        if (pPlan.mResticPasswordFile.isEmpty() || !lInfo.isFile() || !lInfo.isReadable()) {
+            pError = xi18nc("@info notification", "The password file <filename>%1</filename> of the restic repository cannot be read.", lPath);
+            return false;
+        }
+        // A password file others can read discloses every backup in the
+        // repository; refusing before the backup runs is the only moment the
+        // refusal still protects anything.
+        const auto lOpen = QFileDevice::ReadGroup | QFileDevice::WriteGroup | QFileDevice::ReadOther | QFileDevice::WriteOther;
+        if (lInfo.permissions() & lOpen) {
+            pError = xi18nc("@info notification",
+                            "The password file <filename>%1</filename> can be read by other users. "
+                            "Make it readable by you alone (mode 0600).",
+                            lPath);
+            return false;
+        }
+        setPasswordFile(lPath);
+        return true;
+    }
+    QString lPassword;
+    if (!readWalletPassword(pPlan.resticWalletKey(), lPassword, pWindow, pError)) {
+        return false;
+    }
+    setPassword(lPassword);
+    return true;
+}
+
+bool Credentials::prepare(QProcess &pProcess, const QString &pRepository, const QStringList &pArguments)
+{
+    release();
+    QStringList lArguments{QStringLiteral("-r"), pRepository};
+    if (!mPasswordFile.isEmpty()) {
+        lArguments << QStringLiteral("--password-file") << mPasswordFile;
+        pProcess.setChildProcessModifier({});
+    } else {
+        // The whole password goes into the pipe before the child exists, so
+        // nothing has to feed it later. A write of at most PIPE_BUF bytes to
+        // an empty pipe never blocks.
+        if (mPassword.isEmpty() || mPassword.size() > PIPE_BUF) {
+            return false;
+        }
+        int lFds[2];
+        if (::pipe2(lFds, O_CLOEXEC) != 0) {
+            return false;
+        }
+        const ssize_t lWritten = ::write(lFds[1], mPassword.constData(), static_cast<size_t>(mPassword.size()));
+        ::close(lFds[1]);
+        if (lWritten != mPassword.size()) {
+            ::close(lFds[0]);
+            return false;
+        }
+        mPipeRead = lFds[0];
+        lArguments << QStringLiteral("--password-file") << QStringLiteral("/proc/self/fd/%1").arg(cPasswordFd);
+        const int lReadFd = mPipeRead;
+        QProcess *lProcess = &pProcess;
+        pProcess.setChildProcessModifier([lReadFd, lProcess]() {
+            // dup2 onto the same number leaves close-on-exec set, so the flag
+            // is cleared by hand in that case.
+            if (lReadFd == cPasswordFd) {
+                const int lFlags = ::fcntl(cPasswordFd, F_GETFD);
+                if (lFlags == -1 || ::fcntl(cPasswordFd, F_SETFD, lFlags & ~FD_CLOEXEC) == -1) {
+                    lProcess->failChildProcessModifier("restic password pipe", errno);
+                }
+            } else if (::dup2(lReadFd, cPasswordFd) == -1) {
+                lProcess->failChildProcessModifier("restic password pipe", errno);
+            }
+        });
+    }
+    lArguments << pArguments;
+    pProcess.setProgram(QStringLiteral("restic"));
+    pProcess.setArguments(lArguments);
+    pProcess.setProcessEnvironment(environment());
+    return true;
+}
+
+void Credentials::release()
+{
+    if (mPipeRead >= 0) {
+        ::close(mPipeRead);
+        mPipeRead = -1;
+    }
+}
+
+}
