 //________________________________________________________________
+void Decoration::paintSandboxGlyph(QPainter *painter, const QRectF &rect) const
+{
+    // A box seen from above a corner: the top face and the two sides that
+    // face the viewer, in the caption's own colour. A sandbox whose engine
+    // says only part of its boundary held (`+tagged`) is drawn dashed, one
+    // that says none did (`+unconfined`) as a warning triangle.
+    const QString engine = window()->sandboxEngine();
+    painter->save();
+    painter->setRenderHint(QPainter::Antialiasing);
+    QPen pen(fontColor(), std::max<qreal>(1.0, rect.width() / 10.0));
+    pen.setJoinStyle(Qt::RoundJoin);
+    pen.setCapStyle(Qt::RoundCap);
+    painter->setBrush(Qt::NoBrush);
+
+    if (engine.endsWith(QLatin1String("+unconfined"))) {
+        painter->setPen(pen);
+        QPainterPath triangle;
+        triangle.moveTo(rect.center().x(), rect.top());
+        triangle.lineTo(rect.right(), rect.bottom());
+        triangle.lineTo(rect.left(), rect.bottom());
+        triangle.closeSubpath();
+        painter->drawPath(triangle);
+        painter->drawLine(QPointF(rect.center().x(), rect.top() + rect.height() * 0.35), QPointF(rect.center().x(), rect.top() + rect.height() * 0.65));
+        painter->drawPoint(QPointF(rect.center().x(), rect.top() + rect.height() * 0.82));
+        painter->restore();
+        return;
+    }
+    if (engine.endsWith(QLatin1String("+tagged"))) {
+        pen.setStyle(Qt::DashLine);
+        pen.setDashPattern({1.5, 1.5});
+    }
+    painter->setPen(pen);
+
+    const QRectF r = rect.adjusted(pen.widthF() / 2, pen.widthF() / 2, -pen.widthF() / 2, -pen.widthF() / 2);
+    const qreal cx = r.center().x();
+    const qreal top = r.top();
+    const qreal upper = r.top() + r.height() * 0.25;
+    const qreal mid = r.top() + r.height() * 0.5;
+    const qreal lower = r.top() + r.height() * 0.75;
+    const qreal bottom = r.bottom();
+    QPainterPath box;
+    box.moveTo(cx, top);
+    box.lineTo(r.right(), upper);
+    box.lineTo(r.right(), lower);
+    box.lineTo(cx, bottom);
+    box.lineTo(r.left(), lower);
+    box.lineTo(r.left(), upper);
+    box.closeSubpath();
+    box.moveTo(r.left(), upper);
+    box.lineTo(cx, mid);
+    box.lineTo(r.right(), upper);
+    box.moveTo(cx, mid);
+    box.lineTo(cx, bottom);
+    painter->drawPath(box);
+    painter->restore();
+}
