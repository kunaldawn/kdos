Subject: Lead a sandboxed window's caption with a box glyph

A window whose client is sandboxed (KDecoration3's isSandboxed(), the
sandbox engine of its security context) has a small box drawn before its
caption, in the caption's own colour, so a confined window is told from a
host one at a glance. An engine whose state says only part of the boundary
held (`+tagged`) is drawn dashed, one that says none did (`+unconfined`) as
a warning triangle. The glyph's width comes out of the caption's, so the two
never overlap, whatever the title alignment.

diff -ruN a/kdecoration/breezedecoration.cpp b/kdecoration/breezedecoration.cpp
--- a/kdecoration/breezedecoration.cpp	2026-10-27 16:54:14.000000000 +0530
+++ b/kdecoration/breezedecoration.cpp	2026-10-29 03:44:04.256166942 +0530
@@ -692,8 +692,33 @@
     // draw caption
     painter->setFont(settings()->font());
     painter->setPen(fontColor());
-    const auto [captionRectangle, alignment] = captionRect();
-    const QString caption = painter->fontMetrics().elidedText(window()->caption(), Qt::ElideMiddle, captionRectangle.width());
+    auto [captionRectangle, alignment] = captionRect();
+
+    // a sandboxed window's caption is led by a box glyph, which takes its
+    // room out of the caption's so the two never overlap
+    const bool sandboxed = window()->isSandboxed();
+    const qreal glyphSize = sandboxed ? std::round(painter->fontMetrics().height() * 0.75) : 0;
+    const qreal glyphGap = sandboxed ? settings()->smallSpacing() * 1.5 : 0;
+    const qreal textWidth = std::max<qreal>(0, captionRectangle.width() - glyphSize - glyphGap);
+    const QString caption = painter->fontMetrics().elidedText(window()->caption(), Qt::ElideMiddle, textWidth);
+    if (sandboxed) {
+        const qreal advance = painter->fontMetrics().horizontalAdvance(caption);
+        qreal textLeft = captionRectangle.left() + glyphSize + glyphGap;
+        if (alignment & Qt::AlignRight) {
+            textLeft = captionRectangle.right() - advance;
+        } else if (alignment & Qt::AlignHCenter) {
+            textLeft = captionRectangle.center().x() - (advance - glyphSize - glyphGap) / 2;
+        }
+        const QRectF glyph(textLeft - glyphGap - glyphSize, captionRectangle.center().y() - glyphSize / 2, glyphSize, glyphSize);
+        paintSandboxGlyph(painter, glyph);
+        if (alignment & Qt::AlignHCenter) {
+            captionRectangle.setLeft(textLeft);
+            captionRectangle.setWidth(advance + 1);
+            alignment = Qt::AlignVCenter | Qt::AlignLeft;
+        } else if (!(alignment & Qt::AlignRight)) {
+            captionRectangle.setLeft(textLeft);
+        }
+    }
     painter->drawText(captionRectangle, alignment | Qt::TextSingleLine, caption);
 
