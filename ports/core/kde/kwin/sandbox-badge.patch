+/*
+ * What the client's security context says, read from the connection of the
+ * window's surface. An X11 window's surface belongs to Xwayland, which is no
+ * sandbox, so it reads as unsandboxed whatever the program behind it is.
+ */
+static ClientConnection *sandboxedClient(const Window *window)
+{
+    SurfaceInterface *surface = window->surface();
+    ClientConnection *client = surface ? surface->client() : nullptr;
+    return client && client->isSandboxed() ? client : nullptr;
+}
+
+QString Window::sandboxEngine() const
+{
+    const ClientConnection *client = sandboxedClient(this);
+    return client ? client->securityContextSandboxEngine() : QString();
+}
+
+QString Window::sandboxAppId() const
+{
+    const ClientConnection *client = sandboxedClient(this);
+    return client ? client->securityContextAppId() : QString();
+}
+
+QString Window::sandboxInstanceId() const
+{
+    const ClientConnection *client = sandboxedClient(this);
+    return client ? client->securityContextInstanceId() : QString();
+}
+
 void Window::setExcludeFromCapture(bool newExcludeFromCapture)
 {
     newExcludeFromCapture = rules()->checkExcludeFromCapture(newExcludeFromCapture);
