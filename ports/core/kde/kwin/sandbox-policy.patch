+private:
+    const QSet<QByteArray> &grantsFor(ClientConnection *client)
+    {
+        auto it = m_sandboxGrants.find(client);
+        if (it == m_sandboxGrants.end()) {
+            it = m_sandboxGrants.insert(client, kdosSandboxGrants(client));
+            connect(client, &ClientConnection::aboutToBeDestroyed, this, [this, client]() {
+                m_sandboxGrants.remove(client);
+            });
+        }
+        return *it;
+    }
+
+    QHash<ClientConnection *, QSet<QByteArray>> m_sandboxGrants;
 };
 
