+/*
+ * Globals a sandboxed client is refused unless a grant names them: the ones
+ * that reach past the client's own windows to the rest of the desktop —
+ * every window, every input, every screen, the shell's own surfaces. A grant
+ * name opens a set of them at once, because a client that has one of a set
+ * and not the others is a client that half works.
+ */
+struct SandboxGrant
+{
+    const char *name;
+    QList<QByteArray> interfaces;
+};
+
+static const QList<SandboxGrant> &sandboxGrantTable()
+{
+    static const QList<SandboxGrant> table = {
+        {"window-list", {QByteArrayLiteral("org_kde_plasma_window_management"), QByteArrayLiteral("org_kde_plasma_activation_feedback"), QByteArrayLiteral("org_kde_plasma_virtual_desktop_management")}},
+        {"fake-input", {QByteArrayLiteral("org_kde_kwin_fake_input")}},
+        {"screencast", {QByteArrayLiteral("zkde_screencast_unstable_v1")}},
+        {"data-control", {QByteArrayLiteral("ext_data_control_manager_v1")}},
+        {"layer-shell", {QByteArrayLiteral("zwlr_layer_shell_v1")}},
+        {"output-management", {QByteArrayLiteral("kde_output_management_v2"), QByteArrayLiteral("kde_external_brightness_v1"), QByteArrayLiteral("wp_drm_lease_device_v1")}},
+        {"dpms", {QByteArrayLiteral("org_kde_kwin_dpms_manager")}},
+        {"plasma-shell", {QByteArrayLiteral("org_kde_plasma_shell"), QByteArrayLiteral("kde_screen_edge_manager_v1"), QByteArrayLiteral("org_kde_kwin_keystate")}},
+        // KWin offers the input-method globals to the input method it starts
+        // and to no other client, before this policy is asked, so a profile
+        // may name this grant and it opens nothing past that rule.
+        {"input-method", {QByteArrayLiteral("zwp_input_method_v1"), QByteArrayLiteral("zwp_input_panel_v1")}},
+    };
+    return table;
+}
+
+/*
+ * A box name as KDOS writes them, which is also a file name here: letters,
+ * digits, dots, dashes and underscores, not starting with a dot or a dash and
+ * never `..`, so it cannot name a file outside the profile directory.
+ */
+static bool isKdosBoxName(const QString &name)
+{
+    static const QRegularExpression valid(QStringLiteral("^[A-Za-z0-9_][A-Za-z0-9._-]{0,62}$"));
+    return valid.match(name).hasMatch() && !name.contains(QLatin1String(".."));
+}
+
+static QString kdosBoxProfile(const QString &box)
+{
+    return QDir::homePath() + QLatin1String("/.config/kdos/boxes/") + box + QLatin1String(".conf");
+}
+
+/*
+ * The grants of a client of a KDOS box: the `grant` key of the box's profile,
+ * ~/.config/kdos/boxes/<box>.conf. The box is the security context's instance
+ * id, which kdos-boxsock sets to the box; a context without one is matched by
+ * its app id, which is the box or the box and one launcher component. The
+ * profile is the user's — a box sees it read-only — and is read once per
+ * client, so a changed grant reaches a box's next client and no client's
+ * rights change under it.
+ */
+static QSet<QByteArray> kdosSandboxGrants(ClientConnection *client)
+{
+    const QString engine = client->securityContextSandboxEngine();
+    if (engine != QLatin1String("io.kdos.appbox") && !engine.startsWith(QLatin1String("io.kdos.appbox+"))) {
+        return {};
+    }
+
+    QString box = client->securityContextInstanceId();
+    if (!isKdosBoxName(box)) {
+        box = client->securityContextAppId();
+        if (!isKdosBoxName(box)) {
+            return {};
+        }
+        if (!QFile::exists(kdosBoxProfile(box)) && box.contains(QLatin1Char('.'))) {
+            box.truncate(box.lastIndexOf(QLatin1Char('.')));
+        }
+    }
+
+    QFile profile(kdosBoxProfile(box));
+    if (!profile.open(QIODevice::ReadOnly)) {
+        return {};
+    }
+    QString grant;
+    while (!profile.atEnd()) {
+        const QString line = QString::fromUtf8(profile.readLine()).trimmed();
+        if (line.startsWith(QLatin1Char('#'))) {
+            continue;
+        }
+        const int eq = line.indexOf(QLatin1Char('='));
+        if (eq > 0 && line.left(eq).trimmed() == QLatin1String("grant")) {
+            grant = line.mid(eq + 1).trimmed();
+        }
+    }
+
+    QSet<QByteArray> granted;
+    static const QRegularExpression separators(QStringLiteral("[\\s,]+"));
+    const QStringList names = grant.split(separators, Qt::SkipEmptyParts);
+    for (const QString &name : names) {
+        for (const SandboxGrant &entry : sandboxGrantTable()) {
+            if (name == QLatin1String(entry.name)) {
+                for (const QByteArray &interface : entry.interfaces) {
+                    granted.insert(interface);
+                }
+            }
+        }
+    }
+    if (!granted.isEmpty()) {
+        qCDebug(KWIN_CORE) << "Sandboxed client" << client->securityContextAppId() << "of box" << box << "is granted" << names;
+    }
+    return granted;
+}
