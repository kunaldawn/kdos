+namespace
+{
+
+// A preset is only a set of values for the three settings; nothing stores
+// which one was picked, so the combo shows whichever the values match and
+// Custom when they match none. `kdos phosphor preset` writes the same values.
+struct Preset
+{
+    int strength;
+    int scanlines;
+    int curve;
+};
+
+constexpr std::array<Preset, 2> s_presets = {{
+    {55, 0, 0}, // Subtle
+    {55, 60, 30}, // Retro
+}};
+
+constexpr int s_customIndex = int(s_presets.size());
+
+}
+
+KdosCrtEffectConfig::KdosCrtEffectConfig(QObject *parent, const KPluginMetaData &data)
+    : KCModule(parent, data)
+{
+    m_ui.setupUi(widget());
+    KdosCrtConfig::instance(KWIN_CONFIG);
+    addConfig(KdosCrtConfig::self(), widget());
+
+    connect(m_ui.presetCombo, &QComboBox::activated, this, &KdosCrtEffectConfig::applyPreset);
+    connect(m_ui.kcfg_Strength, &QSpinBox::valueChanged, this, &KdosCrtEffectConfig::showPreset);
+    connect(m_ui.kcfg_Scanlines, &QSpinBox::valueChanged, this, &KdosCrtEffectConfig::showPreset);
+    connect(m_ui.kcfg_Curve, &QSpinBox::valueChanged, this, &KdosCrtEffectConfig::showPreset);
+}
+
+void KdosCrtEffectConfig::load()
+{
+    KCModule::load();
+    showPreset();
+}
+
+void KdosCrtEffectConfig::defaults()
+{
+    KCModule::defaults();
+    showPreset();
+}
+
+void KdosCrtEffectConfig::save()
+{
+    KCModule::save();
+    OrgKdeKwinEffectsInterface interface(QStringLiteral("org.kde.KWin"),
+                                         QStringLiteral("/Effects"),
+                                         QDBusConnection::sessionBus());
+    interface.reconfigureEffect(QStringLiteral("kdos_crt"));
+}
+
+void KdosCrtEffectConfig::applyPreset(int index)
+{
+    if (index < 0 || index >= s_customIndex) {
+        return;
+    }
+    const Preset &preset = s_presets[index];
+    m_ui.kcfg_Strength->setValue(preset.strength);
+    m_ui.kcfg_Scanlines->setValue(preset.scanlines);
+    m_ui.kcfg_Curve->setValue(preset.curve);
+}
+
+void KdosCrtEffectConfig::showPreset()
+{
+    int index = s_customIndex;
+    for (int i = 0; i < s_customIndex; ++i) {
+        const Preset &preset = s_presets[i];
+        if (m_ui.kcfg_Strength->value() == preset.strength
+            && m_ui.kcfg_Scanlines->value() == preset.scanlines
+            && m_ui.kcfg_Curve->value() == preset.curve) {
+            index = i;
+            break;
+        }
+    }
+    const QSignalBlocker blocker(m_ui.presetCombo);
+    m_ui.presetCombo->setCurrentIndex(index);
+}
+
+} // namespace KWin
+
+#include "kdos_crt_config.moc"
+
+#include "moc_kdos_crt_config.cpp"
