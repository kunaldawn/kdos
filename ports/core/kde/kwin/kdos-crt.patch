+/*
+    KWin - the KDE window manager
+    This file is part of the KDE project.
+
+    SPDX-FileCopyrightText: 2026 Kunal Dawn <kunal.dawn@gmail.com>
+
+    SPDX-License-Identifier: GPL-2.0-only
+*/
+
+#include "kdos_crt.h"
+
+#include "core/backendoutput.h"
+#include "core/colorspace.h"
+#include "core/output.h"
+#include "core/rendertarget.h"
+#include "core/renderviewport.h"
+#include "effect/effecthandler.h"
+#include "effect/effectwindow.h"
+#include "opengl/eglcontext.h"
+#include "opengl/glutils.h"
+#include "scene/scene.h"
+
+#include "kdos_crtconfig.h"
+
+#include <KColorScheme>
+#include <KConfigGroup>
+
+#include <QDBusConnection>
+#include <QImage>
+#include <QLoggingCategory>
+
+#include <algorithm>
+#include <cmath>
+
+Q_LOGGING_CATEGORY(KWIN_KDOS_CRT, "kwin_effect_kdos_crt", QtWarningMsg)
+
+using namespace std::chrono_literals;
+
+static void ensureResources()
+{
+    // A static library's resources are registered by hand.
+    Q_INIT_RESOURCE(kdos_crt);
+}
+
+namespace KWin
+{
+
+static const QString s_dbusPath = QStringLiteral("/io/kdos/Crt1");
+
+// The collapse shrinks the picture to this fraction of the output, never to
+// zero: the shader divides sample space by it.
+static constexpr float s_minScale = 0.006f;
+
+// The degauss is one pulse no longer than 400 ms, and pulses start at least
+// 334 ms apart, so it can never flash more than three times a second
+// (WCAG 2.3.1) however fast the accent is changed.
+static constexpr std::chrono::milliseconds s_degaussTime = 400ms;
+static constexpr std::chrono::milliseconds s_degaussGap = 334ms;
+
+// The power-down: about 350 ms to a bright line, then 100 ms to a dot. The
+// power-on runs the same two stages backwards.
+static constexpr std::chrono::milliseconds s_verticalTime = 350ms;
+static constexpr std::chrono::milliseconds s_horizontalTime = 100ms;
+
+// How long the screen may stay dark once a collapse ends. Nothing this effect
+// does may leave a session black: every hold has a deadline, after which the
+// picture comes back whatever is on it.
+static constexpr std::chrono::milliseconds s_requestHold = 10s;
+static constexpr std::chrono::milliseconds s_lockHold = 2s;
+static constexpr std::chrono::milliseconds s_quitHold = 30s;
+
+// A run-time failure puts that output on the plain picture for a cooldown, 5 s
+// doubling to 60 s and reset by a frame that passes: giving up for good would
+// leave a screen unthemed for the session over one transient failure, and
+// retrying every frame would log sixty lines a second.
+static constexpr std::chrono::seconds s_cooldownMin = 5s;
+static constexpr std::chrono::seconds s_cooldownMax = 60s;
+
+static std::chrono::nanoseconds steadyNow()
+{
+    return std::chrono::steady_clock::now().time_since_epoch();
+}
+
+static double ratio(std::chrono::nanoseconds part, std::chrono::nanoseconds whole)
+{
+    if (whole <= 0ns) {
+        return 1.0;
+    }
+    return std::clamp(double(part.count()) / double(whole.count()), 0.0, 1.0);
+}
+
+// The boot splash's power-on curve: most of the opening in the first frames.
+static double easeOut(double u)
+{
+    return 1.0 - std::pow(1.0 - u, 3.0);
+}
+
+static double easeOutInverse(double x)
+{
+    return 1.0 - std::cbrt(1.0 - std::clamp(x, 0.0, 1.0));
+}
+
+KdosCrtEffect::KdosCrtEffect()
+    : m_kdeglobals(KSharedConfig::openConfig(QStringLiteral("kdeglobals")))
+{
+    ensureResources();
+    KdosCrtConfig::instance(effects->config());
+
+    m_holdDeadline.setSingleShot(true);
+    connect(&m_holdDeadline, &QTimer::timeout, this, &KdosCrtEffect::startUnfold);
+
+    connect(effects, &EffectsHandler::screenAboutToLock, this, &KdosCrtEffect::slotScreenAboutToLock);
+    connect(effects, &EffectsHandler::screenLockingChanged, this, &KdosCrtEffect::slotScreenLockingChanged);
+    connect(effects, &EffectsHandler::sessionStateChanged, this, &KdosCrtEffect::slotSessionStateChanged);
+    connect(effects, &EffectsHandler::windowAdded, this, &KdosCrtEffect::slotWindowAdded);
+    connect(effects, &EffectsHandler::screenRemoved, this, &KdosCrtEffect::slotScreenRemoved);
+    // The fullscreen exemption follows the active window, and an output it
+    // leaves or reaches is redrawn whole.
+    connect(effects, &EffectsHandler::windowActivated, this, [this]() {
+        if (!m_fullscreen && isActive()) {
+            effects->addRepaintFull();
+        }
+    });
+
+    // The tint is the accent, and the accent reaches KWin in two ways: a
+    // KConfig notification on kdeglobals and KGlobalSettings' palette signal.
+    // Either one alone misses some writer; refreshTint() makes the second a
+    // no-op.
+    m_kdeglobalsWatcher = KConfigWatcher::create(m_kdeglobals);
+    connect(m_kdeglobalsWatcher.data(), &KConfigWatcher::configChanged, this, [this](const KConfigGroup &group, const QByteArrayList &names) {
+        if (group.name() == QLatin1StringView("KDE") && names.contains("AnimationDurationFactor")
+            && group.readEntry("AnimationDurationFactor", 1.0) <= 0.0) {
+            stopMotion();
+        }
+        if (group.name().startsWith(QLatin1StringView("Colors:"))
+            || (group.name() == QLatin1StringView("General") && (names.contains("ColorScheme") || names.contains("AccentColor")))) {
+            if (refreshTint()) {
+                degauss();
+            }
+            effects->addRepaintFull();
+        }
+    });
+    QDBusConnection::sessionBus().connect(QString(), QStringLiteral("/KGlobalSettings"), QStringLiteral("org.kde.KGlobalSettings"),
+                                          QStringLiteral("notifyChange"), this, SLOT(slotGlobalSettingsChanged(int, int)));
+
+    m_dbus = std::make_unique<KdosCrtDBusInterface>(this);
+
+    m_dumpPrefix = qEnvironmentVariable("KWIN_KDOS_CRT_DUMP");
+    m_dumpAt = std::max(qEnvironmentVariableIntValue("KWIN_KDOS_CRT_DUMP_FRAME"), 1);
+
+    loadShader();
+    loadConfig();
+    refreshTint();
+    effects->addRepaintFull();
+}
+
+KdosCrtEffect::~KdosCrtEffect()
+{
+    effects->addRepaintFull();
+}
+
+bool KdosCrtEffect::supported()
+{
+    if (!effects->isOpenGLCompositing() || !effects->animationsSupported()) {
+        return false;
+    }
+    // A full-screen pass on a software renderer runs on the CPU over every
+    // pixel of every frame. animationsSupported() asks the EGL device, which
+    // Mesa's kms_swrast does not mark as software, so the renderer's own name
+    // decides as well. KWIN_EFFECTS_FORCE_ANIMATIONS=1, KWin's switch for
+    // animating on a software renderer, lets a test load the effect there.
+    const EglContext *context = effects->openglContext();
+    if (!context) {
+        return false;
+    }
+    return !context->isSoftwareRenderer() || qEnvironmentVariableIntValue("KWIN_EFFECTS_FORCE_ANIMATIONS") == 1;
+}
+
+void KdosCrtEffect::loadShader()
+{
+    m_shader = ShaderManager::instance()->generateShaderFromFile(ShaderTrait::MapTexture, QString(), QStringLiteral(":/effects/kdos_crt/kdos_crt.frag"));
+    if (!m_shader) {
+        qCCritical(KWIN_KDOS_CRT) << "The phosphor shader did not build; the effect draws nothing";
+        return;
+    }
+    m_uRes = m_shader->uniformLocation("u_res");
+    m_uInt = m_shader->uniformLocation("u_int");
+    m_uScan = m_shader->uniformLocation("u_scan");
+    m_uCurve = m_shader->uniformLocation("u_curve");
+    m_uTint = m_shader->uniformLocation("u_tint");
+    m_uFx = m_shader->uniformLocation("u_fx");
+    m_uCollapse = m_shader->uniformLocation("u_collapse");
+}
+
+void KdosCrtEffect::loadConfig()
+{
+    m_strength = std::clamp(KdosCrtConfig::strength(), 0, 100);
+    m_scanlines = std::clamp(KdosCrtConfig::scanlines(), 0, 100);
+    m_curve = std::clamp(KdosCrtConfig::curve(), 0, 100);
+    m_fullscreen = KdosCrtConfig::fullscreen();
+}
+
+bool KdosCrtEffect::refreshTint()
+{
+    // The accent is the selection colour of the scheme in force, which is how
+    // every KDOS scheme carries it (`primary`).
+    const KColorScheme selection(QPalette::Active, KColorScheme::Selection, m_kdeglobals);
+    const QColor tint = selection.background(KColorScheme::NormalBackground).color();
+    if (tint == m_tint) {
+        return false;
+    }
+    const bool first = !m_tint.isValid();
+    m_tint = tint;
+    return !first;
+}
+
+void KdosCrtEffect::reconfigure(ReconfigureFlags flags)
+{
+    Q_UNUSED(flags)
+
+    KdosCrtConfig::self()->read();
+    loadConfig();
+    m_kdeglobals->reparseConfiguration();
+    if (refreshTint()) {
+        degauss();
+    }
+    if (!motionAllowed()) {
+        stopMotion();
+    }
+    effects->addRepaintFull();
+}
+
+void KdosCrtEffect::slotGlobalSettingsChanged(int type, int arg)
+{
+    Q_UNUSED(arg)
+
+    // KGlobalSettings::PaletteChanged
+    if (type != 0) {
+        return;
+    }
+    m_kdeglobals->reparseConfiguration();
+    if (refreshTint()) {
+        degauss();
+        effects->addRepaintFull();
+    }
+}
+
+bool KdosCrtEffect::motionAllowed() const
+{
+    // AnimationDurationFactor=0 is the desktop's reduced-motion switch: no
+    // degauss and no collapse. The still pass is not motion and stays.
+    return effects->animationTimeFactor() > 0.0 && effects->animationsSupported();
+}
+
+bool KdosCrtEffect::passConfigured() const
+{
+    return m_strength > 0 || m_scanlines > 0 || m_curve > 0;
+}
+
+LogicalOutput *KdosCrtEffect::exemptScreen() const
+{
+    // Fullscreen=false hands the output of an active fullscreen window back
+    // to the plain picture, so a game or a video keeps direct scanout.
+    if (m_fullscreen) {
+        return nullptr;
+    }
+    const EffectWindow *window = effects->activeWindow();
+    if (!window || !window->isFullScreen() || window->isMinimized()) {
+        return nullptr;
+    }
+    return window->screen();
+}
+
+KdosCrtEffect::Verdict KdosCrtEffect::verdictFor(const RenderView *view, LogicalOutput *screen) const
+{
+    if (!m_shader) {
+        return Verdict::Off;
+    }
+    // A screenshot, a screencast or the colour picker paints through a view of
+    // its own with no backend output; captures keep the pixels true.
+    if (!view || !view->backendOutput()) {
+        return Verdict::Capture;
+    }
+    if (!screen) {
+        return Verdict::Off;
+    }
+    // The shader works on encoded values with white at 1.0. An HDR output
+    // encodes reference white well below that, so the floor, the bleed and
+    // the collapse's brightening would not mean what they mean in SDR.
+    const TransferFunction::Type encoding = view->backendOutput()->colorDescription()->transferFunction().type;
+    if (encoding == TransferFunction::PerceptualQuantizer || encoding == TransferFunction::HLG || encoding == TransferFunction::linear) {
+        return Verdict::Refused;
+    }
+    // Zoom is read through the plain picture: an accessibility magnifier seen
+    // through scanlines and bleed is harder to read, not easier.
+    if (effects->isEffectActive(QStringLiteral("zoom")) || effects->isEffectActive(QStringLiteral("magnifier"))) {
+        return Verdict::Aside;
+    }
+    if (const auto it = m_outputs.find(screen); it != m_outputs.end() && it->second.brokenUntil > std::chrono::steady_clock::now()) {
+        return Verdict::Cooldown;
+    }
+    if (m_stage != Stage::Live || m_degaussing) {
+        return Verdict::Pass;
+    }
+    if (!passConfigured()) {
+        return Verdict::Off;
+    }
+    if (screen == exemptScreen()) {
+        return Verdict::Exempt;
+    }
+    return Verdict::Pass;
+}
+
+bool KdosCrtEffect::isActive() const
+{
+    return m_shader && (passConfigured() || m_stage != Stage::Live || m_degaussing);
+}
+
+bool KdosCrtEffect::blocksDirectScanout() const
+{
+    // A scanned-out buffer is one client's picture, not the screen's, and the
+    // pass cannot run over it; while the pass runs, the cursor is composited
+    // into the picture and curves with it.
+    if (m_stage != Stage::Live || m_degaussing) {
+        return true;
+    }
+    return exemptScreen() == nullptr;
+}
+
+int KdosCrtEffect::requestedEffectChainPosition() const
+{
+    // The pass must be the last thing drawn over the screen, so it takes the
+    // earliest position; an overlay effect at the same position (click rings,
+    // touch points) may still draw after it.
+    return 0;
+}
+
+void KdosCrtEffect::prePaintScreen(ScreenPrePaintData &data)
+{
+    // Only a frame bound for a display moves the motion on: a capture view's
+    // timestamp is its own, and may be from when the capture began.
+    if (data.view && data.view->backendOutput()) {
+        advance(data.view->nextPresentationTimestamp());
+    }
+    m_frameVerdict = verdictFor(data.view, data.screen);
+
+    if (m_frameVerdict != Verdict::Capture && data.screen) {
+        OutputData &output = m_outputs[data.screen];
+        // The pass reads beside and, with the curve, far from each pixel, so
+        // it redraws the whole output. So does the first plain frame after a
+        // passed one, or the pixels outside its damage keep the tube.
+        if (m_frameVerdict == Verdict::Pass || output.passed) {
+            data.mask |= PAINT_SCREEN_TRANSFORMED;
+        }
+        output.verdict = m_frameVerdict;
+    }
+
+    effects->prePaintScreen(data);
+}
+
+bool KdosCrtEffect::ensureOffscreen(OutputData &data, const RenderTarget &renderTarget, const RenderViewport &viewport)
+{
+    const QSize size = viewport.deviceSize();
+    const GLenum format = renderTarget.colorDescription() == ColorDescription::sRGB ? GL_RGBA8 : GL_RGBA16F;
+    if (data.texture && data.framebuffer && data.texture->size() == size && data.texture->internalFormat() == format) {
+        return true;
+    }
+
+    data.framebuffer.reset();
+    data.texture = GLTexture::allocate(format, size);
+    if (!data.texture) {
+        return false;
+    }
+    // The bleed reads a texel either side and the border must not wrap to the
+    // far edge.
+    data.texture->setFilter(GL_LINEAR);
+    data.texture->setWrapMode(GL_CLAMP_TO_EDGE);
+    data.framebuffer = std::make_unique<GLFramebuffer>(data.texture.get());
+    if (!data.framebuffer->valid()) {
+        data.framebuffer.reset();
+        data.texture.reset();
+        return false;
+    }
+    return true;
+}
+
+void KdosCrtEffect::giveUp(OutputData &data, LogicalOutput *screen, const char *why)
+{
+    data.cooldown = data.cooldown == 0s ? s_cooldownMin : std::min(data.cooldown * 2, s_cooldownMax);
+    data.brokenUntil = std::chrono::steady_clock::now() + data.cooldown;
+    data.framebuffer.reset();
+    data.texture.reset();
+    qCWarning(KWIN_KDOS_CRT).nospace() << why << " on " << screen->name() << ": plain picture for " << data.cooldown.count() << " s";
+}
+
+bool KdosCrtEffect::paintScreen(const RenderTarget &renderTarget, const RenderViewport &viewport, int mask, const Region &deviceRegion, LogicalOutput *screen)
+{
+    if (m_frameVerdict != Verdict::Pass || !screen) {
+        if (m_frameVerdict != Verdict::Capture) {
+            if (const auto it = m_outputs.find(screen); it != m_outputs.end()) {
+                it->second.passed = false;
+            }
+        }
+        return effects->paintScreen(renderTarget, viewport, mask, deviceRegion, screen);
+    }
+
+    OutputData &output = m_outputs[screen];
+
+    // A tube that is off draws nothing; the scene under it is not painted.
+    if (m_frameDark) {
+        glDisable(GL_SCISSOR_TEST);
+        glClearColor(0.0, 0.0, 0.0, 1.0);
+        glClear(GL_COLOR_BUFFER_BIT);
+        output.passed = true;
+        return true;
+    }
+
+    if (!ensureOffscreen(output, renderTarget, viewport)) {
+        giveUp(output, screen, "No offscreen texture");
+        output.passed = false;
+        return effects->paintScreen(renderTarget, viewport, mask, deviceRegion, screen);
+    }
+
+    RenderTarget offscreenTarget(output.framebuffer.get(), renderTarget.colorDescription());
+    RenderViewport offscreenViewport(viewport.renderRect(), viewport.scale(), offscreenTarget, QPoint());
+    GLFramebuffer::pushFramebuffer(output.framebuffer.get());
+    const bool painted = effects->paintScreen(offscreenTarget, offscreenViewport, mask, deviceRegion, screen);
+    GLFramebuffer::popFramebuffer();
+    if (!painted) {
+        return false;
+    }
+
+    const QSize size = output.texture->size();
+    const Rect rect = viewport.scaledRenderRect();
+    QMatrix4x4 projection = viewport.projectionMatrix();
+    projection.translate(rect.x(), rect.y());
+
+    ShaderBinder binder(m_shader.get());
+    GLShader *shader = binder.shader();
+    shader->setUniform(GLShader::Mat4Uniform::ModelViewProjectionMatrix, projection);
+    shader->setUniform(m_uRes, QVector2D(size.width(), size.height()));
+    shader->setUniform(m_uInt, float(m_strength) / 100.0f);
+    shader->setUniform(m_uScan, float(m_scanlines) / 100.0f);
+    shader->setUniform(m_uCurve, float(m_curve) / 100.0f);
+    shader->setUniform(m_uTint, QVector3D(m_tint.redF(), m_tint.greenF(), m_tint.blueF()));
+    shader->setUniform(m_uFx, m_frameFx);
+    shader->setUniform(m_uCollapse, m_frameCollapse);
+    output.texture->render(size);
+
+    output.passed = true;
+    output.cooldown = 0s;
+    if (!m_dumpPrefix.isEmpty() && ++m_passedFrames == m_dumpAt) {
+        dump(output, renderTarget);
+    }
+    return true;
+}
+
+// The framebuffer bound now, read back whole into a PNG. GL hands the rows
+// over bottom first, so a target drawn upright (no vertical flip in its
+// transform) is turned over; any rotation stays the buffer's.
+static void dumpBound(const QSize &size, OutputTransform transform, const QString &path)
+{
+    QImage image(size, QImage::Format_RGBA8888);
+    glReadPixels(0, 0, size.width(), size.height(), GL_RGBA, GL_UNSIGNED_BYTE, image.bits());
+    if (transform.kind() != OutputTransform::FlipY) {
+        image = image.mirrored(false, true);
+    }
+    if (image.save(path)) {
+        qCInfo(KWIN_KDOS_CRT) << "Wrote" << path;
+    } else {
+        qCWarning(KWIN_KDOS_CRT) << "Cannot write" << path;
+    }
+}
+
+// The pass's input is the offscreen picture and its output the frame as it
+// goes to the display. The dump is set only from KWin's own environment, so
+// no client of the session can turn it into a capture that bypasses the
+// screenshot interface's authorisation.
+void KdosCrtEffect::dump(OutputData &data, const RenderTarget &renderTarget)
+{
+    dumpBound(renderTarget.size(), renderTarget.transform(), m_dumpPrefix + QStringLiteral("-out.png"));
+    GLFramebuffer::pushFramebuffer(data.framebuffer.get());
+    dumpBound(data.texture->size(), data.texture->contentTransform(), m_dumpPrefix + QStringLiteral("-in.png"));
+    GLFramebuffer::popFramebuffer();
+}
+
+void KdosCrtEffect::postPaintScreen()
+{
+    if (m_stage == Stage::Collapsing || m_stage == Stage::Unfolding || m_degaussing) {
+        effects->addRepaintFull();
+    }
+    effects->postPaintScreen();
+}
+
+void KdosCrtEffect::advance(std::chrono::nanoseconds now)
+{
+    m_frameFx = QVector2D(0.0f, 0.0f);
+    if (m_degaussing) {
+        const auto elapsed = std::max(now - m_degaussStart, 0ns);
+        if (elapsed >= m_degaussTime) {
+            // The frame after the pulse is drawn still; postPaintScreen() has
+            // already asked for it.
+            m_degaussing = false;
+        } else {
+            // The 400 ms decaying wobble, compressed into m_degaussTime when
+            // animations are faster: x is the amplitude in texture space, y
+            // the phase.
+            const double t = 0.4 * ratio(elapsed, m_degaussTime);
+            m_frameFx = QVector2D(float(0.012 * std::exp(-t * 8.0)), float(t * 40.0));
+        }
+    }
+
+    const auto elapsed = std::max(now - m_stageStart, 0ns);
+    const std::chrono::nanoseconds vertical = m_verticalTime;
+    const std::chrono::nanoseconds horizontal = m_horizontalTime;
+    switch (m_stage) {
+    case Stage::Live:
+        m_frameCollapse = QVector2D(1.0f, 1.0f);
+        m_frameDark = false;
+        return;
+    case Stage::Dark:
+        m_frameCollapse = QVector2D(s_minScale, s_minScale);
+        m_frameDark = true;
+        return;
+    case Stage::Collapsing:
+        m_frameDark = false;
+        if (elapsed >= vertical + horizontal) {
+            enterDark();
+            if (m_stage != Stage::Dark) {
+                advance(now);
+            } else {
+                m_frameCollapse = QVector2D(s_minScale, s_minScale);
+                m_frameDark = true;
+            }
+        } else if (elapsed <= vertical) {
+            m_frameCollapse = QVector2D(float(1.0 - ratio(elapsed, vertical) * (1.0 - s_minScale)), 1.0f);
+        } else {
+            m_frameCollapse = QVector2D(s_minScale, float(1.0 - ratio(elapsed - vertical, horizontal) * (1.0 - s_minScale)));
+        }
+        return;
+    case Stage::Unfolding:
+        m_frameDark = false;
+        if (elapsed >= horizontal + vertical) {
+            finishMotion();
+            m_frameCollapse = QVector2D(1.0f, 1.0f);
+        } else if (elapsed <= horizontal) {
+            m_frameCollapse = QVector2D(s_minScale, float(s_minScale + (1.0 - s_minScale) * easeOut(ratio(elapsed, horizontal))));
+        } else {
+            m_frameCollapse = QVector2D(float(s_minScale + (1.0 - s_minScale) * easeOut(ratio(elapsed - horizontal, vertical))), 1.0f);
+        }
+        return;
+    }
+}
+
+// The point of the collapse that shows `scale`, so a collapse that interrupts
+// an unfold starts from the picture on screen instead of jumping.
+std::chrono::nanoseconds KdosCrtEffect::collapseElapsedFor(const QVector2D &scale) const
+{
+    const std::chrono::nanoseconds vertical = m_verticalTime;
+    const std::chrono::nanoseconds horizontal = m_horizontalTime;
+    const double span = 1.0 - s_minScale;
+    if (scale.y() >= 1.0f) {
+        const double u = std::clamp((1.0 - scale.x()) / span, 0.0, 1.0);
+        return std::chrono::nanoseconds(std::llround(u * vertical.count()));
+    }
+    const double u = std::clamp((1.0 - scale.y()) / span, 0.0, 1.0);
+    return vertical + std::chrono::nanoseconds(std::llround(u * horizontal.count()));
+}
+
+// The point of the unfold that shows `scale`.
+std::chrono::nanoseconds KdosCrtEffect::unfoldElapsedFor(const QVector2D &scale) const
+{
+    const std::chrono::nanoseconds vertical = m_verticalTime;
+    const std::chrono::nanoseconds horizontal = m_horizontalTime;
+    const double span = 1.0 - s_minScale;
+    if (scale.x() <= s_minScale) {
+        const double u = easeOutInverse((scale.y() - s_minScale) / span);
+        return std::chrono::nanoseconds(std::llround(u * horizontal.count()));
+    }
+    const double u = easeOutInverse((scale.x() - s_minScale) / span);
+    return horizontal + std::chrono::nanoseconds(std::llround(u * vertical.count()));
+}
+
+std::chrono::milliseconds KdosCrtEffect::holdTime() const
+{
+    switch (m_hold) {
+    case Hold::Quit:
+        return s_quitHold;
+    case Hold::Lock:
+        return s_lockHold;
+    case Hold::None:
+    case Hold::Request:
+        break;
+    }
+    return s_requestHold;
+}
+
+void KdosCrtEffect::startCollapse(Hold hold)
+{
+    if (!m_shader || !motionAllowed()) {
+        return;
+    }
+    const bool stronger = hold > m_hold;
+    if (stronger) {
+        m_hold = hold;
+    }
+    if (hold == Hold::Lock) {
+        m_lockShown = false;
+    }
+
+    switch (m_stage) {
+    case Stage::Collapsing:
+        // Already going dark: the dark it reaches takes the hold above.
+        return;
+    case Stage::Dark:
+        // A stronger hold, such as a logout behind a lock, keeps the dark for
+        // its own length from now.
+        if (stronger) {
+            m_holdDeadline.start(holdTime());
+        }
+        return;
+    case Stage::Live:
+        m_verticalTime = animationTime(s_verticalTime);
+        m_horizontalTime = animationTime(s_horizontalTime);
+        m_stageStart = steadyNow();
+        break;
+    case Stage::Unfolding:
+        m_stageStart = steadyNow() - collapseElapsedFor(m_frameCollapse);
+        break;
+    }
+    m_stage = Stage::Collapsing;
+    effects->addRepaintFull();
+}
+
+void KdosCrtEffect::enterDark()
+{
+    m_stage = Stage::Dark;
+    if (m_hold == Hold::Lock && m_lockShown) {
+        startUnfold();
+        return;
+    }
+    m_holdDeadline.start(holdTime());
+}
+
+void KdosCrtEffect::startUnfold()
+{
+    m_holdDeadline.stop();
+    switch (m_stage) {
+    case Stage::Live:
+    case Stage::Unfolding:
+        return;
+    case Stage::Dark:
+        m_stageStart = steadyNow();
+        break;
+    case Stage::Collapsing:
+        m_stageStart = steadyNow() - unfoldElapsedFor(m_frameCollapse);
+        break;
+    }
+    m_stage = Stage::Unfolding;
+    m_hold = Hold::None;
+    effects->addRepaintFull();
+}
+
+void KdosCrtEffect::finishMotion()
+{
+    m_holdDeadline.stop();
+    m_stage = Stage::Live;
+    m_hold = Hold::None;
+    m_lockShown = false;
+    effects->addRepaintFull();
+}
+
+void KdosCrtEffect::stopMotion()
+{
+    m_degaussing = false;
+    if (m_stage != Stage::Live) {
+        finishMotion();
+    }
+}
+
+void KdosCrtEffect::slotScreenAboutToLock()
+{
+    startCollapse(Hold::Lock);
+}
+
+void KdosCrtEffect::slotScreenLockingChanged(bool locked)
+{
+    // Unlocked while still collapsing or dark: the lock was refused or is
+    // already over, and no lock screen is coming to unfold onto.
+    if (!locked && m_hold == Hold::Lock) {
+        startUnfold();
+    }
+}
+
+void KdosCrtEffect::slotSessionStateChanged()
+{
+    if (effects->sessionState() == SessionState::Quitting) {
+        startCollapse(Hold::Quit);
+    } else if (m_hold == Hold::Quit) {
+        // The logout was cancelled.
+        startUnfold();
+    }
+}
+
+void KdosCrtEffect::slotWindowAdded(EffectWindow *window)
+{
+    if (!window->isLockScreen() || m_hold != Hold::Lock) {
+        return;
+    }
+    m_lockShown = true;
+    if (m_stage == Stage::Dark) {
+        startUnfold();
+    }
+}
+
+void KdosCrtEffect::slotScreenRemoved(LogicalOutput *screen)
+{
+    if (auto it = m_outputs.find(screen); it != m_outputs.end()) {
+        effects->makeOpenGLContextCurrent();
+        m_outputs.erase(it);
+    }
+}
+
+void KdosCrtEffect::collapse()
+{
+    startCollapse(Hold::Request);
+}
+
+void KdosCrtEffect::unfold()
+{
+    startUnfold();
+}
+
+void KdosCrtEffect::degauss()
+{
+    if (!m_shader || !motionAllowed() || m_degaussing) {
+        return;
+    }
+    const auto now = steadyNow();
+    if (m_lastDegaussStart && now - *m_lastDegaussStart < s_degaussGap) {
+        return;
+    }
+    m_degaussTime = std::min(animationTime(s_degaussTime), s_degaussTime);
+    m_degaussStart = now;
+    m_lastDegaussStart = now;
+    m_degaussing = true;
+    effects->addRepaintFull();
+}
+
+QString KdosCrtEffect::phaseName() const
+{
+    switch (m_stage) {
+    case Stage::Live:
+        return QStringLiteral("live");
+    case Stage::Collapsing:
+        return QStringLiteral("collapsing");
+    case Stage::Dark:
+        return QStringLiteral("dark");
+    case Stage::Unfolding:
+        return QStringLiteral("unfolding");
+    }
+    return QString();
+}
+
+static QString verdictName(int verdict)
+{
+    static const char *const names[] = {"pass", "capture", "off", "refused (hdr)", "exempt (fullscreen)", "aside (zoom)", "cooldown"};
+    return QString::fromLatin1(names[verdict]);
+}
+
+QString KdosCrtEffect::debug(const QString &parameter) const
+{
+    Q_UNUSED(parameter)
+
+    static const char *const holds[] = {"none", "request", "lock", "quit"};
+    QString text;
+    text += QStringLiteral("phase: %1\n").arg(phaseName());
+    text += QStringLiteral("hold: %1\n").arg(QString::fromLatin1(holds[int(m_hold)]));
+    text += QStringLiteral("strength: %1\nscanlines: %2\ncurve: %3\n").arg(m_strength).arg(m_scanlines).arg(m_curve);
+    text += QStringLiteral("fullscreen: %1\n").arg(m_fullscreen ? QStringLiteral("true") : QStringLiteral("false"));
+    text += QStringLiteral("tint: %1\n").arg(m_tint.name());
+    text += QStringLiteral("motion: %1\n").arg(motionAllowed() ? QStringLiteral("on") : QStringLiteral("off"));
+    text += QStringLiteral("degauss: %1\n").arg(m_degaussing ? QStringLiteral("running") : QStringLiteral("idle"));
+    text += QStringLiteral("shader: %1\n").arg(m_shader ? QStringLiteral("ok") : QStringLiteral("failed"));
+    // An effect that is not active is not asked about its frames, so each
+    // output's last verdict would be stale.
+    const bool active = isActive();
+    for (const auto &[screen, data] : m_outputs) {
+        text += QStringLiteral("output %1: %2\n").arg(screen->name(), active ? verdictName(int(data.verdict)) : QStringLiteral("off"));
+    }
+    return text;
+}
