+KdosCrtDBusInterface::KdosCrtDBusInterface(KdosCrtEffect *effect)
+    : m_effect(effect)
+{
+    QDBusConnection::sessionBus().registerObject(s_dbusPath, this, QDBusConnection::ExportAllSlots | QDBusConnection::ExportAllProperties);
+}
+
+KdosCrtDBusInterface::~KdosCrtDBusInterface()
+{
+    QDBusConnection::sessionBus().unregisterObject(s_dbusPath);
+}
