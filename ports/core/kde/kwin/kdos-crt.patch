diff -ruN a/src/plugins/kdos_crt/kdos_crt.frag b/src/plugins/kdos_crt/kdos_crt.frag
--- /dev/null
+++ b/src/plugins/kdos_crt/kdos_crt.frag
@@ -0,0 +1,68 @@
+#version 140
+// SPDX-FileCopyrightText: 2026 Kunal Dawn <kunal.dawn@gmail.com>
+// SPDX-License-Identifier: GPL-2.0-only
+
+// The phosphor pass over one output's composited picture.
+//
+// Every proportion scales with u_int, so u_int = 0 with no scanlines and no
+// curve is the picture unchanged. The curvature is normalised by how far the
+// corners move (r^2 = 2), so no u_curve crops the desktop.
+//
+// The arithmetic is on encoded values, white at 1.0: the effect sends an HDR
+// output the plain picture instead.
+
+uniform sampler2D u_tex;
+uniform vec2 u_res;
+uniform float u_int;
+uniform float u_scan;
+uniform float u_curve;
+uniform vec3 u_tint;
+// degauss: x amplitude in texture space, y phase; both 0 when idle
+uniform vec2 u_fx;
+// power-down: vertical and horizontal scale of the picture, (1, 1) live
+uniform vec2 u_collapse;
+
+in vec2 texcoord0;
+
+out vec4 fragColor;
+
+void main()
+{
+    vec2 c = texcoord0 * 2.0 - 1.0;
+    float k = u_curve * 0.06;
+    c *= (1.0 + k * dot(c, c)) / (1.0 + 2.0 * k);
+    // the collapse widens sample space, so everything off the shrinking band
+    // lands in the black branch below
+    c = vec2(c.x / u_collapse.y, c.y / u_collapse.x);
+    vec2 uv = c * 0.5 + 0.5;
+    uv.x += u_fx.x * sin(uv.y * 90.0 + u_fx.y);
+    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
+        fragColor = vec4(0.0, 0.0, 0.0, 1.0);
+        return;
+    }
+
+    vec3 col = texture(u_tex, uv).rgb;
+
+    // three-tap horizontal bleed, weights 1/4 1/2 1/4
+    vec2 dx = vec2(1.0 / u_res.x, 0.0);
+    vec3 bleed = texture(u_tex, uv + dx).rgb + texture(u_tex, uv - dx).rgb;
+    col = mix(col, 0.5 * col + 0.25 * bleed, 0.5 * u_int);
+
+    // scanlines on every third row of the output's pixels
+    float row = floor(uv.y * u_res.y);
+    float line = mod(row, 3.0) < 1.0 ? 1.0 - 0.45 * u_scan : 1.0;
+    col *= line;
+
+    // vignette
+    vec2 v = uv * 2.0 - 1.0;
+    col *= 1.0 - 0.15 * u_int * dot(v, v);
+
+    // the degauss lifts the picture a little; the collapse concentrates a
+    // screen's worth of light into the band that is left
+    col *= 1.0 + 6.0 * u_fx.x + 1.5 * (2.0 - u_collapse.x - u_collapse.y);
+
+    // the phosphor floor: black is never quite black
+    col += u_tint * 0.02 * u_int;
+
+    fragColor = vec4(col, 1.0);
+}
