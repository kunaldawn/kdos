--- /dev/null
+++ b/src/plugins/kdos_crt/kdos_crt.h
@@ -0,0 +1,210 @@
+/*
+    KWin - the KDE window manager
+    This file is part of the KDE project.
+
+    SPDX-FileCopyrightText: 2026 Kunal Dawn <kunal.dawn@gmail.com>
+
+    SPDX-License-Identifier: GPL-2.0-only
+*/
+
+#pragma once
+
+#include "effect/effect.h"
+
+#include <QColor>
+#include <QTimer>
+#include <QVector2D>
+
+#include <KConfigWatcher>
+#include <KSharedConfig>
+
+#include <chrono>
+#include <map>
+#include <memory>
+#include <optional>
+
+namespace KWin
+{
+
+class GLFramebuffer;
+class GLShader;
+class GLTexture;
+class LogicalOutput;
+class RenderView;
+class KdosCrtEffect;
+
+/**
+ * io.kdos.Crt1: the power-down and the degauss, for a test or a KDOS tool.
+ * Every hold it starts has the effect's own deadline, so a caller that goes
+ * away cannot leave the screen dark.
+ */
+class KdosCrtDBusInterface : public QObject
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "io.kdos.Crt1")
+    Q_PROPERTY(QString Phase READ phase)
+
+public:
+    explicit KdosCrtDBusInterface(KdosCrtEffect *effect);
+    ~KdosCrtDBusInterface() override;
+
+    QString phase() const;
+
+public Q_SLOTS:
+    void Collapse();
+    void Unfold();
+    void Degauss();
+
+private:
+    KdosCrtEffect *m_effect;
+};
+
+/**
+ * The KDOS phosphor pass: every output drawn through a CRT tube, with a
+ * degauss when the accent changes and a power-down at lock and logout.
+ *
+ * The scene is painted into an offscreen texture per output and drawn back
+ * through kdos_crt.frag. The pass goes only into frames bound for a display:
+ * screenshots, screencasts and the colour picker render through views with no
+ * backend output and get the plain picture.
+ *
+ * The power-down is exported as io.kdos.Crt1 on org.kde.KWin, object
+ * /io/kdos/Crt1, so that a test or a KDOS tool can drive it.
+ */
+class KdosCrtEffect : public Effect
+{
+    Q_OBJECT
+
+public:
+    KdosCrtEffect();
+    ~KdosCrtEffect() override;
+
+    static bool supported();
+
+    void reconfigure(ReconfigureFlags flags) override;
+    void prePaintScreen(ScreenPrePaintData &data) override;
+    bool paintScreen(const RenderTarget &renderTarget, const RenderViewport &viewport, int mask, const Region &deviceRegion, LogicalOutput *screen) override;
+    void postPaintScreen() override;
+    bool isActive() const override;
+    bool blocksDirectScanout() const override;
+    int requestedEffectChainPosition() const override;
+    QString debug(const QString &parameter) const override;
+
+    QString phaseName() const;
+    void collapse();
+    void unfold();
+    void degauss();
+
+private Q_SLOTS:
+    void slotScreenAboutToLock();
+    void slotScreenLockingChanged(bool locked);
+    void slotSessionStateChanged();
+    void slotWindowAdded(KWin::EffectWindow *window);
+    void slotScreenRemoved(KWin::LogicalOutput *screen);
+    void slotGlobalSettingsChanged(int type, int arg);
+
+private:
+    enum class Stage {
+        Live,
+        Collapsing,
+        Dark,
+        Unfolding,
+    };
+    // What keeps the screen dark once a collapse ends, weakest first. A
+    // stronger hold replaces a weaker one and never the reverse, so a lock
+    // during logout cannot unfold the logout.
+    enum class Hold {
+        None,
+        Request,
+        Lock,
+        Quit,
+    };
+    // Why a frame did or did not go through the pass, per output.
+    enum class Verdict {
+        Pass,
+        Capture,
+        Off,
+        Refused,
+        Exempt,
+        Aside,
+        Cooldown,
+    };
+
+    struct OutputData
+    {
+        std::unique_ptr<GLTexture> texture;
+        std::unique_ptr<GLFramebuffer> framebuffer;
+        std::chrono::steady_clock::time_point brokenUntil;
+        std::chrono::seconds cooldown{0};
+        bool passed = false;
+        Verdict verdict = Verdict::Off;
+    };
+
+    void loadConfig();
+    void loadShader();
+    bool refreshTint();
+    bool motionAllowed() const;
+    bool passConfigured() const;
+    LogicalOutput *exemptScreen() const;
+    Verdict verdictFor(const RenderView *view, LogicalOutput *screen) const;
+    bool ensureOffscreen(OutputData &data, const RenderTarget &renderTarget, const RenderViewport &viewport);
+    void giveUp(OutputData &data, LogicalOutput *screen, const char *why);
+    void dump(OutputData &data, const RenderTarget &renderTarget);
+
+    void startCollapse(Hold hold);
+    void startUnfold();
+    void enterDark();
+    void finishMotion();
+    void stopMotion();
+    void advance(std::chrono::nanoseconds now);
+    std::chrono::nanoseconds collapseElapsedFor(const QVector2D &scale) const;
+    std::chrono::nanoseconds unfoldElapsedFor(const QVector2D &scale) const;
+    std::chrono::milliseconds holdTime() const;
+
+    std::unique_ptr<KdosCrtDBusInterface> m_dbus;
+    std::unique_ptr<GLShader> m_shader;
+    int m_uRes = -1;
+    int m_uInt = -1;
+    int m_uScan = -1;
+    int m_uCurve = -1;
+    int m_uTint = -1;
+    int m_uFx = -1;
+    int m_uCollapse = -1;
+
+    int m_strength = 55;
+    int m_scanlines = 0;
+    int m_curve = 0;
+    bool m_fullscreen = false;
+    QColor m_tint;
+
+    KSharedConfigPtr m_kdeglobals;
+    KConfigWatcher::Ptr m_kdeglobalsWatcher;
+
+    std::map<LogicalOutput *, OutputData> m_outputs;
+    Verdict m_frameVerdict = Verdict::Off;
+
+    Stage m_stage = Stage::Live;
+    Hold m_hold = Hold::None;
+    std::chrono::nanoseconds m_stageStart{0};
+    std::chrono::milliseconds m_verticalTime{350};
+    std::chrono::milliseconds m_horizontalTime{100};
+    bool m_lockShown = false;
+    QTimer m_holdDeadline;
+
+    bool m_degaussing = false;
+    std::chrono::nanoseconds m_degaussStart{0};
+    std::optional<std::chrono::nanoseconds> m_lastDegaussStart;
+    std::chrono::milliseconds m_degaussTime{400};
+
+    // KWIN_KDOS_CRT_DUMP=<prefix> writes <prefix>-in.png and <prefix>-out.png
+    // once, KWIN_KDOS_CRT_DUMP_FRAME=<n> on the n-th passed frame.
+    QString m_dumpPrefix;
+    int m_dumpAt = 1;
+    int m_passedFrames = 0;
+
+    QVector2D m_frameCollapse{1.0f, 1.0f};
+    QVector2D m_frameFx{0.0f, 0.0f};
+    bool m_frameDark = false;
+};
+
+} // namespace KWin
