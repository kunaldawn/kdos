+QMap<QString, QColor> ConfigValueProvider::libadwaitaColors() const
+{
+    using KCS = KColorScheme;
+
+    const KCS view(QPalette::Active, KCS::View);
+    const KCS window(QPalette::Active, KCS::Window);
+    const KCS selection(QPalette::Active, KCS::Selection);
+    const KCS inactiveWindow(QPalette::Inactive, KCS::Window);
+    const bool hasHeader = KCS::isColorSetSupported(kdeglobalsConfig, KCS::Header);
+    const KCS header(QPalette::Active, hasHeader ? KCS::Header : KCS::Window);
+    const KCS inactiveHeader(QPalette::Inactive, hasHeader ? KCS::Header : KCS::Window);
+
+    const QColor viewBackground = view.background(KCS::NormalBackground).color();
+    const QColor viewForeground = view.foreground(KCS::NormalText).color();
+    const QColor windowBackground = window.background(KCS::NormalBackground).color();
+    const QColor windowForeground = window.foreground(KCS::NormalText).color();
+    const QColor negative = view.foreground(KCS::NegativeText).color();
+    const QColor neutral = view.foreground(KCS::NeutralText).color();
+    const QColor positive = view.foreground(KCS::PositiveText).color();
+
+    // A status colour that fills a button carries the view's background or
+    // its text on top, whichever of the two reads better on it
+    const auto textOn = [&viewBackground, &viewForeground](const QColor &fill) {
+        return KColorUtils::contrastRatio(fill, viewBackground) >= KColorUtils::contrastRatio(fill, viewForeground) ? viewBackground : viewForeground;
+    };
+
+    return {
+        {QStringLiteral("accent_bg_color"), selection.background(KCS::NormalBackground).color()},
+        {QStringLiteral("accent_fg_color"), selection.foreground(KCS::NormalText).color()},
+        {QStringLiteral("accent_color"), view.foreground(KCS::LinkText).color()},
+
+        {QStringLiteral("destructive_bg_color"), negative},
+        {QStringLiteral("destructive_fg_color"), textOn(negative)},
+        {QStringLiteral("destructive_color"), negative},
+        {QStringLiteral("success_bg_color"), positive},
+        {QStringLiteral("success_fg_color"), textOn(positive)},
+        {QStringLiteral("success_color"), positive},
+        {QStringLiteral("warning_bg_color"), neutral},
+        {QStringLiteral("warning_fg_color"), textOn(neutral)},
+        {QStringLiteral("warning_color"), neutral},
+        {QStringLiteral("error_bg_color"), negative},
+        {QStringLiteral("error_fg_color"), textOn(negative)},
+        {QStringLiteral("error_color"), negative},
+
+        {QStringLiteral("window_bg_color"), windowBackground},
+        {QStringLiteral("window_fg_color"), windowForeground},
+        {QStringLiteral("view_bg_color"), viewBackground},
+        {QStringLiteral("view_fg_color"), viewForeground},
+
+        {QStringLiteral("headerbar_bg_color"), header.background(KCS::NormalBackground).color()},
+        {QStringLiteral("headerbar_fg_color"), header.foreground(KCS::NormalText).color()},
+        {QStringLiteral("headerbar_border_color"), header.foreground(KCS::NormalText).color()},
+        {QStringLiteral("headerbar_backdrop_color"), inactiveHeader.background(KCS::NormalBackground).color()},
+
+        {QStringLiteral("sidebar_bg_color"), windowBackground},
+        {QStringLiteral("sidebar_fg_color"), windowForeground},
+        {QStringLiteral("sidebar_backdrop_color"), inactiveWindow.background(KCS::NormalBackground).color()},
+
+        {QStringLiteral("card_bg_color"), viewBackground},
+        {QStringLiteral("card_fg_color"), viewForeground},
+        {QStringLiteral("dialog_bg_color"), windowBackground},
+        {QStringLiteral("dialog_fg_color"), windowForeground},
+        {QStringLiteral("popover_bg_color"), windowBackground},
+        {QStringLiteral("popover_fg_color"), windowForeground},
+        {QStringLiteral("thumbnail_bg_color"), viewBackground},
+        {QStringLiteral("thumbnail_fg_color"), viewForeground},
+    };
+}
+
 qreal ConfigValueProvider::frameContrast() const
 {
     return KColorScheme::frameContrast();
