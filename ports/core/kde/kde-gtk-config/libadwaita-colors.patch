 }
 
-void modifyColorsCssFile(const QMap<QString, QColor> &colorsDefinitions)
+void modifyColorsCssFile(const QMap<QString, QColor> &colorsDefinitions, const QMap<QString, QColor> &libadwaitaColors)
 {
     for (auto gtkVersion : Utils::s_gtkVersions) {
         QString colorsCssPath = Utils::configDirPath(gtkVersion) + QStringLiteral("/colors.css");
@@ -96,6 +96,23 @@
             for (auto it = colorsDefinitions.cbegin(); it != colorsDefinitions.cend(); it++) {
                 colorsCssStream << QStringLiteral("@define-color %1 %2;\n").arg(it.key(), it.value().name());
             }
+
+            // libadwaita reads only its own names, never the Breeze ones above
+            for (auto it = libadwaitaColors.cbegin(); it != libadwaitaColors.cend(); it++) {
+                colorsCssStream << QStringLiteral("@define-color %1 %2;\n").arg(it.key(), it.value().name());
+            }
+
+            // libadwaita 1.6 and later draws every widget from CSS variables, which a named
+            // color does not reach; GTK 3 cannot parse custom properties, so only GTK 4 gets them
+            if (gtkVersion == 4 && !libadwaitaColors.isEmpty()) {
+                colorsCssStream << QStringLiteral(":root {\n");
+                for (auto it = libadwaitaColors.cbegin(); it != libadwaitaColors.cend(); it++) {
+                    QString variable = it.key();
+                    variable.replace(QLatin1Char('_'), QLatin1Char('-'));
+                    colorsCssStream << QStringLiteral("  --%1: %2;\n").arg(variable, it.value().name());
+                }
+                colorsCssStream << QStringLiteral("}\n");
+            }
         }
     }
 }
