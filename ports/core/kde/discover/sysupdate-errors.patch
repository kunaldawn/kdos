+++ b/libdiscover/backends/SystemdSysupdateBackend/SystemdSysupdateBackend.cpp
@@ -94,7 +94,6 @@ Transaction *SystemdSysupdateBackend::installApplication(AbstractResource *app)
         return nullptr;
     }
 
-    m_updater->setNeedsReboot(true);
     return resource->update();
 }
 
@@ -133,6 +132,8 @@ QCoro::Task<> SystemdSysupdateBackend::checkForUpdatesAsync()
     const auto targetsReply = co_await m_manager->ListTargets();
     if (targetsReply.isError()) {
         qCWarning(SYSTEMDSYSUPDATE_LOG) << "Failed to list targets:" << targetsReply.error().message();
+        Q_EMIT passiveMessage(xi18nc("@info:status", "Failed to list the system's update targets.<nl/><nl/>Error message: %1", targetsReply.error().message()));
+        endFetch();
         co_return;
     }
 
@@ -195,8 +196,22 @@ QCoro::Task<> SystemdSysupdateBackend::checkForUpdatesAsync()
         auto component = metadata.component();
         qCDebug(SYSTEMDSYSUPDATE_LOG) << "Component:" << component.name() << component.summary() << component.description();
 
-        QString installedVersion = co_await target->GetVersion();
-        QString availableVersion = co_await target->CheckNew();
+        // An error reply converts to its message as a QString, which would
+        // be taken for a version; an error is reported and skips the target.
+        const QDBusPendingReply<QString> installedReply = co_await target->GetVersion();
+        if (installedReply.isError()) {
+            Q_EMIT passiveMessage(
+                xi18nc("@info:status", "Failed to read the installed version of “%1”.<nl/><nl/>Error message: %2", name, installedReply.error().message()));
+            continue;
+        }
+        const QDBusPendingReply<QString> availableReply = co_await target->CheckNew();
+        if (availableReply.isError()) {
+            Q_EMIT passiveMessage(
+                xi18nc("@info:status", "Failed to check for a new version of “%1”.<nl/><nl/>Error message: %2", name, availableReply.error().message()));
+            continue;
+        }
+        const QString installedVersion = installedReply.value();
+        const QString availableVersion = availableReply.value();
         qCDebug(SYSTEMDSYSUPDATE_LOG) << "Installed version:" << installedVersion << "Available version:" << availableVersion;
 
         if (installedVersion.isEmpty()) {
diff --git a/libdiscover/backends/SystemdSysupdateBackend/SystemdSysupdateResource.cpp b/libdiscover/backends/SystemdSysupdateBackend/SystemdSysupdateResource.cpp
index b4de406..bb87597 100644
--- a/libdiscover/backends/SystemdSysupdateBackend/SystemdSysupdateResource.cpp
+++ b/libdiscover/backends/SystemdSysupdateBackend/SystemdSysupdateResource.cpp
@@ -97,24 +97,38 @@ quint64 SystemdSysupdateResource::size()
     const auto networkAccess = static_cast<SystemdSysupdateBackend *>(backend())->networkAccess();
     auto updateSizeReply = networkAccess->get(QNetworkRequest{QUrl(QStringLiteral("http://localhost:3129/v1/updatesize?version=%1").arg(availableVersion()))});
     connect(updateSizeReply, &QNetworkReply::finished, this, [this, updateSizeReply]() {
+        updateSizeReply->deleteLater();
         if (updateSizeReply->error() != QNetworkReply::NoError) {
             qWarning() << "Update size retrieval error!" << updateSizeReply->error();
             return;
         }
         auto sizeString = updateSizeReply->readAll().trimmed();
         bool ok = false;
-        m_size = sizeString.toULongLong(&ok);
+        const quint64 size = sizeString.toULongLong(&ok);
         if (!ok) {
             qCWarning(LIBDISCOVER_BACKEND_SYSTEMDSYSUPDATE_LOG) << "Failed to parse reply into uint" << sizeString;
         } else {
-            m_fetchedSize = true;
+            m_size = size;
             Q_EMIT sizeChanged();
         }
     });
+    // One request per resource, whatever it answers: a size nobody serves
+    // stays 0, which sizeDescription() shows as no size at all.
+    m_fetchedSize = true;
 
     return m_size;
 }
 
+QString SystemdSysupdateResource::sizeDescription()
+{
+    // An empty description hides the page's size row and its busy
+    // indicator, which would otherwise spin for a size nobody serves.
+    if (size() == 0) {
+        return {};
+    }
+    return AbstractResource::sizeDescription();
+}
+
 QJsonArray SystemdSysupdateResource::licenses()
 {
     return QJsonArray({m_component.projectLicense(), m_component.metadataLicense()});
