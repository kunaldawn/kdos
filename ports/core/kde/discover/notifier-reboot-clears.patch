+void SystemdSysupdateBackend::slotsPropertiesChanged(const QString &interface, const QVariantMap &changed, const QStringList &invalidated)
+{
+    if (interface != QLatin1String("io.kdos.Slots1")) {
+        return;
+    }
+    if (changed.contains(QStringLiteral("State"))) {
+        slotsStateChanged(qdbus_cast<QVariantMap>(changed.value(QStringLiteral("State"))));
+        return;
+    }
+    if (invalidated.contains(QStringLiteral("State"))) {
+        readSlotsState();
+    }
+}
+
+void SystemdSysupdateBackend::readSlotsState()
+{
+    QDBusMessage get = QDBusMessage::createMethodCall(QStringLiteral("io.kdos.Slots1"),
+                                                      QStringLiteral("/io/kdos/Slots1"),
+                                                      QStringLiteral("org.freedesktop.DBus.Properties"),
+                                                      QStringLiteral("Get"));
+    get << QStringLiteral("io.kdos.Slots1") << QStringLiteral("State");
+    auto watcher = new QDBusPendingCallWatcher(OUR_BUS().asyncCall(get), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        const QDBusPendingReply<QDBusVariant> reply = *watcher;
+        if (!reply.isError()) {
+            slotsStateChanged(qdbus_cast<QVariantMap>(reply.value().variant()));
+        }
+    });
+}
+
+// The restart follows the slots both ways. A disarmed slot withdraws the
+// restart, and the targets are read again, so the update the slot held is
+// offered on the open page. An armed one may stage it (takeStagedUpdate).
+void SystemdSysupdateBackend::slotsStateChanged(const QVariantMap &state)
+{
+    m_slotsState = state;
+    if (!state.value(QStringLiteral("rebootRequired"), true).toBool()) {
+        if (m_updater->needsReboot()) {
+            m_updater->setNeedsReboot(false);
+            checkForUpdates();
+        }
+        return;
+    }
+    takeStagedUpdate();
+}
+
+// An armed slot that holds a version newer than the one running is a staged
+// update, whoever installed it, and the page asks for the restart; an armed
+// slot of the running or an older version is a switch between versions,
+// which asks for none here. The running version is the one the last fetch
+// read from the target's GetVersion, so a State that arrives before it is
+// taken again when the fetch ends. Only the arrival is taken then: a State
+// kept from before this backend's own install would withdraw its restart.
+void SystemdSysupdateBackend::takeStagedUpdate()
+{
+    const QVariantMap &state = m_slotsState;
+    if (m_updater->needsReboot() || m_runningVersion.isEmpty() || !state.value(QStringLiteral("rebootRequired")).toBool()
+        || state.value(QStringLiteral("phase")).toString() != QLatin1String("armed")) {
+        return;
+    }
+    const QString armedVersion = state.value(QStringLiteral("version")).toString();
+    if (!armedVersion.isEmpty() && AppStream::Utils::vercmpSimple(armedVersion, m_runningVersion) > 0) {
+        m_updater->setNeedsReboot(true);
+    }
+}
