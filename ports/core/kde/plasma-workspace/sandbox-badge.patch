 namespace TaskManager
 {
+/*
+ * The sandbox a desktop entry runs its application in, from the keys the
+ * sandbox writes into the entries it exports: X-Flatpak (the application id)
+ * and X-KDOS-Box (the box). It names where a launch goes, not what a running
+ * window is; the compositor's security context is the authority for that.
+ */
+static void fillSandbox(AppData &data, const KService::Ptr &service)
+{
+    const QString flatpak = service->property<QString>(QStringLiteral("X-Flatpak"));
+    const QString box = service->property<QString>(QStringLiteral("X-KDOS-Box"));
+    if (!flatpak.isEmpty()) {
+        data.sandboxEngine = QStringLiteral("org.flatpak");
+        data.sandboxName = flatpak;
+    } else if (!box.isEmpty()) {
+        data.sandboxEngine = QStringLiteral("io.kdos.appbox");
+        data.sandboxName = box;
+    }
+}
+
 AppData appDataFromUrl(const QUrl &url, const QIcon &fallbackIcon)
 {
     AppData data;
