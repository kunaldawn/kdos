+// A component is offered only when every word of the query occurs in its
+// name, id, package name or one of its keywords: AppStream's search also
+// matches summaries and descriptions, and over a large catalogue that
+// answers almost any query with applications it does not name.
+static bool namesEveryWord(const AppStream::Component &component, const QStringList &words)
+{
+    QStringList fields{component.name().toCaseFolded(), component.id().toCaseFolded()};
+    for (const QString &package : component.packageNames())
+        fields << package.toCaseFolded();
+    for (const QString &keyword : component.keywords())
+        fields << keyword.toCaseFolded();
+    return !words.isEmpty() && std::ranges::all_of(words, [&fields](const QString &word) {
+        return std::ranges::any_of(fields, [&word](const QString &field) {
+            return field.contains(word);
+        });
+    });
+}
