+private:
+    // A scope's own processes may sit in child cgroups it made for itself, as
+    // a container engine's per-container cgroup does. Those children are
+    // counted with the scope, except a child that is a .scope or .service of
+    // its own, which the model lists as a node and counts there. The walk is
+    // bounded, so a pathological tree cannot hold a pool thread.
+    static constexpr int s_maxDepth = 8;
+    static constexpr int s_maxDescendants = 1024;
+
+    static bool readProcs(const QString &dir, QList<pid_t> &pids)
+    {
+        QFile pidFile(dir + QLatin1String("/cgroup.procs"));
+        if (!pidFile.open(QFile::ReadOnly | QIODevice::Text)) {
