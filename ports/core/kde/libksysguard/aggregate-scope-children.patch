-            QMetaObject::invokeMethod(m_context, std::bind(m_callback, pids));
+        return true;
+    }
+
+    static void readDescendants(const QString &dir, int depth, int &budget, QList<pid_t> &pids)
+    {
+        if (depth >= s_maxDepth) {
+            return;
+        }
+        const QStringList children = QDir(dir).entryList(QDir::Dirs | QDir::NoDotAndDotDot | QDir::NoSymLinks);
+        for (const QString &child : children) {
+            if (budget <= 0) {
+                return;
+            }
+            if (child.endsWith(QLatin1String(".scope")) || child.endsWith(QLatin1String(".service"))) {
+                continue;
+            }
+            --budget;
+            const QString path = dir + QLatin1Char('/') + child;
+            readProcs(path, pids);
+            readDescendants(path, depth + 1, budget, pids);
         }
     }
 
-private:
