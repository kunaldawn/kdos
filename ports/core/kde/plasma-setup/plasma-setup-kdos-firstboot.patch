+// SPDX-FileCopyrightText: 2026 KDOS
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "layoutvariantsortmodel.h"
+
+LayoutVariantSortModel::LayoutVariantSortModel(QObject *parent)
+    : QSortFilterProxyModel(parent)
+{
+    setDynamicSortFilter(true);
+    connect(this, &QAbstractProxyModel::sourceModelChanged, this, [this]() {
+        sort(0);
+    });
+}
+
+bool LayoutVariantSortModel::searching() const
+{
+    return m_searching;
+}
+
+void LayoutVariantSortModel::setSearching(bool searching)
+{
+    if (m_searching == searching) {
+        return;
+    }
+    m_searching = searching;
+    invalidate();
+    Q_EMIT searchingChanged();
+}
+
+bool LayoutVariantSortModel::lessThan(const QModelIndex &left, const QModelIndex &right) const
+{
+    // Looked up on every call: the source's roles appear only once its own source is set.
+    const auto roles = sourceModel()->roleNames();
+    const int variantNameRole = roles.key(QByteArrayLiteral("variantName"), -1);
+    const int descriptionRole = roles.key(QByteArrayLiteral("description"), -1);
+    if (variantNameRole < 0 || descriptionRole < 0) {
+        return left.row() < right.row();
+    }
+
+    const bool leftPlain = left.data(variantNameRole).toString().isEmpty();
+    const bool rightPlain = right.data(variantNameRole).toString().isEmpty();
+    if (leftPlain != rightPlain) {
+        return leftPlain;
+    }
+
+    const int searchScoreRole = roles.key(QByteArrayLiteral("searchScore"), -1);
+    if (m_searching && searchScoreRole >= 0) {
+        const int leftScore = left.data(searchScoreRole).toInt();
+        const int rightScore = right.data(searchScoreRole).toInt();
+        if (leftScore != rightScore) {
+            return leftScore > rightScore;
+        }
+    }
+
+    return QString::localeAwareCompare(left.data(descriptionRole).toString(), right.data(descriptionRole).toString()) < 0;
+}
+
