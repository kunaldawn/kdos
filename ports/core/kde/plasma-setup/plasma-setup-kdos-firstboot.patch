@@ -0,0 +1,38 @@
+// SPDX-FileCopyrightText: 2026 KDOS
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <QSortFilterProxyModel>
+#include <qqmlintegration.h>
+
+/**
+ * Orders the variants of one keyboard layout for the variant list.
+ *
+ * The row without a variant (the plain layout, e.g. "German") comes first. While
+ * searching is set the variants follow by their "searchScore", best match first, and
+ * otherwise, or between equal scores, in the order of their descriptions. The source
+ * model must provide the "variantName", "description" and "searchScore" roles of the
+ * keyboard KCM's LayoutSearchModel.
+ */
+class LayoutVariantSortModel : public QSortFilterProxyModel
+{
+    Q_OBJECT
+    QML_ELEMENT
+    Q_PROPERTY(bool searching READ searching WRITE setSearching NOTIFY searchingChanged)
+
+public:
+    explicit LayoutVariantSortModel(QObject *parent = nullptr);
+
+    bool searching() const;
+    void setSearching(bool searching);
+
+Q_SIGNALS:
+    void searchingChanged();
+
+protected:
+    bool lessThan(const QModelIndex &left, const QModelIndex &right) const override;
+
+private:
+    bool m_searching = false;
+};
