+
+QUrl InitialStartUtil::wallpaperImage(bool landscape, bool dark) const
+{
+    const KConfig config(QString::fromUtf8(PLASMA_SETUP_CONFIG_PATH), KConfig::SimpleConfig);
+    const QString name = appearanceGroup(config).readEntry("Wallpaper", u"Next"_s);
+    const QString contents = u"wallpapers/"_s + name + u"/contents/"_s;
+
+    QStringList folders;
+    if (dark) {
+        folders << contents + u"images_dark"_s;
+    }
+    folders << contents + u"images"_s;
+
+    for (const bool orientation : {landscape, !landscape}) {
+        for (const QString &folder : std::as_const(folders)) {
+            const QString dir = QStandardPaths::locate(QStandardPaths::GenericDataLocation, folder, QStandardPaths::LocateDirectory);
+            if (dir.isEmpty()) {
+                continue;
+            }
+            const QString image = largestImage(dir, orientation);
+            if (!image.isEmpty()) {
+                return QUrl::fromLocalFile(image);
+            }
+        }
+    }
+    return QUrl();
+}
