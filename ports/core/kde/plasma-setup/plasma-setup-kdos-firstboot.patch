+KConfigGroup appearanceGroup(const KConfig &config)
+{
+    return config.group(u"Appearance"_s);
+}
+
+// The image named "WxH.ext" in dir, in landscape's orientation, with the longest short side
+// (then the largest area), or an empty string. The short side decides so that an ultrawide
+// image, which a 16:9 screen crops to a strip, loses to a 16:9 one of the same height.
+QString largestImage(const QString &dir, bool landscape)
+{
+    QString best;
+    qint64 bestShort = 0;
+    qint64 bestArea = 0;
+    const auto entries = QDir(dir).entryInfoList({u"*.png"_s, u"*.jpg"_s, u"*.jpeg"_s, u"*.webp"_s}, QDir::Files);
+    for (const QFileInfo &entry : entries) {
+        const QStringList size = entry.completeBaseName().split(u'x');
+        if (size.size() != 2) {
+            continue;
+        }
+        bool widthOk = false;
+        bool heightOk = false;
+        const qint64 width = size.at(0).toLongLong(&widthOk);
+        const qint64 height = size.at(1).toLongLong(&heightOk);
+        if (!widthOk || !heightOk || width <= 0 || height <= 0 || (width >= height) != landscape) {
+            continue;
+        }
+        const qint64 shortSide = qMin(width, height);
+        if (shortSide > bestShort || (shortSide == bestShort && width * height > bestArea)) {
+            bestShort = shortSide;
+            bestArea = width * height;
+            best = entry.absoluteFilePath();
+        }
+    }
+    return best;
+}
+}
 
