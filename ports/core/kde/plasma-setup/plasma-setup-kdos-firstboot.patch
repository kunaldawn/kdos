+// SPDX-FileCopyrightText: 2026 KDOS
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <QSortFilterProxyModel>
+#include <qqmlintegration.h>
+
+/**
+ * Orders the keyboard page's layout list and the variant list of one layout.
+ *
+ * While searching is set the rows follow their "searchScore", best match first. With
+ * plainFirst set (the variant list) the row without a variant, the plain layout such as
+ * "German", comes before every variant; plainFirst is unset for the layout list. Rows are
+ * otherwise, and between equal scores, in the locale-aware order of their descriptions:
+ * the source model's own order is the XKB rules files' and is not alphabetical, and every
+ * score is 0 before a search. The source model must provide the "variantName",
+ * "description" and "searchScore" roles of the keyboard KCM's LayoutSearchModel.
+ */
+class LayoutVariantSortModel : public QSortFilterProxyModel
+{
+    Q_OBJECT
+    QML_ELEMENT
+    Q_PROPERTY(bool searching READ searching WRITE setSearching NOTIFY searchingChanged)
+    Q_PROPERTY(bool plainFirst READ plainFirst WRITE setPlainFirst NOTIFY plainFirstChanged)
+
+public:
+    explicit LayoutVariantSortModel(QObject *parent = nullptr);
+
+    bool searching() const;
+    void setSearching(bool searching);
+
+    bool plainFirst() const;
+    void setPlainFirst(bool plainFirst);
+
+Q_SIGNALS:
+    void searchingChanged();
+    void plainFirstChanged();
+
+protected:
+    bool lessThan(const QModelIndex &left, const QModelIndex &right) const override;
+
+private:
+    bool m_searching = false;
+    bool m_plainFirst = true;
+};
