Subject: Add the sandbox engine, app id and instance id of a decorated window

DecoratedWindowPrivateV5 adds sandboxEngine(), sandboxAppId() and
sandboxInstanceId(), and DecoratedWindow exposes them, with isSandboxed(),
as constant properties, so a decoration can mark the windows of a sandboxed
client (a Flatpak, a KDOS box) the way it marks a modal or kept-above one.
A compositor that implements only V4 answers empty strings.

diff -ruN a/src/decoratedwindow.cpp b/src/decoratedwindow.cpp
--- a/src/decoratedwindow.cpp	2026-10-27 16:55:47.000000000 +0530
+++ b/src/decoratedwindow.cpp	2026-10-29 03:43:12.476535623 +0530
@@ -78,6 +78,35 @@
     return false;
 }
 
+bool DecoratedWindow::isSandboxed() const
+{
+    return !sandboxEngine().isEmpty();
+}
+
+QString DecoratedWindow::sandboxEngine() const
+{
+    if (auto impl = dynamic_cast<DecoratedWindowPrivateV5 *>(d.get())) {
+        return impl->sandboxEngine();
+    }
+    return QString();
+}
+
+QString DecoratedWindow::sandboxAppId() const
+{
+    if (auto impl = dynamic_cast<DecoratedWindowPrivateV5 *>(d.get())) {
+        return impl->sandboxAppId();
+    }
+    return QString();
+}
+
+QString DecoratedWindow::sandboxInstanceId() const
+{
+    if (auto impl = dynamic_cast<DecoratedWindowPrivateV5 *>(d.get())) {
+        return impl->sandboxInstanceId();
+    }
+    return QString();
+}
+
 bool DecoratedWindow::isCloseable() const
 {
     return d->isCloseable();
