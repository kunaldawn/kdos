+    // A page named on the command line: one of Welcome Center's own pages,
+    // else a distro page of that name, else the error page for an unknown one
+    function _createNamedPage(page) {
+        var error = "";
+        var warnStrings = "";
+
+        let tryPage = function(page) {
+            let component = Qt.createComponent(page);
+            if (component.status !== Component.Error) {
+                return component.createObject(null);
+            } else {
+                error += component.errorString();
+                warnStrings += ((warnStrings.length > 0) ? "\n" : "")
+                                + "Couldn't load page '" + page + "'" + "\n" + "  " + component.errorString();
+                component.destroy();
+                return null;
+            }
+        }
+
+        // Try as both a regular page and distro page
+        let object = tryPage(page);
+        if (object === null) {
+            object = tryPage("file://" + Private.App.distroPagesDir + page);
+        }
+        if (object === null) {
+            console.warn(warnStrings);
+            object = _createErrorPage(error, false, true);
+        }
+        return object;
+    }
+
+    // Pages a second instance asks for open as layers over whatever this
+    // window shows, so Back returns to it; asking again replaces them. A
+    // window that is itself a run of exactly those pages is only raised.
+    Connections {
+        target: Private.App
+
