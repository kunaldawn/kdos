+    // Every row is read from kglobalaccel, so the card names only chords this
+    // machine binds: an action with no chord loses its row, and a rebound
+    // action shows its new chord. A row keeps only the chords that start with
+    // Meta, the key the card is about, so Print or Alt+F1 never appear; the
+    // launcher's row keeps the Meta key alone, which is the whole of its
+    // chord. kglobalaccel hands chords back in no stable order, so they are
+    // sorted, shortest first, to give a row the same text every session.
+    function chords(component, action, keepBareMeta) {
+        return Welcome.Utils.globalShortcutTexts(component, action)
+            .filter(text => text.startsWith("Meta+") || (keepBareMeta && text === "Meta"))
+            .sort((a, b) => a.length - b.length || a.localeCompare(b));
+    }
+
+    function firstChords(component, actions) {
+        const found = [];
+        for (const action of actions) {
+            const texts = chords(component, action, false);
+            if (texts.length > 0) {
+                found.push(texts[0]);
+            }
+        }
+        return found;
+    }
+
+    function chordModel() {
+        const rows = [];
+        const add = (texts, what) => {
+            if (texts.length > 0) {
+                rows.push({ keys: texts.join(", "), what: what });
+            }
+        };
+
+        add(chords("plasmashell", "activate application launcher", true),
+            i18nc("@info:usagetip", "Open the Application Launcher widget"));
+        add(firstChords("kwin", ["Window Quick Tile Left", "Window Quick Tile Right",
+                                 "Window Quick Tile Top", "Window Quick Tile Bottom"]),
+            i18nc("@info:usagetip", "Tile window to screen edges or corners"));
+
+        // Entries 1 to 9 only: entry 10 is Meta+0, which would end the run
+        // on a key that reads as lower than where it starts.
+        const entries = firstChords("plasmashell",
+            [1, 2, 3, 4, 5, 6, 7, 8, 9].map(n => "activate task manager entry " + n));
+        add(entries.length > 2
+                ? [i18nc("@info:usagetip %1 is the first keyboard shortcut of a run, %2 the last", "%1 to %2",
+                         entries[0], entries[entries.length - 1])]
+                : entries,
+            i18nc("@info:usagetip", "Launch pinned Task Manager apps"));
+
+        add(chords("org.kde.spectacle.desktop", "RecordRegion", false),
+            i18nc("@info:usagetip", "Record a region of the screen"));
+        add(chords("ksmserver", "Lock Session", false),
+            i18nc("@info:usagetip", "Lock the screen"));
+        add(chords("org.kde.screenreader.desktop", "toggleScreenReader", false),
+            i18nc("@info:usagetip", "Toggle screen reader on/off"));
+        add(chords("plasmashell", "cycle-panels", false),
