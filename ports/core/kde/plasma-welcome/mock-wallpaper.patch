Subject: Mocks: draw the global theme's wallpaper instead of Next

The mock desktops of Simple by Default, Powerful When Needed and the
update page draw /usr/share/wallpapers/Next whatever the session uses,
so a distribution whose global theme names its own wallpaper shows a
tour of a desktop it does not ship. App gains defaultWallpaper: the
image the global theme in use names in its defaults ([Wallpaper] Image),
its images_dark variant under a dark colour scheme as the image
wallpaper chooses, the largest landscape size; Next when the theme
names none that is installed.

diff --git a/src/app.cpp b/src/app.cpp
index bd1d353..b129891 100644
--- a/src/app.cpp
+++ b/src/app.cpp
@@ -7,8 +7,14 @@
  */
 
 #include <QDir>
+#include <QGuiApplication>
+#include <QImageReader>
+#include <QPalette>
+#include <QStandardPaths>
 
 #include <KAuthorized>
+#include <KConfig>
+#include <KConfigGroup>
 #include <KDesktopFile>
 #include <KOSRelease>
 #include <KPluginMetaData>
@@ -52,6 +58,57 @@ QString App::installPrefix() const
     return QString::fromLatin1(PLASMA_WELCOME_INSTALL_DIR);
 }
 
+QString App::defaultWallpaper() const
+{
+    const QString fallback = QStringLiteral("file:") + installPrefix() + QStringLiteral("/share/wallpapers/Next/contents/images/5120x2880.png");
+
+    const KConfig globals(QStringLiteral("kdeglobals"));
+    const QString lookAndFeel = globals.group(QStringLiteral("KDE")).readEntry("LookAndFeelPackage", QStringLiteral("org.kde.breeze.desktop"));
+    const QString defaults =
+        QStandardPaths::locate(QStandardPaths::GenericDataLocation, QStringLiteral("plasma/look-and-feel/") + lookAndFeel + QStringLiteral("/contents/defaults"));
+    if (defaults.isEmpty()) {
+        return fallback;
+    }
+    const QString image = KConfig(defaults, KConfig::SimpleConfig).group(QStringLiteral("Wallpaper")).readEntry("Image", QString());
+    if (image.isEmpty()) {
+        return fallback;
+    }
+    const QString package = QDir::isAbsolutePath(image)
+        ? image
+        : QStandardPaths::locate(QStandardPaths::GenericDataLocation, QStringLiteral("wallpapers/") + image, QStandardPaths::LocateDirectory);
+    if (package.isEmpty()) {
+        return fallback;
+    }
+
+    // As Plasma's image wallpaper: images_dark under a dark colour scheme
+    // when the package has it, and of the landscape sizes the largest.
+    const bool dark = qGuiApp && qGuiApp->palette().color(QPalette::Window).lightness() < 128;
+    QStringList dirs{package + QStringLiteral("/contents/images")};
+    if (dark) {
+        dirs.prepend(package + QStringLiteral("/contents/images_dark"));
+    }
+    for (const QString &dirname : std::as_const(dirs)) {
+        QString best;
+        qint64 bestArea = 0;
+        const QFileInfoList files = QDir(dirname).entryInfoList(QDir::Files | QDir::Readable, QDir::Name);
+        for (const QFileInfo &file : files) {
+            const QSize size = QImageReader(file.absoluteFilePath()).size();
+            if (size.width() < size.height()) {
+                continue;
+            }
+            const qint64 area = qint64(size.width()) * size.height();
+            if (area > bestArea) {
+                bestArea = area;
+                best = file.absoluteFilePath();
+            }
+        }
+        if (!best.isEmpty()) {
+            return QStringLiteral("file:") + best;
+        }
+    }
+    return fallback;
+}
