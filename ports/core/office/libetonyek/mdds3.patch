Subject: call flat_segment_tree::valid_tree() in IWORKTable.cpp

mdds 3's flat_segment_tree has valid_tree() and no is_tree_valid(), which
IWORKTable.cpp calls, so the file does not compile against mdds 3.
From Alpine community/libetonyek.

--- a/src/lib/IWORKTable.cpp	2024-11-05 15:56:01.000000000 -0600
+++ b/src/lib/IWORKTable.cpp	2025-02-07 14:50:09.040442328 -0600
@@ -168,7 +168,7 @@
 
 void writeBorder(librevenge::RVNGPropertyList &props, const char *name, IWORKGridLine_t &line, unsigned index)
 {
-  if (!line.is_tree_valid())
+  if (!line.valid_tree())
     line.build_tree();
 
   IWORKStylePtr_t style;
