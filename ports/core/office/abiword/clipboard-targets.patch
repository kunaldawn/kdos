 /*!
+  The length of a buffer IE_Exp::copyToBuffer filled, without the NUL
+  it ends the buffer with: the NUL is not part of the format, and a
+  program that pastes the text receives it as a control character.
+*/
+static UT_uint32 s_lengthWithoutNul(const UT_ByteBuf & buf)
+{
+	UT_uint32 len = buf.getLength();
+	if (len > 0 && *buf.getPointer(len - 1) == 0)
+		len--;
+	return len;
+}
