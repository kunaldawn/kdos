+/*!
+  Empty the internal copy of one selection before a copy adds its
+  formats, leaving the selection itself owned: a format left from an
+  earlier copy would otherwise be offered with that copy's data.
+*/
+void XAP_UnixClipboard::beginAddingData(T_AllowGet tTo)
+{
+	if (tTo == TAG_PrimaryOnly)
+		m_fakePrimaryClipboard.clearClipboard();
+	else
+		m_fakeClipboard.clearClipboard();
+}
+
+/*!
+  Offer CLIPBOARD in the formats the internal copy holds, not every
+  format AbiWord can read: a format offered with no data reaches a
+  clipboard manager as an empty entry.
+*/
 void XAP_UnixClipboard::finishedAddingData(void)
 {
+  GtkTargetEntry * targets = g_new0(GtkTargetEntry, m_nTargets ? m_nTargets : 1);
+  guint nTargets = 0;
+
+  for (UT_uint32 k = 0; k < m_nTargets; k++)
+    if (m_fakeClipboard.hasFormat(m_Targets[k].target))
+      targets[nTargets++] = m_Targets[k];
+
   gtk_clipboard_set_with_data (gtkClipboardForTarget(TAG_ClipboardOnly),
-			       m_Targets,
-			       m_nTargets,
+			       targets,
+			       nTargets,
 			       s_clipboard_get_func,
 			       s_clipboard_clear_func,
 			       this);
 
-  gtk_clipboard_set_can_store (gtkClipboardForTarget(TAG_ClipboardOnly), m_Targets, m_nTargets);
+  gtk_clipboard_set_can_store (gtkClipboardForTarget(TAG_ClipboardOnly), targets, nTargets);
+  g_free(targets);
 }
 
 void XAP_UnixClipboard::clearData(bool bClipboard, bool bPrimary)
