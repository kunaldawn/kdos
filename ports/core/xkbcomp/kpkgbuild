# description	: XKB keymap compiler, invoked by Xwayland at runtime
# homepage	: https://gitlab.freedesktop.org/xorg/app/xkbcomp
# depends	: libX11 libxkbfile xkeyboard-config

name=xkbcomp
version=1.5.0
release=1
source="https://www.x.org/releases/individual/app/$name-$version.tar.xz"

build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--with-xkb-config-root=/usr/share/X11/xkb
	make
	make DESTDIR=$PKG install
}
