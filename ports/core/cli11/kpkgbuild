# description	: Header-only command-line parser for C++ (Quickshell build dep)
# homepage	: https://github.com/CLIUtils/CLI11
# depends	: cmake

name=cli11
version=2.4.2
release=1
source="https://github.com/CLIUtils/CLI11/archive/refs/tags/v$version.tar.gz"

build() {
	mkdir -p build
	cd build
	cmake .. \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCLI11_BUILD_TESTS=OFF \
		-DCLI11_BUILD_EXAMPLES=OFF
	make
	make DESTDIR=$PKG install
}
