# description	: Core X11 client-side library
# homepage	: https://gitlab.freedesktop.org/xorg/lib/libX11
# depends	: libxcb xtrans xorgproto

name=libX11
version=1.8.13
release=1
source="https://www.x.org/releases/individual/lib/$name-$version.tar.xz"

build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--disable-static
	make
	make DESTDIR=$PKG install
}
