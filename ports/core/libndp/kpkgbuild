# description	: IPv6 Neighbor Discovery Protocol library (NetworkManager dep)
# homepage	: https://github.com/jpirko/libndp

name=libndp
version=1.9
release=1
source="https://github.com/jpirko/libndp/archive/refs/tags/v$version.tar.gz"

build() {
	export CFLAGS="$CFLAGS -Wno-incompatible-pointer-types"
	./autogen.sh
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--disable-static
	make
	make DESTDIR=$PKG install
}
