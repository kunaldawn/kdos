# description	: Window Maker — NeXTSTEP-style stacking window manager
# homepage	: https://www.windowmaker.org/
# depends	: libx11 libxext libxft libxmu libxpm libxrandr libxrender libxinerama libxfixes
# depends	: fontconfig freetype2 libpng libjpeg-turbo libtiff giflib libwebp

name=wmaker
version=0.96.0
release=1
source="https://github.com/window-maker/wmaker/archive/refs/tags/wmaker-$version.tar.gz"

build() {
	./autogen.sh
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--with-pixmapdir=/usr/share/pixmaps \
		--with-gnustepdir=/usr/lib/GNUstep \
		--enable-modelock \
		--enable-xrandr \
		--enable-xinerama \
		--enable-randr \
		--enable-usermenu \
		--enable-mwm-hints \
		--disable-nls
	make
	make DESTDIR=$PKG install
}
