# description	: X transport library (headers only, build-time)
# homepage	: https://gitlab.freedesktop.org/xorg/lib/xtrans
# depends	: 

name=xtrans
version=1.6.0
release=1
source="https://www.x.org/releases/individual/lib/$name-$version.tar.xz"

build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--disable-static
	make
	make DESTDIR=$PKG install
}
