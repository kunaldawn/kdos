# description	: Qt 6 Qt5Compat module — legacy QML APIs (GraphicalEffects etc.)
# homepage	: https://www.qt.io/
# depends	: cmake ninja qt6-base qt6-declarative

name=qt6-5compat
version=6.8.3
release=1
source="https://download.qt.io/archive/qt/${version%.*}/${version}/submodules/qt5compat-everywhere-src-${version}.tar.xz"

build() {
	mkdir -p build
	cd build
	cmake .. \
		-GNinja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DQT_BUILD_TESTS=OFF \
		-DQT_BUILD_EXAMPLES=OFF \
		-DQT_GENERATE_SBOM=OFF
	ninja
	DESTDIR=$PKG ninja install
}
