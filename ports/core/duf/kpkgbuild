# description	: duf — Disk Usage / Free utility (better df)
# homepage	: https://github.com/muesli/duf
# depends	: go

name=duf
version=0.9.1
release=1
source="https://github.com/muesli/duf/archive/v$version.tar.gz"
vendoring=go

build() {
	tar xf $PORT_SRC/${name}-vendor-${version}.tar.xz

	export CGO_ENABLED=0
	go build -ldflags "-s -w -X main.Version=$version" -o duf
	install -Dm755 duf $PKG/usr/bin/duf
}
