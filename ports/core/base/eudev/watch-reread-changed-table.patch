+#ifdef HAVE_BLKID
+/*
+ * Compare the partition table on the disk with the partitions the kernel
+ * holds, by number, start and size, all in 512-byte sectors. An extended
+ * partition is compared by start alone: the kernel gives it a size of one
+ * or two sectors. Any probe error counts as a difference. The probe opens
+ * the node read-only, so its close raises no new watch event.
+ */
+static bool disk_table_matches_kernel(const char *devnode, struct udev *udev, struct udev_enumerate *e) {
+        blkid_probe pr;
+        blkid_partlist pl;
+        struct udev_list_entry *item;
+        int nblkid = 0, nkernel = 0;
+        bool match = false;
+
+        pr = blkid_new_probe_from_filename(devnode);
+        if (!pr)
+                return false;
+
+        if (blkid_probe_enable_superblocks(pr, 0) < 0 ||
+            blkid_probe_enable_partitions(pr, 1) < 0)
+                goto out;
+
+        pl = blkid_probe_get_partitions(pr);
+        if (pl) {
+                nblkid = blkid_partlist_numof_partitions(pl);
+                if (nblkid < 0)
+                        goto out;
+        }
+
+        udev_list_entry_foreach(item, udev_enumerate_get_list_entry(e)) {
+                _cleanup_udev_device_unref_ struct udev_device *d = NULL;
+                blkid_partition par;
+                const char *v;
+                unsigned long long start, size;
+                int partno;
+
+                d = udev_device_new_from_syspath(udev, udev_list_entry_get_name(item));
+                if (!d)
+                        goto out;
+
+                if (!streq_ptr("partition", udev_device_get_devtype(d)))
+                        continue;
+
+                nkernel++;
+                if (!pl)
+                        goto out;
+
+                v = udev_device_get_sysattr_value(d, "partition");
+                if (!v || safe_atoi(v, &partno) < 0)
+                        goto out;
+                v = udev_device_get_sysattr_value(d, "start");
+                if (!v || safe_atollu(v, &start) < 0)
+                        goto out;
+                v = udev_device_get_sysattr_value(d, "size");
+                if (!v || safe_atollu(v, &size) < 0)
+                        goto out;
+
+                par = blkid_partlist_get_partition_by_partno(pl, partno);
+                if (!par)
+                        goto out;
+                if ((unsigned long long) blkid_partition_get_start(par) != start)
+                        goto out;
+                if (!blkid_partition_is_extended(par) &&
+                    (unsigned long long) blkid_partition_get_size(par) != size)
+                        goto out;
+        }
+
+        match = nkernel == nblkid;
+out:
+        blkid_free_probe(pr);
+        return match;
+}
+#endif
+
 static int synthesize_change(struct udev_device *dev) {
         char filename[UTIL_PATH_SIZE];
         int r;
