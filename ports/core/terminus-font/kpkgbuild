# description	: Monospace bitmap console font
# depends	: python3

name=terminus-font
version=4.49.1
release=1
source="https://downloads.sourceforge.net/project/$name/$name-${version%.1}/$name-$version.tar.gz"

build() {
	./configure \
		--prefix=/usr \
		--psfdir=/usr/share/consolefonts
	make psf
	make DESTDIR=$PKG install-psf
}
