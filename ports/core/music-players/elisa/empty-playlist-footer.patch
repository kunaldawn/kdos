+++ b/src/progressindicator.cpp
@@ -10,7 +10,24 @@
 
 using namespace Qt::StringLiterals;
 
-ProgressIndicator::ProgressIndicator(QObject *parent) : QObject(parent)
+static QString formatDuration(int position)
+{
+    int totalNumberOfSeconds = position / 1000;
+    int seconds = totalNumberOfSeconds % 60;
+    int minutes = (totalNumberOfSeconds / 60) % 60;
+    int hours = (totalNumberOfSeconds / 60 / 60);
+
+    QString hoursString = u"%1"_s.arg(hours, 2, 10, '0'_L1);
+    QString minutesString = u"%1"_s.arg(minutes, 2, 10, '0'_L1);
+    QString secondsString = u"%1"_s.arg(seconds, 2, 10, '0'_L1);
+
+    if (hours == 0) {
+        return i18nc("duration formatted as minutes:seconds", "%1:%2", minutesString, secondsString);
+    }
+    return i18nc("duration formatted as hours:minutes:seconds", "%1:%2:%3", hoursString, minutesString, secondsString);
+}
+
+ProgressIndicator::ProgressIndicator(QObject *parent) : QObject(parent), mProgressDuration(formatDuration(mPosition))
 {
 }
 
