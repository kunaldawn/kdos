# description	: MuPDF — fast, small PDF / XPS / EPUB / CBZ viewer with its own X frontend
# homepage	: https://mupdf.com/
# depends	: freetype2 harfbuzz libjpeg-turbo brotli zlib openssl curl libx11 libxext libxrandr libxi

name=mupdf
version=1.27.2
release=1
source="https://github.com/ArtifexSoftware/mupdf-downloads/releases/download/$version/mupdf-$version-source.tar.gz"

build() {
	# USE_SYSTEM_LIBS=yes makes mupdf link against host freetype/harfbuzz/
	# libjpeg/zlib/brotli. gumbo/jbig2dec/openjpeg aren't packaged in kdos,
	# so override those to use the bundled copies in thirdparty/.
	#
	# HAVE_GLUT=no disables the GL viewer (would need freeglut). The
	# X11 viewer (mupdf-x11) builds fine from libx11 alone.
	local sys="USE_SYSTEM_LIBS=yes \
		USE_SYSTEM_GUMBO=no \
		USE_SYSTEM_JBIG2DEC=no \
		USE_SYSTEM_OPENJPEG=no \
		HAVE_GLUT=no"
	make $sys verbose=yes prefix=/usr build=release
	make $sys verbose=yes prefix=/usr DESTDIR=$PKG install
}
