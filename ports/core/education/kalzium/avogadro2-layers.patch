+void KalziumGLWidget::setMolecule(Avogadro::QtGui::Molecule *molecule)
+{
+    if (molecule) {
+        m_layerModel->addMolecule(molecule);
+    }
+    Avogadro::QtOpenGL::GLWidget::setMolecule(molecule);
+    applySceneStyle();
+    updateScene();
+}
+
+void KalziumGLWidget::setSceneStyle(const QString &name)
+{
+    m_sceneStyle = name;
+    applySceneStyle();
+    updateScene();
+}
+
+void KalziumGLWidget::applySceneStyle()
+{
+    const auto plugins = sceneModel().scenePlugins();
+    for (auto *plugin : plugins) {
+        plugin->setEnabled(plugin->name() == m_sceneStyle);
+    }
+}
+
+// The scene's own background is transparent black, which a Wayland
+// surface with alpha composites as a hole in the window; the view takes
+// the palette's opaque base colour instead.
+void KalziumGLWidget::applyBackground()
+{
+    const QColor base = palette().color(QPalette::Base);
+    renderer().scene().setBackgroundColor(Avogadro::Vector4ub(base.red(), base.green(), base.blue(), 255));
+}
+
+void KalziumGLWidget::changeEvent(QEvent *event)
+{
+    Avogadro::QtOpenGL::GLWidget::changeEvent(event);
+    if (event->type() == QEvent::PaletteChange) {
+        applyBackground();
+        update();
+    }
+}
+
