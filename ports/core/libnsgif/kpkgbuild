# description	: NetSurf GIF decoding library (used by imv for animated GIF support)
# homepage	: https://www.netsurf-browser.org/projects/libnsgif/
# depends	: buildsystem

name=libnsgif
version=0.2.1
release=1
source="https://download.netsurf-browser.org/libs/releases/libnsgif-$version-src.tar.gz"

build() {
	export NSSHARED=/usr/share/netsurf-buildsystem
	make COMPONENT_TYPE=lib-shared PREFIX=/usr LIBDIR=lib
	make install COMPONENT_TYPE=lib-shared PREFIX=/usr LIBDIR=lib DESTDIR=$PKG
}
