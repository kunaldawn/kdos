# description	: wmnet — Window Maker dock applet displaying network throughput
# homepage	: https://www.dockapps.net/wmnet
# depends	: libx11 libxext

name=wmnet
version=1.06
release=1
source="https://www.dockapps.net/download/wmnet-$version.tar.gz"

build() {
	# wmnet 1.06 ships only an Imakefile (dead build system); compile
	# the two C sources directly. Linux drivers selected via -Dlinux.
	#
	# Disable the 2.0/2.1-kernel-era drivers (PPP via net/ppp_defs.h,
	# ipfwadm, ipchains) — those headers don't exist on musl and the
	# code paths are ~25 years obsolete. /proc/net/dev (USE_2_1_DEV)
	# covers every modern interface.
	sed -i \
		-e 's|^#define USE_LINUX_PPP|/* & */|' \
		-e 's|^#define USE_IPFWADM|/* & */|' \
		-e 's|^#define USE_IPCHAINS|/* & */|' \
		config.h

	cc $CFLAGS -Dlinux -Dlinux_libc6 \
		-o wmnet wmnet.c drivers.c \
		-lX11 -lXext -lm
	install -Dm755 wmnet $PKG/usr/bin/wmnet
	install -Dm644 wmnet.man $PKG/usr/share/man/man1/wmnet.1
}
