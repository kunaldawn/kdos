# description	: X protocol XML descriptions (build-time)
# homepage	: https://xcb.freedesktop.org/
# depends	: python3

name=xcb-proto
version=1.17.0
release=1
source="https://www.x.org/releases/individual/xcb/$name-$version.tar.xz"

build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--disable-static
	make
	make DESTDIR=$PKG install
}
