# description	: Image viewer for Wayland (and X) — successor to nsxiv on Wayland
# homepage	: https://sr.ht/~exec64/imv
# depends	: meson pkgconf wayland wayland-protocols libxkbcommon mesa fontconfig pango cairo libpng libjpeg-turbo libtiff giflib libwebp

name=imv
version=4.5.0
release=1
source="https://git.sr.ht/~exec64/imv/archive/v$version.tar.gz"

build() {
	make CONFIGPREFIX=/etc PREFIX=/usr WINDOWS=wayland
	make CONFIGPREFIX=/etc PREFIX=/usr DESTDIR=$PKG install
}
