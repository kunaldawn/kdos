+// A help: path names a page of a handbook under doc/HTML/<language>/ in the generic data
+// directories. Return that page as a file: URL, with the help: URL's fragment, when it is an HTML
+// file installed there in the user's language or in English; otherwise an invalid URL. A path
+// with a ".." component is refused, so a help: URL can only name a file under doc/HTML.
+static QUrl localHtmlPage(const QUrl &url)
+{
+    const QString rawPath = url.path();
+    if (!rawPath.startsWith(QLatin1Char('/')) || rawPath.split(QLatin1Char('/')).contains(QLatin1String(".."))) {
+        return {};
+    }
+
+    QString path = QDir::cleanPath(rawPath);
+    if (path == QLatin1Char('/')) {
+        path += QCoreApplication::applicationName() + QLatin1String("/index.html");
+    } else if (rawPath.endsWith(QLatin1Char('/'))) {
+        path += QLatin1String("/index.html");
+    }
+    if (!path.endsWith(QLatin1String(".html"))) {
+        return {};
+    }
+
+    QStringList languages;
+    const QStringList uiLanguages = QLocale().uiLanguages();
+    for (const QString &uiLanguage : uiLanguages) {
+        QString language = uiLanguage;
+        language.replace(QLatin1Char('-'), QLatin1Char('_'));
+        languages << language << language.section(QLatin1Char('_'), 0, 0);
+    }
+    languages << QStringLiteral("en");
+    languages.removeDuplicates();
+
+    for (const QString &language : std::as_const(languages)) {
+        const QString file = QStandardPaths::locate(QStandardPaths::GenericDataLocation, QLatin1String("doc/HTML/") + language + path);
+        if (!file.isEmpty()) {
+            QUrl page = QUrl::fromLocalFile(file);
+            page.setFragment(url.fragment());
+            return page;
+        }
+    }
+
+    return {};
+}
