# description	: Userspace library for low-level interaction with nf_tables (nftables dep)
# homepage	: https://netfilter.org/projects/libnftnl/
# depends	: libmnl

name=libnftnl
version=1.3.1
release=1
source="https://www.netfilter.org/pub/libnftnl/libnftnl-$version.tar.xz"

build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--disable-static
	make
	make DESTDIR=$PKG install
}
