name=dnsmasq
version=2.92
release=1
source="https://thekelleys.org.uk/dnsmasq/dnsmasq-$version.tar.xz"

build() {
	make PREFIX=/usr CONFFILE=/etc/dnsmasq.conf
	make PREFIX=/usr CONFFILE=/etc/dnsmasq.conf DESTDIR=$PKG install
}
