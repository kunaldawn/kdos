Subject: Import settings without wxPython, for the console client

--- a/printrun/settings.py
+++ b/printrun/settings.py
@@ -20,10 +20,24 @@
 
 from functools import wraps
 
-import wx
 from pathlib import Path
 from .utils import parse_build_dimensions, check_rgb_color, check_rgba_color
-from .gui.widgets import get_space
+
+# wx IS A GUI DEPENDENCY AND THIS MODULE IS ON THE CONSOLE PATH. pronsole
+# imports Settings from here, so anything this module evaluates at import
+# time must not need wx, or the terminal client refuses to start on a machine
+# with no wxPython. Every use of wx and get_space is inside a method that
+# builds a widget, ComboSetting's default width included, which is worked out
+# when its widget is built rather than as a default argument: a GUI build
+# reaches each exactly as before, and a console session never does.
+try:
+    import wx
+    from .gui.widgets import get_space
+except ImportError:
+    wx = None
+
+    def get_space(*args, **kwargs):
+        raise ImportError('wxPython is required to build settings widgets')
 
