# description	: Open-source SSL VPN solution (full-featured tunnel + OS bridge)
# homepage	: https://openvpn.net/
# depends	: openssl lzo lz4 libcap-ng

name=openvpn
version=2.6.20
release=1
source="https://swupdate.openvpn.org/community/releases/openvpn-$version.tar.gz"

build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--with-crypto-library=openssl \
		--enable-systemd=no \
		--disable-plugin-auth-pam \
		--disable-debug
	make
	make DESTDIR=$PKG install
}
