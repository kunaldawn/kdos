# description	: direnv — unclutter your .profile, load env per directory
# homepage	: https://direnv.net/
# depends	: go

name=direnv
version=2.37.1
release=1
source="https://github.com/direnv/direnv/archive/v$version.tar.gz"
vendoring=go

build() {
	tar xf $PORT_SRC/${name}-vendor-${version}.tar.xz

	export CGO_ENABLED=0
	make
	make DESTDIR=$PKG PREFIX=/usr install
}
