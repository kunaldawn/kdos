+// The name krdpserver's KDBusService owns: its organisation domain reversed
+// and its application name.
+static const QString dbusKrdpServerName = u"org.kde.krdp-server"_s;
+static const QString krdpServerDesktopFile = u"org.kde.krdpserver.desktop"_s;
+
+// Without a systemd user manager on the session bus the page runs krdpserver
+// itself: it starts the program, stops it through the D-Bus name it owns,
+// reads its state from that name and starts it at login with an autostart
+// entry.
+static bool systemdAvailable()
+{
+    static const bool available = QDBusConnection::sessionBus().interface()->isServiceRegistered(u"org.freedesktop.systemd1"_s);
+    return available;
+}
 
