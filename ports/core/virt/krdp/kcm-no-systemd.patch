+void KRDPServerConfig::startServerProcess()
+{
+    const QString program = QStandardPaths::findExecutable(u"krdpserver"_s);
+    if (program.isEmpty() || !QProcess::startDetached(program, {})) {
+        qCWarning(KRDPKCM) << "Could not start krdpserver";
+        setServerStatus(SystemdService::Status::Failed);
+    }
+}
+
+void KRDPServerConfig::quitServerProcess()
+{
+    auto msg = QDBusMessage::createMethodCall(dbusKrdpServerName, u"/MainApplication"_s, u"org.qtproject.Qt.QCoreApplication"_s, u"quit"_s);
+    QDBusConnection::sessionBus().asyncCall(msg);
 }
 
 void KRDPServerConfig::toggleAutoconnect(const bool enabled)
 {
+    if (!systemdAvailable()) {
+        const QString autostartDir = QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation) + u"/autostart"_s;
+        const QString entry = autostartDir + u'/' + krdpServerDesktopFile;
+        QFile::remove(entry);
+        if (enabled) {
+            const QString source = QStandardPaths::locate(QStandardPaths::ApplicationsLocation, krdpServerDesktopFile);
+            if (source.isEmpty() || !QDir().mkpath(autostartDir) || !QFile::copy(source, entry)) {
+                qCWarning(KRDPKCM) << "Could not write the autostart entry" << entry;
+            }
+            createRestoreToken();
+        }
+        return;
+    }
+
