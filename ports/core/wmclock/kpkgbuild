# description	: wmclock — Window Maker dock applet showing date and time
# homepage	: https://www.dockapps.net/wmclock
# depends	: libx11 libxext libxpm

name=wmclock
version=1.0.16
release=1
source="https://www.dockapps.net/download/wmclock-$version.tar.gz"

build() {
	autoreconf -fi
	./configure --prefix=/usr --mandir=/usr/share/man
	make
	make DESTDIR=$PKG install
}
