# ██╗  ██╗██████╗  ██████╗ ███████╗
# ██║ ██╔╝██╔══██╗██╔═══██╗██╔════╝
# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   ports/Containerfile.fetch — the toolchains vendoring needs
# ---------------------------------
#
# `ports/fetch` downloads tarballs, which needs nothing, and VENDORS rust, go,
# node and python dependency trees, which needs each of those toolchains. This
# carries them so the developer's machine does not have to.
#
# THE VERSIONS ARE THE TREE'S OWN, passed in as build args from the recipes in
# ports/core. A vendor bundle is resolved by the toolchain that produces it: a
# cargo newer than the one that will compile the port can write a lockfile
# version the target's cargo refuses, and a `go mod vendor` from a newer go can
# record a module graph the target's go rejects. Pinning here is what keeps the
# bundle and the compiler in step.
#
# cmake AND ninja-build ARE HERE BECAUSE PIP BUILDS METADATA WHILE DOWNLOADING.
# `pip download --no-binary :all:` runs each sdist's build backend to get its
# metadata, and a backend that wants cmake and cannot find one on PATH resolves
# it as the PyPI `cmake` package — which is CMake's whole source tree, compiled
# from scratch, inside a step that is supposed to be downloading. It then fails
# and the bundle comes out empty. The target's cmake and ninja are ports; these
# exist only so the download step never reaches for PyPI's copies. patchelf is
# there for the same reason one level along: scikit-build-core asks for it when
# it is not on PATH, and the PyPI `patchelf` package is patchelf's own source
# tree with an autotools build inside it.
#
# python3-dev, libffi-dev AND libssl-dev ARE HERE FOR THE SAME REASON, one
# level down: a
# package that depends on cffi or cryptography makes pip resolve THEIR sdists
# too, and building their metadata compiles against those headers. The target's
# libffi and openssl are ports; these exist only so a download resolves.

FROM debian:trixie-slim

ARG RUST_VERSION
ARG GO_VERSION
ARG NODE_VERSION

RUN apt-get -o APT::Update::Error-Mode=any update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl wget git \
        build-essential pkg-config \
        python3 python3-pip python3-venv python3-dev \
        tar xz-utils bzip2 zstd unzip \
        cmake ninja-build patchelf libffi-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
RUN curl -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile minimal \
                 --default-toolchain "${RUST_VERSION}" \
    && chmod -R a+rwX /opt/rustup /opt/cargo

RUN curl -sSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
      | tar -xz -C /usr/local

RUN curl -sSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1

ENV PATH=/opt/cargo/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin

# A container runs as the CALLER's uid so the tarballs it writes are the
# caller's. That uid has no passwd entry and no writable home, and cargo, go
# and npm all want one — `ports/fetch` points HOME, CARGO_HOME and GOPATH at a
# scratch directory for exactly that reason.
WORKDIR /kdos
