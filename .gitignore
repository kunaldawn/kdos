# █████╔╝ ██║  ██║██║   ██║███████╗
# ██╔═██╗ ██║  ██║██║   ██║╚════██║
# ██║  ██╗██████╔╝╚██████╔╝███████║
# ╚═╝  ╚═╝╚═════╝  ╚═════╝ ╚══════╝
# ---------------------------------
#   KD's Homebrew Linux Distro
# ---------------------------------

# Anchored: an unanchored build/ would match a directory of that name anywhere
# in the tree and hide its sources from git.
/build/
/build_test/

# Host-built recipe reader (src_kpkg_ensure in ports/srclib.sh compiles it
# for ports/fetch and ports/publish to read kpkgbuild files, which are not
# shell and cannot be sourced). Its basename must be
# literally "kpkg" for kdos-kpkg's own basename dispatch to resolve it, hence
# the dedicated directory rather than a bare ports/.kpkg-meta file.
ports/.kpkg-meta
ports/.kpkgbin/
# Host-built port updater (ports/update's own compile-on-demand block) and
# its own private copy of the recipe reader — kept separate from
# ports/.kpkgbin/ rather than shared, since the two are built from different
# call sites and there is no reason for one to assume the other has run.
ports/.portup
ports/.portup-tools/
# Per-port check results, 24h TTL, written by kdos-portup on every run.
ports/.update-cache.json

# Upstream sources are not in git. `make fetch` puts each one in the local
# cache (ports/.srccache/sha256-XX/<hash>, split by the hash's leading byte;
# the archive keeps its copy in the src-<shelf> pre-release of kunaldawn/kdos) and
# hard-links it into its port directory; `ports/publish` is what
# puts a new one in the archive. Anchored to ports/core/<shelf>/<port>, the
# depth every port sits at, so a source in a port directory is ignored and the
# archive fixtures under testing/fixtures stay tracked — ignoring those makes
# every test that replays them silently absent on a fresh clone. A pattern
# never untracks a file git already carries, so a patch or config file a recipe
# hashes is unaffected, and testing/preflight.sh fails on a tracked archive a
# recipe hashes.
ports/.srccache/
/ports/core/*/*/*.tar
/ports/core/*/*/*.tar.*
/ports/core/*/*/*.tgz
/ports/core/*/*/*.tbz2
/ports/core/*/*/*.txz
/ports/core/*/*/*.zip
/ports/core/*/*/*.7z
/ports/core/*/*/*.part
/ports/core/*/*/*.jar
/ports/core/*/*/*.rcc
/ports/core/*/*/*.onnx
/ports/core/*/*/*.traineddata
/ports/core/*/*/*.sf3
/ports/core/*/*/*.nnue
/ports/core/*/*/*.bin
/ports/core/graphics/digikam/*.jpeg
/ports/core/music-libs/fluidr3-gm-sf3/*.md
/ports/core/hamradio/meshtastic-firmware/*.json
/ports/core/hamradio/rnode-firmware/*.json
__pycache__/
ports-archived/
port-archive.sh

# Testing runtime artifacts. NOT testing/fixtures — those are the recorded
# corpora testing/selftest.sh replays (stutter, cve, portup, privacy, tray,
# energy), and ignoring them makes every fixture-driven test silently absent on
# a fresh clone while it passes on the machine that wrote them.
testing/logs/
testing/test_results.json

# Claude Code local settings and notes
.claude/

# docs/ is ignored by default so scratch notes can live there, with the two
# things that ARE the documentation named back in. A new documentation
# directory needs a line here or it is silently uncommittable.
docs/*
!docs/screenshots/
!docs/kdos/

# The mobile build root. Firmware blobs land under it and are never committed.
build-mobile/
